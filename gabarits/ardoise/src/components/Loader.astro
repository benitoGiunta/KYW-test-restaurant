---
// Loader « Ardoise » : fond ardoise, nom en Cabinet, trait de craie jaune qui se trace. Masqué en mobile (CSS).
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Chargement">
  <div class="loader__inner">
    <span class="loader__name" data-loader-out>{site.nom}</span>
    <span class="loader__count" data-loader-out data-loader-count>00</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
