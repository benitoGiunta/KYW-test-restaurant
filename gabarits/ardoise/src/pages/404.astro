---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas ou plus sur le site de ${site.nom}. Retrouvez la carte, les formules et la réservation depuis l'accueil.`}>
  <section class="entete wrap" style="min-height: 60svh; align-content: center">
    <h1 class="cap">Effacé</h1>
    <p class="lead muted">Cette ligne n'est plus sur l'ardoise. L'adresse a peut-être changé, ou contient une coquille. La carte, les formules et la réservation sont toujours là.</p>
    <div class="actions" style="flex-basis: 100%">
      <a class="btn btn--plein" href={u('/')}>Retour à l'ardoise</a>
      <a class="btn" href={u('/carte/')}>La carte</a>
      <a class="btn" href={u('/reservation/')}>Réserver</a>
    </div>
  </section>
</Base>
