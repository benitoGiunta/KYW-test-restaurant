---
// Loader « Comptoir » : page blanche, nom en capitales 200, compteur discret, barre céladon de 1 px.
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Chargement">
  <div class="loader__inner">
    <span class="loader__name" data-loader-out>{site.nom}</span>
    <span class="loader__count" data-loader-out data-loader-count>0</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
