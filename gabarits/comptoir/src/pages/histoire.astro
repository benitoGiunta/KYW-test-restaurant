---
// Histoire et équipe : portraits N&B, texte du site du client, équipe (rôles non prouvés marqués), avis, galerie.
import Base from '../layouts/Base.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const damien = photoDe('/photos/chef-damien-nb.webp');
const francois = photoDe('/photos/chef-francois-nb.webp');
const galerie = [
  '/photos/cuisine-chefs-passe.webp', '/photos/service-francois-table.webp', '/photos/equipe-trio.webp', '/photos/cuisine-chefs-dressage.webp',
  '/photos/salle-clients-bar.webp', '/photos/service-planche.webp', '/photos/salle-ampoules.webp', '/photos/dessert-tarte-pomme.webp',
].map(photoDe);
---
<Base title="Les chefs" description={`Damien Gorjanec et François Schepens, deux potes au passe : l'histoire des Potes au Feu à ${site.adresse.commune}, de la Plage d'Amée à l'avenue de la Plante.`}>
  <section class="entete-page wrap">
    <p class="petite-cap">Les chefs</p>
    <h1 data-split="lines" data-intro>L'histoire d'une rencontre</h1>
    <p class="lead">{site.baseline}</p>
  </section>

  <section class="split" aria-label="Damien Gorjanec">
    <figure class="split__media bord" data-reveal="fade">
      <img src={asset(damien.src)} srcset={`${asset('/photos/chef-damien-nb-800.webp')} 800w, ${asset(damien.src)} 1200w`} sizes="(max-width: 767px) 100vw, 50vw" alt={damien.alt} width={damien.largeur} height={damien.hauteur} fetchpriority="high" decoding="async" />
    </figure>
    <div class="split__aplat">
      <p class="petite-cap">Depuis la Plage d'Amée</p>
      <div class="texte"><p>{site.histoire[0]}</p><p>{site.histoire[1]}</p></div>
    </div>
  </section>

  <section class="split split--inverse" aria-label="François Schepens">
    <figure class="split__media" data-reveal="fade" style="margin-right: var(--lane)">
      <img src={asset(francois.src)} alt={francois.alt} width={francois.largeur} height={francois.hauteur} loading="lazy" decoding="async" />
    </figure>
    <div class="split__aplat">
      <p class="petite-cap">Avenue de la Plante</p>
      <div class="texte"><p>{site.histoire[2]}</p><p>{site.histoire[3]}</p></div>
      <a class="filet" data-filet href={u('/menu/')}><span>Le menu du moment</span><span class="fleche" aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section wrap deux-colonnes" aria-labelledby="equipe-titre">
    <div>
      <p class="petite-cap">L'équipe</p>
      <h2 id="equipe-titre" style="margin-top: 0.4em">Quatre au service</h2>
    </div>
    <ul class="equipe">
      {site.equipe.map((m) => (
        <li data-reveal="fade">
          <span class="nom">{m.nom}{m.placeholder && <span class="illu">personne illustrative</span>}</span>
          <span class="muted">{m.role}{m.rolePlaceholder && <span class="illu">rôle illustratif</span>}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap" aria-label="Ce qu'on en dit" style="padding-top: 0">
    <div class="galerie">
      {site.avis.map((a) => (
        <blockquote class="citation" data-reveal="fade">
          <p>« {a.texte} »</p>
          <cite>{a.auteur}, {a.source}{a.placeholder && <span class="illu">avis illustratif</span>}</cite>
        </blockquote>
      ))}
    </div>
  </section>

  <section class="section wrap galerie" aria-label="En images" style="padding-top: 0">
    {galerie.map((p, i) => (
      <figure class:list={[{ angle: i % 3 === 1 }]} data-reveal="fade">
        <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
        <figcaption>{p.alt}</figcaption>
      </figure>
    ))}
  </section>
</Base>
