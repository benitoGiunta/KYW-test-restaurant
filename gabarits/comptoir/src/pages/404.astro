---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas ou plus sur le site de ${site.nom}. Retrouvez le menu, les chefs et la réservation depuis l'accueil.`}>
  <section class="page-simple wrap">
    <p class="petite-cap">Erreur 404</p>
    <h1 data-split="lines" data-intro>Cette assiette n'est pas au passe</h1>
    <p class="lead">La page demandée est introuvable. Le menu, les chefs et la réservation sont à leur place.</p>
    <div class="actions">
      <a class="btn" href={u('/')}>Retour à l'accueil</a>
      <a class="btn btn--ghost" href={u('/menu/')}>Le menu</a>
    </div>
  </section>
</Base>
