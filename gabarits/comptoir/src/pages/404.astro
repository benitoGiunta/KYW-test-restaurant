---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas ou plus sur le site de ${site.nom}. Retrouvez la carte, notre histoire et la réservation depuis l'accueil.`}>
  <section class="hero wrap">
    <h1 class="hero__title" data-split="lines" data-intro>Cette table n'existe pas</h1>
    <p class="hero__baseline lead" data-reveal="fade" data-intro data-delay="0.3">
      La page demandée est introuvable. Elle a peut-être changé de nom, ou l'adresse contient une coquille. Tout le reste est à sa place : la carte du moment, l'histoire des deux chefs et la réservation en ligne.
    </p>
    <div class="actions" data-reveal="up" data-intro data-delay="0.5">
      <a class="btn btn--primary" href={u('/')}>Retour à l'accueil</a>
      <a class="btn" href={u('/carte/')}>Voir la carte</a>
      <a class="btn" href={u('/reservation/')}>Réserver</a>
    </div>
  </section>
</Base>
