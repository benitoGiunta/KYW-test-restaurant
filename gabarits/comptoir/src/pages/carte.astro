---
// Formules : cadence de blocs 50/50 photo / aplat ; boissons illustratives marquées.
import Base from '../layouts/Base.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const visuels = [photoDe('/photos/assiette-boeuf.webp'), photoDe('/photos/assiette-saint-jacques.webp'), photoDe('/photos/assiette-dessert.webp')];
const liens = [u('/menu/'), u('/reservation/'), u('/reservation/')];
const libelles = ['Voir les services', 'Réserver le midi', 'Réserver le midi'];
const boissons = site.carte[2].plats;
---
<Base title="Formules" description={`Les formules des Potes au Feu à Namur : menu dégustation ${site.menus[0].prix} le soir, formule 3 services ${site.menus[1].prix} et lunch ${site.menus[2].prix} le midi, bon cadeau.`}>
  <section class="entete-page wrap">
    <p class="petite-cap">Formules</p>
    <h1 data-split="lines" data-intro>Soir et midi</h1>
    <p class="lead">Un menu unique le soir, deux formules le midi. Tout est fait maison, avec les produits du moment.</p>
  </section>

  {site.menus.map((m, i) => (
    <section class:list={['split', { 'split--inverse': i % 2 === 1 }]} aria-labelledby={`formule-${i}`}>
      <figure class="split__media split__media--assiette" data-reveal="fade" style={i % 2 === 0 ? 'margin-left: var(--lane)' : 'margin-right: var(--lane)'}>
        <img src={asset(visuels[i].src)} srcset={i === 0 ? `${asset('/photos/assiette-boeuf-900.webp')} 900w, ${asset(visuels[i].src)} 1400w` : undefined} sizes={i === 0 ? '(max-width: 767px) 80vw, 40vw' : undefined} alt={visuels[i].alt} width={visuels[i].largeur} height={visuels[i].hauteur} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      </figure>
      <div class="split__aplat">
        <p class="petite-cap">{i === 0 ? 'Le soir' : 'Le midi'}</p>
        <h2 id={`formule-${i}`} data-split="lines">{m.nom}</h2>
        <p class="lead" style="font-weight: 400">{m.prix}{m.placeholder && <span class="illu">illustratif</span>}</p>
        <p class="texte">{m.description}</p>
        <a class="filet" data-filet href={liens[i]}><span>{libelles[i]}</span><span class="fleche" aria-hidden="true">→</span></a>
      </div>
    </section>
  ))}

  <section class="section wrap deux-colonnes" aria-labelledby="boissons-titre">
    <div>
      <p class="petite-cap">Boissons</p>
      <h2 id="boissons-titre" style="margin-top: 0.4em">Au verre, au bar</h2>
      <p class="muted" style="margin-top: 1em; max-width: 30ch">Carte des vins non publiée par le restaurant : les deux lignes ci-contre sont illustratives.</p>
    </div>
    <ul class="menu-liste" style="list-style: none">
      {boissons.map((p) => (
        <li data-reveal="fade">
          <span class="num" aria-hidden="true"></span>
          <span class="nom">{p.nom}{p.placeholder && <span class="illu">illustratif</span>}</span>
          <span class="prix">{p.prix ?? ''}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="bande wrap" id="cadeau-apercu" aria-label="Bon cadeau">
    <p>Bon cadeau de {site.bonCadeau.montants}<span class="source">{site.bonCadeau.mode}. <a class="lien" href={u('/reservation/#cadeau')}>En faire la demande</a></span></p>
  </section>
</Base>
