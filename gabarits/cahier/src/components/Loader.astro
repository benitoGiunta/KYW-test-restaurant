---
// Premier chargement : l'étiquette du cahier se colle, le compteur tourne les pages. Crochets du moteur conservés.
import { site, cahier } from '../data/site';
---
<div id="loader" role="status" aria-label="Chargement">
  <div class="etiquette etiquette--loader" data-loader-out>
    <span class="etiquette__nom">{site.nom}</span>
    <span class="etiquette__ligne">cahier n° {cahier.numero}, {cahier.saison}</span>
    <span class="etiquette__count" data-loader-count>p. 1</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
