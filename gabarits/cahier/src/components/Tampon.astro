---
// Tampon : date ou mention en capitales mono cerclées, posé avec un claquement (data-tampon, driver cahier.ts).
interface Props { texte: string; class?: string; couleur?: 'rouge' | 'bille' }
const { texte, class: cls, couleur = 'rouge' } = Astro.props;
---
<span class:list={['tampon', `tampon--${couleur}`, cls]} data-tampon>{texte}</span>
