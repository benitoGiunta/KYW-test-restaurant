---
import Base from '../layouts/Base.astro';
import { site, cahier, telHref, photoDe } from '../data/site';
import { u } from '../lib/url';
import Polaroid from '../components/Polaroid.astro';
import Tampon from '../components/Tampon.astro';
---
<Base title="Commander" description={`Bon cadeau, privatisation du samedi et chef à domicile chez ${site.nom}, ${site.adresse.commune} : demandes par téléphone ou en ligne.`}>
  <section class="page-cahier" aria-labelledby="h1">
    <div class="wrap">
      <div class="titre titre--grand">
        <p class="titre__sur">Cahier n° {cahier.numero}, commandes</p>
        <h1 id="h1" data-split="words" data-intro>Commander</h1>
        <p class="lead" style="margin-top: var(--u)">Ce que le restaurant propose en dehors du service : un bon cadeau, la salle privatisée le samedi, les chefs à domicile. Le reste se demande par téléphone.</p>
      </div>
      <div class="formules">
        {cahier.traiteur.map((f, i) => (
          <article class="formule" data-reveal="up" data-delay={String(i * 0.1)}>
            <h2 style="font-size: var(--t-m)">{f.nom}</h2>
            <p class="formule__prix">{f.prix}</p>
            <p style="font-size: var(--t-s)">{f.description}{f.placeholder && <span class="illu"> (illustratif)</span>}</p>
            <p class="formule__min">{f.minimum}</p>
          </article>
        ))}
      </div>
      <p class="muted" style="margin-top: calc(var(--u) * 2); font-size: var(--t-s)">Bon cadeau et privatisation : informations du site du restaurant. Prix et conditions de la privatisation et du chef à domicile sur demande.</p>
      <div class="actions">
        <a class="btn btn--plein" href={telHref()}>Appeler le {site.telephone}</a>
        <a class="btn" href={site.url} rel="noopener">Bon cadeau sur le site du restaurant</a>
      </div>
    </div>
    <p class="folio"></p>
  </section>

  <section class="page-cahier" aria-labelledby="h-comment">
    <div class="wrap feuille">
      <div class="recit">
        <h2 id="h-comment" data-split="words">Comment ça se passe</h2>
        <p>Pour un bon cadeau, la demande se fait en ligne sur le site du restaurant, puis le bon se retire au restaurant, avenue de la Plante.</p>
        <p>Pour une privatisation du samedi, un mariage ou un chef à domicile, appelez avec la date, le nombre de personnes et l'occasion : les chefs vous répondent avec leurs conditions.</p>
        <p><Tampon texte="sur demande" couleur="bille" /></p>
        <div class="actions"><a class="btn" href={u('/carte/')}>Voir la carte du moment</a></div>
      </div>
      <div class="feuille__marge">
        <Polaroid photo={photoDe('/photos/service-planche.webp')} rot={-2.5} legende="une planche, en route vers la salle" />
      </div>
    </div>
    <p class="folio"></p>
  </section>
</Base>
