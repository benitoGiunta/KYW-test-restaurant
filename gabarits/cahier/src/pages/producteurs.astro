---
import Base from '../layouts/Base.astro';
import { site, cahier, photoDe } from '../data/site';
import { u } from '../lib/url';
import Timbre from '../components/Timbre.astro';
import Polaroid from '../components/Polaroid.astro';
const rots = [-3, 2, -2, 3, -1.5, 2.5];
---
<Base title="Les producteurs" description={`Les Potes au Feu à ${site.adresse.commune} travaillent avec des producteurs du coin : légumes cultivés localement, produits des saisons, fait maison.`}>
  <section class="page-cahier" aria-labelledby="h1">
    <div class="wrap">
      <div class="titre titre--grand">
        <p class="titre__sur">Cahier n° {cahier.numero}, fournisseurs</p>
        <h1 id="h1" data-split="words" data-intro>De chez qui</h1>
        <p class="lead" style="margin-top: var(--u)">Les chefs soignent leurs relations avec les producteurs du coin, qui leur fournissent des produits frais. Les fiches ci-dessous sont des exemples, en attendant la liste du restaurant.</p>
      </div>
      <div class="mur" data-mur>
        {cahier.producteurs.map((p, i) => (
          <div>
            <Timbre photo={photoDe(p.photo)} rot={rots[i]} legende={`${p.prenom}, ${p.village}`} detail={p.produit} illustratif={p.placeholder} lazy={i > 2} />
            <p class="annot annot--fleche">{p.note}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="folio"></p>
  </section>

  <section class="page-cahier" aria-labelledby="h-regle">
    <div class="wrap feuille">
      <div class="recit">
        <h2 id="h-regle" data-split="words">La règle du cahier</h2>
        <p>Une cuisine bistronomique à quatre mains, avec un ancrage local : les chefs soignent leurs relations avec les producteurs du coin, et le menu unique suit les saisons et les produits du moment. Tout est fait maison.</p>
        <p>Le Guide MICHELIN Belgique 2026 le relève : « Légumes cultivés localement, associations originales et saveurs intenses sont au rendez-vous. »</p>
        <p class="illu">Les producteurs de cette page (prénoms, villages, produits) sont illustratifs : la liste exacte est à fournir par le restaurant.</p>
        <div class="actions">
          <a class="btn btn--plein" href={u('/carte/')}>La carte, avec les origines</a>
        </div>
      </div>
      <div class="feuille__marge">
        <Polaroid photo={photoDe('/photos/cuisine-salage-viande.webp')} rot={2} legende="le sel, avant la cuisson" />
      </div>
    </div>
    <p class="folio"></p>
  </section>
</Base>
