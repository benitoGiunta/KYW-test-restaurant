---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n'existe pas. Retour à l'accueil des Potes au Feu.">
  <HeroPage titre="Rideau" sur="Erreur 404">
    <p>Cette page n'existe pas, ou plus. La salle, elle, est toujours avenue de la Plante.</p>
    <div class="actions">
      <a class="btn btn--primary" href={u('/')}>Retour à l'accueil</a>
      <a class="btn" href={u('/reservation/')}>Réserver</a>
    </div>
  </HeroPage>
</Base>
