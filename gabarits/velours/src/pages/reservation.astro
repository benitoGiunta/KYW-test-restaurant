---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site, adresseLigne, horaireTexte, telHref } from '../data/site';
---
<Base title="Réservation" description={`Réserver une table aux Potes au Feu, ${site.adresse.commune} : en ligne via ${site.reservation.outil} ou par téléphone au ${site.telephone}.`}>
  <HeroPage titre="Réserver" sur="Une table, le soir ou le midi">
    <p>La réservation se fait en ligne via {site.reservation.outil}. {site.reservation.note}</p>
    <div class="actions">
      <a class="btn btn--primary" href={site.reservation.url} rel="noopener">Réserver sur {site.reservation.outil}</a>
      <a class="btn" href={telHref()}>Appeler le {site.telephone}</a>
    </div>
  </HeroPage>

  <section class="section" aria-labelledby="demande-titre">
    <div class="wrap resa">
      <div class="resa__form">
        <h2 class="petite-cap" id="demande-titre">Votre demande</h2>
        <p class="muted">Formulaire de démonstration sans envoi : la validation vous conduit vers {site.reservation.outil}.</p>
        <form class="form" data-reservation action={site.reservation.url} method="get">
          <label>Nom <input type="text" name="nom" autocomplete="name" required /></label>
          <label>Date <input type="date" name="date" data-min-aujourdhui required /></label>
          <label>Heure d'arrivée <input type="time" name="heure" required /></label>
          <label>Couverts <input type="number" name="couverts" min="1" max="6" value="2" required /></label>
          <label>Message <textarea name="message" rows="3"></textarea></label>
          <p class="actions"><button class="btn btn--primary" type="submit">Continuer sur {site.reservation.outil}</button></p>
        </form>
      </div>
      <aside class="resa__infos" data-reveal="fade">
        <p class="petite-cap">Services</p>
        <dl class="horaires">
          {site.horaires.map((h) => <><dt>{h.jour}</dt><dd>{horaireTexte(h)}</dd></>)}
        </dl>
        <p class="petite-cap">Adresse</p>
        <address>{adresseLigne()}<br />Bord de Meuse, côté Citadelle</address>
        <p><a class="lien" href={`https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lon}#map=18/${site.geo.lat}/${site.geo.lon}`} rel="noopener">Itinéraire</a></p>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { onPage } from '../engine';
  // Formulaire sans backend : à la validation, on ouvre l'outil de réservation réel (les champs ne sont pas transmis).
  // La date minimale est aujourd'hui, calculée côté client : jamais de date écrite en dur.
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-reservation]');
    if (!form) return;
    const date = form.querySelector<HTMLInputElement>('[data-min-aujourdhui]');
    if (date) { const d = new Date(); date.min = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }
    const go = (e: SubmitEvent) => { e.preventDefault(); window.open(form.action, '_blank', 'noopener'); };
    form.addEventListener('submit', go);
    return () => form.removeEventListener('submit', go);
  });
</script>
