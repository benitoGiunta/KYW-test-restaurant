---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n'existe pas : le feu est éteint ici. Retour à l'accueil, à la carte ou à la réservation." start={20}>
  <section class="section p404" data-temp="20">
    <div class="wrap">
      <p class="chapeau" data-reveal="fade" data-intro>20 °C</p>
      <h1 class="t-xl" data-split="lines" data-intro>Le feu est éteint ici.</h1>
      <p class="lead" data-reveal="up" data-intro data-delay="0.4" style="margin-top: calc(var(--u) * 2)">La page que vous cherchez n'existe pas ou a changé d'adresse. La cuisine, elle, est toujours ouverte.</p>
      <div class="actions" data-reveal="fade" data-intro data-delay="0.6">
        <a class="btn btn--solid" href={u('/')}>Retour au passe</a>
        <a class="btn" href={u('/carte/')}>La carte</a>
        <a class="btn" href={u('/reservation/')}>Réserver</a>
      </div>
    </div>
  </section>
</Base>
