---
// Barre basse fixe (mobile) : réserver / appeler.
import { site, telHref } from '../data/site';
import { u } from '../lib/url';
---
<div class="barre">
  <span class="barre__temp num" aria-hidden="true"><span data-thermo-val>900</span>°C</span>
  <a class="btn btn--solid" href={u('/reservation/')}>Réserver</a>
  <a class="btn" href={telHref()}>Appeler</a>
</div>
