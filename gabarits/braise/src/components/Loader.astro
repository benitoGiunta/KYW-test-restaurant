---
// Premier chargement : le compteur chauffe de 20 à 900 °C (format dans src/motion/setup.ts).
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Chargement">
  <div class="loader__inner">
    <span class="loader__name" data-loader-out>{site.nom}</span>
    <span class="loader__count num" data-loader-out><span data-loader-count>20</span> °C</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
