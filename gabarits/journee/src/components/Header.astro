---
// En-tête « Journée » : marque, badge ouvert (calculé en JS sur les horaires réels), navigation.
import { site } from '../data/site';
import { u } from '../lib/url';
import Badge from './Badge.astro';
const liens = [
  { href: u('/'), label: 'Accueil' },
  { href: u('/carte/'), label: 'La carte' },
  { href: u('/brunch/'), label: 'Brunch' },
  { href: u('/histoire/'), label: 'Histoire' },
  { href: u('/reservation/'), label: 'Réserver' },
];
const ici = Astro.url.pathname.replace(/\/+$/, '');
const courant = (href: string) => (href.replace(/\/+$/, '') === ici ? 'page' : undefined);
---
<header class="header">
  <div class="header__inner">
    <a class="header__brand" href={u('/')} aria-label={`${site.nom}, accueil`}>
      <span class="header__disque" aria-hidden="true"></span>
      <span>{site.nom}</span>
    </a>
    <Badge compact />
    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => <a class="nav__lien" href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
    </nav>
  </div>
</header>
