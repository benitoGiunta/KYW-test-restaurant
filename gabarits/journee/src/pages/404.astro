---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" theme="nuitProfonde" description={`Cette page n'existe pas ou plus sur le site de ${site.nom}. Retrouvez la carte, notre histoire et la réservation depuis l'accueil.`}>
  <section class="section quatre" data-ciel="nuitProfonde">
    <div class="wrap">
      <p class="chapeau" data-reveal="fade" data-intro>Erreur 404</p>
      <h1 class="t-xl" data-split="lines" data-intro>Cette page a fermé</h1>
      <p class="lead" style="margin-top: calc(var(--u) * 2)">L'adresse demandée est introuvable : elle a peut-être changé de nom, ou contient une coquille. La journée continue ailleurs : la carte heure par heure, l'histoire des deux chefs et la réservation.</p>
      <div class="actions" data-reveal="up" data-intro data-delay="0.3">
        <a class="btn btn--soleil" href={u('/')}>Retour à l'accueil</a>
        <a class="btn" href={u('/carte/')}>Voir la carte</a>
        <a class="btn" href={u('/reservation/')}>Réserver</a>
      </div>
    </div>
  </section>
</Base>
