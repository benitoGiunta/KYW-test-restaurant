---
// Loader « nappe » : fond lin, nom en Zodiak italique, un cornet de frites dont le remplissage suit la progression, compteur sr-only.
import { site } from '../data/site';
import Objet from './Objet.astro';
---
<div id="loader" role="status" aria-label="Chargement">
  <div class="loader__inner">
    <span class="loader__objet" data-loader-out><Objet id="frites" classe="loader__svg" /></span>
    <span class="loader__name" data-loader-out>{site.nom}</span>
    <span class="sr-only" data-loader-count>000</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
