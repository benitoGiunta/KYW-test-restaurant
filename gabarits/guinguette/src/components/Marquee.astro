---
// Marquee d'état : sans JS, les jours de service ; avec JS, « Ouvert » ou « Fermé » calculé depuis site.horaires (aucune date en dur).
import { site, adresseLigne } from '../data/site';
const ouverts = site.horaires.filter((h) => h.creneaux.length).map((h) => h.jour);
const base = [`Service du soir du ${ouverts[0]} au ${ouverts[ouverts.length - 1]}`, adresseLigne(), `Réservation en ligne via ${site.reservation.outil}`];
const horaires = JSON.stringify(site.horaires.map((h) => ({ j: h.jour, c: h.creneaux })));
---
<div class="marquee" data-marquee data-horaires={horaires} aria-label="État du restaurant">
  <div class="marquee__piste">
    {[0, 1].map((k) => (
      <p class="marquee__groupe" aria-hidden={k === 1 ? 'true' : undefined}>
        <span class="marquee__etat" data-marquee-etat>Horaires du jour</span>
        {base.map((t) => <span>{t}</span>)}
      </p>
    ))}
  </div>
</div>
