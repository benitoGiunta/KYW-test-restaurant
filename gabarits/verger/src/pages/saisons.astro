---
// Calendrier indicatif par saison (un seul tableau `ingredients`) et un EXEMPLE de composition par saison, marqué ; le menu réel est sur /carte/.
import Base from '../layouts/Base.astro';
import { site, saisons, ingredients, mois } from '../data/site';
import { u } from '../lib/url';
const ingDe = (s: (typeof saisons)[number]) => ingredients.filter((i) => i.mois.some((m) => s.mois.includes(m)));
---
<Base title="Les saisons" description={`Les Potes au Feu à ${site.adresse.commune} servent un menu unique de saison : calendrier indicatif des produits et exemples illustratifs de ce que chaque saison peut apporter.`}>
  <section class="hero wrap" data-hero>
    <p class="meta hero__sur">Calendrier indicatif</p>
    <h1 class="mots" data-mots><span>Au</span><span>fil</span><span>des</span><span>saisons</span></h1>
    <p class="hero__accroche" data-hero-apres>Un menu unique, de saison, inspiré des produits du moment. Voici ce que chaque saison peut apporter, et des exemples de ce qu'elle pourrait devenir à table<span class="exemple">*</span>.</p>
  </section>

  <section class="section section--fin">
    <div class="wrap saisons">
      {saisons.map((s) => (
        <article class="saison" data-reveal="up">
          <p class="meta">{s.mois.map((m) => mois[m - 1]).join(' · ')}</p>
          <h2>{s.nom}</h2>
          <p class="saison__ingredients">{ingDe(s).map((i) => <span class="etiquette">{i.nom}</span>)}</p>
          <p class="meta meta--terre">Exemple de carte<span class="exemple">*</span></p>
          <ul class="carte-liste">{s.plats.map((p) => <li class="plat"><span class="plat__nom">{p.nom}</span></li>)}</ul>
        </article>
      ))}
    </div>
    <div class="col centre" style="margin-top: calc(var(--u) * 6)">
      <p class="muted"><span class="exemple">*</span> Calendrier des produits et exemples de plats illustratifs : le rythme de la carte n'est pas connu. <a class="link" href={u('/carte/')}>Le menu actuel</a> est le seul menu réel.</p>
    </div>
  </section>
</Base>
