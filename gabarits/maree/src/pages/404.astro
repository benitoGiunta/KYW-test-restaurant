---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas sur le site des ${site.nom}.`}>
  <section class="hero hero--texte sec--fin" aria-labelledby="t-404" style="min-height: 70svh">
    <div class="wrap hero__bas">
      <span class="eyebrow mono" data-reveal="fade" data-intro>Marée basse</span>
      <h1 id="t-404" style="font-size: var(--t-xl)" data-split="words" data-intro>Cette page est partie avec la marée</h1>
      <p class="lead" style="margin-top: calc(var(--u) * 3)">L'adresse n'existe pas, ou plus. La table, elle, est toujours là.</p>
      <div class="actions">
        <a class="btn btn--plein" href={u('/')}>Retour à l'accueil</a>
        <a class="btn" href={u('/reservation/')}>Réserver</a>
      </div>
    </div>
  </section>
</Base>
