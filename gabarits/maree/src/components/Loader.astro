---
// Premier chargement : la marée monte de 0,00 m à 2,40 m (format dans src/motion/setup.ts) ; le panneau écume
// remonte ensuite avec une crête de houle à son bord inférieur.
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Chargement">
  <div class="loader__inner wrap">
    <span class="loader__name" data-loader-out>{site.nom}</span>
    <span class="loader__count mono" data-loader-out><span class="loader__label">marée montante</span> <span data-loader-count>0,00 m</span></span>
  </div>
  <div class="wrap"><div class="loader__bar" data-loader-bar></div></div>
  <svg class="loader__crete" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path data-crete d="M0,40 L1440,40 L1440,80 L0,80 Z" /></svg>
</div>
