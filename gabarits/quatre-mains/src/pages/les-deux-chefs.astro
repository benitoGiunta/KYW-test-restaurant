---
import Base from '../layouts/Base.astro';
import { site, chef, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const damien = chef('D');
const francois = chef('F');
const portraitD = photoDe(damien.portrait);
const portraitF = photoDe(francois.portrait);
const cuisineD = photoDe('/photos/cuisine-salage-viande.webp');
const cuisineF = photoDe('/photos/service-francois-table.webp');
const ensemble = photoDe('/photos/cuisine-chefs-dressage.webp');
const plat = (nom: string) => site.carteQuatreMains.find((p) => p.nom === nom);
---
<Base title="Les deux chefs" description={`Damien Gorjanec et François Schepens, les deux chefs et associés des Potes au Feu à Namur : deux parcours, une cuisine à quatre mains.`}>
  <section class="hero dip" data-voix="deux" aria-labelledby="chefs-h1">
    <div class="dip__g hero__col">
      <figure class="photo photo--4x5 photo--nb hero__portrait" data-reveal="clip" data-intro data-delay="0.15">
        <img src={asset(portraitD.src)} alt={portraitD.alt} width={portraitD.largeur} height={portraitD.hauteur} data-critical />
      </figure>
      <div class="hero__legende">
        <span class="mono muted">{damien.registre}</span>
        <h1 class="display t-xl" id="chefs-h1" style="margin-left: 0">{damien.prenom}<br />et {francois.prenom}</h1>
        <p class="muted">Deux chefs, deux parcours, une cuisine.</p>
      </div>
    </div>
    <div class="dip__d hero__col hero__col--d">
      <figure class="photo photo--4x5 hero__portrait" data-reveal="clip" data-intro data-delay="0.25">
        <img src={asset(portraitF.src)} alt={portraitF.alt} width={portraitF.largeur} height={portraitF.hauteur} data-critical />
      </figure>
      <div class="hero__legende" data-reveal="up" data-intro data-delay="0.5">
        <span class="mono muted">{francois.registre}</span>
        <p class="t-m">{francois.prenom} {francois.nom}</p>
        <p class="muted">{francois.role}</p>
      </div>
    </div>
  </section>

  <section class="dip section" data-voix="gauche" data-decale aria-labelledby="damien-titre">
    <div class="dip__g">
      <span class="mono muted eyebrow" data-reveal="fade">01, {damien.registre.toLowerCase()}</span>
      <h2 class="titre" id="damien-titre" data-split="lines">{damien.prenom} {damien.nom}</h2>
      <div class="stack mesure" style="margin-top: calc(var(--u) * 3)">
        {damien.bio.map((p) => <p data-reveal="up">{p}</p>)}
        <p class="mono muted" data-reveal="fade">Plats fétiches : {damien.platsFetiches.join(' ; ')}</p>
      </div>
      <blockquote class="citation" style="margin-top: calc(var(--u) * 6)">
        <p data-split="lines">« {damien.citation.texte} »</p>
        <cite class="mono muted" data-reveal="fade">{damien.prenom}{damien.citation.placeholder ? ', citation illustrative' : ''}</cite>
      </blockquote>
    </div>
    <div class="dip__d escalier--d">
      <figure class="photo photo--3x2 photo--nb frise__photo" data-reveal="clip">
        <img class="photo__para" src={asset(cuisineD.src)} alt={cuisineD.alt} width={cuisineD.largeur} height={cuisineD.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
      </figure>
      <ol class="frise">
        {damien.parcours.map((e) => (
          <li data-reveal="up"><span class="frise__annee">{e.annee}</span><div><p class="frise__lieu">{e.lieu}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="dip section" data-voix="droite" data-decale aria-labelledby="francois-titre">
    <div class="dip__g escalier--g">
      <figure class="photo photo--3x2 frise__photo" data-reveal="clip">
        <img class="photo__para" src={asset(cuisineF.src)} alt={cuisineF.alt} width={cuisineF.largeur} height={cuisineF.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
      </figure>
      <ol class="frise">
        {francois.parcours.map((e) => (
          <li data-reveal="up"><span class="frise__annee">{e.annee}</span><div><p class="frise__lieu">{e.lieu}</p></div></li>
        ))}
      </ol>
    </div>
    <div class="dip__d">
      <span class="mono muted eyebrow" data-reveal="fade">02, {francois.registre.toLowerCase()}</span>
      <h2 class="titre" id="francois-titre" data-split="lines">{francois.prenom} {francois.nom}</h2>
      <div class="stack mesure" style="margin-top: calc(var(--u) * 3)">
        {francois.bio.map((p) => <p data-reveal="up">{p}</p>)}
        <p class="mono muted" data-reveal="fade">Plats fétiches : {francois.platsFetiches.join(' ; ')}</p>
      </div>
      <blockquote class="citation" style="margin-top: calc(var(--u) * 6)">
        <p data-split="lines">« {francois.citation.texte} »</p>
        <cite class="mono muted" data-reveal="fade">{francois.prenom}{francois.citation.placeholder ? ', citation illustrative' : ''}</cite>
      </blockquote>
    </div>
  </section>

  <section class="commune section" data-voix="commune" data-rejoint aria-labelledby="ensemble-titre">
    <div class="wrap grille">
      <div class="col-6">
        <span class="mono muted eyebrow" data-reveal="fade">Ensemble</span>
        <h2 class="titre" id="ensemble-titre" data-split="lines">À quatre mains, au passe et en salle</h2>
        <div class="stack mesure" style="margin-top: calc(var(--u) * 3)">
          <p data-reveal="up">{site.histoire[3]}</p>
          <ul class="stack" data-reveal="up">
            {site.valeurs.map((v) => <li>{v}</li>)}
          </ul>
        </div>
        <div class="actions">
          <a class="btn" href={u('/carte/')}><span class="roll"><span>Voir la carte</span><span aria-hidden="true">Voir la carte</span></span></a>
          <a class="lien" href={u('/reservation/')}>Réserver</a>
        </div>
      </div>
      <figure class="col-6 photo photo--4x5" data-reveal="scale">
        <img src={asset(ensemble.src)} alt={ensemble.alt} width={ensemble.largeur} height={ensemble.hauteur} loading="lazy" decoding="async" />
      </figure>
      <div class="col-6">
        <h3 class="mono muted">Les plats de {damien.prenom}</h3>
        <ul class="plats">{damien.platsFetiches.map((n) => <li><div><h4 style="font-weight: 700">{n}</h4><p class="muted">{plat(n)?.description}</p></div></li>)}</ul>
      </div>
      <div class="col-6">
        <h3 class="mono muted">Les plats de {francois.prenom}</h3>
        <ul class="plats">{francois.platsFetiches.map((n) => <li><div><h4 style="font-weight: 700">{n}</h4><p class="muted">{plat(n)?.description}</p></div></li>)}</ul>
      </div>
    </div>
  </section>
</Base>
