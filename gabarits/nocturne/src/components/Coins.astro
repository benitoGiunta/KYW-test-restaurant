---
// Boutons de coin : Suivre (réseau réel, bas gauche) et Réserver (ambre, bas droite), fixes sur toutes les pages ;
// barre basse en mobile ; se retirent quand le pied de page est visible.
import { site } from '../data/site';
import { u } from '../lib/url';
const reseau = site.reseaux[0];
---
<div class="coins" data-coins>
  <a class="coin coin--gauche" href={reseau.url} rel="noopener"><span class="coin__fleche" aria-hidden="true">←</span><span>{reseau.nom}</span></a>
  <a class="coin coin--droite" href={u('/reservation/')}><span>Réserver</span><span class="coin__fleche" aria-hidden="true">→</span></a>
</div>
