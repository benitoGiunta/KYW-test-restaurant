---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas ou plus sur le site de ${site.nom}. Retrouvez la carte, les cocktails, l'histoire et la réservation depuis l'accueil.`}>
  <section class="hero hero--page col-l">
    <h1 class="hero__titre tube" data-tube>Lumière éteinte</h1>
    <p class="lead" data-reveal="fade">La page demandée est introuvable. Elle a peut-être changé de nom, ou l'adresse contient une coquille. Tout le reste est allumé.</p>
    <div class="actions" data-reveal="up" data-delay="0.15">
      <a class="btn btn--ambre" href={u('/')}>Retour à l'accueil</a>
      <a class="btn" href={u('/carte/')}>La carte</a>
      <a class="btn" href={u('/reservation/')}>Réserver</a>
    </div>
  </section>
</Base>
