---
import Base from '../layouts/Base.astro';
import { site, adresseLigne, horaireTexte, telHref, serviceSoir, heure } from '../data/site';
const s = serviceSoir(site);
const midi = site.horaires.filter((h) => h.creneaux.some((c) => c.ouverture < '17:00'));
const midiTexte = midi.length ? `Le midi, ${midi.map((h) => h.jour).join(' et ')}, de ${heure(midi[0].creneaux[0].ouverture)} à ${heure(midi[0].creneaux[0].fermeture)}. ` : '';
const creneaux = JSON.stringify(site.horaires.map((h) => ({ jour: h.jour, creneaux: h.creneaux })));
---
<Base title="Réservation" description={`Réserver une table chez ${site.nom} à ${site.adresse.commune} : en ligne via ${site.reservation.outil} ou par téléphone au ${site.telephone}. Service du soir ${s.texte}.`}>
  <section class="hero hero--page col-l">
    <h1 class="hero__titre tube" data-tube>Réserver</h1>
    <p class="lead" data-reveal="fade">En ligne via {site.reservation.outil}. {site.regles[1].texte}</p>
    <div class="actions" data-reveal="up" data-delay="0.15">
      <a class="btn btn--ambre" href={site.reservation.url} rel="noopener">Réserver sur {site.reservation.outil} <span class="fleche" aria-hidden="true">→</span></a>
      <a class="btn" href={telHref()}>Appeler le {site.telephone}</a>
    </div>
  </section>

  <section class="section section--serre col-l" aria-labelledby="demande">
    <div class="section__tete">
      <h2 id="demande" class="tube tube--xl" data-tube data-reveal="fade">Votre table</h2>
      <p class="muted">{midiTexte}Le soir, {s.texte}, de {heure(s.ouverture)} à {heure(s.fermeture)} (heures d'arrivée). Formulaire de démonstration : rien n'est envoyé, le bouton ouvre {site.reservation.outil} où vous choisissez votre table.</p>
    </div>
    <form class="form" data-reservation data-creneaux={creneaux} action={site.reservation.url} method="get">
      <label>Nom <input type="text" name="nom" autocomplete="name" required /></label>
      <label>Date <input type="date" name="date" required /></label>
      <label>Heure <input type="time" name="heure" step="900" required aria-describedby="heure-aide" /></label>
      <p id="heure-aide" class="note-heure muted" aria-live="polite"></p>
      <label>Couverts <input type="number" name="couverts" min="1" max="6" value="2" required /></label>
      <label>Message <textarea name="message" rows="3"></textarea></label>
      <div class="actions" style="margin-top: 0">
        <button class="btn btn--ambre" type="submit">Ouvrir {site.reservation.outil}</button>
      </div>
    </form>
  </section>

  <section class="section col-l venir" aria-labelledby="horaires">
    <div data-reveal="fade">
      <h2 id="horaires" class="tube tube--xl" data-tube style="margin-bottom: calc(var(--u) * 2)">Horaires</h2>
      <dl class="horaires">
        {site.horaires.map((h) => <><dt>{h.jour}</dt><dd>{horaireTexte(h)}</dd></>)}
      </dl>
    </div>
    <div class="stack" data-reveal="fade" data-delay="0.15">
      <p class="meta">Adresse</p>
      <address>{adresseLigne()}</address>
      <p class="meta" style="margin-top: calc(var(--u) * 2)">À savoir</p>
      <ol class="regles" style="border-top: 0">
        {site.regles.slice(0, 4).map((r) => <li class="regle" style="font-size: var(--t-body)">{r.texte}{r.placeholder && <span class="illu">illustratif</span>}</li>)}
      </ol>
    </div>
  </section>
</Base>

<script>
  import { onPage } from '../engine';
  // Contrôle doux de l'heure : accepte chaque créneau réel du jour choisi (midi et soir), heures d'arrivée bornes incluses.
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-reservation]');
    if (!form) return;
    const jours = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
    const horaires = JSON.parse(form.dataset.creneaux || '[]') as { jour: string; creneaux: { ouverture: string; fermeture: string }[] }[];
    const date = form.querySelector<HTMLInputElement>('input[name="date"]')!;
    const heure = form.querySelector<HTMLInputElement>('input[name="heure"]')!;
    const aide = form.querySelector<HTMLElement>('#heure-aide')!;
    const h = (s: string) => s.replace(':00', 'h').replace(':', 'h');
    const verifier = () => {
      heure.setCustomValidity('');
      aide.textContent = '';
      if (!date.value) return;
      const [a, mo, j] = date.value.split('-').map(Number);
      const jour = jours[new Date(Date.UTC(a, mo - 1, j)).getUTCDay()];
      const cr = horaires.find((x) => x.jour === jour)?.creneaux ?? [];
      if (!cr.length) { const msg = `Le restaurant est fermé le ${jour}.`; aide.textContent = msg; date.setCustomValidity(msg); return; }
      date.setCustomValidity('');
      aide.textContent = `Le ${jour} : ${cr.map((c) => `${h(c.ouverture)} à ${h(c.fermeture)}`).join(' ou ')}.`;
      if (heure.value && !cr.some((c) => heure.value >= c.ouverture && heure.value <= c.fermeture)) {
        heure.setCustomValidity(`Choisissez une heure d'arrivée ${cr.map((c) => `entre ${h(c.ouverture)} et ${h(c.fermeture)}`).join(' ou ')}.`);
      }
    };
    const go = (e: SubmitEvent) => { e.preventDefault(); window.open(form.action, '_blank', 'noopener'); };
    date.addEventListener('input', verifier); heure.addEventListener('input', verifier);
    form.addEventListener('submit', go);
    return () => { form.removeEventListener('submit', go); date.removeEventListener('input', verifier); heure.removeEventListener('input', verifier); };
  });
</script>
