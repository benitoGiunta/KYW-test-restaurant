---
// Plan d'accès au trait : la Meuse, la Citadelle, le Casino, le Royal Snail et le restaurant, d'après les repères du
// dossier (bord de Meuse côté Citadelle, entre le Casino et le Royal Snail). Les tracés se dessinent à l'entrée
// (setup.ts, [data-trace]). Schéma, pas une carte à l'échelle : la légende le dit.
import { site } from '../data/site';
---
<figure class="plan">
  <svg class="plan__svg" viewBox="0 0 420 320" role="img" aria-label={`Schéma d'accès : la Meuse, la Citadelle, le Casino et ${site.nom}, avenue de la Plante`}>
    <path class="plan__meuse" data-trace d="M-10 250 C 70 215, 130 290, 210 240 S 330 170, 430 205" />
    <path class="plan__meuse plan__meuse--fine" data-trace d="M-10 272 C 70 237, 130 312, 210 262 S 330 192, 430 227" />
    <path class="plan__trait" data-trace d="M40 120 C 70 60, 150 40, 200 80 S 190 160, 140 170 S 50 170, 40 120" />
    <path class="plan__trait" data-trace d="M95 118 l 18 -22 l 22 14 l -8 26 l -28 4 z" />
    <path class="plan__trait" data-trace d="M236 120 h 54 v 36 h -54 z" />
    <path class="plan__trait" data-trace d="M352 122 h 42 v 30 h -42 z" />
    <path class="plan__trait plan__trait--rue" data-trace d="M200 200 C 260 190, 320 185, 420 180" />
    <circle class="plan__ici" cx="318" cy="186" r="7" />
    <text class="plan__texte" x="118" y="60">La Citadelle</text>
    <text class="plan__texte" x="226" y="112">Casino</text>
    <text class="plan__texte" x="340" y="114">Royal Snail</text>
    <text class="plan__texte plan__texte--meuse" x="250" y="300">La Meuse</text>
    <text class="plan__texte plan__texte--ici" x="296" y="214">{site.nom}</text>
    <text class="plan__texte plan__texte--petit" x="206" y="176">avenue de la Plante</text>
  </svg>
  <figcaption class="plan__legende">Schéma indicatif, sans échelle : {site.acces.reperes.map((r) => r.nom.toLowerCase()).join(', ')}.</figcaption>
</figure>
