---
import Base from '../layouts/Base.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const visuel = photoDe('/photos/plat-boeuf-confit.webp');
---
<Base title="La carte" description={`La carte et les formules de ${site.nom} à ${site.adresse.commune} : menu dégustation unique de saison, formule du midi, lunch et bon cadeau.`}>
  <section class="hero wrap">
    <h1 class="hero__title" data-split="lines" data-intro>La carte</h1>
    <p class="hero__baseline lead" data-reveal="fade" data-intro data-delay="0.3">
      Un menu unique qui change au fil des saisons, écrit à quatre mains et servi par les chefs.
    </p>
  </section>

  {site.carte.map((cat) => (
    <section class="section">
      <div class="wrap">
        <h2 class="section__title" data-split="words">{cat.categorie}</h2>
        <div data-reveal="up">
          {cat.plats.map((p) => (
            <div class="plat">
              <div>
                <h3>{p.nom}{p.placeholder ? <span class="muted"> (exemple)</span> : null}</h3>
                {p.description && <p class="muted">{p.description}</p>}
              </div>
              {p.prix && <p class="plat__prix">{p.prix}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap">
      <h2 class="section__title" data-split="words">Les formules</h2>
      <div class="grid">
        {site.menus.map((m) => (
          <article class="menu stack" data-reveal="up">
            <h3>{m.nom}</h3>
            <p><strong>{m.prix}</strong></p>
            <p class="muted">{m.description}</p>
          </article>
        ))}
      </div>
      <figure class="card" style="margin-top: calc(var(--u) * 4); max-width: 36rem" data-reveal="clip">
        <img src={asset(visuel.src)} alt={visuel.alt} width={visuel.largeur} height={visuel.hauteur} loading="lazy" decoding="async" />
        <figcaption class="muted">{visuel.alt}</figcaption>
      </figure>
      <div class="actions">
        <a class="btn btn--primary" href={u('/reservation/')}>Réserver une table</a>
      </div>
    </div>
  </section>
</Base>
