---
// Page d'exemple : le restaurant de référence ne propose pas de service à emporter (inconnu au dossier).
// Bandeau peint sans JS dans le hero, sous l'en-tête (jamais en tête de page : il percutait l'en-tête absolu),
// page absente de la navigation principale (lien d'exemple en pied de page), prix « à définir », aucun CTA de réservation, chaque ligne marquée « exemple ».
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
const { emporter } = site;
---
<Base title="À emporter (exemple)" description={`Page d'exemple du gabarit : un service de plats à emporter, que ${site.nom} ne propose pas.`} preloads={[{ href: '/photos/service-planche-960.webp', media: '(max-width: 767px)' }, { href: '/photos/service-planche.webp', media: '(min-width: 768px)' }]}>
  <HeroPage photo="/photos/service-planche.webp" photoMobile="/photos/service-planche-960.webp" titre={emporter.titre} phrase="Exemple de page pour un service de plats à emporter." bandeau="Le service à emporter n’est pas connu pour ce restaurant : cette page montre ce que le gabarit en ferait. Plats et prix sont illustratifs." />

  <section class="section" aria-labelledby="emporter-titre">
    <div class="wrap colonne">
      <p class="chapeau" data-reveal="fade">01</p>
      <h2 class="titre-centre" id="emporter-titre" data-split="lines">Boîtes et bentos</h2>
      <p class="texte" data-reveal="up">{emporter.texte}</p>
    </div>
    <div class="wrap emporter-liste" style="margin-top: calc(var(--u) * 3)">
      <ul style="list-style: none; padding: 0" data-reveal="up">
        {emporter.lignes.map((l) => (
          <li class="ligne ligne--sans"><span class="ligne__num" aria-hidden="true">·</span><span class="ligne__nom">{l.nom}<span class="illu">exemple</span></span><span class="ligne__prix ligne__prix--vide">Prix à définir</span></li>
        ))}
      </ul>
      <div class="actions actions--centre">
        <a class="btn" href={u('/carte/')}>Voir la carte réelle</a>
      </div>
    </div>
  </section>
</Base>
