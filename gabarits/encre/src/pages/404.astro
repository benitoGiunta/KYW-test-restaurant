---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas sur le site de ${site.nom}.`}>
  <section class="wrap page-404">
    <p class="chapeau">404</p>
    <h1>Le rouleau s’arrête ici</h1>
    <p class="muted">Cette page n’existe pas ou plus.</p>
    <div class="actions actions--centre">
      <a class="btn btn--plein" href={u('/')}>Retour à l’accueil</a>
      <a class="btn" href={u('/carte/')}>Voir la carte</a>
    </div>
  </section>
</Base>
