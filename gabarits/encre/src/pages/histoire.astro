---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import TitreV from '../components/TitreV.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';

const chefs = site.equipe.filter((m) => m.photo).map((m) => ({ ...m, img: photoDe(m.photo!) }));
const salle = site.equipe.filter((m) => !m.photo);
const diptyque1 = ['/photos/cuisine-chefs-passe.webp', '/photos/cuisine-francois-poele.webp'].map(photoDe);
const diptyque2 = ['/photos/salle-banquette.webp', '/photos/equipe-trio.webp'].map(photoDe);
---
<Base title="L’histoire" description={`L'histoire de ${site.nom} : la rencontre de François Schepens et Damien Gorjanec, deux chefs qui cuisinent à quatre mains à ${site.adresse.commune}.`} preloads={[{ href: '/photos/portrait-damien-profil-960.webp', media: '(max-width: 767px)' }, { href: '/photos/portrait-damien-profil.webp', media: '(min-width: 768px)' }]}>
  <HeroPage photo="/photos/portrait-damien-profil.webp" photoMobile="/photos/portrait-damien-profil-960.webp" titre="L’histoire" phrase="D’abord l’histoire d’une rencontre, celle de deux potes passionnés." />

  <section class="section section--v" aria-labelledby="rencontre-titre">
    <div class="wrap">
      <TitreV texte="La rencontre" id="rencontre-titre" />
      <div>
        <p class="chapeau chapeau--gauche">01</p>
        <div class="diptyque">
          {diptyque1.map((p, i) => (
            <figure data-reveal="clip" data-delay={String(i * 0.15)}>
              <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
        <div class="histoire__texte" data-reveal="up">
          <p>{site.histoire[0]}</p>
          <p>{site.histoire[1]}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--v section--serre" aria-labelledby="lieu-titre">
    <div class="wrap">
      <TitreV texte="Le lieu" id="lieu-titre" />
      <div>
        <p class="chapeau chapeau--gauche">02</p>
        <div class="diptyque">
          {diptyque2.map((p, i) => (
            <figure data-reveal="clip" data-delay={String(i * 0.15)}>
              <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
        <div class="histoire__texte" data-reveal="up">
          <p>{site.histoire[2]}</p>
          <p>{site.histoire[3]}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--serre" aria-labelledby="equipe-titre">
    <div class="wrap colonne">
      <p class="chapeau" data-reveal="fade">03</p>
      <h2 class="titre-centre" id="equipe-titre" data-split="lines">Les chefs et l’équipe</h2>
    </div>
    <div class="wrap portraits">
      {chefs.map((m, i) => (
        <div class="portrait" data-reveal="scale" data-delay={String(i * 0.15)}>
          <figure><img src={asset(m.img.src)} alt={m.img.alt} width={m.img.largeur} height={m.img.hauteur} loading="lazy" decoding="async" /></figure>
          <p class="portrait__nom">{m.nom}</p>
          <p class="portrait__role">{m.role}</p>
        </div>
      ))}
    </div>
    <ul class="wrap equipe-liste" data-reveal="fade">
      {salle.map((m) => (
        <li><strong>{m.nom}</strong>, {m.role.toLowerCase()}{m.placeholder && <span class="illu">rôle illustratif, à confirmer</span>}</li>
      ))}
    </ul>
  </section>

  <section class="section section--serre" aria-labelledby="valeurs-titre">
    <div class="wrap colonne">
      <p class="chapeau" data-reveal="fade">04</p>
      <h2 class="titre-centre" id="valeurs-titre" data-split="lines">Ce qui ne change pas</h2>
      <ul style="list-style: none; padding: 0" class="stack" data-reveal="up">
        {site.valeurs.map((v) => <li>{v}</li>)}
      </ul>
      <div class="actions actions--centre">
        <a class="btn btn--plein" href={u('/reservation/')}>Réserver une table</a>
        <a class="btn" href={u('/carte/')}>Voir la carte</a>
      </div>
    </div>
  </section>
</Base>
