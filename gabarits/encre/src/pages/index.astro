---
import Base from '../layouts/Base.astro';
import Rouleau from '../components/Rouleau.astro';
import Plan from '../components/Plan.astro';
import TitreV from '../components/TitreV.astro';
import { site, photoDe, horairesGroupes, adresseLigne } from '../data/site';
import { u, asset } from '../lib/url';

const hero = photoDe('/photos/salle-clients-bar.webp');
const heroMobile = '/photos/salle-clients-bar-960.webp';
const diptyque = ['/photos/salle-banquette.webp', '/photos/cuisine-mains-pate.webp'].map(photoDe);
const chefs = site.equipe.filter((m) => m.photo).map((m) => ({ ...m, img: photoDe(m.photo!) }));
const galerie = ['/photos/plat-saint-jacques.webp', '/photos/dessert-tarte-pomme.webp', '/photos/plat-tartare.webp', '/photos/service-planche.webp'].map(photoDe);
const michelin = site.avis.find((a) => !a.placeholder);
---
<Base preloads={[{ href: heroMobile, media: '(max-width: 767px)' }, { href: hero.src, media: '(min-width: 768px)' }]}>
  <section class="hero" data-hero aria-label="Accueil">
    <picture class="hero__photo">
      <source media="(max-width: 767px)" srcset={asset(heroMobile)} width="960" height="541" />
      <img src={asset(hero.src)} alt={hero.alt} width={hero.largeur} height={hero.hauteur} fetchpriority="high" decoding="async" data-hero-photo data-critical />
    </picture>
    <div class="hero__voile" data-vapeur aria-hidden="true"></div>
    <div class="hero__contenu wrap">
      <svg class="hero__trace" viewBox="0 0 12 200" preserveAspectRatio="none" aria-hidden="true"><path data-trace-hero d="M6 2 C 1 50, 11 120, 6 198" /></svg>
      <h1 class="hero__nom">{site.nom}</h1>
      <p class="hero__phrase">{site.phraseHero}</p>
      <a class="hero__lien" href="#rouleau" data-hero-lien>Dérouler un exemple de carte</a>
    </div>
  </section>

  <section class="section concept" aria-labelledby="concept-titre">
    <div class="wrap colonne">
      <p class="chapeau" data-reveal="fade">01</p>
      <h2 class="titre-centre" id="concept-titre" data-split="lines">{site.manifeste.titre}</h2>
      <p class="texte-l" data-reveal="up" data-delay="0.1">{site.manifeste.texte}</p>
      {michelin && (
        <blockquote class="citation" data-reveal="up" data-delay="0.2">
          <p>« {michelin.texte} »</p>
          <cite>{michelin.source}</cite>
        </blockquote>
      )}
    </div>
  </section>

  <Rouleau epingle={true} id="rouleau" numero="02" />
  <p class="rouleau__vraie"><a class="link" href={u('/carte/')}>Voir la vraie carte : menu unique, {site.servicesMenu} services, {site.menus[0].prix}</a></p>

  <section class="section section--v" aria-labelledby="histoire-titre">
    <div class="wrap">
      <TitreV texte="L’histoire" id="histoire-titre" />
      <div>
        <p class="chapeau chapeau--gauche">03</p>
        <div class="diptyque">
          {diptyque.map((p, i) => (
            <figure data-reveal="clip" data-delay={String(i * 0.15)}>
              <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
        <div class="histoire__texte" data-reveal="up">
          <p>{site.histoire[0]}</p>
          <p>{site.histoire[2]}</p>
          <p class="lien-suite"><a class="link" href={u('/histoire/')}>Lire l’histoire des deux chefs</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--serre" aria-labelledby="chefs-titre">
    <div class="wrap colonne">
      <p class="chapeau" data-reveal="fade">04</p>
      <h2 class="titre-centre" id="chefs-titre" data-split="lines">Les chefs</h2>
      <p class="texte" data-reveal="up">
        François et Damien accompagnent eux-mêmes leurs plats jusqu’à votre table et vous expliquent leur démarche, épaulés par Sara et Jordan.
      </p>
    </div>
    <div class="wrap portraits">
      {chefs.map((m, i) => (
        <div class="portrait" data-reveal="scale" data-delay={String(i * 0.15)}>
          <figure><img src={asset(m.img.src)} alt={m.img.alt} width={m.img.largeur} height={m.img.hauteur} loading="lazy" decoding="async" /></figure>
          <p class="portrait__nom">{m.nom}</p>
          <p class="portrait__role">{m.role}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--v" aria-labelledby="images-titre">
    <div class="wrap">
      <TitreV texte="En images" id="images-titre" />
      <div>
        <p class="chapeau chapeau--gauche">05</p>
        <div class="quinconce">
          {galerie.map((p, i) => (
            <figure data-reveal="fade" data-delay={String((i % 2) * 0.1)}>
              <div class="cadre"><img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" data-parallax="0.06" /></div>
              <figcaption>{p.alt}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--v" aria-labelledby="venir-titre">
    <div class="wrap">
      <TitreV texte="Venir" id="venir-titre" />
      <div>
        <p class="chapeau chapeau--gauche">06</p>
        <div class="venir">
          <Plan />
          <div class="infos" data-reveal="up">
            <div>
              <h3>Adresse</h3>
              <address>{adresseLigne()}</address>
              <ul>
                {site.acces.reperes.map((r) => <li>{r.nom}</li>)}
                <li>{site.acces.gare.nom} : environ {site.acces.gare.marche}<span class="illu illu--ast" aria-hidden="true">*</span></li>
                <li>{site.acces.parking.texte}<span class="illu illu--ast" aria-hidden="true">*</span></li>
              </ul>
              <p class="muted" style="font-size: var(--t-xs); margin-top: 0.5rem"><span class="illu illu--ast" style="margin-left: 0">*</span> estimation illustrative, à confirmer par le restaurant</p>
            </div>
            <div>
              <h3>Horaires</h3>
              <dl class="horaires">
                {horairesGroupes().map((h) => <><dt>{h.jours}</dt><dd>{h.texte}</dd></>)}
              </dl>
            </div>
            <div class="actions" style="margin-top: 0">
              <a class="btn btn--plein" href={site.reservation.url} rel="noopener">Réserver sur {site.reservation.outil}</a>
              <a class="btn" href={`https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lon}#map=18/${site.geo.lat}/${site.geo.lon}`} rel="noopener">Itinéraire</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
