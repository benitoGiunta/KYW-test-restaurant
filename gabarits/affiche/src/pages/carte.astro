---
import Base from '../layouts/Base.astro';
import Affiche from '../components/Affiche.astro';
import Bento from '../components/Bento.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
const tons: ('rouge' | 'jaune' | 'vert')[][] = [['rouge', 'jaune', 'vert'], ['vert', 'rouge', 'jaune'], ['jaune', 'vert', 'rouge']];
---
<Base title="La carte" description={`La carte des ${site.nom} à ${site.adresse.commune} : menu unique en quatre services, formule du midi, lunch, cuisinés à quatre mains.`} fin="rouge">
  <Affiche tone="jaune" plein label="titre">
    <div class="wrap">
      <h1 id="titre" class="display display--mega affiche__titre" data-split="chars" data-intro>La carte</h1>
      <p class="lead">Un menu unique en quatre services, qui change avec les saisons et les producteurs du coin. Ci-dessous, les plats du moment ; les prix à la carte sont illustratifs.</p>
    </div>
  </Affiche>

  <Affiche tone="creme" prev="jaune" label="plats-titre">
    <div class="wrap stack" style="--u: calc(var(--gutter) * 2)">
      <h2 id="plats-titre" class="sr-only">Les plats</h2>
      {site.carte.map((c, i) => (
        <div>
          <h3 class="display display--xl affiche__chapeau" data-split="words">{c.categorie}</h3>
          <Bento plats={c.plats} tones={tons[i % tons.length]} />
        </div>
      ))}
    </div>
  </Affiche>

  <Affiche tone="vert" prev="creme" label="formules-titre">
    <div class="wrap">
      <h2 id="formules-titre" class="display display--mega affiche__titre" data-split="chars">Formules</h2>
      <div class="formules" data-claque>
        {site.menus.map((m) => (
          <article class="formule">
            <div>
              <h3>{m.nom}</h3>
              <p style="margin-top: var(--u)">{m.description}</p>
            </div>
            <p class="formule__prix">{m.prix}</p>
          </article>
        ))}
      </div>
      <div class="formules" style="margin-top: var(--gutter)">
        <article class="formule formule--jour" data-reveal="up">
          <div>
            <h3>{site.menuDuJour.titre} <span class="exemple">(exemple)</span></h3>
            <ul style="margin-top: var(--u)">
              {site.menuDuJour.lignes.map((l) => <li>{l}</li>)}
            </ul>
          </div>
          <p class="formule__prix">{site.menuDuJour.prix}</p>
        </article>
      </div>
    </div>
  </Affiche>

  <Affiche tone="rouge" prev="vert" label="resa-titre">
    <div class="wrap">
      <h2 id="resa-titre" class="display display--mega affiche__titre" data-split="chars">À table ?</h2>
      <div class="actions">
        <a class="btn btn--primary" href={u('/reservation/')}>Réserver</a>
        <a class="btn" href={u('/a-emporter/')}>À emporter</a>
      </div>
    </div>
  </Affiche>
</Base>
