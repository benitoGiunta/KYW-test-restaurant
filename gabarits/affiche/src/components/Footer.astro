---
// Pied de page « finale » : mot d'adieu géant sur ink, puis le pied de page KYW obligatoire (un seul logo, kyw-signature).
import KywFooter from '@kyw/footer';
import { site, adresseLigne, horaireTexte, telHref } from '../data/site';
import { u } from '../lib/url';
interface Props { prev?: string }
const { prev = 'vert' } = Astro.props;
const dents = 40;
const pts = Array.from({ length: dents + 1 }, (_, i) => `${(i / dents) * 100},0 ${((i + 0.5) / dents) * 100},18`).join(' ');
---
<footer class="footer" data-tone="ink" data-footer>
  <svg class="affiche__dents" viewBox="0 0 100 18" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <polygon points={`0,0 ${pts} 100,0`} fill={`var(--${prev})`} />
  </svg>
  <p class="display display--mega footer__adieu" data-split="chars">{site.adieu}</p>
  <div class="footer__cols">
    <div>
      <h2>{site.nom}</h2>
      <address>{adresseLigne()}<br />{site.adresse.repere}</address>
    </div>
    <div>
      <h2>Horaires</h2>
      <ul class="stack" style="list-style: none; padding: 0">
        {site.horaires.map((h) => <li><span style="text-transform: capitalize">{h.jour}</span> : {horaireTexte(h)}</li>)}
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <p><a class="link" href={telHref()}>{site.telephone}</a></p>
      <p><a class="link" href={`mailto:${site.email.valeur}`}>{site.email.valeur}</a> <span class="exemple">(exemple)</span></p>
      <p><a class="link" href={u('/reservation/')}>Réserver une table</a></p>
    </div>
    <div>
      <h2>Suivre</h2>
      {site.reseaux.map((r) => <p><a class="link" href={r.url} rel="noopener">{r.nom}</a></p>)}
      <p><a class="link" href={site.url} rel="noopener">Site actuel</a></p>
    </div>
  </div>
  <div class="footer__colophon">
    <p>Maquette KYW, certaines données sont illustratives (marquées « exemple » ou « illustratif »).</p>
    <p>{site.colophon}</p>
  </div>
</footer>
<KywFooter base={import.meta.env.BASE_URL} />
