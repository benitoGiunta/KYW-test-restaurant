---
import Logo from './Logo.astro';
import { u } from '../lib/url';
const liens = [
  { href: u('/'), label: 'Accueil' },
  { href: u('/carte/'), label: 'Carte' },
  { href: u('/agenda/'), label: 'Agenda' },
  { href: u('/privatisation/'), label: 'Privatiser' },
  { href: u('/histoire/'), label: 'Histoire' },
];
const reserver = { href: u('/reservation/'), label: 'Réserver' };
const ici = Astro.url.pathname.replace(/\/+$/, '');
const courant = (href: string) => (href.replace(/\/+$/, '') === ici ? 'page' : undefined);
---
<header class="header">
  <div class="wrap header__inner">
    <Logo section />
    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
      <a class="nav__reserver" href={reserver.href} aria-current={courant(reserver.href)}>{reserver.label}</a>
      <button class="nav__menu" type="button" data-menu-ouvrir aria-expanded="false" aria-controls="menu-mobile">Menu</button>
    </nav>
  </div>
</header>
<div class="overlay" id="menu-mobile" data-menu hidden>
  <button class="overlay__fermer" type="button" data-menu-fermer>Fermer</button>
  <nav class="overlay__liens" aria-label="Menu mobile">
    {[...liens, reserver].map((l) => <a href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
  </nav>
</div>
