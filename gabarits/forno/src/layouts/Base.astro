---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import { asset } from '../lib/url';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  image?: string; // image OG (1200x630) dans public/, chemin sans base : '/og.jpg'
  theme?: 'four' | 'farine'; // couleur de l'en-tête au chargement (basculée ensuite par les zones data-theme-zone)
  preload?: string; // photo au-dessus de la ligne de flottaison (chemin sans base)
}
const { title, description = site.description, image = '/og.jpg', theme = 'farine', preload } = Astro.props;
const fullTitle = title ? `${title} | ${site.nom}` : `${site.nom} | Restaurant bistronomique à ${site.adresse.commune}`;
const siteUrl = Astro.site ?? new URL('https://kyw-test-restaurant.vercel.app');
const canonical = new URL(Astro.url.pathname, siteUrl).href; // Astro.url.pathname contient déjà `base` au build.
const ogImage = new URL(asset(image), siteUrl).href;

// Polices locales (public/fonts/) : @font-face généré ici pour que l'URL passe par `base`.
const fontFaces = [
  ['Big Shoulders Display', 'big-shoulders-display-800-normal', 800, 'normal'],
  ['Erode', 'erode-400-normal', 400, 'normal'],
  ['Erode', 'erode-400-italic', 400, 'italic'],
  ['Erode', 'erode-500-normal', 500, 'normal'],
  ['Erode', 'erode-500-italic', 500, 'italic'],
] as const;
const fontCss = fontFaces
  .map(([fam, f, w, s]) => `@font-face{font-family:'${fam}';font-weight:${w};font-style:${s};font-display:swap;src:url(${asset(`/fonts/${f}.woff2`)}) format('woff2')}`)
  .join('');
const polices = ['/fonts/big-shoulders-display-800-normal.woff2', '/fonts/erode-400-normal.woff2', '/fonts/erode-500-normal.woff2'];

const jours: Record<string, string> = { lundi: 'Monday', mardi: 'Tuesday', mercredi: 'Wednesday', jeudi: 'Thursday', vendredi: 'Friday', samedi: 'Saturday', dimanche: 'Sunday' };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.nom,
  description: site.description,
  url: site.url,
  telephone: site.telephone,
  servesCuisine: site.typeCuisine,
  image: ogImage,
  address: { '@type': 'PostalAddress', streetAddress: `${site.adresse.rue} ${site.adresse.numero}`, postalCode: site.adresse.cp, addressLocality: site.adresse.commune, addressCountry: site.adresse.pays },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lon },
  openingHoursSpecification: site.horaires.flatMap((h) =>
    h.creneaux.map((c) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: jours[h.jour], opens: c.ouverture, closes: c.fermeture })),
  ),
  acceptsReservations: site.reservation.url,
  sameAs: site.reseaux.map((r) => r.url),
};
---
<!doctype html>
<html lang="fr" transition:animate="none" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2b1e19" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style set:html={fontCss} />
    {polices.map((p) => <link rel="preload" as="font" type="font/woff2" href={asset(p)} crossorigin />)}
    {preload && <link rel="preload" as="image" href={asset(preload)} fetchpriority="high" />}
    <slot name="head" />
    <!-- Avant le premier rendu : marque JS + motion pour que les états « caché avant reveal » ne clignotent jamais. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <div id="gl" transition:persist="gl" aria-hidden="true"></div>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"></div></div>
    <div id="cursor" transition:persist="cursor" aria-hidden="true"><span data-cursor-label></span></div>
    <Loader />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
