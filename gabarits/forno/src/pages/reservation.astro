---
import Base from '../layouts/Base.astro';
import { site, adresseLigne, horaireTexte, telHref, photoDe } from '../data/site';
import { asset } from '../lib/url';
const salle = photoDe('/photos/salle-clients-bar.webp');
---
<Base title="Réservation" description={`Réserver une table chez ${site.nom} à ${site.adresse.commune} : en ligne via ${site.reservation.outil} ou par téléphone au ${site.telephone}.`}>
  <section class="wrap page-hero">
    <p class="eyebrow">Réserver</p>
    <h1 data-split="words">Une table</h1>
    <p class="lead">
      La réservation se fait en ligne via {site.reservation.outil}. Pour une table de plus de six personnes ou une demande de dernière minute, appelez-nous.
    </p>
    <div class="actions" data-reveal="up" data-intro data-delay="0.5">
      <a class="btn btn--primary" href={site.reservation.url} rel="noopener" data-magnetic="0.25">Réserver sur {site.reservation.outil}</a>
      <a class="btn" href={telHref()}>Appeler le {site.telephone}</a>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap g12">
      <div style="grid-column: 1 / 7">
        <div class="cat__head">
          <h2 data-split="words">Votre demande</h2>
        </div>
        <p class="muted" style="margin-bottom: calc(var(--u) * 2)">Formulaire de démonstration sans envoi : la validation récapitule votre demande, à confirmer ensuite sur {site.reservation.outil} ou par téléphone.</p>
        <form class="form" data-reservation data-reveal="up" action={site.reservation.url} method="get">
          <label>Nom <input type="text" name="nom" autocomplete="name" required /></label>
          <label>Date <input type="date" name="date" required /></label>
          <label>Heure <input type="time" name="heure" required /></label>
          <label>Couverts <input type="number" name="couverts" min="1" max="12" value="2" required /></label>
          <label>Message <textarea name="message" rows="3"></textarea></label>
          <div class="actions" style="margin-top: 0">
            <button class="btn btn--primary" type="submit">Préparer ma demande</button>
          </div>
        </form>
        <div class="recap" data-recap role="status" aria-live="polite" tabindex="-1" hidden>
          <p class="recap__titre">Votre demande, à confirmer</p>
          <p data-recap-texte></p>
          <p class="muted">Rien n'a été envoyé : la table est réservée une fois confirmée sur {site.reservation.outil} ou par téléphone.</p>
          <div class="actions" style="margin-top: var(--u)">
            <a class="btn btn--primary" href={site.reservation.url} rel="noopener" target="_blank">Confirmer sur {site.reservation.outil}</a>
            <a class="btn" href={telHref()}>Appeler le {site.telephone}</a>
            <button class="link" type="button" data-recap-modifier>Modifier</button>
          </div>
        </div>
      </div>
      <div class="stack" style="grid-column: 8 / 13" data-reveal="up" data-delay="0.1">
        <div class="cat__head"><h2 data-split="words">Horaires</h2></div>
        <dl class="horaires">
          {site.horaires.map((h) => <><dt>{h.jour}</dt><dd>{horaireTexte(h)}</dd></>)}
        </dl>
        <p style="margin-top: calc(var(--u) * 2)"><strong>Adresse</strong><br />{adresseLigne()}</p>
        <p><a class="link" href={`https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lon}#map=18/${site.geo.lat}/${site.geo.lon}`} rel="noopener">Itinéraire</a></p>
        <figure style="margin: calc(var(--u) * 2) 0 0" data-reveal="clip">
          <img src={asset(salle.src)} alt={salle.alt} width={salle.largeur} height={salle.hauteur} loading="lazy" decoding="async" style="width: 100%; height: auto; display: block" />
        </figure>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (max-width: 767px) { .g12 > * { grid-column: 1 / 13 !important; } }
</style>

<script>
  import { onPage } from '../engine';
  // Formulaire sans backend : la validation garde la saisie et l'affiche en récapitulatif, avec les deux voies réelles
  // (outil de réservation, téléphone). Rien n'est perdu : « Modifier » rend le formulaire tel qu'il était rempli.
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-reservation]');
    const recap = document.querySelector<HTMLElement>('[data-recap]');
    const texte = recap?.querySelector<HTMLElement>('[data-recap-texte]');
    const modifier = recap?.querySelector<HTMLButtonElement>('[data-recap-modifier]');
    if (!form || !recap || !texte) return;
    const go = (e: SubmitEvent) => {
      e.preventDefault();
      const d = new FormData(form);
      const v = (k: string) => String(d.get(k) || '').trim();
      const date = v('date') ? new Date(`${v('date')}T12:00`).toLocaleDateString('fr-BE', { weekday: 'long', day: 'numeric', month: 'long' }) : '';
      const n = Number(v('couverts')) || 0;
      texte.textContent = `${v('nom')}, ${n} couvert${n > 1 ? 's' : ''}, le ${date} à ${v('heure')}.${v('message') ? ` Message : ${v('message')}` : ''}`;
      form.hidden = true;
      recap.hidden = false;
      recap.focus();
    };
    const retour = () => { recap.hidden = true; form.hidden = false; form.querySelector<HTMLInputElement>('input')?.focus(); };
    form.addEventListener('submit', go);
    modifier?.addEventListener('click', retour);
    return () => { form.removeEventListener('submit', go); modifier?.removeEventListener('click', retour); };
  });
</script>
