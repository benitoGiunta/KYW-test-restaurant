---
import Base from '../layouts/Base.astro';
import Fiche from '../components/Fiche.astro';
import { site, photoDe, numerosServices, compteCategorie } from '../data/site';
import { u } from '../lib/url';
---
<Base title="La carte" description={`La carte des Potes au Feu à ${site.adresse.commune} : menu dégustation unique 4 services, formule du midi, lunch, options végétariennes et allergies.`}>
  <section class="wrap page-hero">
    <p class="eyebrow">La carte</p>
    <h1 data-split="words">Menu unique</h1>
    <p class="lead">{site.menus[0].nom} à {site.menus[0].prix}, du lundi au vendredi soir. Le midi, formule 3 services ou lunch. Tout est fait maison, avec les produits des saisons.</p>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      {site.carte.map((c, ci) => (
        <div class="cat">
          <div class="cat__head">
            <h2 data-split="words">{c.categorie}</h2>
            <span class="cat__num">{compteCategorie(c)}</span>
          </div>
          <div class="cat__grid">
            {c.plats.map((p, i) => (
              <Fiche nom={p.nom} description={p.description} prix={p.prix} photo={p.photo ? photoDe(p.photo) : undefined} disque={ci === 0 ? numerosServices(c.plats)[i] : ''} placeholder={p.placeholder} delai={(i % 2) * 0.08} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section s-four" data-theme-zone="four">
    <div class="wrap">
      <div class="cat__head" style="margin-bottom: calc(var(--u) * 4); border-color: var(--farine)">
        <h2 data-split="words">Les formules</h2>
        <span class="cat__num">{String(site.menus.filter((m) => !m.horsFormule).length).padStart(2, '0')}</span>
      </div>
      <div class="g12">
        {site.menus.map((mn, i) => (
          <article class="menu" data-reveal="up" data-delay={String(i * 0.08)} style="grid-column: span 6">
            <h3>{mn.nom}{mn.placeholder && <span class="illu">illustratif</span>}</h3>
            <p class="menu__prix">{mn.prix}</p>
            <p class="muted">{mn.description}</p>
          </article>
        ))}
      </div>
      <div class="actions">
        <a class="btn btn--primary" href={u('/reservation/')}>Réserver une table</a>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (max-width: 767px) { .menu { grid-column: 1 / 13 !important; } }
</style>
