---
// Page entièrement illustrative (service non attesté) : bandeau d'exemple peint sans JS, aucun CTA de réservation.
import Base from '../layouts/Base.astro';
import { site, telHref, servicesTexte } from '../data/site';
import { u } from '../lib/url';
const e = site.emporter;
const services = servicesTexte();
---
<Base title="À emporter (exemple)" description="Exemple de page « à emporter » du gabarit Forno : horaires de fournées illustratifs, téléphone du restaurant. Données illustratives." theme="four">
  <p class="bandeau" role="note">Page d'exemple : {e.intro}</p>
  <section class="s-four page-hero page-hero--four" data-theme-zone="four">
    <div class="wrap">
      <p class="eyebrow">À emporter<span class="illu">illustratif</span></p>
      <h1 data-split="words">Les fournées</h1>
      <p class="lead">Une bande horaire pour un fournil : chaque fournée sort à heure fixe, on vient la chercher. Les heures ci-dessous sont des exemples.</p>
    </div>
  </section>

  <section class="section" data-theme-zone="farine">
    <div class="wrap g12">
      <div style="grid-column: 1 / 8">
        <div class="cat__head">
          <h2 data-split="words">Horaires des fournées</h2>
          <span class="cat__num">{String(e.fournees.length).padStart(2, '0')}</span>
        </div>
        <ul class="fournees" role="list" data-reveal="up">
          {e.fournees.map((f) => (
            <li><span>{f.libelle}<span class="illu">exemple</span></span><span class="heure">{f.heure}</span></li>
          ))}
        </ul>
      </div>
      <div class="stack" style="grid-column: 9 / 13" data-reveal="up" data-delay="0.1">
        <h3>Le restaurant</h3>
        <p class="muted">Pour toute question, appelez le restaurant :</p>
        <p><a class="btn" href={telHref()}>{site.telephone}</a></p>
        {services.map((s) => <p class="muted">{`${s.libelle} · ${s.jours} · ${s.heures}`}</p>)}
        <p><a class="link" href={u('/carte/')}>Voir la carte réelle</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (max-width: 767px) { .g12 > * { grid-column: 1 / 13 !important; } }
</style>
