{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "**": false, "publication": true } },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"publication\" ] && exit 1 || exit 0",
  "routes": [
    { "src": "/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "^/([^.]*[^/.])$", "status": 308, "headers": { "Location": "/$1/" } },
    { "handle": "filesystem" },
    { "src": "^/(?!kyw/|suivi/)([^/]+)/([^/]+)/.*$", "status": 404, "dest": "/$1/$2/404.html" },
    { "src": "^/.*$", "status": 404, "dest": "/404.html" }
  ]
}
