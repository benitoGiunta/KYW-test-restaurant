---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, menus, couples, horaires, plage } from '../data/site';
import { u } from '../lib/url';
const ouvertures = horaires.filter((h) => h.ouvert.length);
---
<Base page="accueil" description="Be Belge… et d’ailleurs, à Wépion (Namur) : cuisine belge et de saison, menu du chef en 3 ou 4 services, mur de pierre, terrasse et feu de bois. Réservez au 081 47 00 95.">
  <!-- 1. Poster : le nom, trois points, la suite hors de la page -->
  <section class="hero wrap">
    <h1 class="hero__titre display" data-hero-titre>
      <span class="hero__nom">Be Belge</span>
      <span class="hero__pts" aria-hidden="true">…</span>
      <span class="hero__suite">et d’ailleurs</span>
    </h1>
    <p class="hero__sous">Cuisine belge et de saison, avec le goût d’ailleurs. Avenue de Marlagne, à Wépion.</p>
    <div class="hero__actions">
      <a class="btn" href={site.reservationUrl} rel="noopener" target="_blank">Réserver une table<span class="sr-only"> (nouvel onglet)</span></a>
      <a class="btn btn--ligne" href={site.telephoneHref}>Appeler le {site.telephoneLisible}</a>
    </div>
    <figure class="hero__photo">
      <Photo cle="cheminee" sizes="(min-width: 900px) 46vw, 100vw" widths={[640, 960, 1400]} prioritaire />
    </figure>
  </section>

  <!-- 2. Statement : la phrase de la maison -->
  <section class="statement wrap">
    <p class="statement__texte display">{site.accroche}</p>
    <p class="statement__suite">{site.accueil} <span class="statement__src">Le mot d’accueil de la maison.</span></p>
  </section>

  <!-- 3. Paires asymétriques : d'ici … d'ailleurs -->
  <section class="couples wrap" aria-labelledby="couples-titre">
    <h2 id="couples-titre" class="titre-l display">D’ici<span class="pts">…</span> d’ailleurs</h2>
    <ol class="couples__liste">
      {couples.map((c) => (
        <li class="couple">
          <h3 class="couple__plat">{c.plat}</h3>
          <p class="couple__ici"><span class="couple__lib">D’ici</span>{c.ici}</p>
          <p class="couple__la"><span class="couple__lib">D’ailleurs</span>{c.ailleurs}</p>
        </li>
      ))}
    </ol>
    <p class="couples__lien"><a class="lt" href={u('/carte/')}>Lire toute la carte</a></p>
  </section>

  <!-- 4. Données : le menu du chef -->
  <section class="menus" aria-labelledby="menus-titre">
    <div class="wrap">
      <h2 id="menus-titre" class="titre-l display">Le menu du chef</h2>
      <ul class="menus__liste">
        {menus.map((m) => (
          <li class="menu">
            <p class="menu__nom">{m.nom}</p>
            <p class="menu__detail">{m.detail}</p>
            <p class="menu__prix"><span class="chiffre">{m.prix}</span>&nbsp;€</p>
            <p class="menu__vins">Sélection de vins en option : {m.vins}&nbsp;€</p>
          </li>
        ))}
      </ul>
      <p class="menus__note">Menu proposé du 13 août au 6 septembre 2026, relevé sur le site du restaurant : à reconfirmer à la réservation.</p>
    </div>
  </section>

  <!-- 5. Filmstrip : le nid, du jardin à la salle -->
  <section class="lieu" aria-labelledby="lieu-titre">
    <div class="wrap"><h2 id="lieu-titre" class="titre-l display">Un petit nid, à l’orée du jardin</h2></div>
    <ul class="strip" role="list">
      <li class="strip__vue strip__vue--l"><Photo cle="facade" sizes="(min-width: 900px) 40vw, 78vw" widths={[480, 800, 1200]} /><p>Le jardin et le bâtiment.</p></li>
      <li class="strip__vue"><Photo cle="tableaux" sizes="(min-width: 900px) 30vw, 70vw" widths={[480, 800]} /><p>La salle, ses tableaux rouges.</p></li>
      <li class="strip__vue strip__vue--l"><Photo cle="brasero" sizes="(min-width: 900px) 40vw, 78vw" widths={[480, 800, 1200]} /><p>Le feu de la terrasse.</p></li>
      <li class="strip__vue"><Photo cle="terrasse" sizes="(min-width: 900px) 30vw, 70vw" widths={[480, 800]} /><p>La terrasse ombragée.</p></li>
    </ul>
  </section>

  <!-- 6. Pratique : jours d'ouverture -->
  <section class="jours wrap" aria-labelledby="jours-titre">
    <h2 id="jours-titre" class="titre-l display">Du mercredi au dimanche</h2>
    <ul class="jours__liste">
      {ouvertures.map((h) => <li><span class="jours__j">{h.jour}</span><span class="jours__h">{h.ouvert.map(plage).join(' et ')}</span></li>)}
    </ul>
    <p class="jours__note">Fermé le lundi et le mardi.</p>
  </section>
</Base>
