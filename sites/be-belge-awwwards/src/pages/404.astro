---
import Points from '../components/Points.astro';
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas : retournez à l’accueil de Be Belge… et d’ailleurs, à la carte ou à la réservation.">
  <section class="quatre wrap">
    <h1 class="quatre__titre display" data-intro-points><span>Introuvable</span><Points /><span class="quatre__suite">et pourtant ailleurs</span></h1>
    <p class="page-tete__chapo">Cette page n’existe pas, ou plus. La phrase reste en suspens : reprenons-la depuis la table.</p>
    <p class="quatre__liens"><a class="btn" href={u('/')}>Retour à l’accueil</a> <a class="lt" href={u('/carte/')}>La carte</a> <a class="lt" href={u('/reservation/')}>Réserver</a></p>
  </section>
</Base>
