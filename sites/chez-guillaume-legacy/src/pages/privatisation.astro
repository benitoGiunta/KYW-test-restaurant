---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import { resto, evenementsPrives } from '../data/site';
---
<Base page="privatisation" title="Privatisation | Chez Guillaume, Namur" description="Privatiser un comedy club à Namur pour un événement ou un team building : Chez Guillaume adapte la formule à votre envie.">
  <div class="container page-hero">
    <h1>Privatiser un comedy club, c’est possible.</h1>
    <p class="lead">Un anniversaire, un team building, un départ à la retraite, une soirée d’entreprise ou une bonne excuse pour réunir du monde autour d’un verre et de quelques éclats de rire.</p>
    <p><a class="btn btn--primary" href={resto.emailHref}>On en discute</a></p>
  </div>
  <section class="sec--tight" aria-labelledby="h-types">
    <div class="container duo">
      <div class="duo__text">
        <h2 id="h-types">Pour quels types d’événements ?</h2>
        <ul class="checks" style="grid-template-columns:1fr">
          {evenementsPrives.map((e) => <li>{e}</li>)}
        </ul>
        <p>Stand-up, DJ, repas assis, formule cocktail, ambiance intimiste ou soirée dansante : on adapte la formule au nombre de personnes, au budget, au type d’événement et aux animations souhaitées.</p>
      </div>
      <div class="duo__img"><Fig src="banquette" slot="priv" alt="Banquette rayée rouge et blanc, table dressée avec verres et set illustré" w={964} h={1204} /></div>
    </div>
  </section>
  <section class="band" aria-labelledby="h-ecrire">
    <div class="container">
      <h2 id="h-ecrire">On y retourne quand ?</h2>
      <p class="lead">Vous avez une idée précise, ou juste une envie de faire quelque chose de différent ? Écrivez-nous et imaginons ensemble une soirée.</p>
      <a class="btn" href={resto.emailHref}>Envoyer un mail</a>
    </div>
  </section>
</Base>
