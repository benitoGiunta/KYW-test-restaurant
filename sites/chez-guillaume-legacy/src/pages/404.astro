---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable | Chez Guillaume" description="Cette page n’existe pas : retour à l’accueil de Chez Guillaume, restaurant et comedy club à Namur.">
  <div class="container page-hero">
    <h1>Cette page a quitté la scène.</h1>
    <p class="lead">L’adresse demandée n’existe pas. Retour à l’accueil ou à l’agenda.</p>
    <p><a class="btn btn--primary" href={base}>Accueil</a> <a class="btn" href={`${base}agenda/`}>Agenda</a></p>
  </div>
</Base>
