---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { photos } from '../lib/photos';
import { u } from '../lib/url';
import { restaurant as r } from '../data/site';
---
<Base title="Page introuvable" page="404" description="Cette page n’existe pas : la maison est au numéro 149 de l’avenue Albert Ier, à Jambes. Retour à l’accueil, à la carte ou à la réservation.">
  <section class="nf ground-nuit fans" data-hour="22">
    <div class="wrap grid" style="width:100%;align-items:center;row-gap:2rem">
      <div class="col-a">
        <p class="plaque num" aria-hidden="true" data-reveal="scale" data-intro>404</p>
        <h1 class="display" data-split="lines" data-intro style="font-size:var(--t-xl);margin-top:1.5rem;max-width:12ch">Ici, ce n’est pas le 149.</h1>
        <p class="lead" style="margin-top:1.5rem">Cette page n’existe pas, ou plus. La maison est avenue Albert Ier, au numéro 149, et la salle est ouverte de 11 h à 22 h.</p>
        <div class="btns" style="margin-top:2rem">
          <a class="btn btn--plein" href={u('/')}>Retour à l’accueil</a>
          <a class="btn" href={u('/carte/')}>La carte</a>
          <a class="btn" href={u('/reservation/')}>Réserver</a>
        </div>
      </div>
      <div class="col-b">
        <Image src={photos.mascotte.src} alt="Le serveur de la maison, dessin orange, plateau et bouteille levés" width={420} format="webp" loading="eager" />
      </div>
    </div>
  </section>
</Base>
