---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n’existe pas sur le site du Royal Namur. Retournez à l’accueil ou à la carte." page="404">
  <section class="wrap page-tete erreur">
    <p class="face__lib">Erreur 404</p>
    <h1 class="display page-titre">Hors de la place.</h1>
    <p class="page-chapo">Cette adresse n’existe pas : de l’autre côté de la place, il n’y a que le Théâtre.</p>
    <p class="hero__actions">
      <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
      <a class="cta cta--vide" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </p>
  </section>
</Base>
