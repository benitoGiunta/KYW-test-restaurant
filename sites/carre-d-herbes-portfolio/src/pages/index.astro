---
import Base from '../layouts/Base.astro';
import Chapitre from '../components/Chapitre.astro';
import { site, photoDe, horairesResume, adresseLigne, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const hero = photoDe('/photos/hero-salle.webp');
const heroM = photoDe('/photos/hero-salle-960.webp');
const c = site.chiffres;
const motsNom = site.nom.split(' ');
const motsCitation = site.citation.texte.split(' ');
const galerie = ['/photos/gal-1-nb.webp', '/photos/gal-2-nb.webp', '/photos/gal-3-nb.webp', '/photos/gal-4-nb.webp', '/photos/gal-5-nb.webp'].map(photoDe);
const hauteurs = ['haute', 'basse', 'moyenne', 'haute', 'basse'];
const offres = site.fetes.offres;
const resume = horairesResume();
---
<Base preloadImage={{ href: heroM.src, media: '(max-width: 767px)' }}>
  <section class="hero" data-hero aria-label="Accueil">
    <picture class="hero__photo">
      <source media="(max-width: 767px)" srcset={asset(heroM.src)} />
      <img src={asset(hero.src)} alt={hero.alt} width={hero.largeur} height={hero.hauteur} fetchpriority="high" decoding="async" data-critical />
    </picture>
    <div class="hero__scrim" aria-hidden="true"></div>
    <svg class="hero__carre" aria-hidden="true" focusable="false" preserveAspectRatio="none"><rect data-carre-trait pathLength="100" x="0" y="0" width="100%" height="100%" /></svg>
    <span class="hero__coin hero__coin--hg" aria-hidden="true" data-carre-coin></span><span class="hero__coin hero__coin--hd" aria-hidden="true" data-carre-coin></span><span class="hero__coin hero__coin--bg" aria-hidden="true" data-carre-coin></span><span class="hero__coin hero__coin--bd" aria-hidden="true" data-carre-coin></span>
    <div class="wrap hero__contenu">
      <p class="petite-cap hero__sur">{adresseLigne()}</p>
      <h1 class="hero__nom">{motsNom.map((m, i) => <><span class="hero__mot"><span class="hero__mot-in" data-hero-mot>{m}</span></span>{i < motsNom.length - 1 ? ' ' : ''}</>)}</h1>
      <p class="hero__accroche">{site.baseline}</p>
      <div class="actions">
        <a class="btn btn--primary" href={u('/reservation/')} data-magnetic="0.2">Réserver une table</a>
        <a class="lien lien--fleche" href="#services">Découvrir la maison</a>
      </div>
    </div>
  </section>

  <section class="guides" aria-label="Distinctions">
    <div class="wrap guides__inner" data-reveal="fade">
      <p class="petite-cap guides__sur">Dans les guides</p>
      <ul class="guides__liste">
        {site.distinctions.map((d) => (
          <li><a class="guides__item" href={d.url} rel="noopener"><span class="guides__nom">{d.nom}</span><span class="guides__detail">{d.detail}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Chapitre id="services" chiffre={c.menus} photo={photoDe('/photos/chap-plat-1200.webp')} lien={{ href: u('/menu/'), label: 'Lire les menus' }}>
    <p>Pas de carte à la carte : des menus en assiettes. Le lunch en 2 assiettes, puis 3, 4 ou 5 assiettes, avec un accord mets-vins en option.</p>
    <p>Foie gras de canard cuit au torchon, biche en deux préparations, Saint-Jacques : les plats du moment, faits maison avec des produits locaux de saison.</p>
  </Chapitre>

  <Chapitre id="prix" chiffre={c.prix} photo={photoDe('/photos/chap-salle-1200.webp')} inverse filet lien={{ href: u('/carte/'), label: 'Les quatre formules' }}>
    <p>{site.menus[0].prix} le lunch en 2 assiettes, {site.menus[1].prix} en 3 assiettes, {site.menus[2].prix} en 4 assiettes et {site.menus[3].prix} en 5 assiettes.</p>
    <p>Végétarien et allergies se signalent à la réservation, qui se fait par téléphone.</p>
  </Chapitre>

  <section class="citation" data-allume aria-labelledby="citation-source">
    <div class="wrap citation__wrap">
      <p class="petite-cap" id="citation-source">{site.citation.source}</p>
      <blockquote class="citation__texte" cite={site.citation.url}>
        <p>{motsCitation.map((m, i) => <><span class="mot">{m}</span>{i < motsCitation.length - 1 ? ' ' : ''}</>)}</p>
      </blockquote>
      <p class="citation__lien"><a class="lien" href={site.citation.url} rel="noopener">Sur le site du restaurant</a></p>
    </div>
  </section>

  <Chapitre id="parc" chiffre={c.parc} photo={photoDe('/photos/chap-parc-1080.webp')} lien={{ href: u('/histoire/'), label: 'La maison et ses hôtes' }}>
    <p>Une maison de bord de Meuse entièrement rénovée, un parc arboré, une terrasse au calme et un carré potager d'aromates qui a donné son nom au lieu.</p>
    <p>{site.equipe[0].nom} est au fourneau, {site.equipe[1].nom} vous accueille en salle.</p>
  </Chapitre>

  <section class="onglets" data-onglets aria-labelledby="onglets-titre">
    <div class="onglets__photos" aria-hidden="true">
      {offres.map((o, i) => { const p = photoDe(o.photo); return <img class:list={['onglets__photo', { 'is-active': i === 0 }]} data-onglet-photo src={asset(p.src)} alt="" width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />; })}
    </div>
    <div class="wrap onglets__contenu">
      <h2 class="petite-cap" id="onglets-titre">Les fêtes 2026</h2>
      <p class="onglets__intro">{site.fetes.intro}</p>
      <div class="onglets__liste" role="tablist" aria-label="Offres des fêtes">
        {offres.map((o, i) => (
          <button class="onglet" role="tab" id={`onglet-${i}`} aria-controls={`panneau-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">
            <span class="onglet__nom">{o.nom}</span><span class="onglet__barre" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      {offres.map((o, i) => (
        <div class="onglets__panneau" role="tabpanel" id={`panneau-${i}`} aria-labelledby={`onglet-${i}`} hidden={i !== 0}>
          <p>{o.texte}{o.textePlaceholder && <span class="illu">texte illustratif</span>}</p>
        </div>
      ))}
      <p class="onglets__action"><a class="btn" href={u('/fetes/')}>Les fêtes en détail</a><button class="lien onglets__pause" type="button" data-onglets-pause aria-pressed="false" hidden>Suspendre le défilement des offres</button></p>
    </div>
  </section>

  <section class="galerie" aria-label="La maison en noir et blanc">
    <div class="galerie__bande" role="group" aria-label="Photos de la maison, faites défiler" data-galerie>
      {galerie.map((p, i) => (
        <figure class:list={['galerie__item', `galerie__item--${hauteurs[i]}`]} data-reveal="up" data-delay={String(i * 0.08)} data-cursor="Voir">
          <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>

  <section class="cloture" data-rideau aria-labelledby="cloture-titre">
    <div class="rideau" aria-hidden="true"></div>
    <div class="wrap cloture__bloc">
      <p class="chiffre chiffre--centre" aria-hidden="true"><span data-compteur={String(c.parking.valeur)}>{c.parking.valeur}</span></p>
      <h2 class="petite-cap" id="cloture-titre"><span class="sr-only">{c.parking.valeur} {c.parking.libelle}</span><span aria-hidden="true">{c.parking.libelle}</span></h2>
      <p class="cloture__sous">{c.parking.sousLibelle}.</p>
      <address class="cloture__adresse">{adresseLigne()}</address>
      <dl class="cloture__horaires">
        {resume.map((r) => <div><dt>{r.libelle}</dt><dd>{r.valeur}</dd></div>)}
      </dl>
      <div class="actions actions--centre">
        <a class="btn btn--primary" href={u('/reservation/')}>Réserver une table</a>
        <a class="lien" href={telHref()}>{site.telephone}</a>
      </div>
    </div>
  </section>
</Base>
