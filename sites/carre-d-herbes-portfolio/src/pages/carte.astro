---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Formules" description={`Les formules de Carré d'herbes à Wépion : lunch en 2 assiettes ${site.menus[0].prix}, menus en 3, 4 et 5 assiettes de ${site.menus[1].prix} à ${site.menus[3].prix}.`}>
  <HeroPage titre="Formules" chiffre={site.chiffres.prix} sur="Quatre menus, une cuisine">
    <p>Du lunch en 2 assiettes au menu en 5 assiettes. Le fromage se prend en supplément ou à la place du dessert.</p>
  </HeroPage>

  <section class="section" aria-label="Les formules">
    <div class="wrap">
      <ol class="formules">
        {site.menus.map((m, i) => (
          <li class="formule" data-reveal="up" data-delay={String(i * 0.08)}>
            <p class="formule__prix" aria-hidden="true">{m.prix.replace(/\s*€/, '')}<span class="formule__euro">€</span></p>
            <div class="formule__texte">
              <h2 class="formule__nom">{m.nom}<span class="sr-only">, {m.prix}</span></h2>
              <p class="petite-cap">{m.services} assiettes, {m.quand}</p>
              <p>{m.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="formules__pied" data-reveal="fade">
        <p><strong>Bon cadeau</strong> : {site.bonCadeau.montants}. {site.bonCadeau.texte} Fromages affinés : 15 € en supplément, 7 € à la place du dessert.</p>
        <div class="actions">
          <a class="btn" href={u('/menu/')}>Le menu en détail</a>
          <a class="btn btn--primary" href={u('/reservation/')}>Réserver</a>
        </div>
      </div>
    </div>
  </section>
</Base>
