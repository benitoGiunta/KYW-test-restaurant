---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site, photoDe, telHref } from '../data/site';
import { asset } from '../lib/url';
const offres = site.fetes.offres;
---
<Base title="Fêtes 2026" description={`Fêtes 2026 à Carré d'herbes (Wépion) : Noël au restaurant le 25 décembre, menus à emporter les 24 et 31 décembre, bon cadeau. Commande au ${site.telephone}.`}>
  <HeroPage titre="Les fêtes" sur="Noël, Nouvel An, bon cadeau">
    <p>{site.fetes.intro}</p>
  </HeroPage>

  <section class="section" aria-label="Les offres des fêtes">
    <div class="wrap offres">
      {offres.map((o, i) => { const p = photoDe(o.photo); return (
        <article class:list={['offre', { 'offre--inverse': i % 2 === 1 }]}>
          <figure class="offre__photo" data-reveal="clip">
            <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
          </figure>
          <div class="offre__texte">
            <h2 class="offre__nom">{o.nom}</h2>
            <p>{o.texte}{o.textePlaceholder && <span class="illu">texte illustratif</span>}</p>
          </div>
        </article>
      ); })}
    </div>
  </section>

  <section class="section section--contact" aria-labelledby="contact-titre">
    <div class="wrap contact">
      <h2 class="petite-cap" id="contact-titre">Commander ou réserver</h2>
      <p class="contact__texte">Le menu de Noël, les menus à emporter et le bon cadeau se commandent par téléphone.</p>
      <p class="actions"><a class="btn btn--primary" href={telHref()}>Appeler le {site.telephone}</a></p>
    </div>
  </section>
</Base>
