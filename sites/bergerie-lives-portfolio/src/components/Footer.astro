---
// Pied de page « Velours » : fond profond, logo cerclé, coordonnées, pages, presse ; puis le pied de page KYW obligatoire
// (une seule mention « Maquette KYW… », celle du composant).
import KywFooter from '@kyw/footer';
import { site, adresseLigne, telHref } from '../data/site';
import { u } from '../lib/url';
---
<footer class="footer">
  <div class="wrap footer__cols">
    <div class="footer__col footer__marque">
      <span class="header__cercle footer__cercle" aria-hidden="true">{site.sigle}</span>
      <p class="footer__nom">{site.nom}</p>
      <address>{adresseLigne()}</address>
      <p><a class="lien" href={telHref()}>{site.telephone}</a></p>
      <p><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="footer__col">
      <p class="petite-cap">Accueil</p>
      <p class="muted">Horaires d'accueil non publiés : appelez ou écrivez pour convenir d'un moment.</p>
    </div>
    <div class="footer__col">
      <p class="petite-cap">Pages</p>
      <p><a class="lien" href={u('/chambres/')}>Chambres</a></p>
      <p><a class="lien" href={u('/mariage/')}>Mariage</a></p>
      <p><a class="lien" href={u('/seminaires/')}>Séminaires</a></p>
      <p><a class="lien" href={u('/le-domaine/')}>Le domaine</a></p>
      <p><a class="lien" href={u('/contact/')}>Contact</a></p>
    </div>
    <div class="footer__col">
      <p class="petite-cap">Ailleurs</p>
      <p><a class="lien" href={site.url} rel="noopener">Site actuel</a></p>
      {site.presse.map((p) => <p><a class="lien" href={p.url} rel="noopener">{p.media}, {p.date.slice(0, 4)}</a></p>)}
    </div>
  </div>
</footer>
<KywFooter base={import.meta.env.BASE_URL} />
