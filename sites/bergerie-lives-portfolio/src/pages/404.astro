---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n'existe pas. Retour à l'accueil de La Bergerie de Lives.">
  <HeroPage titre="Rideau" sur="Erreur 404">
    <p>Cette page n'existe pas, ou plus. Le domaine, lui, est toujours rue de Mosanville.</p>
    <div class="actions">
      <a class="btn btn--primary" href={u('/')}>Retour à l'accueil</a>
      <a class="btn" href={u('/contact/')}>Nous contacter</a>
    </div>
  </HeroPage>
</Base>
