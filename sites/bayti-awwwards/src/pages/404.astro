---
import Base from '../layouts/Base.astro';
import Rue from '../components/Rue.astro';
import { u } from '../lib/url';
---
<Base tone="nuit" title="Page introuvable" description="Cette adresse n’existe pas Rue du Pont. Retrouvez le n° 6, le comptoir, ou le n° 15, le restaurant, de Bayti à Namur.">
  <section class="sec tone-nuit">
    <div class="wrap p404">
      <p class="plaque"><span class="plaque__rue">Rue du Pont</span><span class="plaque__ville">Numéro inconnu</span></p>
      <h1 class="display display--xl">Cette porte <span class="ital">n’existe pas.</span></h1>
      <p class="prose muted">Rue du Pont, il n’y a que deux numéros : le 6 et le 15. Choisissez la bonne porte.</p>
      <Rue />
      <p><a class="btn btn--plein" href={u('/')}>Revenir à l’accueil</a></p>
    </div>
  </section>
</Base>
