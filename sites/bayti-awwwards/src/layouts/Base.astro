---
import { ClientRouter } from 'astro:transitions';
import KywFooter from '@kyw/footer';
import { site, adresses } from '../data/site';
import { asset } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props { title?: string; description?: string; image?: string; tone?: 'jour' | 'carreau' | 'nuit' }
const { title, description = site.description, image = '/og.png', tone = 'jour' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Cuisine du Moyen-Orient à Namur`;
const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(asset(image), siteUrl).href;
const a = adresses.restaurant;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  url: canonical,
  image: ogImage,
  telephone: site.telephoneHref,
  servesCuisine: ['Moyen-Orient', 'Libanaise'],
  address: { '@type': 'PostalAddress', streetAddress: `${a.rue} ${a.numero}`, postalCode: a.cp, addressLocality: a.commune, addressCountry: 'BE' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '11:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '18:00', closes: '21:00' },
  ],
  sameAs: [site.facebook, site.instagram],
};
---
<!doctype html>
<html lang="fr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0f0e" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <link rel="preload" href={asset('/fonts/zodiak-700-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset('/fonts/switzer-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <div id="fond" transition:persist="fond" aria-hidden="true"></div>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"><span class="curtain__nom">Rue du Pont</span><span class="curtain__fil"></span></div></div>
    <Header tone={tone} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div id="fil" transition:persist="fil" aria-hidden="true">
      <span class="fil__porte">n°&nbsp;6</span>
      <span class="fil__ligne"><span class="fil__paves"></span><span class="fil__trace"></span><span class="fil__passant"></span></span>
      <span class="fil__porte">n°&nbsp;15</span>
    </div>
    <KywFooter base={import.meta.env.BASE_URL} note="Maquette KYW, certaines données sont illustratives." />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
