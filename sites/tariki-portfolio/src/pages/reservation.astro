---
import Base from '../layouts/Base.astro';
import { site, adresseLigne, horaireTexte, telHref } from '../data/site';
---
<Base title="Réserver" description={`Réserver une table chez ${site.nom} à ${site.adresse.commune} : en ligne, ou par téléphone au ${site.telephone}.`} start={90} footerCompact>
  <section class="hero hero--page" data-temp="90">
    <div class="wrap">
      <p class="chapeau" data-reveal="fade" data-intro>Nuit</p>
      <h1 class="hero__title" data-split="lines" data-intro data-delay="0.1">Réserver une table</h1>
      <div class="hero__foot">
        <p class="hero__lead">Avec {site.reservation.outil}, ou par téléphone au {site.telephone}.</p>
        <div class="actions" data-reveal="fade" data-intro data-delay="0.7" style="margin-top: 0">
          <a class="btn btn--solid" href={site.reservation.url} rel="noopener">Réserver en ligne</a>
          <a class="btn" href={telHref()}>{site.telephone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-temp="60" data-temp-end="20">
    <div class="wrap pratique__grid">
      <div class="pratique__a stack" data-reveal="up">
        <p class="chapeau">Horaires</p>
        <dl class="horaires">
          {site.horaires.map((h) => <><dt>{h.jour}</dt><dd>{horaireTexte(h)}</dd></>)}
        </dl>
        <address style="margin-top: calc(var(--u) * 3)">{adresseLigne()}</address>
        <p class="note">Le midi, du mercredi au samedi ; le soir, du lundi au samedi. Fermé le dimanche.</p>
      </div>
      <div class="pratique__b" data-reveal="up" data-delay="0.1">
        <p class="chapeau">Votre demande</p>
        <p class="note" style="margin-bottom: calc(var(--u) * 2)">Formulaire de démonstration sans envoi : la validation vous conduit vers le module de réservation du restaurant.</p>
        <form class="form" data-reservation action={site.reservation.url} method="get">
          <label>Nom <input type="text" name="nom" autocomplete="name" required /></label>
          <label>Téléphone <input type="tel" name="tel" autocomplete="tel" /></label>
          <label>Date <input type="date" name="date" required aria-describedby="err-date" /><span class="form__err" id="err-date" data-err-date hidden></span></label>
          <label>Heure <input type="time" name="heure" required /></label>
          <label>Couverts <input type="number" name="couverts" min="1" max="12" value="2" required /></label>
          <label class="full">Message <textarea name="message" rows="3"></textarea></label>
          <div class="actions full" style="margin-top: 0">
            <button class="btn btn--solid" type="submit">Continuer vers la réservation</button>
          </div>
          <p class="form__status full" role="status" aria-live="polite" data-status></p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import { onPage } from '../engine';
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-reservation]');
    if (!form) return;
    const date = form.elements.namedItem('date') as HTMLInputElement;
    const err = form.querySelector<HTMLElement>('[data-err-date]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    // Pas de date passée (jour de Bruxelles) ; dimanche refusé : le restaurant est fermé.
    const auj = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Brussels' });
    date.min = auj;
    const verifie = () => {
      const [y, m, d] = date.value.split('-').map(Number);
      const dimanche = !!date.value && new Date(y, m - 1, d).getDay() === 0;
      date.setCustomValidity(dimanche ? 'Le restaurant est fermé le dimanche.' : '');
      if (err) { err.hidden = !dimanche; err.textContent = dimanche ? 'Le restaurant est fermé le dimanche, choisissez un autre jour.' : ''; }
    };
    date.addEventListener('input', verifie);
    const go = (e: SubmitEvent) => {
      e.preventDefault();
      verifie();
      if (!form.reportValidity()) return;
      const w = window.open(form.action, '_blank'); // « noopener » renverrait toujours null : on coupe l'opener à la main
      if (w) w.opener = null;
      if (!status) return;
      status.textContent = '';
      if (w) { status.textContent = 'Le module de réservation du restaurant s’ouvre dans un nouvel onglet.'; return; }
      const a = document.createElement('a');
      a.className = 'link'; a.href = form.action; a.rel = 'noopener'; a.target = '_blank';
      a.textContent = 'ouvrir le module de réservation';
      status.append('Votre navigateur a bloqué l’ouverture : ', a, '.');
    };
    form.addEventListener('submit', go);
    return () => { form.removeEventListener('submit', go); date.removeEventListener('input', verifie); };
  });
</script>
