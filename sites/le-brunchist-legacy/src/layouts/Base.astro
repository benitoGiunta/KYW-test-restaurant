---
import KywFooter from '@kyw/footer';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import { resto, base, photos } from '../data/site';
interface Props { title: string; description: string; pied?: boolean }
const { title, description, pied = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'CafeOrCoffeeShop', name: resto.nom, url: resto.siteActuel,
  telephone: resto.telephone, servesCuisine: ['Brunch', 'Café de spécialité'],
  address: { '@type': 'PostalAddress', streetAddress: `${resto.adresse.rue} ${resto.adresse.numero}`, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  sameAs: [resto.facebook, resto.instagram],
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%272%27 fill=%27%23273c9e%27/%3E%3C/svg%3E" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}${photos.hero.src}`, Astro.site).href} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@600&family=Grenze:wght@400&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={ld} />
    <style is:global>@import "../styles/page.css";</style>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu"><slot /></main>
    {pied && <Pied />}
    <script is:inline>
      document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });
    </script>
    <KywFooter base={base} />
    <script>
      // Switcher de la carte : le premier panneau est visible sans script (tous le sont, onglets masqués)
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((zone) => {
        const onglets = Array.from(zone.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const panneaux = Array.from(zone.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
        const choisir = (i: number, focus = false) => {
          onglets.forEach((o, k) => { o.setAttribute('aria-selected', String(k === i)); o.tabIndex = k === i ? 0 : -1; });
          panneaux.forEach((p, k) => p.classList.toggle('is-on', k === i));
          if (focus) onglets[i].focus();
        };
        onglets.forEach((o, i) => {
          o.addEventListener('click', () => choisir(i));
          o.addEventListener('keydown', (e) => {
            const n = onglets.length;
            if (e.key === 'ArrowRight') { e.preventDefault(); choisir((i + 1) % n, true); }
            if (e.key === 'ArrowLeft') { e.preventDefault(); choisir((i - 1 + n) % n, true); }
          });
        });
      });
    </script>
  </body>
</html>
