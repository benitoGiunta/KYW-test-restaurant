---
import KywFooter from '@kyw/footer';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import { resto, base, photos, horaires } from '../data/site';
interface Props { title: string; description: string; pied?: boolean }
const { title, description, pied = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const dayEn: Record<string, string> = { Lundi: 'Monday', Mardi: 'Tuesday', Mercredi: 'Wednesday', Jeudi: 'Thursday', Vendredi: 'Friday', Samedi: 'Saturday', Dimanche: 'Sunday' };
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'CafeOrCoffeeShop', name: resto.nom, url: resto.siteActuel,
  telephone: resto.telephone, servesCuisine: ['Brunch', 'Café de spécialité'],
  address: { '@type': 'PostalAddress', streetAddress: `${resto.adresse.rue} ${resto.adresse.numero}`, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  image: new URL(`${base}${photos.hero.src}`, Astro.site).href,
  openingHoursSpecification: horaires.filter((h) => h.ouvert).map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: dayEn[h.jour], opens: h.iso[0], closes: h.iso[1] })),
  sameAs: [resto.facebook, resto.instagram],
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%272%27 fill=%27%23273c9e%27/%3E%3C/svg%3E" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}${photos.hero.src}`, Astro.site).href} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@600&family=Grenze:wght@400&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={ld} />
    <style is:global>@import "../styles/page.css";</style>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu"><slot /></main>
    {pied && <Pied />}
    <script is:inline>
      document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });
    </script>
    <KywFooter base={base} />
    <script>
      // Switcher de la carte : le premier panneau est visible sans script (tous le sont, onglets masqués)
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((zone) => {
        const onglets = Array.from(zone.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const panneaux = Array.from(zone.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
        const choisir = (i: number, focus = false) => {
          onglets.forEach((o, k) => { o.setAttribute('aria-selected', String(k === i)); o.tabIndex = k === i ? 0 : -1; });
          panneaux.forEach((p, k) => p.classList.toggle('is-on', k === i));
          if (focus) onglets[i].focus();
        };
        onglets.forEach((o, i) => {
          o.addEventListener('click', () => choisir(i));
          o.addEventListener('keydown', (e) => {
            const n = onglets.length;
            const cible = e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i - 1 + n) % n : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
            if (cible >= 0) { e.preventDefault(); choisir(cible, true); }
          });
        });
      });

      // Menu mobile : <dialog> modal, fermé par Échap (natif), le bouton, un lien ou le fond
      const menu = document.getElementById('menu') as HTMLDialogElement | null;
      const ouvrir = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      if (menu && ouvrir && typeof menu.showModal === 'function') {
        ouvrir.addEventListener('click', () => menu.showModal());
        menu.querySelectorAll('[data-menu-close]').forEach((b) => b.addEventListener('click', () => menu.close()));
        menu.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });
        matchMedia('(min-width: 60.001rem)').addEventListener('change', (m) => { if (m.matches && menu.open) menu.close(); });
      } else if (ouvrir) { ouvrir.hidden = true; }

      // Livre du jour : la ligne d'aujourd'hui (heure de Namur) est marquée dans les horaires
      const jour = new Intl.DateTimeFormat('fr-BE', { weekday: 'long', timeZone: 'Europe/Brussels' }).format(new Date());
      const ligne = Array.from(document.querySelectorAll<HTMLElement>('.hours__row')).find((r) => (r.dataset.jour || '').toLowerCase() === jour.toLowerCase());
      if (ligne) {
        ligne.setAttribute('aria-current', 'date');
        const dt = ligne.querySelector('dt');
        if (dt) { const m = document.createElement('span'); m.className = 'hours__now'; m.textContent = 'Aujourd’hui'; dt.append(m); }
      }

      // Section courante dans la barre : un seul signal (soulignement), posé par IntersectionObserver
      const liens = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__links a'));
      const cibles = liens.map((a) => document.getElementById((a.hash || '').slice(1))).filter(Boolean) as HTMLElement[];
      if (cibles.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => {
          es.forEach((e) => { if (e.isIntersecting) liens.forEach((a) => { if (a.hash === '#' + e.target.id) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); }); });
        }, { rootMargin: '-45% 0px -50% 0px' });
        cibles.forEach((c) => io.observe(c));
      }
    </script>
  </body>
</html>
