---
import { base, photos } from '../data/site';
const l = photos.lieu;
---
<section class="lieu" id="lieu" aria-labelledby="t-lieu">
  <div class="container lieu__grid">
    <figure class="lieu__photo">
      <div class="frame frame--lieu" data-slot="lieu" data-alt={l.data} data-credits={`${l.credit}, ${l.licence}`} data-placeholder="true">
        <img src={`${base}${l.src}`} width={l.w} height={l.h} alt={l.alt} loading="lazy" decoding="async" style="object-position: 55% 50%" />
      </div>
      <figcaption>Un coin de salle.</figcaption>
    </figure>
    <div class="lieu__text">
      <h2 id="t-lieu">Un lieu cosy, une terrasse.</h2>
      <p class="lead">Ambiance décontractée et conviviale, vaisselle vintage, cuisine locale et faite maison.</p>
      <dl class="faits">
        <div><dt>Ouverture</dt><dd>2022, par Mélisande et Arnaud, un couple namurois</dd></div>
        <div><dt>Terrasse</dt><dd>En extérieur</dd></div>
        <div><dt>Adresse</dt><dd>Place d’Armes 8, au centre de Namur</dd></div>
      </dl>
    </div>
  </div>
</section>
