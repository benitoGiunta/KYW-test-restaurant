---
import Fig from './Fig.astro';
import { resto } from '../data/site';
---
<section class="hero" aria-labelledby="h-hero">
  <Fig f="09-tables-fauteuils-orange.jpg" alt="Tables dressées de verres à pied et de fauteuils orange devant un mur de briques" hero pos="50% 55%" sizes="100vw" cls="hero__fig" />
  <div class="container hero__in">
    <h1 id="h-hero">Un moment hors du temps au cœur du village</h1>
    <p class="lead">Une brasserie à Crupet, pour se retrouver en famille ou entre amis, midi et soir, tous les jours.</p>
    <p class="hero__act">
      <a class="btn btn--accent btn--big" href={resto.reserver} rel="noopener">Réserver une table</a>
      <a class="link" href="#carte">Voir la carte</a>
    </p>
  </div>
</section>
