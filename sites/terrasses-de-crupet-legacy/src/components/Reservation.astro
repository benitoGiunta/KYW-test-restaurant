---
import Fig from './Fig.astro';
import { resto } from '../data/site';
---
<section class="resa" id="reservations" aria-labelledby="h-resa">
  <div class="container resa__in">
    <Fig f="20-chalet-hiver-table.jpg" alt="Une table dressée dans le chalet d’hiver" sizes="(min-width: 900px) 34vw, 100vw" cls="resa__fig" pos="50% 40%" />
    <div class="resa__txt">
      <h2 id="h-resa">Réserver, au restaurant ou au chalet d’hiver</h2>
      <p class="lead">Réservez en ligne ou par téléphone, en salle ou dans le chalet d’hiver.</p>
      <p class="resa__act">
        <a class="btn btn--accent btn--big" href={resto.reserver} rel="noopener">Réserver en ligne</a>
        <a class="btn btn--big" href={resto.tel.href}>{resto.tel.affiche}</a>
      </p>
      <p>Un bon cadeau peut s’offrir au restaurant.</p>
    </div>
  </div>
</section>
