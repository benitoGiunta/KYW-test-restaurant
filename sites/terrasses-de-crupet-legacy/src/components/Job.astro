---
import { postes, resto } from '../data/site';
---
<section class="job" id="job" aria-labelledby="h-job">
  <div class="container job__in">
    <h2 id="h-job">Rejoindre l’équipe</h2>
    <div>
      <p class="lead">Le restaurant recrute pour ces postes. Écrivez-nous.</p>
      <ul class="job__list">{postes.map((p) => <li>{p}</li>)}</ul>
      <p><a class="btn" href={`mailto:${resto.email}?subject=Candidature`}>Postuler par e-mail</a></p>
    </div>
  </div>
</section>
