---
import { resto } from '../data/site';
---
<section class="foot" id="contact" aria-label="Contact et adresse">
  <div class="container">
    <p class="foot__mast" aria-hidden="true">Les Terrasses<span> de Crupet</span></p>
    <div class="foot__cols">
      <div><h2 class="foot__h">Adresse</h2><p>{resto.rue}<br />{resto.ville}</p><p><a href={resto.carteAdresse} rel="noopener">Itinéraire</a></p></div>
      <div><h2 class="foot__h">Contact</h2><p><a class="num" href={resto.tel.href}>{resto.tel.affiche}</a><br /><a class="mail" href={`mailto:${resto.email}`}>{resto.email}</a></p></div>
      <div><h2 class="foot__h">Ouverture</h2><p>Tous les jours, 12 h 00 à 14 h 00 et 18 h 00 à 22 h 00.</p></div>
      <div><h2 class="foot__h">Suivre</h2><p><a href={resto.facebook} rel="noopener">Facebook</a><br /><a href={resto.instagram} rel="noopener">Instagram</a></p></div>
    </div>
    <p class="foot__credits" data-credits>Photographies : Les Terrasses de Crupet. Site d’origine : <a href={resto.site} rel="noopener">lesterrassesdecrupet.be</a>.</p>
  </div>
</section>
