---
import { photo } from '../data/site';
interface Props { f: string; alt: string; sizes?: string; hero?: boolean; pos?: string; cls?: string; credit?: boolean }
const { f, alt, sizes = '(min-width: 900px) 50vw, 100vw', hero = false, pos = 'center', cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const p = photo(f);
---
<figure class={`fig ${cls}`} data-slot={f.replace(/\.\w+$/, '')} data-alt={alt} style={`aspect-ratio:${p.w}/${p.h}`}>
  <img src={`${base}photos/${f}`} width={p.w} height={p.h} alt={alt} sizes={sizes} style={`object-position:${pos}`} loading={hero ? 'eager' : 'lazy'} decoding={hero ? 'auto' : 'async'} fetchpriority={hero ? 'high' : undefined} />
  <slot />
</figure>
