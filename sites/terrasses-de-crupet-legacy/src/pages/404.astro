---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable, Les Terrasses de Crupet" description="Cette page n’existe pas.">
  <header class="container pagehead"><h1>Page introuvable</h1><p class="lead">Cette adresse ne mène à rien.</p><p><a class="btn btn--accent" href={base}>Retour à l’accueil</a></p></header>
</Base>
