---
import Base from '../layouts/Base.astro';
import Echelle from '../components/Echelle.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas sur le site du Félicien, brasserie à Suarlée. Retournez à l’accueil ou ouvrez la carte d’automne.">
  <section class="horsechelle" aria-labelledby="titre">
    <div class="wrap">
      <h1 id="titre" class="display titre-mega">Hors échelle.</h1>
      <p class="horsechelle__texte">Cette page n’est pas sur la règle : pas de prix, pas de table. Retrouvez le bon chemin.</p>
      <Echelle classe="horsechelle__regle" pins={[{ prix: 40, texte: '404' }]} />
      <p class="horsechelle__liens"><a class="cta cta--or" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a> <a class="cta" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a></p>
    </div>
  </section>
</Base>
