---
import Base from '../layouts/Base.astro';
import { site, services, horairesNote } from '../data/site';
---
<Base page="reservation" title="Réserver une table" description="Réservez une table au Félicien, à Suarlée (Namur) : en ligne ou par téléphone. Horaires de la cuisine, adresse, plan et menus de groupe.">
  <section class="entete" aria-labelledby="titre">
    <div class="wrap entete__grille">
      <h1 id="titre" class="display titre-mega entete__titre">Réserver</h1>
      <p class="entete__texte">La cuisine travaille midi et soir, tous les jours. Choisissez votre moyen : la réservation en ligne ou le téléphone.</p>
      <p class="resa__actions">
        <a class="cta cta--or" href={site.reservationUrl} rel="noopener"><span class="cta__txt">Réserver en ligne</span></a>
        <a class="cta" href={site.telephoneHref}><span class="cta__txt">Appeler le {site.telephoneLisible}</span></a>
      </p>
    </div>
  </section>

  <section class="resa" aria-labelledby="t-resa">
    <div class="wrap resa__grille">
      <h2 id="t-resa" class="display titre-l" data-split="lines">Quand et où</h2>
      <div class="resa__col">
        <h3 class="resa__titre">Horaires de la cuisine</h3>
        <ul class="resa__horaires">
          {services.map((s) => <li><span>{s.jours}</span><span>{s.midi}<br />{s.soir}</span></li>)}
        </ul>
        <p class="resa__note">{horairesNote}</p>
      </div>
      <div class="resa__col">
        <h3 class="resa__titre">Adresse</h3>
        <address>{site.nom}<br />{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune} ({site.adresse.ville})</address>
        <p>La brasserie se trouve dans le Business Village Ecolys.</p>
        <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
      </div>
      <div class="resa__col">
        <h3 class="resa__titre">Groupes et événements</h3>
        <p>Le premier étage accueille dîners, banquets et réceptions. Les menus démarrent à 27&nbsp;€ hors boissons.</p>
        <p><a class="lien" href={`mailto:${site.emailEvenements}`}>{site.emailEvenements}</a></p>
      </div>
      <div class="resa__col">
        <h3 class="resa__titre">Le midi en semaine</h3>
        <p>Du mardi au vendredi, les suggestions de la semaine se prennent à 25&nbsp;€ en entrée et plat, 18&nbsp;€ en plat seul. Le lundi, la cuisine du marché est décidée le jour même.</p>
      </div>
    </div>
  </section>
</Base>
