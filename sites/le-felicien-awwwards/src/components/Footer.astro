---
import KywFooter from '@kyw/footer';
import Echelle from './Echelle.astro';
import { u } from '../lib/url';
import { site, services, horairesNote } from '../data/site';
---
<section class="pied" aria-label="Contact et horaires">
  <div class="wrap pied__corps">
    <p class="pied__mot display" aria-hidden="true">Venez comme vous êtes.</p>
    <Echelle classe="pied__regle" />
    <div class="pied__col">
      <h2 class="pied__titre">Venir</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune} ({site.adresse.ville})</address>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Ouvert 7 jours sur 7</h2>
      <ul class="pied__horaires">
        {services.map((s) => <li><span>{s.jours}</span><span>{s.midi}<br />{s.soir}</span></li>)}
      </ul>
      <p class="pied__note">{horairesNote}</p>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Contact</h2>
      <p><a class="pied__tel" href={site.telephoneHref}>{site.telephoneLisible}</a><br /><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="pied__reseaux"><li><a class="lien" href={site.facebook} rel="noopener">Facebook</a></li><li><a class="lien" href={site.instagram} rel="noopener">Instagram</a></li></ul>
    </div>
    <div class="pied__cta"><a class="cta cta--or" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a></div>
    <p class="pied__colophon">{site.credit}. Polices : Big Shoulders Display et Schibsted Grotesk (Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
