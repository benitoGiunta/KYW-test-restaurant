---
// Taches de vache : signature décorative (noir vache du logo), posées sur les bords du hero.
const { compact = false } = Astro.props;
const formes = [
  'M62 8c20-10 52-4 66 16 12 17 6 34 18 52 10 16 2 42-18 52-14 8-26-2-42 6-22 12-52 2-58-22-4-16 8-26 4-42-4-20 8-52 30-62z',
  'M20 40c12-26 54-34 80-18 20 12 22 34 38 46 18 14 14 44-8 56-18 10-34-2-52 4-26 8-60-6-64-36-2-18 0-34 6-52z',
  'M40 10c26-12 64 0 76 26 8 18-4 30 4 46 8 18-6 40-30 44-18 2-28-12-46-10-24 2-48-14-46-38 2-16 14-22 12-38-2-14 12-26 30-30z',
];
const poses = compact
  ? [{ f: 0, x: '-6%', y: '-30%', t: '16vw' }, { f: 2, x: '90%', y: '40%', t: '12vw' }]
  : [{ f: 0, x: '-6%', y: '58%', t: '18vw' }, { f: 1, x: '82%', y: '-8%', t: '16vw' }, { f: 2, x: '90%', y: '66%', t: '9vw' }, { f: 1, x: '-8%', y: '-6%', t: '12vw' }];
---
<div class:list={['taches', { 'taches--compact': compact }]} aria-hidden="true" data-taches>
  {poses.map((p, i) => (
    <span class="tache" data-tache style={`--x:${p.x};--y:${p.y};--t:${p.t};--d:${(i * 1.7).toFixed(1)}s`}>
      <svg viewBox="-30 -30 220 180" focusable="false"><path d={formes[p.f]} fill="currentColor" /></svg>
    </span>
  ))}
</div>
