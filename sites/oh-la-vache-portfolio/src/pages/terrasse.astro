---
// Terrasse : documentée par six photos du client. Événements et privatisation : inconnus, donc absents.
import Base from '../layouts/Base.astro';
import Taches from '../components/Taches.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g, photoDe, telHref } from '../data/site';
import { u } from '../lib/url';
import { asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const photos = ['/photos/terrasse-canapes.webp', '/photos/terrasse-tables.webp', '/photos/terrasse-pergola.webp', '/photos/terrasse-ardoise.webp', '/photos/terrasse-parasol.webp', '/photos/salle-rouge.webp'].map(photoDe);
---
<Base title="La terrasse" description={`La terrasse de ${site.nom} à Erpent (Namur) : canapés, parasols, pergola et salle sous tente.`}>
  <section class="hero hero--page wrap" data-hero>
    <Taches compact />
    <div class="hero__inner">
      <h1>La terrasse</h1>
      <p class="lead">Des canapés pour l'apéritif, des tables sous parasol et sous pergola, et une salle sous tente à côté.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Dehors, <span>tout simplement</span></h2>
      <p class="lead">{g.terrasse.texte}</p>
      <ul role="list" style="display:flex;flex-wrap:wrap;gap:0.6em;justify-content:center;margin-top:calc(var(--u)*3)">
        {g.terrasse.points.map((t) => <li class="vege" style="font-size:var(--t-s);padding:0.4em 1em">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section__titre">En <em>images</em></h2>
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3, -2, 4, -3, 2][i]}deg`} data-reveal="up" data-delay={String((i % 3) * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.alt.split(',')[0]}</figcaption>
          </figure>
        ))}
      </div>
      <p class="prose" style="margin-top:calc(var(--u)*4)">Pour réserver une table ou poser une question, appelez le <a class="link" href={telHref()}>{site.telephone}</a>.</p>
      <div class="actions"><a class="btn btn--plein" href={u('/reservation/')}>Réserver</a></div>
    </div>
  </section>
</Base>
