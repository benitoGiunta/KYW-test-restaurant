---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import { site, guinguette, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const g = guinguette;
const picto = (cat: string) => g.pictos.find((p) => cat.startsWith(p.categorie))?.picto ?? 'fourchette';
const cuisine = site.carte.filter((c) => !g.boissons.includes(c.categorie));
const bar = site.carte.filter((c) => g.boissons.includes(c.categorie));
const nomCat = (c: string) => c.replace(/ \(tous accompagnés.*\)/, ' (avec tonic sélectionné)');
const photos = ['/photos/entrecote-frites.webp', '/photos/moules-frites.webp', '/photos/dessert-fondant.webp', '/photos/planche-charcuterie.webp'].map(photoDe);
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
---
<Base title="La carte" description={`La carte et les formules de ${site.nom} à Erpent (Namur) : fondues, pierrades, raclette, viandes grillées, burgers, desserts, gin'to et cocktails.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>La carte</h1>
      <p class="lead">Fondues, pierrades et raclette dès deux couverts, viandes grillées, burgers, pâtes, salades, desserts, puis le bar : bières, cocktails et treize gin'to. Prix de la carte d'octobre 2024.</p>
      <p class="muted" style="margin-top:0.8em">Un seul paiement par table. Supplément doggy bag : 0,90 €.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--corail is-flottant" style="--x:84%;--y:4%;--r:14deg;--taille:110px" aria-hidden="true"><Objet id="fourchette" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="carte">
        <h2 class="section__titre">À <em>table</em></h2>
        <div class="carte__grille">
          {cuisine.map((c) => (
            <div>
              <h3 class="cat__titre"><Objet id={picto(c.categorie)} />{c.categorie}</h3>
              <ul role="list">
                {c.plats.map((p) => (
                  <li class="plat">
                    <span class="plat__nom">{p.nom}{p.description && <span class="plat__desc">{p.description}</span>}</span>
                    <span class="plat__points" aria-hidden="true"></span>
                    {p.prix && <span class="plat__prix">{p.prix}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <h2 class="section__titre" style="margin-top: calc(var(--u) * 5)">Les <em>formules</em></h2>
        <div class="carte__menus">
          {site.menus.map((m) => (
            <article class="formule">
              <h3>{m.nom}</h3>
              <p class="formule__prix">{m.prix}</p>
              <p class="muted" style="margin-top:0.8em">{m.description}</p>
            </article>
          ))}
        </div>
        <h2 class="section__titre" style="margin-top: calc(var(--u) * 5)">Au <em>bar</em></h2>
        <div class="carte__grille">
          {bar.map((c) => (
            <div>
              <h3 class="cat__titre"><Objet id={picto(c.categorie)} />{nomCat(c.categorie)}</h3>
              <ul role="list">
                {c.plats.map((p) => (
                  <li class="plat">
                    <span class="plat__nom">{p.nom}{p.description && <span class="plat__desc">{p.description}</span>}</span>
                    <span class="plat__points" aria-hidden="true"></span>
                    {p.prix && <span class="plat__prix">{p.prix}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--canard">
    <div class="wrap">
      <h2 class="section__titre">Dans <em>l'assiette</em></h2>
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3, -2, 5][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.alt.split(',')[0]}</figcaption>
          </figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--lin" href={u('/reservation/')}>Réserver une table</a></div>
    </div>
  </section>
</Base>
