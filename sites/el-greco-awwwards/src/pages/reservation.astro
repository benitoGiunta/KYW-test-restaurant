---
import Base from '../layouts/Base.astro';
import Horaires from '../components/Horaires.astro';
import { site } from '../data/site';
---
<Base page="reservation" title="Réserver" description="Réserver une table chez El Greco, rue de Sardanson 22 à Bouge (Namur) : téléphone 081 20 07 47, e-mail, horaires, plan et moyens de paiement.">
  <section class="entete" aria-labelledby="h1">
    <div class="wrap">
      <h1 class="entete__titre display" id="h1" data-allonge data-intro>Réserver</h1>
      <p class="entete__phrase">Pour réserver, appelez le 081 20 07 47. Il n’y a pas de formulaire en ligne sur cette maquette.</p>
    </div>
  </section>
  <section class="sec--serre sec">
    <div class="wrap grille resa">
      <div class="resa__a">
        <h2 class="resa__h">Par téléphone</h2>
        <a class="resa__tel display num" href={site.telephoneHref}>{site.telephoneLisible}</a>
        <div class="actions">
          <a class="cta" href={site.telephoneHref}><span class="cta__txt">Appeler</span></a>
          <a class="cta cta--contour" href={site.reservationUrl} rel="noopener"><span class="cta__txt">Page contact du restaurant (à confirmer)</span></a>
        </div>
        <ul class="resa__liste">
          <li>Contact : <a class="lien" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>Paiement : {site.paiements}.</li>
          <li>Terrasse : citée par des clients, à confirmer par téléphone.</li>
        </ul>
      </div>
      <div class="resa__b">
        <h2 class="resa__h">Horaires</h2>
        <Horaires />
        <p class="petit">D’après Trouve Ton Resto, à confirmer par téléphone.</p>
        <h2 class="resa__h" style="margin-top: var(--normal)">Accès</h2>
        <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
        <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
      </div>
    </div>
  </section>
</Base>
