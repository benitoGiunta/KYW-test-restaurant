---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas sur la maquette d’El Greco, restaurant grec de Bouge (Namur). Revenez à l’accueil ou à la carte.">
  <section class="perdu" aria-labelledby="h1">
    <div class="wrap">
      <h1 class="perdu__titre display" id="h1" data-allonge data-intro>Trop long</h1>
      <p class="perdu__txt">Cette page s’est étirée jusqu’à disparaître de la carte. Revenez à l’accueil, ou allez droit aux plats.</p>
      <div class="actions">
        <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
        <a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">La carte</span></a>
      </div>
    </div>
  </section>
</Base>
