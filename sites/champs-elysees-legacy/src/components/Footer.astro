---
import { resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="foot" aria-label="Coordonnées de la brasserie">
  <div class="container foot__in">
    <img class="foot__logo" src={`${base}photos/logo.webp`} width="1721" height="1135" alt="Champs Elysées, bistro convivial" loading="lazy" />
    <address class="foot__addr">
      {resto.adresse1}<br />{resto.adresse2}<br />
      <a href={resto.telHref}>{resto.tel}</a><br />
      <a href={`mailto:${resto.email}`}>{resto.email}</a>
    </address>
    <ul class="foot__links">
      <li><a href={`${base}#propos`}>À propos</a></li>
      <li><a href={`${base}la-carte/`}>La carte</a></li>
      <li><a href={`${base}fetes-patronales/`}>Fêtes patronales</a></li>
      <li><a href={resto.zenchef}>Réserver</a></li>
      <li><a href={`${base}contact/`}>Contact</a></li>
      <li><a href={resto.facebook}>Facebook</a></li>
    </ul>
    <p class="foot__credits" data-credits>Photographies et logo : Champs Elysées. Site d’origine : <a href={resto.site}>champselysees.be</a>.</p>
  </div>
</section>
