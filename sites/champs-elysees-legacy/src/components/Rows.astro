---
import type { Plat } from '../data/site';
interface Props { plats: Plat[] }
const { plats } = Astro.props;
---
<ul class="rows">
  {plats.map((p) => (
    <li class="row">
      <div class="row__name">
        <h3>{p.nom}</h3>
        {p.desc && <p class="row__desc">{p.desc}</p>}
      </div>
      <ul class="row__prices">
        {p.prix.map((x) => <li class="num">{x.l && <span>{x.l}</span>} {x.p && <b>{x.p}</b>}</li>)}
      </ul>
    </li>
  ))}
</ul>
