---
import Base from '../../layouts/Base.astro';
import { resto } from '../../data/site';
---
<Base page="contact" title="Contact, Champs Elysées, brasserie à Namur" description="Écrire à la brasserie Champs Elysées, avenue Albert Ier à Jambes (Namur) : formulaire, téléphone, e-mail et adresse.">
  <section class="banner" aria-labelledby="h-contact">
    <div class="container banner__in">
      <h1 id="h-contact">Contact</h1>
      <p class="lead">Un message, un appel ou un e-mail.</p>
    </div>
  </section>
  <section class="sec">
    <div class="container resa">
      <form class="form" method="post" data-endpoint="" action="" novalidate>
        <h2>Envoyez-nous un message</h2>
        <div class="form__grid">
          <div class="field">
            <label for="f-prenom">Prénom *</label>
            <input id="f-prenom" name="prenom" type="text" autocomplete="given-name" placeholder="Camille" required aria-describedby="f-prenom-h" />
            <p class="help" id="f-prenom-h" data-help="Obligatoire."></p>
          </div>
          <div class="field">
            <label for="f-nom">Nom *</label>
            <input id="f-nom" name="nom" type="text" autocomplete="family-name" placeholder="Dupont" required aria-describedby="f-nom-h" />
            <p class="help" id="f-nom-h" data-help="Obligatoire."></p>
          </div>
          <div class="field">
            <label for="f-email">Adresse e-mail *</label>
            <input id="f-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="nom@exemple.be" required aria-describedby="f-email-h" />
            <p class="help" id="f-email-h" data-help="Format : nom@exemple.be."></p>
          </div>
          <div class="field">
            <label for="f-tel">Téléphone ou GSM</label>
            <input id="f-tel" name="tel" type="tel" inputmode="tel" autocomplete="tel" placeholder="0470 12 34 56" aria-describedby="f-tel-h" />
            <p class="help" id="f-tel-h" data-help="Facultatif."></p>
          </div>
          <div class="field form__wide">
            <label for="f-message">Message *</label>
            <textarea id="f-message" name="message" rows="5" required aria-describedby="f-message-h"></textarea>
            <p class="help" id="f-message-h" data-help="Obligatoire."></p>
          </div>
        </div>
        {/* Hallmark · reworded "Les Terrasses du Prince" to "le restaurant" · le site d’origine cite une autre enseigne par erreur, texte de consentement à faire valider */}
        <div class="field field--check">
          <label class="check" for="f-consent"><input id="f-consent" type="checkbox" name="consentement" required aria-describedby="f-consent-h" /> Oui, je donne mon consentement *</label>
          <p class="help" id="f-consent-h" data-help=""></p>
        </div>
        <p class="small">En envoyant ce formulaire, vous acceptez que le restaurant mémorise et utilise les informations collectées afin de traiter votre demande.</p>
        <p><button class="btn" type="submit">Envoyer</button></p>
        <p class="form__status" role="status" aria-live="polite" data-status></p>
        <p class="small">Pour une réponse rapide, appelez le 081 23 14 26.</p>
      </form>
      <dl class="facts">
        <div><dt>Téléphone</dt><dd class="num"><a href={resto.telHref}>{resto.tel}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${resto.email}`}>{resto.email}</a></dd></div>
        <div><dt>Adresse</dt><dd>{resto.adresse1}<br />{resto.adresse2}<br /><a href={resto.maps}>Voir sur la carte</a></dd></div>
        <div><dt>Réseaux</dt><dd><a href={resto.facebook}>Facebook</a></dd></div>
      </dl>
    </div>
  </section>
</Base>
<script>
  // Validation : au blur d’un champ touché, puis à chaque saisie. Rien n’est posté (data-endpoint vide).
  const NBSP = '\u00a0';
  const messages: Record<string, string> = {
    prenom: 'Indiquez votre prénom.',
    nom: 'Indiquez votre nom.',
    email: 'Cette adresse semble incomplète. Écrivez-la sous la forme nom@exemple.be.',
    message: 'Écrivez votre message, même en une ligne.',
    consentement: 'Cochez la case pour que nous puissions traiter votre demande.',
  };
  document.querySelectorAll<HTMLFormElement>('form[data-endpoint]').forEach((form) => {
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea'));
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const help = document.getElementById(el.getAttribute('aria-describedby') ?? '');
      const ok = el.checkValidity();
      if (ok) el.removeAttribute('aria-invalid'); else el.setAttribute('aria-invalid', 'true');
      if (help) help.textContent = ok ? (help.dataset.help ?? '') : (messages[el.name] ?? 'Ce champ est incomplet.');
      return ok;
    };
    fields.forEach((el) => {
      el.addEventListener('blur', () => { el.dataset.touched = 'true'; check(el); });
      const live = () => { if (el.dataset.touched) check(el); };
      el.addEventListener('input', live);
      el.addEventListener('change', live);
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.textContent = '';
      status.removeAttribute('data-state');
      let first: HTMLInputElement | HTMLTextAreaElement | null = null;
      fields.forEach((el) => { el.dataset.touched = 'true'; if (!check(el) && !first) first = el; });
      if (first) { (first as HTMLElement).focus(); return; }
      if (!form.dataset.endpoint) {
        status.dataset.state = 'info';
        status.textContent = `Rien n’a été envoyé${NBSP}: ce formulaire n’est pas encore relié. Appelez le 081 23 14 26 ou écrivez à resto@champselysees.be.`;
      }
    });
  });
</script>
