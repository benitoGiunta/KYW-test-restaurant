---
import Base from '../layouts/Base.astro';
import { resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Champs Elysées" description="Cette page n’existe pas : retrouvez l’accueil, la carte ou la réservation de la brasserie Champs Elysées.">
  <section class="banner" aria-labelledby="h-404">
    <div class="container banner__in">
      <h1 id="h-404">Cette page n’existe pas</h1>
      <p class="lead">L’adresse a changé. La carte et la réservation sont toujours là.</p>
      <p class="actions"><a class="btn" href={resto.zenchef}>Réserver une table</a><a class="link" href={`${base}la-carte/`}>Voir la carte</a><a class="link" href={base}>Retour à l’accueil</a></p>
    </div>
  </section>
</Base>
