---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Horaires from '../components/Horaires.astro';
import { site, adresseLigne, telHref, photoDe } from '../data/site';
import { asset } from '../lib/url';
const salle = photoDe('/photos/terrasse.webp');
---
<Base title="Nous trouver" theme="aube" description={`Horaires, adresse et téléphone de ${site.nom}, ${adresseLigne()}.`}>
  <section class="section" data-ciel="aube">
    <div class="wrap cols">
      <div class="c1-6">
        <p data-reveal="fade" data-intro style="margin-bottom: calc(var(--u) * 2)"><Badge /></p>
        <h1 class="t-xl" data-split="lines" data-intro>Nous trouver</h1>
        <p class="lead" style="margin-top: calc(var(--u) * 2)">Rue des Fossés Fleuris, au centre historique de Namur. Aucun outil de réservation en ligne n’est connu. Téléphone, à confirmer :</p>
        <div class="actions" data-reveal="up" data-intro data-delay="0.3">
          <a class="btn btn--solid" href={telHref()} data-magnetic="0.2">Appeler le {site.telephone}</a>
          <a class="btn" href={`https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lon}#map=18/${site.geo.lat}/${site.geo.lon}`} rel="noopener">Itinéraire</a>
        </div>
        <p class="note" style="margin-top: var(--u)">Numéro <span class="tag">à confirmer</span> : le dossier du restaurant ne le garantit pas.</p>
      </div>
      <div class="c8-12" data-reveal="up" data-intro data-delay="0.2">
        <p class="chapeau">Horaires<span class="tag">à confirmer</span></p>
        <Horaires />
        <p class="note" style="margin-top: calc(var(--u) * 2)"><strong>Adresse</strong><br />{adresseLigne()}</p>
      </div>
    </div>
  </section>

  <section class="section" data-ciel="midi">
    <div class="wrap cols">
      <div class="c1-6">
        <p class="chapeau">Bon à savoir</p>
        <h2 class="t-l" data-split="words">Avant de venir</h2>
        <ul class="lignes" style="margin-top: calc(var(--u) * 2)" data-reveal="up">
          <li class="ligne"><span class="ligne__nom">Terrasse</span><span class="ligne__detail">mentionnée par les sites d'avis</span></li>
          <li class="ligne"><span class="ligne__nom">Mardi étudiants</span><span class="ligne__detail">une boisson offerte avec un brunch</span></li>
          <li class="ligne"><span class="ligne__nom">Budget<span class="tag">indicatif</span></span><span class="ligne__detail">20 à 30 € par personne selon Restaurant Guru</span></li>
        </ul>
      </div>
      <figure class="c8-12 photo photo--4x5" data-reveal="scale">
        <img src={asset(salle.src)} alt={salle.alt} width={salle.largeur} height={salle.hauteur} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</Base>
