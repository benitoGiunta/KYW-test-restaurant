---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Icone from '../components/Icone.astro';
import Horaires from '../components/Horaires.astro';
import { site, moments, mardiEtudiants, photoDe } from '../data/site';
import { u, asset } from '../lib/url';

const icones = ['tasse', 'assiette', 'couverts', 'verre', 'cloche'];
const m = Object.fromEntries(moments.map((x) => [x.id, x]));
const cafe = m['m-9h'], brunch = m['m-10h30'], dej = m['m-12h'], gouter = m['m-14h'], fin = m['m-16h'];
const photoAstre = photoDe('/photos/tasse-rouge.webp');
const photoCafe = photoDe(cafe.photo!), photoDej = photoDe(dej.photo!), photoGouter = photoDe(gouter.photo!);
const medaillons = [
  { photo: photoDe('/photos/yaourt-fraises.webp'), titre: 'Granola et fruits', texte: '', placeholder: true },
  { photo: photoDe('/photos/miel.webp'), titre: 'Miel', texte: '', placeholder: true },
  { photo: photoDe('/photos/the-citron.webp'), titre: 'Thé au citron', texte: '', placeholder: true },
];
---
<Base theme="aube">
  <div data-accueil>
    <!-- HERO : cadran réglé à l'heure réelle. Le nom et l'accroche sont peints au premier rendu (LCP). -->
    <section class="hero" id="accueil" data-ciel="auto" aria-labelledby="titre">
      <figure class="hero__astre" data-astre>
        <span class="hero__orbite" data-astre-orbite aria-hidden="true"><span class="hero__soleil"></span></span>
        <span class="hero__repere hero__repere--g" aria-hidden="true">9h</span>
        <span class="hero__repere hero__repere--d" aria-hidden="true">16h</span>
        <span class="hero__photo"><img src={asset(photoAstre.src)} alt={photoAstre.alt} width={photoAstre.largeur} height={photoAstre.hauteur} fetchpriority="high" decoding="async" data-astre-img /></span>
        
      </figure>
      <div class="wrap">
        <div class="hero__haut">
          <Badge />
          <div class="horloge" role="group" aria-label="Heure locale">
            <svg class="horloge__ring" viewBox="0 0 36 36" aria-hidden="true"><circle class="fond" cx="18" cy="18" r="15.9" /><circle class="cran" cx="18" cy="18" r="15.9" pathLength="100" data-horloge-ring /></svg>
            <span class="horloge__hm num" data-horloge-hm>09:00</span>
            <span class="horloge__s num" data-horloge-s aria-hidden="true"></span>
          </div>
        </div>
        <h1 class="hero__nom t-mega" id="titre">Café<br />Fleuri</h1>
        <p class="hero__baseline lead">Café-brunch à Namur, rue des Fossés Fleuris : un café le matin, le brunch salé, sucré ou mixte, une limonade maison l’après-midi.</p>
        <ul class="chips" data-reveal="up" data-intro data-delay="0.35" aria-label="Les moments de la journée">
          {moments.map((x, i) => (
            <li><a class="chip" href={`#${x.id}`} data-chip={x.id}><Icone nom={icones[i]} /><span class="chip__h">{x.heureTexte}</span><span class="chip__t">{x.titre}</span></a></li>
          ))}
        </ul>
        <p class="maintenant" data-maintenant hidden>
          <a class="maintenant__lien" href="#accueil" data-maintenant-lien><span class="maintenant__point" aria-hidden="true"></span><span data-maintenant-texte>Aller au moment présent</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></a>
        </p>
      </div>
    </section>

    <!-- 9h CAFÉ : split texte | photo. -->
    <section class="moment moment--split" id={cafe.id} data-ciel={cafe.theme} aria-labelledby="t-9h">
      <div class="wrap cols">
        <div class="c1-6">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{cafe.heureTexte}</p>
            <h2 class="moment__titre" id="t-9h" data-split="words">{cafe.titre}</h2>
          </div>
          <p class="moment__accroche" data-reveal="fade">{cafe.accroche}</p>
          <ul class="lignes" data-reveal="up">
            {cafe.lignes.map((l) => (
              <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
            ))}
          </ul>
        </div>
        <figure class="c8-12 photo photo--4x5" data-reveal="clip">
          <img src={asset(photoCafe.src)} alt={photoCafe.alt} width={photoCafe.largeur} height={photoCafe.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
        </figure>
      </div>
    </section>

    <!-- 9h BRUNCH : médaillons ronds à titre courbé. -->
    <section class="moment" id={brunch.id} data-ciel={brunch.theme} aria-labelledby="t-10h30">
      <div class="wrap">
        <div class="moment__tete">
          <p class="moment__heure num" data-split="chars">{brunch.heureTexte}</p>
          <h2 class="moment__titre" id="t-10h30" data-split="words">{brunch.titre}</h2>
        </div>
        <div class="cols">
          <p class="c1-6 moment__accroche">{brunch.accroche}</p>
          <ul class="c1-10 medaillons" data-medaillons tabindex="0" aria-label="Photos libres du brunch">
            {medaillons.map((md, i) => (
              <li>
                <div class="medaillon">
                  <div class="medaillon__photo"><img src={asset(md.photo.src)} alt={md.photo.alt} width={md.photo.largeur} height={md.photo.hauteur} loading="lazy" decoding="async" /></div>
                  <svg class="medaillon__anneau" viewBox="0 0 200 200" aria-hidden="true">
                    <defs><path id={`arc-${i}`} d="M100,100 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0" /></defs>
                    <text><textPath href={`#arc-${i}`} startOffset="0">{md.titre} · {md.titre} ·</textPath></text>
                  </svg>
                </div>
                <p class="medaillon__legende"><b>{md.titre}</b>{md.texte}</p>
              </li>
            ))}
          </ul>
          <div class="c1-6">
            <ul class="lignes" data-reveal="up">
              {brunch.lignes.map((l) => (
                <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
              ))}
            </ul>
            <p class="actions"><a class="fleche" href={u('/brunch/')}>Tout le brunch <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 12h DÉJEUNER : liste index, un plat par jour. -->
    <section class="moment" id={dej.id} data-ciel={dej.theme} aria-labelledby="t-12h">
      <div class="wrap cols">
        <div class="c1-5">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{dej.heureTexte}</p>
            <h2 class="moment__titre" id="t-12h" data-split="words">{dej.titre}</h2>
          </div>
          <p class="moment__accroche" data-reveal="fade">{dej.accroche}</p>
          <ul class="lignes" data-reveal="up">
            {dej.lignes.map((l) => (
              <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
            ))}
          </ul>
          <div class="actions"><a class="btn" href={u('/carte/')}>Toute la carte</a></div>
        </div>
        <div class="c7-12">
          <figure class="photo photo--4x5" data-reveal="clip"><img src={asset(photoDej.src)} alt={photoDej.alt} width={photoDej.largeur} height={photoDej.hauteur} loading="lazy" decoding="async" data-parallax="0.08" /></figure>
        </div>
      </div>
    </section>

    <!-- 14h GOÛTER : bande de cartes, ciel corail. -->
    <section class="moment" id={gouter.id} data-ciel={gouter.theme} aria-labelledby="t-14h">
      <div class="wrap">
        <div class="moment__tete">
          <p class="moment__heure num" data-split="chars">{gouter.heureTexte}</p>
          <h2 class="moment__titre" id="t-14h" data-split="words">{gouter.titre}</h2>
        </div>
        <div class="cols" style="margin-bottom: calc(var(--u) * 3)">
          <p class="c1-6 moment__accroche" style="margin-bottom: 0">{gouter.accroche}</p>
          <p class="c8-12" data-reveal="fade"><span class="happy"><Icone nom="verre" />{mardiEtudiants}</span></p>
        </div>
        <ul class="bande lignes" data-reveal="up" tabindex="0" aria-label="Cartes du goûter, défilables">
          <li class="carte-apero carte-apero--photo"><img src={asset(photoGouter.src)} alt={photoGouter.alt} width={photoGouter.largeur} height={photoGouter.hauteur} loading="lazy" decoding="async" /></li>
          {gouter.lignes.map((l) => (
            <li class="carte-apero">
              <p class="carte-apero__nom">{l.nom}</p>
              <p>{l.detail && <span class="t-s muted">{l.detail}<br /></span>}{l.prix && <span class="carte-apero__prix">{l.prix}</span>}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 16h FERMETURE : statement + horaires à flèches, lune sur la frise. -->
    <section class="moment" id={fin.id} data-ciel={fin.theme} aria-labelledby="t-16h">
      <div class="wrap cols">
        <div class="c1-6">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{fin.heureTexte}</p>
            <h2 class="moment__titre" id="t-16h" data-split="words">{fin.titre}</h2>
          </div>
          <p class="statement" data-split="lines">{fin.accroche}</p>
          <ul class="lignes" style="margin-top: calc(var(--u) * 4); max-width: 28rem" data-reveal="up">
            {fin.lignes.map((l) => (
              <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
            ))}
          </ul>
        </div>
        <div class="c8-12" data-reveal="up">
          <p class="chapeau">Horaires de la semaine</p>
          <Horaires />
          <div class="actions">
            <a class="btn btn--soleil" href={u('/reservation/')}>Horaires et contact</a>
            <a class="btn" href={`https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lon}#map=18/${site.geo.lat}/${site.geo.lon}`} rel="noopener">Itinéraire</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
