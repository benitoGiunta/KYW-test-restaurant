---
import Base from '../layouts/Base.astro';
import { site, moments, mardiEtudiants, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const brunch = moments.find((m) => m.id === 'm-10h30')!;
const plats = [
  { photo: photoDe('/photos/yaourt-fraises.webp'), titre: 'Granola et fruits', texte: 'Photo libre, assiette non attribuée', placeholder: true },
  { photo: photoDe('/photos/framboises.webp'), titre: 'Framboises', texte: 'Photo libre, pour la limonade maison', placeholder: true },
  { photo: photoDe('/photos/miel.webp'), titre: 'Miel', texte: 'Photo libre, produit non attribué', placeholder: true },
  { photo: photoDe('/photos/the-citron.webp'), titre: 'Thé au citron', texte: 'Photo libre, boisson non attribuée', placeholder: true },
];
const salle = photoDe('/photos/salle.webp');
const terrasse = photoDe('/photos/terrasse.webp');
---
<Base title="Le brunch" theme="midi" description={`Le brunch de ${site.nom} à ${site.adresse.commune} : salé, sucré ou mixte, gravlax et granola maison, limonades et thé glacé maison.`}>
  <section class="section" data-ciel="midi">
    <div class="wrap cols">
      <div class="c1-6">
        <p class="chapeau">Tous les jours, dès 10h30<span class="tag">horaire illustratif</span></p>
        <h1 class="t-xl" data-split="lines" data-intro>Le brunch</h1>
        <p class="lead" style="margin-top: calc(var(--u) * 2)">{brunch.accroche}</p>
        <p class="note" style="margin-top: var(--u)">{mardiEtudiants}</p>
        <div class="actions" data-reveal="up" data-intro data-delay="0.3">
          <a class="btn btn--solid" href={u('/reservation/')} data-magnetic="0.2">Horaires et contact</a>
          <a class="btn" href={u('/carte/')}>Toute la carte</a>
        </div>
      </div>
      <figure class="c8-12 photo photo--4x5">
        <img src={asset(salle.src)} alt={salle.alt} width={salle.largeur} height={salle.hauteur} data-critical fetchpriority="high" data-parallax="0.08" />
      </figure>
    </div>
  </section>

  <section class="section" data-ciel="ocre">
    <div class="wrap">
      <div class="section__head">
        <p class="chapeau">Les assiettes<span class="tag">photos libres</span></p>
        <h2 class="t-xl" data-split="words">Salé, sucré, mixte</h2>
      </div>
      <ul class="medaillons" data-medaillons tabindex="0" aria-label="Photos d'ambiance du brunch" style="grid-template-columns: repeat(4, minmax(0, 1fr))">
        {plats.map((md, i) => (
          <li>
            <div class="medaillon">
              <div class="medaillon__photo"><img src={asset(md.photo.src)} alt={md.photo.alt} width={md.photo.largeur} height={md.photo.hauteur} loading="lazy" decoding="async" /></div>
              <svg class="medaillon__anneau" viewBox="0 0 200 200" aria-hidden="true">
                <defs><path id={`barc-${i}`} d="M100,100 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0" /></defs>
                <text><textPath href={`#barc-${i}`}>{md.titre} · photo libre · {md.titre} · photo libre ·</textPath></text>
              </svg>
            </div>
            <p class="medaillon__legende"><b>{md.titre}</b>{md.texte}{md.placeholder ? <span class="tag">illustratif</span> : null}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" data-ciel="aube">
    <div class="wrap cols">
      <div class="c1-6">
        <p class="chapeau">Les trois brunchs</p>
        <h2 class="t-l" data-split="words">Un brunch, trois humeurs</h2>
        <ul class="lignes" style="margin-top: calc(var(--u) * 2)" data-reveal="up">
          {brunch.lignes.map((l) => (
            <li class="ligne"><span class="ligne__nom">{l.nom}{l.placeholder ? <span class="tag">prix à confirmer</span> : null}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
          ))}
        </ul>
      </div>
      <figure class="c8-12 photo photo--4x3" data-reveal="scale">
        <img src={asset(terrasse.src)} alt={terrasse.alt} width={terrasse.largeur} height={terrasse.hauteur} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</Base>
