---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { site, horaires, services } from '../data/site';
const midi = horaires.filter((h) => h.midi).map((h) => h.jour.toLowerCase());
const soir = horaires.filter((h) => h.soir).map((h) => h.jour.toLowerCase());
---
<footer class="pied table-grille">
  <div class="pied__g">
    <p class="pied__titre">Venir</p>
    <address>
      {site.adresse.rue} {site.adresse.numero}<br />
      {site.adresse.cp} {site.adresse.commune}<br />
      <span class="pied__doux">Piétonnier, {site.adresse.repere}</span>
    </address>
    <p><a class="lien" href={site.carteUrl} rel="noopener">Ouvrir le plan</a></p>
  </div>
  <div class="pied__milieu chemin">
    <a class="cta cta--chemin" href={u('/reservation/')}><span class="cta__txt">Réserver</span></a>
    <a class="pied__tel" href={site.telephoneHref}>{site.telephoneLisible}</a>
  </div>
  <div class="pied__d">
    <p class="pied__titre">Service</p>
    <p class="chiffres">Midi, {services.midi.lisible} : du {midi[0]} au {midi[midi.length - 1]}<br />
      Soir, {services.soir.lisible} : du {soir[0]} au {soir[soir.length - 1]}<br />
      <span class="pied__doux">Fermé le dimanche et le lundi</span></p>
    <ul class="pied__reseaux">
      {site.reseaux.map((r) => <li><a class="lien" href={r.url} rel="noopener">{r.nom}</a></li>)}
    </ul>
  </div>
  <p class="pied__mot" aria-hidden="true"><span>PAR</span><span>TAGE</span></p>
  <p class="pied__colophon">Photos : Partage. Polices : Panchang et General Sans (Indian Type Foundry, Fontshare). Construit avec Astro, GSAP et Lenis.</p>
</footer>
<KywFooter base={import.meta.env.BASE_URL} />
