---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { lunch, euros } from '../data/site';
import { cuisine, boissons } from '../data/carte';
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const intro: Record<string, string> = {
  Starters: 'Pour ouvrir, au milieu, avant même de choisir.',
  'Entrées': 'À partager à deux ou à quatre.',
  Plats: 'Le plat se coupe à table et fait le tour.',
  Desserts: 'Une cuillère chacun, ou deux.',
};
const moitie = Math.ceil(boissons.length / 2);
const prixBoisson = (p: { prix?: number; bouteille?: number; prixTexte?: string }) =>
  p.prixTexte ?? (p.bouteille ? `${euros(p.prix!)} · ${euros(p.bouteille)}` : euros(p.prix!));
---
<Base title="La carte" page="carte" description="La carte de Partage à Namur : starters, entrées, plats et desserts à partager, le lunch à 38 € du midi, vins au verre et boissons, avec tous les prix.">
  <section class="page-tete table-grille">
    <h1 class="display"><span class="g">La</span><span class="fente" aria-hidden="true"></span><span class="d">carte</span></h1>
    <div class="page-tete__g"><p class="chapo">Tout se commande pour la table. Les prix sont posés au milieu, comme les plats.</p></div>
    <div class="page-tete__d"><p class="doux">Carte du 28 septembre 2026. Elle change avec les saisons : la salle vous dira ce qui arrive ce soir.</p></div>
  </section>

  <nav class="ancres table-grille" aria-label="Rubriques de la carte">
    <ul>
      {cuisine.map((c) => <li><a class="nl" href={`#${slug(c.categorie)}`}>{c.categorie}</a></li>)}
      <li><a class="nl" href="#lunch">Lunch</a></li>
      <li><a class="nl" href="#boissons">Boissons</a></li>
    </ul>
  </nav>

  {cuisine.map((c) => (
    <section class="categorie table-grille" id={slug(c.categorie)} aria-labelledby={`t-${slug(c.categorie)}`}>
      <div class="categorie__titre">
        <h2 class="titre-l" id={`t-${slug(c.categorie)}`}>{c.categorie}</h2>
        <p class="doux">{intro[c.categorie]}</p>
      </div>
      <ul class="plats">
        {c.plats.map((p) => (
          <li class="plat">
            <h3 class="plat__nom">{p.nom}</h3>
            <p class="plat__prix">{euros(p.prix!)}</p>
            <p class="plat__desc">{p.description ?? ''}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="lunch table-grille" id="lunch" aria-labelledby="titre-lunch">
    <div class="lunch__titre">
      <h2 id="titre-lunch" class="titre-l">Lunch</h2>
      <p class="doux">{lunch.regle} Menu du {lunch.date}, il change chaque semaine.</p>
    </div>
    <p class="lunch__prix chemin"><strong>{lunch.prix}&nbsp;€</strong><span>entrée, plat, dessert</span></p>
    <ul class="lunch__menu">
      {lunch.services.map((s) => (
        <li><span class="etiquette">{s.temps}</span><span>{s.plat}, <span class="doux">{s.detail}</span></span></li>
      ))}
      <li class="doux">{lunch.fromages}</li>
    </ul>
  </section>

  <section class="boissons table-grille" id="boissons" aria-labelledby="titre-boissons">
    <div class="boissons__tete">
      <h2 id="titre-boissons" class="titre-l">À boire</h2>
      <p class="doux">Vins au verre : prix du verre, puis de la bouteille.</p>
    </div>
    <div class="boissons__col boissons__col--g">
      {boissons.slice(0, moitie).map((b) => (
        <div class="boisson">
          <h3 class="titre-m">{b.categorie}</h3>
          <ul>{b.plats.map((p) => <li><span>{p.nom}{p.description ? `, ${p.description}` : ''}</span><span>{prixBoisson(p)}</span></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="boissons__col boissons__col--d">
      {boissons.slice(moitie).map((b) => (
        <div class="boisson">
          <h3 class="titre-m">{b.categorie}</h3>
          <ul>{b.plats.map((p) => <li><span>{p.nom}{p.description ? `, ${p.description}` : ''}</span><span>{prixBoisson(p)}</span></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="mur__fin"><a class="cta cta--plein" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a></div>
  </section>
</Base>
