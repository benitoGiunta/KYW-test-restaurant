---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" page="perdu" description="Cette page de Partage n’existe pas. Revenez à l’accueil, à la carte du bistro ou à la réservation d’une table dans le piétonnier de Namur.">
  <section class="perdu table-grille">
    <p class="perdu__mot display" aria-hidden="true"><span data-mot="Par"></span><span data-mot="tage"></span></p>
    <p class="perdu__vide" aria-hidden="true">rien ici</p>
    <div class="perdu__texte">
      <h1 class="titre-l">Il n’y a rien au milieu de la table</h1>
      <p class="doux texte">Cette page n’existe pas, ou elle a été débarrassée. Le reste du repas vous attend.</p>
      <a class="cta cta--plein" href={u('/')}><span class="cta__txt">Revenir à l’accueil</span></a>
      <a class="lien" href={u('/carte/')}>Lire la carte</a>
    </div>
  </section>
</Base>
