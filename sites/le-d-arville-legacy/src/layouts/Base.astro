---
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import KywFooter from '@kyw/footer';
import '../styles/page.css';
import { resto } from '../data/site';
interface Props { title: string; description: string; page: string; horaires?: boolean }
const { title, description, page, horaires = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, telephone: resto.tel.href, email: resto.email, servesCuisine: 'Gastronomique de saison',
  address: { '@type': 'PostalAddress', streetAddress: `${resto.adresse.rue} ${resto.adresse.numero}`, postalCode: resto.adresse.cp, addressLocality: 'Wierde', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0ebe3" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=sentient@300,400&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400&display=swap" rel="stylesheet" />
    {page !== '404' && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={page}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu"><slot /></main>
    <Pied horaires={horaires} />
    {page !== 'reservation' && (
      <div class="bar" role="region" aria-label="Réserver">
        <a class="btn" href={`${base}reservation/`}>Réserver</a>
        <a class="btn" href={`tel:${resto.tel.href}`}>Appeler</a>
      </div>
    )}
    <KywFooter base={base} />
    <script is:inline>
    (function () {
      try {
        var j = new Date().toLocaleDateString('fr-BE', { weekday: 'long', timeZone: 'Europe/Brussels' }).toLowerCase();
        document.querySelectorAll('.sched [data-jour]').forEach(function (r) { if (r.getAttribute('data-jour') === j) r.setAttribute('aria-current', 'date'); });
      } catch (e) {}
      var els = document.querySelectorAll('[data-reveal]');
      var show = function (el) { el.classList.add('is-in'); };
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) { els.forEach(show); return; }
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -10% 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
    </script>
  </body>
</html>
