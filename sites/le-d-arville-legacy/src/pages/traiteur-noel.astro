---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import { resto } from '../data/site';
---
<Base page="traiteur-noel" title="Traiteur de fêtes, Le D’Arville" description="Le service traiteur de fin d’année du restaurant Le D’Arville à Wierde.">
  <section class="pagehead">
    <div class="container">
      <h1>Traiteur de fêtes</h1>
      <p class="lead">Le service traiteur de fin d’année du D’Arville.</p>
    </div>
  </section>
  <section class="sec sec--tight">
    <div class="container split">
      <div class="split__a">
        <h2>La cuisine du restaurant, pour vos fêtes</h2>
        <p>Le restaurant propose un service traiteur pour les fêtes de fin d’année.</p>
        <p class="label">Carte et dates de commande : renseignements au +32 81 46 23 65.</p>
        <dl class="coords" style="margin-top: var(--space-lg)">
          <div><dt>Téléphone</dt><dd><a href={`tel:${resto.tel.href}`}>{resto.tel.affiche}</a></dd></div>
          <div><dt>Courriel</dt><dd><a href={`mailto:${resto.email}`}>{resto.email}</a></dd></div>
        </dl>
      </div>
      <div class="split__b">
        <Fig id="03-plat-dressage-sauce" sizes="(max-width: 60rem) 100vw, 40vw" ratio="4 / 5" cap="Une assiette dressée, la sauce versée à la cuillère." />
      </div>
    </div>
  </section>
</Base>
