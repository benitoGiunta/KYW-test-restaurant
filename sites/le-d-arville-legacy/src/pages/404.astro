---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Le D’Arville" description="Cette page n’existe pas.">
  <section class="pagehead">
    <div class="container">
      <h1>Cette page est introuvable</h1>
      <p class="lead">Retour à <a class="link" href={base}>l’accueil</a> ou à la <a class="link" href={`${base}carte/`}>carte</a>.</p>
    </div>
  </section>
</Base>
