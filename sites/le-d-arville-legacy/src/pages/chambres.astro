---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import { resto } from '../data/site';
const b = resto.barabas;
---
<Base page="chambres" title="Chambres, villa Barabas, Le D’Arville" description="Les suites et chambres à thèmes de la villa Barabas, à deux cents mètres du restaurant Le D’Arville : piscine chauffée et petit-déjeuner.">
  <section class="pagehead">
    <div class="container">
      <h1>Chambres, villa Barabas</h1>
      <p class="lead">Des suites et des chambres à thèmes, à deux cents mètres du restaurant.</p>
    </div>
  </section>
  <section class="sec sec--tight">
    <div class="container split">
      <div class="split__a">
        <h2>Cinq chambres, chacune son thème</h2>
        <ul class="idx" style="margin-top: var(--space-md)">
          <li><span class="t" style="display:block; padding-block: var(--space-md)">Suite Glamour</span></li>
          <li><span class="t" style="display:block; padding-block: var(--space-md)">Suite Orientale</span></li>
          <li><span class="t" style="display:block; padding-block: var(--space-md)">Suite à la française</span></li>
          <li><span class="t" style="display:block; padding-block: var(--space-md)">Chambre Zen</span></li>
          <li><span class="t" style="display:block; padding-block: var(--space-md)">Chambre Aux pommes</span></li>
        </ul>
        <p class="label"><span class="fill" data-fill="tarifs">Tarifs des chambres à confirmer</span></p>
      </div>
      <div class="split__b">
        <Fig id="18-barabas-suite-glamour" sizes="(max-width: 60rem) 100vw, 40vw" cap="La suite Glamour." />
      </div>
    </div>
  </section>
  <section class="sec sec--tint sec--tight">
    <div class="container split split--flip">
      <div class="split__a">
        <h2>Piscine, petit-déjeuner, room service</h2>
        <dl class="coords">
          <div><dt>Piscine</dt><dd>Chauffée</dd></div>
          <div><dt>Petit-déjeuner</dt><dd class="num">18&nbsp;€ par personne</dd></div>
          <div><dt>Room service</dt><dd>Jusqu’à 23&nbsp;h&nbsp;00</dd></div>
          <div><dt>Adresse</dt><dd>{b.rue}&nbsp;{b.numero}, {resto.adresse.cp} Wierde</dd></div>
        </dl>
        <p><a class="link" href={resto.facebookBarabas} rel="noopener">La Suite du D’Arville sur Facebook</a></p>
      </div>
      <div class="split__b">
        <Fig id="21-barabas-piscine" sizes="(max-width: 60rem) 100vw, 40vw" cap="La piscine extérieure." />
      </div>
    </div>
  </section>
  <section class="sec sec--tight">
    <div class="container gal">
      <Fig id="17-barabas-suite-orientale" sizes="(max-width: 40rem) 100vw, 58vw" cap="La suite Orientale." />
      <Fig id="22-barabas-chambre-rouge" sizes="(max-width: 40rem) 100vw, 42vw" cap="Une chambre à la tête de lit rouge." />
    </div>
  </section>
</Base>
