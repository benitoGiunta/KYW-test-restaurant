---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import { resto } from '../data/site';
---
<Base page="seminaires" title="Séminaires, villa Barabas, Le D’Arville" description="Séminaires et événements à la villa Barabas, à deux cents mètres du restaurant Le D’Arville à Wierde.">
  <section class="pagehead">
    <div class="container">
      <h1>Séminaires</h1>
      <p class="lead">Séminaires et événements à la villa Barabas, à deux cents mètres du restaurant.</p>
    </div>
  </section>
  <section class="sec sec--tight">
    <div class="container split">
      <div class="split__a">
        <h2>Un domaine de plus de cinq hectares</h2>
        <p>Le restaurant et la villa Barabas partagent une prairie. Les séminaires se tiennent à la villa ; la table se prend au restaurant.</p>
        <p class="label"><span class="fill" data-fill="seminaires">Capacités, équipement et tarifs à confirmer</span></p>
        <dl class="coords" style="margin-top: var(--space-lg)">
          <div><dt>Téléphone</dt><dd><a href={`tel:${resto.tel.href}`}>{resto.tel.affiche}</a></dd></div>
          <div><dt>Courriel</dt><dd><a href={`mailto:${resto.email}`}>{resto.email}</a></dd></div>
        </dl>
      </div>
      <div class="split__b">
        <Fig id="20-barabas-facade" sizes="(max-width: 60rem) 100vw, 40vw" cap="La façade de la villa Barabas." />
      </div>
    </div>
  </section>
</Base>
