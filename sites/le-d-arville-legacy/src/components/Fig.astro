---
import { photo } from '../data/site';
interface Props { id: string; sizes?: string; eager?: boolean; pos?: string; ratio?: string; cap?: string; class?: string; credit?: boolean }
const { id, sizes = '100vw', eager = false, pos = 'center', ratio, cap, class: cls = 'ph', credit = true } = Astro.props;
const p = photo(id);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const big = Math.min(p.w, 1600);
const style = `aspect-ratio: ${ratio ?? `${p.w} / ${p.h}`}`;
---
<figure class={cls}>
  <div data-slot={id} data-alt={p.alt} style={style} data-credits={credit ? 'Photo : Le D’Arville' : undefined}>
    <img
      src={`${base}photos/${id}-1600.webp`}
      srcset={`${base}photos/${id}-800.webp 800w, ${base}photos/${id}-1600.webp ${big}w`}
      sizes={sizes} width={p.w} height={p.h} alt={p.alt}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? 'sync' : 'async'}
      style={`object-position: ${pos}`}
    />
  </div>
  {cap && <figcaption>{cap}</figcaption>}
</figure>
