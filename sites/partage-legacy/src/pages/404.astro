---
import Base from '../layouts/Base.astro';
import { u } from '../data/site';
---
<Base page="404" title="Page introuvable · Partage, Namur"
  description="Cette adresse n’existe pas sur le site de Partage, à Namur.">
  <section class="tete-page tete-page--texte air" aria-labelledby="introuvable-titre">
    <div class="container">
      <h1 id="introuvable-titre">Cette page n’est pas à table</h1>
      <p class="lead">L’adresse demandée n’existe pas, ou plus. La carte et la réservation, elles, sont toujours là.</p>
      <p class="introuvable__actions"><a class="btn" href={u()}>Revenir à l’accueil</a> <a class="lien" href={u('carte/')}>Lire la carte</a></p>
    </div>
  </section>
</Base>
