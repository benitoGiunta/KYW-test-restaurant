---
// Horaires (Timetable du thème) : jours en Sentient 400, heures en chiffres tabulaires, jour fermé en muted.
import { horaires, fermeture } from '../data/site';
---
<div class="horaires">
  <table class="horaires__table ruled-table">
    <caption class="visually-hidden">Heures d’ouverture</caption>
    <thead class="visually-hidden"><tr><th scope="col">Jour</th><th scope="col">Midi</th><th scope="col">Soir</th></tr></thead>
    <tbody>
      {horaires.map((d) => (
        <tr data-jour={d.jour} class:list={[{ ferme: !d.midi && !d.soir }]}>
          <th scope="row">{d.nom}</th>
          {!d.midi && !d.soir
            ? <td colspan="2">Fermé</td>
            : <>
                <td class="num">{d.midi ? <time>{d.midi}</time> : <span class="muted">Midi fermé</span>}</td>
                <td class="num" data-placeholder={d.aConfirmer ? 'true' : undefined}><time>{d.soir}</time></td>
              </>}
        </tr>
      ))}
    </tbody>
  </table>
  <p class="horaires__note">{fermeture} Heures de service indicatives, à confirmer par téléphone.</p>
</div>
<script>
  const j = new Date().getDay();
  document.querySelector(`.horaires__table tr[data-jour="${j}"]`)?.classList.add('aujourdhui');
</script>
