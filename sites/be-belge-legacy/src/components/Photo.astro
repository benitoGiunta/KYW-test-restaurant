---
import type { Photo } from '../data/site';
interface Props { p: Photo; sizes?: string; hero?: boolean; label?: string; pos?: string; class?: string; ratio?: string }
const { p, sizes = '(min-width: 60rem) 50vw, 100vw', hero = false, label, pos = '50% 50%', ratio, class: cls = '' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<figure class:list={['ph', cls]} style={ratio ? `--ratio:${ratio}` : undefined}>
  <img src={`${b}photos/${p.src}-1600.webp`} srcset={`${b}photos/${p.src}-800.webp 800w, ${b}photos/${p.src}-1600.webp 1600w`} sizes={sizes}
    alt={p.alt} width={p.w} height={p.h} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : undefined} decoding="async" style={`object-position:${pos}`} />
  {label && <figcaption>{label}</figcaption>}
</figure>
