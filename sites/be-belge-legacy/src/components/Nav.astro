---
import { site, nav } from '../data/site';
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { here = '' } = Astro.props;
---
<header class="bar">
  <nav class="bar__in" aria-label="Navigation principale">
    <a class="mark" href={b} aria-label={`${site.nom}, accueil`}><span>{site.court}</span> <span class="mark__s">{site.suite}</span></a>
    <ul class="bar__links">
      {nav.map((n) => <li><a href={`${b}${n.href}`} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
    <button class="bar__toggle" type="button" popovertarget="menu-mobile" aria-label="Ouvrir le menu de navigation" aria-expanded="false" aria-controls="menu-mobile">
      <span class="bar__toggle-t">Menu</span>
      <svg viewBox="0 0 18 12" width="18" height="12" aria-hidden="true" focusable="false"><path d="M0 1h18M0 6h18M0 11h18" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
    <a class="btn btn--fill btn--bar" href={`${b}reservation/`}>Réserver</a>
  </nav>
  <div id="menu-mobile" popover="auto" class="sheet" aria-label="Menu de navigation">
    <ul>
      {nav.map((n) => <li><a href={`${b}${n.href}`} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      <li><a href={site.telHref}>Appeler, {site.telAffiche}</a></li>
    </ul>
  </div>
</header>
<script is:inline>
  (() => {
    const sheet = document.getElementById('menu-mobile');
    if (!sheet) return;
    if (!('popover' in HTMLElement.prototype)) { document.documentElement.classList.add('no-popover'); return; }
    const btn = document.querySelector('.bar__toggle');
    sheet.addEventListener('toggle', (e) => {
      const open = e.newState === 'open';
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fermer le menu de navigation' : 'Ouvrir le menu de navigation');
      btn.querySelector('.bar__toggle-t').textContent = open ? 'Fermer' : 'Menu';
    });
    sheet.addEventListener('click', (e) => { if (e.target.closest('a')) sheet.hidePopover(); });
    matchMedia('(min-width: 60.01rem)').addEventListener('change', (m) => { if (m.matches && sheet.matches(':popover-open')) sheet.hidePopover(); });
  })();
</script>
