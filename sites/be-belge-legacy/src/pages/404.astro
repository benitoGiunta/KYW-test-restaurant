---
import Base from '../layouts/Base.astro';
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable, Be Belge… et d’ailleurs">
  <section class="sec page-head"><div class="container"><p class="pencil">Erreur 404</p><h1>Cette page n’existe pas.</h1><p><a class="btn btn--fill" href={b}>Retour à l’accueil</a></p></div></section>
</Base>
