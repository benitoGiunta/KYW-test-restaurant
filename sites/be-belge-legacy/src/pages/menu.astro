---
import Base from '../layouts/Base.astro';
import Formules from '../components/Formules.astro';
import Rows from '../components/Rows.astro';
import Photo from '../components/Photo.astro';
import { photos, periode } from '../data/site';
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Menu du Chef, Be Belge… et d’ailleurs" description="Le Menu du Chef de Be Belge… et d’ailleurs à Wépion : 3 services à 57 €, 4 services à 72 €, vins en option." here="menu/">
  <section class="sec page-head">
    <div class="container two">
      <div>
        <p class="pencil">Menu</p>
        <h1>Le Menu du Chef</h1>
        <p class="lead">Dernier menu publié, {periode}.</p>
      </div>
      <Formules id="menu" />
    </div>
  </section>
  <section class="sec"><div class="container menu-page"><Rows /><Photo p={photos.buffet} sizes="(min-width: 60rem) 36vw, 100vw" label="Le buffet de la salle" ratio="4/5" /></div></section>
  <section class="sec sec--alt"><div class="container cta"><p class="big">À table ?</p><a class="btn btn--fill" href={`${b}reservation/`}>Réserver</a></div></section>
</Base>
