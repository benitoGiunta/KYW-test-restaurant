---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Réserver, Be Belge… et d’ailleurs" description="Réserver une table à Be Belge… et d’ailleurs, Wépion : réservation en ligne ou par téléphone." here="reservation/">
  <section class="sec page-head">
    <div class="container two">
      <div>
        <p class="pencil">Réservation</p>
        <h1>Réserver une table</h1>
        <p class="lead">Mercredi et dimanche à midi, jeudi et vendredi à midi et le soir, samedi le soir.</p>
        <p class="wall">Une question ? <a href={site.telHref}>{site.telAffiche}</a> ou <a href={`mailto:${site.mail}`}>{site.mail}</a>.</p>
      </div>
      <div class="stock book">
        <iframe src={site.zenchef} title="Réservation en ligne, Zenchef" loading="lazy" width="100%" height="630"></iframe>
        <p class="muted">Le formulaire s’affiche grâce à Zenchef. <a href={site.zenchef} rel="noopener">L’ouvrir dans un nouvel onglet</a>.</p>
      </div>
    </div>
  </section>
</Base>
