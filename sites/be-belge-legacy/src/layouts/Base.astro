---
import '../styles/page.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, jours } from '../data/site';
interface Props { title: string; description?: string; here?: string }
const b0 = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const EN = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const ogImage = `${b0}photos/02-facade-jardin-1600.webp`;
const ld = {
  '@context': 'https://schema.org', '@type': 'Restaurant', name: site.nom, description: site.description,
  telephone: site.tel, email: site.mail, servesCuisine: ['Belge', 'De saison'], url: Astro.site ? new URL(b0, Astro.site).href : undefined,
  image: Astro.site ? new URL(ogImage, Astro.site).href : ogImage,
  address: { '@type': 'PostalAddress', streetAddress: site.adresse.rue, postalCode: '5000', addressLocality: 'Namur (Wépion)', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: 50.4517812, longitude: 4.8421921 },
  openingHoursSpecification: jours.flatMap((j, i) => j.services.map((sv) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: EN[i], opens: sv[0], closes: sv[1] }))),
  sameAs: [site.facebook],
};
const { title, description = site.description, here = '' } = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f1ede6" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={Astro.site ? new URL(ogImage, Astro.site).href : ogImage} />
  <meta property="og:image:alt" content="Pelouse et bâtiment du restaurant vus du jardin" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%232b4a6e'/%3E%3Ctext x='16' y='23' font-size='20' text-anchor='middle' font-family='serif' fill='%23f1ede6'%3EB%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://api.fontshare.com/v2/css?f[]=sentient@300,400&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <Nav here={here} />
  <main id="contenu"><slot /></main>
  <Footer />
  <script is:inline>
    (() => {
      const els = [...document.querySelectorAll('[data-reveal]')];
      if (!els.length) return;
      const show = (el) => el.classList.add('is-in');
      if (!('IntersectionObserver' in window)) { els.forEach(show); return; }
      const io = new IntersectionObserver((entries) => entries.forEach((en) => { if (en.isIntersecting) { show(en.target); io.unobserve(en.target); } }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      els.forEach((el) => io.observe(el));
      addEventListener('beforeprint', () => els.forEach(show));
    })();
  </script>
</body>
</html>
<style is:global>html, body { overflow-x: clip; }</style>
