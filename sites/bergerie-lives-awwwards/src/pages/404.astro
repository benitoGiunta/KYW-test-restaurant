---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base titre="Page introuvable" description="Cette barrière ne s’ouvre sur rien : la page demandée n’existe pas sur le site de la Bergerie de Lives.">
  <section class="sec final err">
    <div class="wrap final__grille">
      <h1 class="display final__titre" data-split="lines" data-intro>Cette barrière ne s’ouvre sur rien.</h1>
      <p class="final__texte">La page demandée n’existe pas dans l’enclos. Revenez à l’entrée du domaine.</p>
      <p><a class="bouton bouton--grand" href={u('/')}>Retour à l’entrée</a></p>
    </div>
  </section>
</Base>
