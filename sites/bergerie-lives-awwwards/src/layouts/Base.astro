---
import { ClientRouter } from 'astro:transitions';
import { restaurant, services } from '../data/site';
import { asset, u } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';
interface Props { titre?: string; description?: string; }
const { titre, description = restaurant.description } = Astro.props;
const fullTitle = titre ? `${titre} | ${restaurant.nom}` : `${restaurant.nom} | Maison d’hôtes et domaine de mariage à Namur`;
const siteUrl = Astro.site ?? new URL('https://kyw-test-restaurant.vercel.app');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(asset('/og.png'), siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: restaurant.nom,
  description: restaurant.description,
  url: new URL(u('/'), siteUrl).href,
  telephone: restaurant.telephone,
  email: restaurant.email,
  image: ogImage,
  address: { '@type': 'PostalAddress', streetAddress: restaurant.adresse.rue, postalCode: restaurant.adresse.cp, addressLocality: `${restaurant.adresse.localite}, ${restaurant.adresse.commune}`, addressCountry: 'BE' },
  amenityFeature: services.map((s) => ({ '@type': 'LocationFeatureSpecification', name: s.nom, value: true })),
  sameAs: [restaurant.siteActuel],
};
---
<!doctype html>
<html lang="fr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#17201a" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={restaurant.nom} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" as="font" type="font/woff2" href={asset('/fonts/young-serif-400-normal.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={asset('/fonts/hanken-400_700-normal.woff2')} crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"></div></div>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
