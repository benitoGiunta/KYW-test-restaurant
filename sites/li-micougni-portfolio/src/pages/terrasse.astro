---
// Terrasse et événements : la cour privée (30 couverts, toute l'année) et la privatisation viennent du site actuel (dossier.md).
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g, photoDe, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const photos = ['/photos/terrasse.webp', '/photos/grill-charbon.webp', '/photos/salle-fenetres.webp'].map(photoDe);
---
<Base title="Terrasse et évènements" description={`La terrasse de ${site.nom} à ${site.adresse.commune} : une cour privée de 30 couverts, ouverte toute l'année, et la privatisation du lieu.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse</h1>
      <p class="lead">{g.terrasse.texte}</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">La cour, <em class="ital">toute l'année</em></h2>
      <ul role="list" style="display:flex;flex-wrap:wrap;gap:0.6em;justify-content:center;margin-top:calc(var(--u)*3)">
        {g.terrasse.points.map((t) => <li class="vege" style="font-size:var(--t-s);padding:0.4em 1em">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section__titre">Privatiser <em>le lieu</em></h2>
      <div class="maison__grille">
        <div class="prose">
          <p>{g.terrasse.privatisation}</p>
          <p>Pour en parler, appelez le restaurant au <a class="link" href={telHref()}>{site.telephone}</a> ou écrivez à <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
        </div>
        <div class="grille-photos">
          {photos.map((p, i) => (
            <figure class="tirage" style={`--r:${[-4, 3, -2][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
              <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
              <figcaption>{p.alt.split(',')[0]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
