---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import '../styles/page.css';
import { resto } from '../data/site';
interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CafeOrCoffeeShop', name: resto.nom, telephone: '+3281658915', openingHours: 'Mo-Su 09:00-16:00', servesCuisine: 'Café, brunch, pâtisserie maison',
  address: { '@type': 'PostalAddress', streetAddress: 'Rue des Fossés Fleuris 38', postalCode: '5000', addressLocality: 'Namur', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b5a33" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gabarito:wght@800&family=Manrope:wght@500;700&display=swap" rel="stylesheet" />
    {page !== '404' && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={page}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu"><slot /></main>
    <Footer />
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
    document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <script>
      // La barre d'appel (téléphone) s'efface quand un bouton Appeler de la page est déjà à l'écran.
      const bar = document.querySelector<HTMLElement>('[data-bar]');
      const cibles = document.querySelectorAll('main a.btn[href^="tel:"]');
      if (bar && cibles.length && 'IntersectionObserver' in window) {
        const visibles = new Set<Element>();
        const io = new IntersectionObserver((es) => {
          es.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
          const away = visibles.size > 0;
          bar.classList.toggle('is-away', away);
          bar.toggleAttribute('inert', away);
        });
        cibles.forEach((c) => io.observe(c));
      }
      // Copier le numéro : état par le texte (pas de toast), bouton désactivé si le presse-papiers manque.
      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((root) => {
        const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
        const msg = root.querySelector<HTMLElement>('[data-copy-msg]');
        if (!btn || !msg) return;
        const txt = root.dataset.copy ?? '';
        if (!navigator.clipboard) { btn.disabled = true; msg.textContent = `Copie indisponible ici : notez ${txt}.`; return; }
        btn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(txt); msg.textContent = `Numéro copié : ${txt}.`; }
          catch { msg.textContent = `Copie refusée : notez ${txt}.`; }
        });
      });
    </script>
    <KywFooter base={base} />
  </body>
</html>
<style is:global>
  html { overflow-x: clip; }
  body { overflow-x: clip; }
</style>
