---
import { resto, horaires } from '../data/site';
const { adresse: a } = resto;
---
<div class="colophon" role="group" aria-label="Coordonnées" data-credits="">
  <div class="container colophon__in">
    <p class="colophon__name">Café Fleuri</p>
    <p class="colophon__txt">{a.rue} {a.numero}, {a.cp} {a.commune}. {horaires.jours}, {horaires.plage}. Téléphone <a href={`tel:${resto.tel.href}`}>{resto.tel.affiche}</a>.</p>
  </div>
</div>
<div class="bar" data-bar role="region" aria-label="Appeler le café">
  <p class="bar__txt">{a.rue} {a.numero}, {a.commune}</p>
  <a class="btn btn--bar" href={`tel:${resto.tel.href}`}>Appeler</a>
</div>
