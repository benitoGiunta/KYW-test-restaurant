---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, valeurs, offres } from '../data/site';
---
<Base page="a-propos" title="À propos" description="Novobel est une entreprise familiale de construction et de rénovation à Namur. Son approche, ses valeurs et les postes ouverts.">
  <header class="entete wrap">
    <p class="cote" aria-hidden="true"><span class="cote__val">À propos</span></p>
    <h1 class="titre-xl display" data-split="lines" data-intro>Rénover, c’est d’abord s’engager</h1>
  </header>

  <section class="histoire wrap" aria-label="Qui est Novobel">
    <div class="histoire__texte">
      <p>Novobel est une société namuroise de construction et de rénovation, installée rue Emile Cuvelier. Elle accompagne chaque projet de l’étude jusqu’à la remise des clés : rénovation complète, gros œuvre, finitions et installations techniques.</p>
      <p>Son approche est familiale et son principe est simple : la qualité avant tout. Elle met en avant la proximité avec le client et le respect des délais.</p>
    </div>
    <figure class="histoire__media" data-reveal><Photo cle="combles" widths={[480, 800, 1200]} sizes="(min-width: 900px) 46vw, 100vw" /><figcaption class="legende">Image d’illustration</figcaption></figure>
  </section>

  <section class="valeurs wrap" aria-labelledby="h-val">
    <p class="cote" aria-hidden="true"><span class="cote__val">Trois principes</span></p>
    <h2 class="titre-l display" id="h-val" data-split="lines">Ce qui guide le chantier</h2>
    <ul class="valeurs__liste">
      {valeurs.map((v) => <li class="display">{v}</li>)}
    </ul>
  </section>

  <section class="rejoindre nuit" aria-labelledby="h-rej">
    <div class="wrap rejoindre__grille">
      <div>
        <p class="cote cote--nuit" aria-hidden="true"><span class="cote__val">Carrière</span></p>
        <h2 class="titre-l display" id="h-rej" data-split="lines">Rejoindre l’équipe</h2>
        <p>Novobel publie actuellement six offres sur son site. Les offres sont à consulter sur la page carrière.</p>
        <p><a class="cta cta--jaune" href={site.carriereUrl} rel="noopener"><span class="cta__txt">Voir les offres</span></a></p>
      </div>
      <ul class="rejoindre__liste">
        {offres.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="outils wrap" aria-label="Le métier">
    <figure class="outils__media" data-reveal><Photo cle="outils" widths={[480, 800, 1200]} sizes="(min-width: 900px) 60vw, 100vw" /><figcaption class="legende">Image d’illustration</figcaption></figure>
    <p class="outils__mot display">Des outils, des mains, des délais tenus.</p>
  </section>
</Base>
