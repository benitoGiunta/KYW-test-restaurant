---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas sur le site de Novobel. Retournez à l’accueil ou aux projets.">
  <section class="perdu wrap">
    <p class="cote" aria-hidden="true"><span class="cote__val">Cote introuvable</span></p>
    <h1 class="display perdu__titre" data-split="lines" data-intro>Hors plan.</h1>
    <p class="entete__chapo">La page demandée n’existe pas ou plus. Reprenons le chantier là où il est mesuré.</p>
    <p class="hero__actions"><a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a><a class="lien" href={u('/projets/')}>Voir les projets</a></p>
  </section>
</Base>
