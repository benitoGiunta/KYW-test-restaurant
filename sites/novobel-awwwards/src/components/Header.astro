---
import { u } from '../lib/url';
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const courant = (p: string) => (path === u(p).replace(/\/+$/, '') + '/' ? 'page' : undefined);
const liens = [
  { href: '/projets/', label: 'Projets' },
  { href: '/a-propos/', label: 'À propos' },
];
---
<header class="tete">
  <a class="tete__marque" href={base} aria-label={`${site.nom}, accueil`} aria-current={path === base ? 'page' : undefined}>
    <span class="tete__carre" aria-hidden="true"></span><span class="tete__nom">Novobel</span>
  </a>
  <p class="tete__lieu" aria-hidden="true">Construction et rénovation, Namur</p>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => <li><a class="nl" href={u(l.href)} aria-current={courant(l.href)}>{l.label}</a></li>)}
      <li><a class="cta cta--petit" href={u('/contact/')} aria-current={courant('/contact/')}><span class="cta__txt">Nous contacter</span></a></li>
    </ul>
  </nav>
  <button class="tete__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-bouton>Menu</button>
</header>
<nav id="menu" class="menu" hidden aria-label="Menu" data-menu>
  <button class="menu__fermer" type="button" data-menu-fermer>Fermer</button>
  <ul>
    <li><a class="menu__lien" href={base} aria-current={path === base ? 'page' : undefined}>Accueil</a></li>
    {liens.map((l) => <li><a class="menu__lien" href={u(l.href)} aria-current={courant(l.href)}>{l.label}</a></li>)}
    <li><a class="menu__lien" href={u('/contact/')} aria-current={courant('/contact/')}>Contact</a></li>
  </ul>
  <div class="menu__pied">
    <a href={site.telephoneHref}>{site.telephoneLisible}</a>
    <span>{site.adresse.rue} {site.adresse.numero}, {site.adresse.cp} {site.adresse.commune}</span>
  </div>
</nav>
