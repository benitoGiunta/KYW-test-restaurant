---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { site } from '../data/site';
---
<section class="pied" aria-label="Coordonnées et plan du site">
  <div class="pied__haut">
    <p class="cote cote--pied" aria-hidden="true"><span class="cote__val">Remise des clés</span></p>
    <p class="pied__mot" aria-hidden="true" data-split="chars">Les clés.</p>
  </div>
  <div class="pied__corps">
    <div class="pied__col">
      <h2 class="pied__titre">Adresse</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <p><a class="lien" href={site.carteUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Contact</h2>
      <p><a class="pied__tel" href={site.telephoneHref}>{site.telephoneLisible}</a><br /><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="pied__liste">
        {site.reseaux.map((r) => <li><a class="lien-util" href={r.url} rel="noopener">{r.nom}</a></li>)}
      </ul>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Le site</h2>
      <ul class="pied__liste">
        <li><a class="lien-util" href={u('/projets/')}>Projets</a></li>
        <li><a class="lien-util" href={u('/a-propos/')}>À propos</a></li>
        <li><a class="lien-util" href={u('/contact/')}>Contact</a></li>
      </ul>
    </div>
    <div class="pied__cta"><a class="cta cta--sombre" href={u('/contact/')}><span class="cta__txt">Nous contacter</span></a></div>
    <p class="pied__colophon">Photos : site novobel.com (images d’illustration). Polices : Barlow Condensed et Public Sans (Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
