---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site, photoDe, telHref } from '../data/site';
import { asset } from '../lib/url';
const offres = site.privatisation.offres;
---
<Base title="Privatisation" description={`Be Belge… et d'ailleurs (Wépion) se privatise : repas assis de 15 à 34 personnes, walking dinner de 20 à 40. Renseignements au ${site.telephone}.`}>
  <HeroPage titre="Privatiser" sur="Repas assis, walking dinner">
    <p>{site.privatisation.intro}</p>
  </HeroPage>

  <section class="section" aria-label="Les formules de privatisation">
    <div class="wrap offres">
      {offres.map((o, i) => { const p = photoDe(o.photo); return (
        <article class:list={['offre', { 'offre--inverse': i % 2 === 1 }]}>
          <figure class="offre__photo" data-reveal="clip">
            <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
          </figure>
          <div class="offre__texte">
            <h2 class="offre__nom">{o.nom}</h2>
            <p>{o.texte}{o.textePlaceholder && <span class="illu">texte illustratif</span>}</p>
          </div>
        </article>
      ); })}
    </div>
  </section>

  <section class="section section--contact" aria-labelledby="contact-titre">
    <div class="wrap contact">
      <h2 class="petite-cap" id="contact-titre">Parler de votre réception</h2>
      <p class="contact__texte">Pour une privatisation, appelez le restaurant ou écrivez-lui : jours et horaires s’adaptent.</p>
      <p class="actions"><a class="btn btn--primary" href={telHref()}>Appeler le {site.telephone}</a><a class="btn" href={`mailto:${site.email.valeur}`}>Écrire à la maison</a></p>
    </div>
  </section>
</Base>
