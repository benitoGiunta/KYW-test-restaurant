---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Les menus" description={`Les deux Menus du Chef de Be Belge… et d'ailleurs à Wépion : ${site.menus[0].services} services à ${site.menus[0].prix} ou ${site.menus[1].services} services à ${site.menus[1].prix}, vins en accord en option.`}>
  <HeroPage titre="Les menus" sur="Deux prix, une cuisine">
    <p>Le Menu du Chef se prend en {site.menus[0].services} ou en {site.menus[1].services} services, avec ou sans sélection de vins.</p>
  </HeroPage>

  <section class="section" aria-label="Les menus">
    <div class="wrap">
      <ol class="formules">
        {site.menus.map((m, i) => (
          <li class="formule" data-reveal="up" data-delay={String(i * 0.08)}>
            <p class="formule__prix" aria-hidden="true">{m.prix.replace(/\s*€/, '')}<span class="formule__euro">€</span></p>
            <div class="formule__texte">
              <h2 class="formule__nom">{m.nom}<span class="sr-only">, {m.prix}</span></h2>
              <p class="petite-cap">{m.services} services, {m.quand}</p>
              <p>{m.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="formules__pied" data-reveal="fade">
        <div class="actions">
          <a class="btn" href={u('/menu/')}>La carte en détail</a>
          <a class="btn btn--primary" href={u('/reservation/')}>Réserver</a>
        </div>
      </div>
    </div>
  </section>
</Base>
