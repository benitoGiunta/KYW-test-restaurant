---
// Le filon : les assiettes du tableau de la semaine, accrochées à un fil de cuivre (une pépite par assiette).
import { plats } from '../data/site';
---
<ol class="etapes">
  {plats.map((p) => (
    <li class="etape">
      <h3 class="etape__nom">{p.nom}</h3>
      {p.description && <p class="etape__desc">{p.description}</p>}
    </li>
  ))}
</ol>
