---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { site, horaires, fermes } from '../data/site';
---
<section class="pied" aria-label="Pied de page de Pépite">
  <div class="wrap pied__corps">
    <span class="pied__pepite" aria-hidden="true"></span>
    <p class="pied__mot" aria-hidden="true">À table.</p>
    <div class="pied__col">
      <h2 class="pied__titre">Venir</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Horaires</h2>
      <ul class="pied__horaires">
        {horaires.map((h) => <li><span>{h.jour}</span><span>cave {h.cave}</span></li>)}
      </ul>
      <p class="pied__doux">{fermes}</p>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Contact</h2>
      <p><a class="pied__tel" href={site.telephoneHref}>{site.telephoneLisible}</a><br /><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="pied__reseaux">
        {site.reseaux.map((r) => <li><a class="lien-util" href={r.url} rel="noopener">{r.nom}</a></li>)}
      </ul>
    </div>
    <div class="pied__cta"><a class="cta" href={u('/reservation/')}><span class="cta__txt">Réserver</span></a></div>
    <p class="pied__colophon">Photos : Pépite. Polices : Boska (Indian Type Foundry, Fontshare) et DM Mono (Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
