---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page de Pépite, cave à manger, n’existe pas ou plus.">
  <section class="erreur wrap">
    <span class="bougie" aria-hidden="true"><i class="bougie__fil"></i><i class="bougie__cire"></i></span>
    <h1 class="titre-xl display">La bougie s’est éteinte.</h1>
    <p class="lead">Cette page n’existe pas ou plus. La salle, elle, est toujours allumée.</p>
    <p class="erreur__liens"><a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a><a class="lien" href={u('/carte/')}>Voir la carte</a></p>
  </section>
</Base>
