---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Etapes from '../components/Etapes.astro';
import { u } from '../lib/url';
import { site, horaires, semaine, citation, boissons, colis } from '../data/site';
---
<Base page="accueil" description="Pépite, cave à manger au 44 rue Notre-Dame à Namur : assiettes à partager, vins d’auteurs, boutique, du jeudi au samedi ; la cave a aussi connu des soirées à la bougie.">
  <section class="hero wrap grid">
    <h1 class="hero__titre display"><span class="sr-only">Pépite, cave à manger</span><span class="hero__nom" aria-hidden="true" data-split="chars" data-intro>Pépite</span><span class="hero__sous" aria-hidden="true" data-split="words" data-intro data-delay="0.35">cave à manger</span></h1>
    <figure class="hero__photo"><span class="fil" data-fil aria-hidden="true"><span class="fil__trait"><i class="fil__lueur"></i></span><i class="fil__pepite"></i></span><div class="hero__cadre" data-reveal="clip" data-intro data-delay="0.1"><Photo cle="cave" widths={[480, 598]} sizes="(max-width: 48rem) 70vw, 30vw" prioritaire /></div></figure>
    <div class="hero__bas">
      <p class="lead">Une boutique de vins d’auteurs et des assiettes à partager, au 44 rue Notre-Dame, à Namur.</p>
      <p class="hero__quand" data-reveal="up" data-intro data-delay="0.5">Jeudi, vendredi, samedi. Cave à manger dès 19 h.</p>
      <p class="hero__actions" data-reveal="up" data-intro data-delay="0.65"><a class="cta" href={u('/reservation/')}><span class="cta__txt">Réserver</span></a><a class="lien" href={site.telephoneHref}>Appeler le {site.telephoneLisible}</a></p>
    </div>
  </section>

  <section class="lin sect sect--citation">
    <div class="wrap">
      <figure class="citation">
        <blockquote class="citation__texte display" data-reveal="up">« {citation.texte} »</blockquote>
        <figcaption class="citation__auteur">{citation.auteur}</figcaption>
      </figure>
    </div>
  </section>

  <section class="sect sect--filon" aria-labelledby="t-tableau">
    <div class="wrap grid">
      <header class="filon__tete">
        <h2 id="t-tableau" class="titre-l display" data-split="lines">Le tableau de la semaine</h2>
        <p class="filon__dates">{semaine.libelle}</p>
      </header>
      <div class="filon__corps">
        <Etapes />
        <p class="filon__prix"><span class="prix">{semaine.prixTexte}</span> le menu 5 services, à partager ou à l’assiette. <a class="lien" href={u('/carte/')}>Voir la carte</a></p>
      </div>
    </div>
  </section>

  <section class="sect sect--paire" aria-labelledby="t-vins">
    <div class="wrap grid">
      <figure class="paire__photo" data-reveal="clip"><Photo cle="bouteilles" widths={[800, 1200, 1600]} sizes="(max-width: 48rem) 100vw, 60vw" /><figcaption class="legende">Photo : Pépite</figcaption></figure>
      <div class="paire__texte">
        <h2 id="t-vins" class="titre-l display" data-split="lines">Des vins qui ont un auteur</h2>
        <p>Les vins de la cave sont élaborés dans le respect du vivant. On les choisit à la boutique ou au verre, à table, avec les assiettes.</p>
        <p class="paire__prix">{boissons[0].nom} <span class="prix">{boissons[0].prix}</span></p>
        <p class="paire__doux">{colis}</p>
      </div>
    </div>
  </section>

  <section class="lin sect sect--strip" aria-labelledby="t-bougie">
    <div class="wrap strip__tete">
      <h2 id="t-bougie" class="titre-l display" data-split="lines">À la bougie, en 2022</h2>
      <p>Des soirées sans gaz ni électricité ont eu lieu dans la cave, racontées par Le Vif en 2022.</p>
    </div>
    <ul class="strip" tabindex="0" aria-label="Photos des soirées à la bougie">
      <li data-reveal="clip" data-delay="0.00"><Photo cle="service" widths={[480, 800]} sizes="(max-width: 48rem) 70vw, 28vw" /></li>
      <li data-reveal="clip" data-delay="0.08"><Photo cle="dessert" widths={[480, 800]} sizes="(max-width: 48rem) 70vw, 28vw" /></li>
      <li data-reveal="clip" data-delay="0.16"><Photo cle="bougie" widths={[480, 800]} sizes="(max-width: 48rem) 70vw, 28vw" /></li>
    </ul>
  </section>
</Base>
