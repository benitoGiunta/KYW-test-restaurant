---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Casier introuvable" page="404" description="Cette page n’existe pas : le casier est vide. Retour à la carte ou à l’accueil de la Pizzeria Doria.">
  <section class="vide wrap" aria-labelledby="titre">
    <p class="plaque plaque--grande" aria-hidden="true">404</p>
    <h1 id="titre" class="vide__titre display">Ce casier est vide.</h1>
    <p class="vide__lead">La page que vous cherchez n’est rangée nulle part. La carte, elle, est pleine.</p>
    <p class="vide__actions">
      <a class="cta" href={u('/carte/')}><span class="cta__txt">Ouvrir la carte</span></a>
      <a class="cta cta--contour" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
    </p>
  </section>
</Base>
