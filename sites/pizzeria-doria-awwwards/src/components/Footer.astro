---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { site, jours, libelleJour } from '../data/site';
const { sans = [] } = Astro.props;
---
<section class="pied" aria-label="Contact et horaires">
  <div class="pied__filet" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap pied__corps">
    <p class="pied__mot" aria-hidden="true">À table dans le coffre.</p>
    {!sans.includes('venir') && <div class="pied__col">
      <h2 class="pied__titre">Venir</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>}
    {!sans.includes('ouvert') && <div class="pied__col">
      <h2 class="pied__titre">Ouvert</h2>
      <ul class="pied__horaires">
        {jours.map((j) => <li><span>{j.nom}</span><span>{libelleJour(j)}</span></li>)}
      </ul>
    </div>}
    <div class="pied__col">
      <h2 class="pied__titre">Contact</h2>
      <p><a class="pied__tel" href={site.telephoneHref}>{site.telephoneLisible}</a><br /><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="pied__reseaux">
        <li><a class="lien-util" href={site.facebookUrl} rel="noopener">Facebook</a></li>
        <li><a class="lien-util" href={site.emporterUrl} rel="noopener">Commander à emporter</a></li>
      </ul>
    </div>
    <div class="pied__cta"><a class="cta cta--coffre" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a></div>
    <p class="pied__colophon">{site.credit}. Polices : Barlow et Barlow Condensed (Jeremy Tribby, Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
