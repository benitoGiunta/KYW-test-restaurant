---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../assets/logo-doria.png';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const courant = (p: string) => (path === u(p).replace(/\/+$/, '') + '/' ? 'page' : undefined);
const liens = [
  { href: '/carte/', label: 'La carte' },
  { href: '/histoire/', label: 'Histoire' },
];
---
<header class="tete">
  <a class="tete__marque" href={base} aria-label="Pizzeria Doria, accueil" aria-current={path === base ? 'page' : undefined}>
    <Image src={logo} alt="" width={120} height={113} densities={[1, 2]} class="tete__logo" loading="eager" />
  </a>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => <li><a class="nl" href={u(l.href)} aria-current={courant(l.href)}>{l.label}</a></li>)}
      <li><a class="cta cta--petit" href={u('/reservation/')} aria-current={courant('/reservation/')}><span class="cta__txt">Réserver</span></a></li>
    </ul>
  </nav>
</header>
