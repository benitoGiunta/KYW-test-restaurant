---
import Base from '../layouts/Base.astro';
import CarteListe from '../components/CarteListe.astro';
import Resa from '../components/Resa.astro';
import { boissons } from '../data/site';
---
<Base page="boissons" title="Les boissons · El Greco, restaurant grec à Bouge" description="Cocktails grecs, apéritifs, vins grecs à la bouteille, bières et softs : la carte des boissons d’El Greco.">
  <header class="entete container">
    <h1>Les boissons</h1>
    <p class="lead">Des cocktails grecs, des apéritifs et des vins de Grèce, de la Limniona à la Retsina.</p>
  </header>
  <div class="container carte"><CarteListe categories={boissons} /></div>
  <Resa />
</Base>
