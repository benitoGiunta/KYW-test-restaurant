---
import Base from '../layouts/Base.astro';
import Horaires from '../components/Horaires.astro';
import { resto, itineraire } from '../data/site';
---
<Base page="contact" title="Infos et réservation · El Greco, restaurant grec à Bouge" description="Réserver chez El Greco : téléphone 081 20 07 47, adresse rue de Sardanson 22 à Bouge, horaires.">
  <header class="entete container">
    <h1>Infos et réservation</h1>
    <p class="lead">Pour réserver, appelez-nous ou écrivez-nous.</p>
  </header>
  <section class="contact container">
    <div class="contact__resa">
      <h2>Réservation</h2>
      <p class="contact__tel"><a href={resto.telHref}>{resto.tel}</a></p>
      <p><a href={`mailto:${resto.email}`}>{resto.email}</a></p>
      <p class="actions"><a class="btn btn--primary" href={resto.telHref}>Appeler le restaurant</a></p>
    </div>
    <div class="contact__adresse">
      <h2>Adresse</h2>
      <address><p>El Greco<br />{resto.adresse.rue}<br />{resto.adresse.cp} {resto.adresse.commune}</p></address>
      <p><a href={itineraire}>Itinéraire</a></p>
      <p><a href={resto.facebook} rel="noopener">Facebook</a><br /><a href={resto.instagram} rel="noopener">Instagram</a></p>
    </div>
    <div class="contact__horaires"><Horaires /></div>
  </section>
</Base>
