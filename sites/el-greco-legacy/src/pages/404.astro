---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="" title="Page introuvable · El Greco" description="Cette page n’existe pas.">
  <header class="entete container">
    <h1>Page introuvable</h1>
    <p class="lead">Cette adresse ne mène à aucune page d’El Greco.</p>
    <p class="actions"><a class="btn btn--primary" href={base}>Retour à l’accueil</a><a class="btn btn--secondary" href={`${base}our-menu/`}>Voir le menu</a></p>
  </header>
</Base>
