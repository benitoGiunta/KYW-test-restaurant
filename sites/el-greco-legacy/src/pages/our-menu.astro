---
import Base from '../layouts/Base.astro';
import CarteListe from '../components/CarteListe.astro';
import Resa from '../components/Resa.astro';
import { menu } from '../data/site';
---
<Base page="menu" title="Le menu · El Greco, restaurant grec à Bouge" description="La carte d’El Greco : entrées, spécialités grecques, grillades, poissons, salades et menus enfant, avec les prix.">
  <header class="entete container">
    <h1>Le menu</h1>
    <p class="lead">Grillades, spécialités, poissons et menus enfant sont servis avec frites, pâtes grecques ou pomme au four, salade et trois sauces froides.</p>
  </header>
  <div class="container carte"><CarteListe categories={menu} /></div>
  <Resa />
</Base>
