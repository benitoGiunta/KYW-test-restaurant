---
import { horaires, h } from '../data/site';
---
<section class="horaires" id="horaires" aria-labelledby="h-horaires">
  <h2 id="h-horaires">Horaires</h2>
  <dl class="sched">
    {horaires.filter((j) => j.creneaux).map((j) => (
      <div class="sched__jour">
        <dt>{j.jour}</dt>
        <dd>{j.creneaux!.map((c, i) => (<>{i > 0 && <span class="sep"> et </span>}<time datetime={c.de}>{h(c.de)}</time> à <time datetime={c.a}>{h(c.a)}</time></>))}</dd>
      </div>
    ))}
  </dl>
</section>
