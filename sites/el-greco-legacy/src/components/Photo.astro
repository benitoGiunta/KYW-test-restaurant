---
// Photo de stock dans un slot Hallmark ; toujours placeholder (aucune photo du restaurant).
// La légende est hors du slot : base.css masque tout enfant non image d'un slot qui porte une image.
interface Props { nom: string; w: number; h: number; alt: string; slot: string; legende: string; sizes?: string; position?: string; priorite?: boolean; class?: string }
const { nom, w, h, alt, slot, legende, sizes = '100vw', position = '50% 50%', priorite = false, class: cls } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<figure class:list={['photo', cls]}>
  <div data-slot={slot} data-alt={alt} data-placeholder="true" data-credits="Pexels">
    <img
      src={`${base}photos/${nom}-1600.webp`}
      srcset={`${base}photos/${nom}-800.webp 800w, ${base}photos/${nom}-1600.webp 1600w`}
      sizes={sizes} width={w} height={h} alt={alt}
      style={`object-position:${position}`}
      loading={priorite ? 'eager' : 'lazy'} fetchpriority={priorite ? 'high' : undefined} decoding="async"
    />
  </div>
  <figcaption>{legende}</figcaption>
</figure>
