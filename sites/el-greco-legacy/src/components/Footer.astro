---
import { resto, navLiens } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="pied">
  <div class="container pied__in">
    <p class="pied__nom">El Greco</p>
    <address class="pied__adresse">
      <p>{resto.adresse.rue}<br />{resto.adresse.cp} {resto.adresse.commune}</p>
      <p><a href={resto.telHref}>{resto.tel}</a><br /><a href={`mailto:${resto.email}`}>{resto.email}</a></p>
    </address>
    <nav class="pied__liens" aria-label="Pied de page">
      {navLiens.map((l) => <a href={`${base}${l.href}`}>{l.texte}</a>)}
      <a href={`${base}contact/#horaires`}>Horaires</a>
      <a href={resto.facebook} rel="noopener">Facebook</a>
      <a href={resto.instagram} rel="noopener">Instagram</a>
    </nav>
    <p class="pied__credits" data-credits>Photographies d’ambiance : banque d’images (Pexels), à remplacer par celles du restaurant.</p>
  </div>
</footer>
