---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import '../styles/page.css';
import { resto } from '../data/site';
interface Props { title: string; description: string; page: string; photos?: boolean; schema?: boolean }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { photos = false, schema = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kyw-test-restaurant.vercel.app').href;
const ld = {
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, servesCuisine: 'Grecque',
  telephone: '+32 81 20 07 47',
  address: { '@type': 'PostalAddress', streetAddress: resto.adresse.rue, postalCode: resto.adresse.cp, addressLocality: 'Bouge (Namur)', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '18:00', closes: '22:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '12:00', closes: '15:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '18:00', closes: '22:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '18:00', closes: '23:00' },
  ],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6efe2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f6efe2'/%3E%3Ctext x='16' y='23' font-family='serif' font-size='22' font-weight='700' text-anchor='middle' fill='%231d3f8a'%3EG%3C/text%3E%3C/svg%3E" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="El Greco" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400&family=Geist:wght@400;500&family=Geist+Mono:wght@400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu"><slot /></main>
    <Footer photos={photos} />
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelector('img')?.remove(); s.prepend(im); } };
    document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <KywFooter base={base} />
  </body>
</html>
