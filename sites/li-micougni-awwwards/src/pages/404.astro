---
import Base from '../layouts/Base.astro';
import Demi from '../components/Demi.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page de Li Micougni n’existe pas ou a changé d’adresse. Retournez à l’accueil, à la carte ou réservez une table au restaurant de Namur.">
  <section class="perdu wrap grid">
    <div style="grid-column: 1 / -1">
      <h1 class="mega"><Demi t="404" /></h1>
      <div class="perdu__txt">
        <p>Cette page n’est là qu’à moitié. Même les demi-fous se perdent parfois.</p>
        <p class="cta-row"><a class="cta" href={u('/')}>Retour à l’accueil</a><a class="cta cta--ghost" href={u('/carte/')}>La carte</a></p>
      </div>
    </div>
  </section>
</Base>
