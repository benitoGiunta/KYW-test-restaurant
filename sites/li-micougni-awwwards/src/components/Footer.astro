---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { restaurant as r } from '../data/site';
import { photos } from '../lib/photos';
import { Picture } from 'astro:assets';
import Demi from './Demi.astro';
---
<section class="pied" aria-label="Contact et liens">
  <div class="wrap">
    <p class="pied__nom" aria-hidden="true"><Demi t="Li Micougni" /></p>
    <p class="pied__mot">Ici, on se retrouve <span class="pied__entier-mot">entier</span>.</p>
    <div class="pied__cols">
      <div class="pied__col">
        <h2 class="pied__titre">Venir</h2>
        <address>{r.adresse.rue} {r.adresse.numero}<br />{r.adresse.cp} {r.adresse.commune}</address>
        <p><a class="lien" href={r.planUrl} rel="noopener">Ouvrir le plan</a></p>
      </div>
      <div class="pied__col">
        <h2 class="pied__titre">Parler</h2>
        <p><a class="pied__tel" href={`tel:${r.telephone}`}>{r.telephoneLisible}</a><br /><a class="lien" href={`mailto:${r.email}`}>{r.email}</a></p>
      </div>
      <div class="pied__col">
        <h2 class="pied__titre">Suivre</h2>
        <ul class="pied__reseaux">
          {r.reseaux.map((s) => <li><a class="lien-util" href={s.url} rel="noopener">{s.nom}</a></li>)}
        </ul>
        <ul class="pied__reseaux">
          <li><a class="lien-util" href={u('/carte/')}>La carte</a></li>
          <li><a class="lien-util" href={u('/histoire/')}>Histoire</a></li>
          <li><a class="lien-util" href={u('/reservation/')}>Réservation</a></li>
        </ul>
      </div>
      <div class="pied__col pied__logo">
        <Picture src={photos.logo.src} alt={photos.logo.alt} formats={['webp']} fallbackFormat="webp" widths={[160, 320]} sizes="160px" loading="lazy" decoding="async" />
      </div>
    </div>
    <p class="pied__colophon">{r.credit}. Polices : Young Serif et Schibsted Grotesk (Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
