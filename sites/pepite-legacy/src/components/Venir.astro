---
import { resto, horaires } from '../data/site';
---
<section class="venir" id="venir" aria-labelledby="venir-t">
  <div class="container venir__grid">
    <div class="venir__tete">
      <h2 id="venir-t">Jeudi, vendredi, samedi</h2>
      <p class="lead">La boutique ouvre l’après-midi, la cave à manger dès 19 h 00. À toute heure, une assiette ou un verre selon l’envie.</p>
      <p class="venir__act">
        <a class="btn" href={resto.reserver}>Réserver une table</a>
        <a class="lien" href={resto.telHref}>Ou appeler le {resto.tel}</a>
      </p>
    </div>
    <dl class="horaires" id="horaires">
      {horaires.map((h) => (
        <div class={h.ferme ? 'hor hor--ferme' : 'hor'} data-jour={h.jour}>
          <dt>{h.jour}</dt>
          <dd>
            {h.ferme ? 'Fermé' : (<>
              <span>Boutique dès <time>{h.boutique}</time></span>
              <span>Cave à manger dès <time>{h.cave}</time></span>
              {h.note && <span class="muted">{h.note}</span>}
            </>)}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
