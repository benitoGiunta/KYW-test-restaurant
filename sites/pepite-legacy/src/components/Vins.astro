---
import { resto, selections } from '../data/site';
---
<section class="vins" id="vins" aria-labelledby="vins-t">
  <div class="container vins__in">
    <h2 id="vins-t">Des vins vivants, vibrants, qui ont une âme</h2>
    <p class="lead">Des vins d’auteurs, élaborés dans le respect du vivant : fluides, digestes, d’une grande buvabilité.</p>
    <ul class="vins__sel" aria-label="Les sélections de Pépite">
      {selections.map((s) => <li>{s}</li>)}
    </ul>
    <p class="vins__bas">
      <a class="btn btn--ligne" href={resto.commander}>Commander en ligne</a>
      <span>Gin Djîn par Sang Hoon Degeimbre : <span class="num">45 €</span> les 50 cl.</span>
    </p>
  </div>
</section>
