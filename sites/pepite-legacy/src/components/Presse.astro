---
import { presse } from '../data/site';
---
<section class="presse" id="presse" aria-labelledby="presse-t">
  <div class="container presse__grid">
    <div><h2 id="presse-t">Ils en ont parlé</h2></div>
    <ul class="rows">
      {presse.map((p) => (
        <li class="row row--presse">
          <h3>{p.media}<span class="muted"> <time>{p.date}</time></span></h3>
          <p>{p.texte}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
