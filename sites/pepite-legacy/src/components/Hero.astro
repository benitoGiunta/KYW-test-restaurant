---
import { resto, base } from '../data/site';
---
<section class="hero" aria-labelledby="h-titre">
  <img class="hero__img" src={`${base}photos/bouteilles.webp`} width="1600" height="1066" fetchpriority="high" decoding="async"
    alt="Rangée de bouteilles de vins d’auteurs sur le comptoir de la boutique, une silhouette floue derrière" />
  <div class="container hero__in">
    <div class="hero__txt">
      <h1 id="h-titre">Pépite, cave à manger</h1>
      <p class="lead">Des vins d’auteurs et des assiettes à partager, <span class="nobr">rue Notre-Dame</span> à Namur.</p>
      <p class="hero__act">
        <a class="btn" href={resto.reserver}>Réserver une table</a>
        <a class="lien" href="#carte">Voir la carte de la semaine</a>
      </p>
    </div>
  </div>
</section>
