---
import { resto } from '../data/site';
---
<footer class="pied">
  <div class="container pied__grid">
    <p class="pied__mark">pépite</p>
    <address>
      {resto.baseline}<br />
      {resto.adresse.numero} {resto.adresse.rue}<br />
      {resto.adresse.cp} {resto.adresse.ville}<br />
      <a href={resto.plan}>Voir le plan</a>
    </address>
    <p class="pied__liens">
      <a href={resto.telHref}>{resto.tel}</a><br />
      <a href={`mailto:${resto.email}`}>{resto.email}</a><br />
      <a href={resto.facebook}>Facebook</a><br />
      <a href={resto.instagram}>Instagram</a>
    </p>
    <p class="pied__cred" data-credits>Photographies : Pépite. Graphisme d’origine : Studio Otamendi.</p>
  </div>
</footer>
