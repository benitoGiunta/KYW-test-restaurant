---
import { resto, base } from '../data/site';
---
<header class="nav">
  <div class="container nav__in">
    <a class="nav__mark" href={base} aria-label="Pépite, cave à manger, accueil">pépite</a>
    <nav class="nav__panel" id="menu" popover aria-label="Principale">
      <ul class="nav__links">
        <li><a href={`${base}#carte`}>La carte</a></li>
        <li><a href={`${base}#vins`}>Les vins</a></li>
        <li><a href={`${base}#lieu`}>Le lieu</a></li>
        <li><a href={`${base}#presse`}>Presse</a></li>
        <li><a href={`${base}#venir`}>Horaires</a></li>
      </ul>
    </nav>
    <a class="nav__cta" href={resto.reserver}>Réserver</a>
    <button class="nav__menu" type="button" popovertarget="menu" aria-controls="menu" aria-expanded="false"><span class="nav__ico" aria-hidden="true"></span><span data-menu-label>Menu</span></button>
  </div>
</header>
