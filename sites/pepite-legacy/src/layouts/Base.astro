---
import KywFooter from '@kyw/footer';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import { resto, base } from '../data/site';
interface Props { title: string; description: string; pied?: boolean }
const { title, description, pied = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: resto.siteActuel,
  telephone: '+32476620182', email: resto.email, servesCuisine: ['Assiettes à partager', 'Bar à vins'],
  address: { '@type': 'PostalAddress', streetAddress: `${resto.adresse.rue} ${resto.adresse.numero}`, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
  sameAs: [resto.facebook, resto.instagram],
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%2716%27 fill=%27%23e9a899%27/%3E%3C/svg%3E" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}photos/bouteilles.webp`, Astro.site).href} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Instrument+Sans:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={ld} />
    <style is:global>@import "../styles/page.css";</style>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu"><slot /></main>
    {pied && <Pied />}
    <KywFooter base={base} />
    <script>
      const menu = document.getElementById('menu');
      const bouton = document.querySelector<HTMLButtonElement>('.nav__menu');
      const libelle = document.querySelector('[data-menu-label]');
      if (menu && bouton && 'hidePopover' in menu) {
        menu.addEventListener('toggle', (e) => {
          const ouvert = (e as ToggleEvent).newState === 'open';
          bouton.setAttribute('aria-expanded', String(ouvert));
          if (libelle) libelle.textContent = ouvert ? 'Fermer' : 'Menu';
        });
        // un lien d'ancre ne ferme pas un popover : fermeture au clic
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
        matchMedia('(min-width: 60rem)').addEventListener('change', (m) => { if (m.matches && menu.matches(':popover-open')) menu.hidePopover(); });
      }

      // jour courant des horaires, d'après le fuseau de Bruxelles
      const jour = new Intl.DateTimeFormat('fr-BE', { weekday: 'long', timeZone: 'Europe/Brussels' }).format(new Date());
      const nom = jour.charAt(0).toUpperCase() + jour.slice(1);
      const ligne = document.querySelector(`.hor[data-jour="${nom}"]`);
      if (ligne) {
        ligne.setAttribute('aria-current', 'date');
        const dt = ligne.querySelector('dt');
        if (dt) { const s = document.createElement('span'); s.className = 'hor__auj'; s.textContent = 'Aujourd’hui'; dt.appendChild(s); }
      }

      // reveal : un seul, sur les rangées de la carte
      const cibles = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
        cibles.forEach((c) => io.observe(c));
      } else cibles.forEach((c) => c.classList.add('is-in'));
    </script>
  </body>
</html>
