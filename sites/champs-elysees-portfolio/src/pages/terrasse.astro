---
// Terrasse et fêtes patronales. La terrasse sur l'avenue est visible sur les photos ; le menu des fêtes patronales
// et la consigne « plus de 10 personnes » viennent du site actuel (dossier.md). Rien d'autre n'est affirmé.
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g, photoDe, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/v/'));
const photos = ['/photos/facade.webp', '/photos/spritz-terrasse.webp', '/photos/biere-pression.webp'].map(photoDe);
const mascotte = photoDe('/photos/mascotte-bouteille.webp');
const fetes = site.menus[0];
---
<Base title="Terrasse et fêtes patronales" description={`Terrasse sur l'avenue Albert Ier et menu des fêtes patronales chez ${site.nom} à ${site.adresse.commune}.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse et fêtes</h1>
      <p class="lead">Dehors sur l'avenue, ou autour d'un menu de fête à partager en groupe.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Un verre, <em class="ital">dehors</em></h2>
      <p class="lead">{g.terrasse.texte}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section__titre">Les fêtes <em>patronales</em></h2>
      <div class="maison__grille">
        <div class="prose">
          <p class="formule__prix">{fetes.prix}</p>
          <p>{fetes.description}</p>
          <p>{g.fetes.groupesTelephone} Appelez le <a class="link" href={telHref()}>{site.telephone}</a>.</p>
          <div class="actions"><a class="btn btn--plein" href={u('/reservation/')}>Réserver</a></div>
        </div>
        <figure class="tirage" style="--w:100%; cursor: default; --r:3deg">
          <img src={asset(mascotte.src)} alt={mascotte.alt} width={mascotte.largeur} height={mascotte.hauteur} loading="lazy" decoding="async" />
          <figcaption>Le serveur de la maison</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--canard">
    <div class="wrap">
      <h2 class="section__titre">De <em>l'avenue</em> au verre</h2>
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3, -2][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.alt.split(',')[0]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
