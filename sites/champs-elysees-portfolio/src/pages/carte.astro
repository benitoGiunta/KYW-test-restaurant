---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import { site, guinguette, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const g = guinguette;
const picto = (cat: string) => g.pictos.find((p) => cat.startsWith(p.categorie))?.picto ?? 'fourchette';
const photos = ['/photos/plat-frites.webp', '/photos/casserole-vapeur.webp', '/photos/biere-pression.webp', '/photos/spritz-terrasse.webp'].map(photoDe);
const iBoissons = site.carte.findIndex((c) => c.categorie.startsWith('Bières pression'));
const blocs = [{ titre: 'À <em>manger</em>', cats: site.carte.slice(0, iBoissons) }, { titre: 'À <em>boire</em>', cats: site.carte.slice(iBoissons) }];
const petite = (src: string) => asset(src.replace('/photos/', '/photos/v/'));
---
<Base title="La carte" description={`La carte de ${site.nom} à ${site.adresse.commune} : croquettes, boulettes, vol-au-vent, viandes, pâtes, menu enfants, bières, cocktails.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>La carte</h1>
      <p class="lead">Croquettes artisanales, boulettes, vol-au-vent maison, viandes, pâtes et un menu pour les enfants, puis les bières, les cocktails et les softs.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--corail is-flottant" style="--x:84%;--y:4%;--r:14deg;--taille:110px" aria-hidden="true"><Objet id="fourchette" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="carte">
        {blocs.map((bl, k) => (
          <>
            <h2 class="section__titre" style={k ? 'margin-top: calc(var(--u) * 5)' : ''} set:html={bl.titre} />
            <div class="carte__grille">
              {bl.cats.map((c) => (
                <div>
                  <h3 class="cat__titre"><Objet id={picto(c.categorie)} />{c.categorie}</h3>
                  <ul role="list">
                    {c.plats.map((p) => (
                      <li class="plat">
                        <span class="plat__nom">{p.nom}{p.description && <span class="plat__desc">{p.description}</span>}</span>
                        <span class="plat__points" aria-hidden="true"></span>
                        {p.prix && <span class="plat__prix">{p.prix}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </>
        ))}
        <h2 class="section__titre" style="margin-top: calc(var(--u) * 5)">Pour les <em>groupes</em></h2>
        <div class="carte__menus">
          {site.menus.map((m) => (
            <article class="formule">
              <h3>{m.nom}</h3>
              <p class="formule__prix">{m.prix}</p>
              <p class="muted" style="margin-top:0.8em">{m.description}</p>
            </article>
          ))}
        </div>
        <p class="muted" style="margin-top:calc(var(--u)*3);font-size:var(--t-s)">Carte relevée sur le PDF du restaurant (octobre, millésime 2024 à confirmer) : prix en euros, à vérifier auprès de la maison.</p>
      </div>
    </div>
  </section>

  <section class="section section--canard">
    <div class="wrap">
      <h2 class="section__titre">Sur <em>la table</em></h2>
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3, -2, 5][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.alt.split(',')[0]}</figcaption>
          </figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--lin" href={u('/reservation/')}>Réserver une table</a></div>
    </div>
  </section>
</Base>
