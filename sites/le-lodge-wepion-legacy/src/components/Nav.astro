---
import { u, SITE } from '../data/site';
interface Props { home?: boolean }
const { home = true } = Astro.props;
const pre = home ? '' : u('');
const liens = [
  { href: `${pre}#carte`, t: 'Carte' },
  { href: `${pre}#tea-room`, t: 'Tea room' },
  { href: `${pre}#reserver`, t: 'Réserver' },
  { href: `${pre}#contact`, t: 'Contact' },
];
---
<header class="top">
  <p class="banner">
    <a href={`${pre}#lieu`}>Le Lodge est au Wine &amp; More, à Erpent</a>
  </p>
  <div class="bar">
    <div class="container bar__in">
      <a class="bar__logo" href={u('')} aria-label="Le Lodge Wépion, accueil">
        <img src={u('logo-blanc.svg')} alt="Le Lodge" width="176" height="32" />
      </a>
      <nav class="bar__nav" aria-label="Principale">
        <ul>
          {liens.map((l) => <li><a href={l.href}>{l.t}</a></li>)}
        </ul>
      </nav>
      <a class="btn btn--sm btn--ghost" href={SITE.reservation} rel="noopener">Réserver une table</a>
      <button class="burger" type="button" popovertarget="menu" aria-controls="menu" aria-haspopup="true">Menu</button>
    </div>
  </div>
  <div class="menu" id="menu" popover>
    <div class="container menu__in">
      <div class="menu__head">
        <span class="menu__titre">Le Lodge</span>
        <button class="burger" type="button" popovertarget="menu" popovertargetaction="hide">Fermer</button>
      </div>
      <nav aria-label="Menu">
        <ul>
          {liens.map((l) => <li><a href={l.href} data-menu-link>{l.t}</a></li>)}
        </ul>
      </nav>
      <a class="btn" href={SITE.reservation} rel="noopener">Réserver une table</a>
    </div>
  </div>
</header>
