<Base title="Cookies | Le Lodge Wépion" description="Cookies du site du Lodge Wépion." home={false}>
  <section class="sec sec--texte">
    <div class="container">
      <h1>Cookies</h1>
      <p class="lead">Cette maquette ne dépose aucun cookie.</p>
      <p>
        La page de cookies du site d’origine (lodgewepion.be/cookies) n’est pas reprise ici :
        <span class="fill" data-fill="texte">texte à fournir par le restaurant</span>.
      </p>
      <p><a class="link" href={u('')}>Retour à l’accueil</a></p>
    </div>
  </section>
</Base>
