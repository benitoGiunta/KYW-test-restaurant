---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const gens = site.equipe;
const maison = photoDe('/photos/maison-jour.webp');
---
<Base title="La maison" description="Une ancienne ferme en carré au-dessus de la Meuse, à deux pas de la citadelle de Namur : l'histoire de la Maison Gersdorff et de sa table, Intuition.">
  <HeroPage titre="La maison" chiffre={site.chiffres.suites} sur="La Maison Gersdorff, Namur">
    <p>{site.histoire[0]}</p>
  </HeroPage>

  <section class="section" aria-label="À table">
    <div class="wrap portraits">
      {gens.map((m, i) => { const p = photoDe(m.photo!); return (
        <article class="portrait">
          <figure class="portrait__photo" data-reveal="clip">
            <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          </figure>
          <h2 class="portrait__nom">{m.nom}</h2>
          <p class="petite-cap">{m.role}</p>
          <p class="portrait__bio">{m.texte}</p>
        </article>
      ); })}
    </div>
  </section>

  <section class="section section--recit" aria-labelledby="recit-titre">
    <div class="wrap recit">
      <h2 class="petite-cap" id="recit-titre">Pierre par pierre</h2>
      <div class="recit__texte stack">
        {site.histoire.slice(1).map((p) => <p data-reveal="fade">{p}</p>)}
        <figure class="recit__photo" data-reveal="clip">
          <img src={asset(maison.src)} alt={maison.alt} width={maison.largeur} height={maison.hauteur} loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="equipe-titre">
    <div class="wrap equipe">
      <h2 class="petite-cap" id="equipe-titre">Ceux qui ont fait la maison</h2>
      <ul class="equipe__liste">
        {site.maison.map((m) => <li><strong>{m.nom}</strong><span class="equipe__role">{m.role}</span></li>)}
      </ul>
      <ul class="valeurs" aria-label="Ce qui compte">
        {site.valeurs.map((v) => <li>{v}</li>)}
      </ul>
      <p class="actions"><a class="btn btn--primary" href={u('/reservation/')}>Réserver une table</a></p>
    </div>
  </section>
</Base>
