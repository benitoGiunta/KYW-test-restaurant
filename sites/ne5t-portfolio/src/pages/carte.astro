---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Formules" description={`Les formules d'Intuition à Namur : trois services à ${site.menus[1].prix}, quatre services à ${site.menus[0].prix}, lunch carte blanche à ${site.menus[2].prix} du jeudi au samedi midi.`}>
  <HeroPage titre="Formules" sur="Trois prix, une même intuition">
    <p>Le menu du mois en trois ou quatre services, et le jeudi, le vendredi et le samedi midi, un lunch en carte blanche.</p>
  </HeroPage>

  <section class="section" aria-label="Les formules">
    <div class="wrap">
      <ol class="formules">
        {site.menus.map((m, i) => (
          <li class="formule" data-reveal="up" data-delay={String(i * 0.08)}>
            <p class="formule__prix" aria-hidden="true">{m.prix.replace(/\s*€/, '')}<span class="formule__euro">€</span></p>
            <div class="formule__texte">
              <h2 class="formule__nom">{m.nom}<span class="sr-only">, {m.prix}</span></h2>
              <p class="petite-cap">{m.services} services, {m.quand}</p>
              <p>{m.description}</p>
              <p class="muted">{m.vins}.</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="formules__pied" data-reveal="fade">
        <p><strong>Pause affinée</strong> : fromage affiné de la Petite Ferme, 14 €, ou 9 € de plus à la place du dessert.</p>
        <div class="actions">
          <a class="btn" href={u('/menu/')}>Le menu du mois</a>
          <a class="btn btn--primary" href={u('/reservation/')}>Réserver</a>
        </div>
      </div>
    </div>
  </section>
</Base>
