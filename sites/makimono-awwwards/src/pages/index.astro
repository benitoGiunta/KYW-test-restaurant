---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Ligne from '../components/Ligne.astro';
import { u } from '../lib/url';
import { restaurant, carte, horaires, hm, eur, boxes, rollsAuChoix, nbsp } from '../data/site';
const choisis = ['Spicy Fuji', 'Crazy Tempura', 'French Kiss', 'Dragon Crunch', 'Sweet Sakura', 'Chicken Nikkeï'];
const rolls = choisis.map((n) => carte.rolls.find((r) => r.nom === n)!);
const nigiri = carte.nigiri;
const etapesRoll = carte.creerRoll;
const aujourd = horaires;
---
<Base page="accueil" description="Rolls créatifs, poké bowls et nigiri flambés au chalumeau, à déguster sur place ou à emporter. Makimono, Rue Saint-Loup 14 à Namur.">
  <section class="hero" aria-labelledby="titre-accueil">
    <div class="wrap grille hero__grille">
      <h1 class="display hero__titre" id="titre-accueil">Makimono</h1>
      <div class="hero__texte">
        <p class="hero__baseline" lang="en">{restaurant.baseline}</p>
        <p class="lede">Rolls créatifs, poké bowls et nigiri flambés. Rue Saint-Loup, à Namur : sur place ou à emporter.</p>
        <div class="groupe-boutons">
          <a class="bouton bouton--plein" href={`tel:${restaurant.telephone}`}>Appeler le {restaurant.telephoneAffiche}</a>
          <a class="bouton" href={u('/carte/')}>Voir la carte</a>
        </div>
        <p class="ouverture">Midi et soir, du lundi au samedi. Le dimanche, le soir seulement.</p>
      </div>
      <figure class="hero__photo">
        <Photo nom="flambe" eager widths={[640, 960, 1400]} sizes="(max-width: 820px) 100vw, 58vw" ratio="16 / 10" position="50% 55%" />
        <figcaption>Nigiri de saumon, passage au chalumeau</figcaption>
      </figure>
    </div>
  </section>

  <section class="affirmation" aria-labelledby="titre-nom">
    <div class="wrap grille">
      <h2 data-split="lines" class="affirmation__phrase" id="titre-nom">Makimono veut dire une chose <em>enroulée</em>.</h2>
      <figure data-reveal="clip" class="affirmation__photo"><Photo nom="snacke" sizes="(max-width: 820px) 100vw, 50vw" ratio="4 / 3" /></figure>
      <div class="affirmation__texte texte">
        <p>En japonais, <i lang="ja">maki</i> désigne ce qui est enroulé et <i lang="ja">mono</i> la chose. Un makimono est aussi un rouleau qu’on déroule en le lisant.</p>
        <p>Ici, ce qu’on enroule, ce sont des uramaki : le riz dehors, la garniture dedans, composés comme vous l’entendez. « Rapide et frais », à déguster sur place ou à emporter.</p>
      </div>
    </div>
  </section>

  <section class="nori section" aria-labelledby="titre-rolls">
    <div class="wrap">
      <div class="grille tete-section">
        <h2 data-split="lines" class="titre-l" id="titre-rolls">{carte.rolls.length} rolls, dont {rollsAuChoix} au choix de la protéine</h2>
        <p class="texte">Saumon, thon, scampis en tempura, poulet katsu, yam tempura ou tofu frit : le roll reste le même, la protéine change.</p>
      </div>
      <ol class="index">{rolls.map((r) => <Ligne roll={r} />)}</ol>
      <p style="margin-top: var(--serre)"><a class="bouton" href={u('/carte/')}>Toute la carte</a></p>
    </div>
  </section>

  <section class="plein nori" aria-labelledby="titre-flambe">
    <div class="plein__photo"><Photo nom="flambe" sizes="100vw" widths={[800, 1400, 2000]} position="50% 55%" alt="" /></div>
    <div class="wrap grille plein__contenu">
      <h2 data-split="lines" class="display plein__titre" id="titre-flambe">Passés au chalumeau</h2>
      <div class="plein__texte">
        <p>Les nigiri de saumon sont flambés au chalumeau.</p>
        <ul class="prix-liste">{nigiri.map((n) => <li><span>{n.nom}, 6{nbsp}pièces</span><span>{eur(n.prix!)}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-composer">
    <div class="wrap grille">
      <div class="composer__tete">
        <h2 data-split="lines" class="titre-l" id="titre-composer">Create.Your.Roll</h2>
        <p class="lede">Un roll à votre main, en cinq gestes. Le prix se compose ingrédient par ingrédient.</p>
        <div><a class="bouton" href={`${u('/carte/')}#composer`}>Voir les ingrédients</a></div>
      </div>
      <ol class="composer__etapes sans-liste">
        {etapesRoll.map((e) => (
          <li class="etape" data-reveal="up">
            <h3>{e.titre}<span>{e.tarif ? e.tarif.replace(/(\d+)\.(\d+)/, '$1,$2').replace(',00', '').replace('€', nbsp + '€').replace('/', ' par ') : ''}</span></h3>
            <p>{e.options.slice(0, 5).map((o) => o.replace(/\s*[\d.,]+\s*€?\s*(\(€\))?$/, '')).join(', ')}{e.options.length > 5 ? '…' : ''}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="titre-boxes">
    <div class="wrap grille">
      <figure data-reveal="clip" class="boxes__photo"><Photo nom="creative" sizes="(max-width: 820px) 100vw, 50vw" ratio="4 / 3" /></figure>
      <div class="boxes__liste">
        <h2 data-split="lines" class="titre-l" id="titre-boxes">Seize pièces dans une boîte</h2>
        {boxes.map((b) => <div class="box"><h3>{b.nom}<span>{eur(b.prix)}</span></h3><p>{b.detail}</p></div>)}
      </div>
    </div>
  </section>

  <section class="nori section" aria-labelledby="titre-mur">
    <div class="wrap">
      <h2 class="sr-only" id="titre-mur">En images</h2>
      <div class="mur">
        <figure data-reveal="clip" class="mur__a"><Photo nom="pokeGros" sizes="(max-width: 820px) 50vw, 30vw" /></figure>
        <figure data-reveal="clip" class="mur__b"><Photo nom="planche" sizes="(max-width: 820px) 50vw, 30vw" /></figure>
        <figure data-reveal="clip" class="mur__c"><Photo nom="chicken" sizes="(max-width: 820px) 50vw, 30vw" position="50% 50%" /></figure>
        <figure data-reveal="clip" class="mur__d"><Photo nom="assiette" sizes="(max-width: 820px) 50vw, 40vw" /></figure>
        <p class="mur__legende lede">Poké bowls, rolls aux sésames noirs, poulet katsu : à déguster sur place ou à emporter.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-pratique">
    <div class="wrap grille">
      <h2 data-split="lines" class="titre-l pratique__titre" id="titre-pratique">À Namur, Rue Saint-Loup</h2>
      <div class="pratique__horaires">
        <ul class="horaires" aria-label="Horaires">
          {aujourd.map((h) => <li><span>{h.jour}</span><span class="tabulaire">{h.services.map((s) => `${hm(s.debut)} à ${hm(s.fin)}`).join(' · ')}</span></li>)}
        </ul>
      </div>
      <div class="pratique__infos">
        <address class="coord"><span>{restaurant.adresse.rue} {restaurant.adresse.numero}</span><span>{restaurant.adresse.cp} {restaurant.adresse.commune}</span></address>
        <a class="tel-geant" href={`tel:${restaurant.telephone}`}>{restaurant.telephoneAffiche}</a>
        <p class="note">{restaurant.livraison}</p>
        <div class="groupe-boutons">
          <a class="bouton bouton--plein" href={u('/reservation/')}>Réserver et venir</a>
          <a class="bouton" href={restaurant.commande[0].url} rel="noopener" target="_blank">Commander en ligne</a>
        </div>
      </div>
    </div>
  </section>
</Base>
