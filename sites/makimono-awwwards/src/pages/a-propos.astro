---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { restaurant, valeurs } from '../data/site';
---
<Base page="a-propos" title="La maison" description="Makimono, ce qui s’enroule : une cuisine japonaise créative, rapide et fraîche, Rue Saint-Loup à Namur. La salle, la façade, les valeurs de la maison.">
  <section class="page-tete">
    <div class="wrap grille">
      <h1 class="display page-tete__titre" style="grid-column: 1 / -1">La maison</h1>
      <p class="lede page-tete__intro" style="grid-column: 1 / 8">Makimono défie le monde du fast-food avec une approche créative de la cuisine : rapide et frais, à déguster sur place ou à emporter.</p>
    </div>
  </section>

  <section class="section section--serre" aria-labelledby="h-nom">
    <div class="wrap grille maison__ligne">
      <div class="maison__a">
        <h2 class="titre-l" id="h-nom">Un nom qui se déroule</h2>
      </div>
      <div class="maison__b texte">
        <p><i lang="ja">Maki</i> veut dire enroulé, <i lang="ja">mono</i> la chose : un makimono est un rouleau. Celui qu’on ouvre en lisant, et celui qu’on mange, le riz dehors et la garniture dedans.</p>
        <p>La maison se présente comme « creative uramaki made with love ». Sur la carte, chaque roll existe avec plusieurs protéines, et Create.Your.Roll laisse chacun composer le sien.</p>
      </div>
    </div>
  </section>

  <section class="section section--serre" aria-labelledby="h-salle">
    <div class="wrap grille maison__ligne">
      <figure class="bloc-photo" style="grid-column: 1 / 5; margin: 0"><Photo nom="facade" sizes="(max-width: 820px) 100vw, 30vw" ratio="4 / 5" /></figure>
      <figure class="bloc-photo" style="grid-column: 5 / 9; margin: var(--normal) 0 0"><Photo nom="salleFenetres" sizes="(max-width: 820px) 100vw, 30vw" ratio="4 / 5" /></figure>
      <figure class="bloc-photo" style="grid-column: 9 / 13; margin: 0"><Photo nom="salleTables" sizes="(max-width: 820px) 100vw, 30vw" ratio="4 / 5" /></figure>
      <div style="grid-column: 1 / 7">
        <h2 class="titre-l" id="h-salle">La salle, la terrasse</h2>
      </div>
      <p class="texte" style="grid-column: 8 / 13">Une salle de tables en bois clair, de chaises en métal et de grandes fenêtres sur la rue Saint-Loup, avec quelques tables en terrasse devant la façade.</p>
    </div>
  </section>

  <section class="nori section" aria-labelledby="h-valeurs">
    <div class="wrap grille maison__ligne">
      <h2 class="titre-l maison__a" id="h-valeurs">Ce qu’on promet</h2>
      <ul class="valeurs maison__b">{valeurs.map((v) => <li>{v}</li>)}</ul>
    </div>
  </section>

  <section class="section section--serre" aria-labelledby="h-venir">
    <div class="wrap grille maison__ligne">
      <h2 class="titre-l maison__a" id="h-venir">À emporter, livré, traiteur</h2>
      <div class="maison__b texte">
        <p>{restaurant.livraison} La commande en ligne se fait chez Makimono, ou par les services de retrait et de livraison indiqués sur la page de réservation.</p>
        <p style="margin-top: var(--serre)"><a class="bouton bouton--plein" href={u('/reservation/')}>Réserver et venir</a></p>
      </div>
    </div>
  </section>
</Base>
