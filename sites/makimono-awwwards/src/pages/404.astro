---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas : le rouleau s’arrête ici. Revenez à l’accueil de Makimono ou ouvrez la carte, rolls, poké bowls et nigiri à Namur.">
  <section class="perdu nori">
    <div class="wrap">
      <h1 class="display perdu__titre">Rien à dérouler</h1>
      <div class="perdu__rouleau" aria-hidden="true"></div>
      <p class="lede">Cette page n’existe pas, ou plus. Le rouleau s’arrête ici.</p>
      <div class="groupe-boutons" style="margin-top: var(--serre)">
        <a class="bouton bouton--plein" href={u('/')}>Revenir à l’accueil</a>
        <a class="bouton" href={u('/carte/')}>Ouvrir la carte</a>
      </div>
    </div>
  </section>
</Base>
