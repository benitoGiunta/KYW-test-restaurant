---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas sur la maquette de Yayami Sushi : retournez à l’accueil ou à la carte.">
  <section class="perdu wrap">
    <div class="perdu__paire" aria-hidden="true"><span></span><span></span></div>
    <h1 class="display display--xl">Il manque une pièce.</h1>
    <p class="hero__lead">Cette page n’existe pas. Le nigiri, lui, se vend par deux.</p>
    <p class="hero__actions">
      <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
      <a class="cta cta--ligne" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </p>
  </section>
</Base>
