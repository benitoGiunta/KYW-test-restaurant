---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site } from '../data/site';
---
<Base page="a-propos" title="La maison" description="Yayami Sushi, restaurant japonais au 15 rue de Bruxelles à Namur : spécialités, horaires, remise à l’emporter, zone de livraison et moyens de paiement.">
  <section class="entete">
    <div class="wrap cols">
      <h1 class="display display--mega">La maison</h1>
      <p class="entete__intro">Un restaurant japonais de la rue de Bruxelles, à Namur. {site.baseline}.</p>
    </div>
  </section>
  <section class="maison" aria-label="Présentation">
    <div class="wrap cols">
      <div class="maison__texte">
        <p>Yayami Sushi sert des nigiri, des maki, des temaki et des chirashi, mais aussi des plats chauds : nouilles udon sautées, riz japonais, gyoza grillés, yakitori et tempura de crevettes.</p>
        <p>La maison est ouverte tous les jours, à midi et le soir. Horaires, livraison et paiement : voir la page <a class="lien" href={u('/reservation/')}>Commander</a>.</p>
      </div>
      <div class="maison__photos">
        <figure><Photo cle="chirashi" widths={[480, 800]} sizes="(max-width: 52rem) 100vw, 40vw" /></figure>
        <figure data-reveal="clip"><Photo cle="tempura" widths={[480, 800]} sizes="(max-width: 52rem) 100vw, 40vw" /></figure>
      </div>
    </div>
  </section>
</Base>
