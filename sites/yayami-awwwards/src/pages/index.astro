---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, services, categories, menus, euro, prixMini } from '../data/site';
const tel = site.telephoneLisible;
const aMenus = ['Menu Matsu', 'Chirashi bowl', 'Menu Sapporo', 'Menu Osaka'];
const menusChoisis = aMenus.map((n) => menus.find((m) => m.nom === n)!);
const photoMenu: Record<string, 'matsu' | 'chirashi' | undefined> = { 'Menu Matsu': 'matsu', 'Chirashi bowl': 'chirashi' };
---
<Base page="accueil">
  <section class="hero" aria-labelledby="titre-accueil">
    <div class="wrap">
      <div class="cols hero__grille">
        <div class="hero__texte">
          <h1 id="titre-accueil" class="display display--xl hero__titre">Yayami<br />Sushi</h1>
          <p class="hero__lead">Restaurant japonais à Namur. Nigiri, maki, plats chauds&nbsp;: à emporter ou livrés chez vous.</p>
          <div class="hero__actions">
            <a class="cta" href={site.telephoneHref}><span class="cta__txt">Appeler le <span class="nw chiffre">{tel}</span></span></a>
            <a class="cta cta--ligne" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
          </div>
        </div>
        <figure class="hero__media" data-hero-media>
          <Photo cle="nigiri" widths={[640, 960, 1280]} sizes="(max-width: 52rem) 100vw, 55vw" prioritaire />
          <div class="pose hero__pose" data-paire data-loin="70,-95">
            <div class="sceau" role="img" aria-label="Nigiri : 4,50 euros les deux pièces" data-piece="sceau">
              <span class="sceau__haut">Nigiri</span><span class="sceau__prix chiffre">4,50&nbsp;€</span><span class="sceau__bas">les deux pièces</span>
            </div>
            <svg class="jumeau" viewBox="0 0 100 100" aria-hidden="true" focusable="false" data-piece="jumeau"><circle cx="50" cy="50" r="48" /></svg>
          </div>
        </figure>
      </div>
      <p class="hero__bas" data-reveal="fade" data-intro data-delay="0.5">
        <span><strong>{site.adresse.rue} {site.adresse.numero}</strong>, {site.adresse.cp} {site.adresse.commune}</span>
        <span><strong>7 jours sur 7</strong>, {services[0].libelle.toLowerCase()} et {services[1].libelle.toLowerCase()}</span>
        <span class="petit">{site.baseline}</span>
      </p>
    </div>
  </section>

  <section class="riz" aria-labelledby="titre-paire">
    <div class="wrap">
      <div class="cols">
        <h2 id="titre-paire" class="display display--l riz__phrase" data-split="lines">On vend le nigiri par deux. La maison aussi va par paires&nbsp;: à emporter ou chez vous.</h2>
      </div>
      <div class="paire">
        <div class="paire__cellule" data-reveal="up">
          <p class="paire__chiffre chiffre">−{site.emporterRemise}&nbsp;%</p>
          <h3 class="paire__titre">Vous venez le chercher</h3>
          <p class="petit">Remise de {site.emporterRemise}&nbsp;% pour toute commande retirée au {site.adresse.numero} {site.adresse.rue.charAt(0).toLowerCase() + site.adresse.rue.slice(1)}.</p>
        </div>
        <div class="paire__cellule" data-reveal="up" data-delay="0.08">
          <p class="paire__chiffre chiffre">{site.livraison.seuil}&nbsp;€</p>
          <h3 class="paire__titre">On vous le livre</h3>
          <p class="petit">Livraison gratuite à partir de {site.livraison.seuil}&nbsp;€, à Namur et dans six codes postaux voisins.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="index" aria-labelledby="titre-index">
    <div class="wrap cols">
      <div class="index__tete">
        <h2 id="titre-index" class="display display--xl" data-split="lines">La carte</h2>
        <a class="cta cta--ligne" href={u('/carte/')}><span class="cta__txt">Toute la carte</span></a>
      </div>
      <ul class="index__liste">
        {categories.map((c) => (
          <li>
            <a class="index__ligne" href={u(`/carte/#${c.nom.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, '-')}`)}>
              <span class="index__nom">{c.nom}</span>
              <span class="index__des chiffre">{c.plats.length}&nbsp;références, dès {euro(prixMini(c.nom))}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="index__media">
        <figure data-reveal="clip"><Photo cle="california" widths={[480, 800]} sizes="(max-width: 52rem) 100vw, 30vw" /></figure>
        <figure data-reveal="clip" data-delay="0.08"><Photo cle="assortiment" widths={[480, 800]} sizes="(max-width: 52rem) 100vw, 30vw" /></figure>
      </div>
    </div>
  </section>

  <section class="menus" aria-labelledby="titre-menus">
    <div class="wrap menus__tete">
      <h2 id="titre-menus" class="display display--l" data-split="lines">Les menus</h2>
      <a class="lien" href={u('/carte/#menus')}>Les neuf menus</a>
    </div>
    <ul class="menus__piste" tabindex="0" aria-label="Menus, défilement horizontal">
      {menusChoisis.map((m, i) => (
        <li class="menu-carte" data-reveal="up" data-delay={(i * 0.06).toFixed(2)}>
          {photoMenu[m.nom] && <Photo cle={photoMenu[m.nom]!} widths={[480, 800]} sizes="(max-width: 40rem) 80vw, 24rem" />}
          <h3 class="titre-m">{m.nom}</h3>
          <p class="menu-carte__prix chiffre">{euro(m.prix)}</p>
          {m.detail && <p>{m.detail}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="zone" aria-labelledby="titre-zone">
    <div class="wrap cols">
      <h2 id="titre-zone" class="display display--xl zone__titre" data-split="lines">Sept codes postaux</h2>
      <div class="zone__texte">
        <p>La livraison est gratuite dès {site.livraison.seuil}&nbsp;€ dans ces codes postaux autour de Namur.</p>
        <a class="cta" href={u('/reservation/')}><span class="cta__txt">Commander</span></a>
      </div>
      <ul class="zone__codes" aria-label="Codes postaux livrés">
        {site.livraison.codes.map((c, i) => <li class="chiffre" data-reveal="up" data-delay={(i * 0.05).toFixed(2)}>{c}</li>)}
      </ul>
    </div>
  </section>
</Base>
