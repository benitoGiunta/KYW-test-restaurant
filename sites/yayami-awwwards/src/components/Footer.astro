---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { site, services } from '../data/site';
---
<section class="pied" aria-label="Contact et horaires">
  <div class="wrap pied__corps">
    <p class="pied__mot" aria-hidden="true">Deux<br />pièces<span>.</span></p>
    <div class="pied__col">
      <h2 class="pied__titre">Venir chercher</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Ouvert 7 jours sur 7</h2>
      <ul class="pied__horaires">
        {services.map((s) => <li><span>Tous les jours</span><span class="chiffre">{s.libelle}</span></li>)}
      </ul>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Appeler</h2>
      <p><a class="pied__tel" href={site.telephoneHref}>{site.telephoneLisible}</a></p>
      <p class="petit">{site.emporterRemise}&nbsp;% de remise à l’emporter, livraison offerte dès {site.livraison.seuil}&nbsp;€.</p>
    </div>
    <div class="pied__cta">
      <a class="cta" href={u('/reservation/')}><span class="cta__txt">Commander</span></a>
      <a class="cta cta--ligne" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </div>
    <p class="pied__colophon">{site.credit}. Polices : Shippori Mincho (Fontworks) et Hanken Grotesk (Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
