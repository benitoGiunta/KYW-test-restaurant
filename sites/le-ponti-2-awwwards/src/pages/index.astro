---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Pont from '../components/Pont.astro';
import { u, prix } from '../lib/url';
import { site, familles, creneaux, jours, menu } from '../data/site';
const trois = [
  { cle: 'pates', photo: 'pates', titre: 'Les pâtes', texte: `${familles.pates.n} sauces, au choix en spaghetti, penne ou tagliatelle.`, prix: `${prix(familles.pates.min)} à ${prix(familles.pates.max)}` },
  { cle: 'pizzas', photo: 'pizza', titre: 'Les pizzas', texte: `${familles.pizzas.n} références, de la Margherita à la Maison.`, prix: `${prix(familles.pizzas.min)} à ${prix(familles.pizzas.max)}` },
  { cle: 'escalopes', photo: 'escalopes', titre: 'Les escalopes de veau', texte: 'Panées, gratinées, piccata ou saltimbocca à la romana.', prix: `${prix(familles.escalopes.min)} à ${prix(familles.escalopes.max)}` },
] as const;
---
<Base page="accueil" description={site.description}>
  <section class="wrap grille hero" aria-label="Le Ponti 2">
    <div class="hero__texte">
      <h1 class="hero__titre"><span>Le Ponti</span><span class="deux it">2</span></h1>
      <p class="hero__pitch">{site.baseline}</p>
      <div class="hero__actions">
        <a class="cta" href={u('/reservation/')}>Réserver une table</a>
        <a class="cta cta--fantome" href={site.telephone.href}>Appeler le <span class="nw">{site.telephone.lisible}</span></a>
      </div>
      <p class="hero__heures petit">Du mardi au dimanche, midi et soir. Le lundi, le pont est levé.</p>
    </div>
    <figure class="arche hero__media"><Photo cle="pates" sizes="(min-width: 64rem) 36vw, 90vw" largeurs={[480, 800, 1100]} prioritaire position="40% 55%" /></figure>
    <div class="hero__pont"><Pont id="pont-hero" /></div>
  </section>

  <section class="enonce" aria-labelledby="enonce">
    <div class="wrap grille"><h2 class="enonce__texte" id="enonce" data-split="lines">{familles.pizzas.n} pizzas, {familles.pates.n} pâtes, des escalopes de veau : trois arches pour <span class="it">traverser la carte.</span></h2></div>
  </section>

  <section class="wrap arches" aria-labelledby="arches-t">
    <div class="arches__tete">
      <h2 id="arches-t" class="sr-only">Les trois spécialités</h2>
      <p class="util">Trois arches, une carte</p>
      <a class="lien" href={u('/carte/')}>Voir toute la carte</a>
    </div>
    <ul class="arches__rang" data-arches>
      {trois.map((t) => (
        <li class="arches__item">
          <a href={u(`/carte/#${t.cle === 'escalopes' ? 'escalopes-de-veau-panees' : t.cle}`)} aria-label={`${t.titre}, ${t.prix}`}>
            <figure class="arche" data-arche><Photo cle={t.photo} sizes="(min-width: 48rem) 30vw, 72vw" largeurs={[400, 700, 1000]} /></figure>
            <h3>{t.titre}</h3>
            <p>{t.texte}</p>
            <span class="arches__prix lien">{t.prix}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="menu" aria-label="Menu trois services">
    <div class="wrap">
      <div class="menu__prix">
        <p class="util">{menu.nom}</p>
        <p class="display" aria-label={`${menu.prix} euros`}>{menu.prix}<span aria-hidden="true">&nbsp;€</span></p>
        <p>Une entrée, un plat, un dessert : le pont en entier.</p>
      </div>
      <ul class="menu__liste" id="menu-t" data-reveal="up" aria-label="Composition du menu">
        {menu.services.map((s) => <li><h3>{s.titre}</h3><p>{s.texte}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="wrap grille adresse" aria-labelledby="adresse-t">
    <figure class="arche adresse__media" data-arche><Photo cle="facade" sizes="(min-width: 48rem) 36vw, 80vw" largeurs={[480, 800, 1100]} position="50% 35%" /></figure>
    <div class="adresse__texte">
      <h2 id="adresse-t" data-split="lines">À Jambes, <span class="it">sous l’enseigne.</span></h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <ul class="heures" aria-label="Horaires">
        {jours.map((j) => j.ferme
          ? <li class="ferme"><span>{j.jour}</span><span>Fermé, le pont est levé</span></li>
          : <li><span>{j.jour}</span><span>{creneaux.midi} · {creneaux.soir}</span></li>)}
      </ul>
      <p class="petit">Terrasse lorsque la météo le permet.</p>
      <p class="adresse__plan"><a class="lien" href={site.planUrl} rel="noopener noreferrer">Ouvrir le plan</a></p>
    </div>
  </section>
</Base>
