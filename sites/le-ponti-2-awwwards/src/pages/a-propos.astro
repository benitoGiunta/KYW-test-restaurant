---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, histoire, familles } from '../data/site';
---
<Base page="apropos" title="La maison" description="Le Ponti 2, restaurant italien et pizzeria de Jambes à Namur : une maison familiale, une carte de pizzas, de pâtes et d’escalopes de veau, des desserts faits maison.">
  <section class="wrap page-tete">
    <h1>La maison</h1>
    <p data-reveal="fade" data-intro data-delay="0.2">{site.baseline}</p>
  </section>
  <div class="wrap grille maison">
    <div class="maison__texte">
      {histoire.map((p) => <p>{p}</p>)}
      <p style="margin-top:1.5rem"><a class="cta" href={u('/carte/')}>Voir la carte</a></p>
    </div>
    <figure class="arche maison__media" data-arche><Photo cle="pizza" sizes="(min-width: 48rem) 36vw, 80vw" largeurs={[480, 800, 1100]} position="55% 50%" /></figure>
    <figure class="arche maison__bande" data-arche><Photo cle="escalopes" sizes="100vw" largeurs={[800, 1200, 1600]} position="50% 60%" /></figure>
  </div>
  <section class="wrap" style="padding-block: 2rem 6rem">
    <p class="petit">{site.credit}. Le restaurant est présenté tel que son site actuel le décrit ({familles.pizzas.n} pizzas, {familles.pates.n} pâtes, escalopes de veau).</p>
  </section>
</Base>
