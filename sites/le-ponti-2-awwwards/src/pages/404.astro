---
import Base from '../layouts/Base.astro';
import Pont from '../components/Pont.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas sur le site du Ponti 2. Retour à l’accueil, à la carte ou à la réservation.">
  <section class="wrap perdu" data-state="0.5">
    <h1>Pont coupé.</h1>
    <p>Cette page est restée sur l’autre rive. Revenez à l’accueil, ou allez droit à la carte.</p>
    <Pont id="pont-404" />
    <p style="margin-top:0"><a class="cta" href={u('/')}>Retour à l’accueil</a> <a class="cta cta--fantome" href={u('/carte/')}>La carte</a></p>
  </section>
</Base>
