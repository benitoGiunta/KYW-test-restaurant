---
// Le pont : tablier + arches répétées sur toute la largeur (filet doré). Décoratif.
const { id = 'pont' } = Astro.props;
---
<svg class="pont" data-pont aria-hidden="true" focusable="false" preserveAspectRatio="none" viewBox="0 0 1200 64">
  <defs>
    <pattern id={id} width="200" height="64" patternUnits="userSpaceOnUse">
      <path d="M0 6H200M16 64V44C16 8 90 8 90 44V64M110 64V44C110 8 184 8 184 44V64" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </pattern>
  </defs>
  <rect width="1200" height="64" fill={`url(#${id})`} />
</svg>
