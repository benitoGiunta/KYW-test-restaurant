---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { site, services, joursOuverts } from '../data/site';
---
<section class="pied" aria-label="Contact et horaires">
  <div class="wrap pied__corps">
    <p class="pied__mot" aria-hidden="true" data-split="words">Reste&nbsp;: la&nbsp;table.</p>
    <div class="pied__col">
      <h2 class="pied__titre">Venir</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}<br /><span class="pied__doux">Terrasse sur les jardins</span></address>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Service</h2>
      <ul class="pied__horaires">
        <li><span>Mercredi à samedi</span><span>{services[0].libelle}</span></li>
        <li><span>Mercredi à samedi</span><span>{services[1].libelle}</span></li>
        <li><span>Dimanche à mardi</span><span>Fermé</span></li>
      </ul>
    </div>
    <div class="pied__col">
      <h2 class="pied__titre">Contact</h2>
      <p><a class="pied__tel" href={site.telephoneHref}>{site.telephoneLisible}</a><br /><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="pied__reseaux">
        {site.reseaux.map((r) => <li><a class="lien-util" href={r.url} rel="noopener">{r.nom}</a></li>)}
      </ul>
    </div>
    <div class="pied__cta"><a class="cta cta--nuit" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a></div>
    <p class="pied__colophon">{site.credit}. Polices : Boska (Indian Type Foundry, Fontshare) et Hanken Grotesk (Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
