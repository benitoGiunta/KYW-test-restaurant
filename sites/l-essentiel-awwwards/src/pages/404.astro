---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" page="404" description="Cette page n’existe pas sur la maquette de L’Essentiel : il ne reste que l’essentiel, la carte, la réservation et l’accueil.">
  <section class="erreur wrap" aria-labelledby="h1">
    <p class="erreur__code">Erreur 404</p>
    <h1 id="h1" class="display erreur__titre"><s class="biffe">Cette page</s> a été retirée.</h1>
    <p class="erreur__texte">Comme chez nous, il ne reste que l’essentiel&nbsp;:</p>
    <ul class="erreur__liens">
      <li><a class="cta" href={u('/')}><span class="cta__txt">L’accueil</span></a></li>
      <li><a class="cta cta--vide" href={u('/carte/')}><span class="cta__txt">La carte</span></a></li>
      <li><a class="cta cta--vide" href={u('/reservation/')}><span class="cta__txt">Réserver</span></a></li>
    </ul>
  </section>
</Base>
