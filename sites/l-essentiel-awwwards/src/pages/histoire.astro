---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, histoire, equipe, chambres } from '../data/site';
---
<Base title="La maison" page="histoire" description="L’Essentiel à Temploux : une ancienne tannerie du XVIIe siècle, plusieurs salles, une terrasse sur les jardins et quatre chambres d’hôtes dans une maison à colombages.">
  <section class="page-tete wrap" aria-labelledby="h1">
    <h1 id="h1" class="display page-tete__titre">Une tannerie, une table.</h1>
    <p class="page-tete__chapeau" data-split="lines" data-intro data-delay="0.15">{histoire.lieu}</p>
  </section>

  <section class="mur wrap" aria-label="Les salles">
    <figure class="mur__a"><Photo cle="rideaux" widths={[640, 1000, 1600]} sizes="(min-width: 64rem) 60vw, 100vw" prioritaire /></figure>
    <figure class="mur__b" data-reveal="clip"><Photo cle="arche" widths={[480, 800, 1200]} sizes="(min-width: 64rem) 28vw, 70vw" /></figure>
    <figure class="mur__c" data-reveal="clip"><Photo cle="ronde" widths={[480, 800, 1200]} sizes="(min-width: 64rem) 28vw, 70vw" /></figure>
    <figure class="mur__d" data-reveal="clip"><Photo cle="tulipes" widths={[640, 1000, 1600]} sizes="(min-width: 64rem) 60vw, 100vw" /></figure>
  </section>

  <section class="wrap histoire-bloc" aria-labelledby="h-accueil">
    <div class="marge">
      <h2 id="h-accueil" class="marge__titre" data-reveal="fade">L’accueil</h2>
      <div class="marge__corps texte">
        <p>{histoire.accueil}</p>
        <p>{histoire.cuisine}</p>
        <p>{histoire.terrasse}</p>
        <ul class="equipe">
          <li><span class="equipe__nom">{equipe.accueil.nom}</span><span class="equipe__role">{equipe.accueil.role}</span></li>
          <li><span class="equipe__nom">{equipe.chef.nom}</span><span class="equipe__role">{equipe.chef.role}, information à confirmer</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="nuit chambres" aria-labelledby="h-chambres">
    <div class="wrap marge">
      <h2 id="h-chambres" class="marge__titre" data-reveal="fade">Les chambres</h2>
      <div class="marge__corps">
        <p class="titre-section" data-split="words">Quatre chambres, à 800&nbsp;m.</p>
        <p class="chambres__intro">{chambres.intro} {chambres.equipement}</p>
        <ul class="chambres__noms">{chambres.noms.map((n) => <li>{n}</li>)}</ul>
        <dl class="tarifs">
          {chambres.tarifs.map((t) => <div class="tarif"><dt>{t.nom}</dt><dd class="prix">{t.prix}</dd></div>)}
        </dl>
      </div>
    </div>
    <ul class="bandes bandes--nuit wrap" aria-label="Les chambres d’hôtes">
      <li data-reveal="clip"><Photo cle="chambre1" widths={[480, 800, 1200]} sizes="(min-width: 48rem) 33vw, 80vw" /></li>
      <li data-reveal="clip"><Photo cle="chambre2" widths={[480, 800, 1200]} sizes="(min-width: 48rem) 33vw, 80vw" /></li>
      <li data-reveal="clip"><Photo cle="chambre3" widths={[480, 800, 1200]} sizes="(min-width: 48rem) 33vw, 80vw" /></li>
    </ul>
    <figure class="maison wrap"><Photo cle="maison" widths={[480, 700]} sizes="(min-width: 48rem) 40vw, 90vw" /><figcaption>La maison à colombages des chambres d’hôtes.</figcaption></figure>
  </section>

  <section class="cloture wrap" aria-labelledby="h-cloture">
    <p id="h-cloture" class="titre-section" data-split="words">Venir à Temploux.</p>
    <div class="hero__actions">
      <a class="cta" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a>
      <a class="cta cta--vide" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </div>
  </section>
</Base>
