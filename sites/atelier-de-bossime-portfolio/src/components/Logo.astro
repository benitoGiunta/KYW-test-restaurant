---
// Marque « Bossimé » d’après le logo du restaurant : serif, et trois accents orange sur le E (un par pilier de la durabilité).
// Le nom accessible reste « L’Atelier de Bossimé » (texte sr-only), le dessin est décoratif.
const { classe = '' } = Astro.props;
---
<span class={`logo ${classe}`}>
  <span class="sr-only">L’Atelier de Bossimé</span>
  <span class="logo__mot" aria-hidden="true">Bossim<span class="logo__e">e<svg class="logo__accents" viewBox="0 0 24 14" focusable="false"><path d="M5 13 L9 2 M11 13 L15 2 M17 13 L21 2" /></svg></span></span>
  <span class="logo__sous" aria-hidden="true">Ferme gastronomique</span>
</span>
