---
// Branche à 12 feuilles : une par mois, la courante en rose (CSS sur html[data-mois]). Décorative.
const { classe = '' } = Astro.props;
---
<svg class={`branche ${classe}`} viewBox="0 0 320 44" aria-hidden="true" focusable="false">
  <path class="branche__tige" d="M4 22 H316" stroke="currentColor" stroke-width="1.5" fill="none" data-loader-bar />
  {Array.from({ length: 12 }, (_, i) => {
    const x = 18 + i * 26; const haut = i % 2 === 0;
    const d = haut ? `M${x} 22 C${x - 7} 14 ${x - 4} 5 ${x + 1} 3 C${x + 8} 7 ${x + 7} 17 ${x} 22Z` : `M${x} 22 C${x - 7} 30 ${x - 4} 39 ${x + 1} 41 C${x + 8} 37 ${x + 7} 27 ${x} 22Z`;
    return <path class="branche__feuille" data-feuille={String(i + 1)} d={d} />;
  })}
</svg>
