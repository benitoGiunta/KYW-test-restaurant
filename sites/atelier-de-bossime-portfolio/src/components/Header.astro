---
import { site } from '../data/site';
import { u } from '../lib/url';
import Logo from './Logo.astro';
const liens = [
  { href: u('/'), label: 'Accueil' },
  { href: u('/carte/'), label: 'La carte' },
  { href: u('/saisons/'), label: 'Saisons' },
  { href: u('/ferme/'), label: 'La ferme' },
  { href: u('/histoire/'), label: 'Histoire' },
  { href: u('/reservation/'), label: 'Réserver' },
];
const ici = Astro.url.pathname.replace(/\/+$/, '');
const courant = (href: string) => (href.replace(/\/+$/, '') === ici ? 'page' : undefined);
---
<header class="header">
  <div class="wrap header__inner">
    <a class="header__brand" href={u('/')}><Logo /></a>
    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
    </nav>
  </div>
</header>
