---
import Base from '../layouts/Base.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const photos = ['/photos/plat-volaille-carottes.webp', '/photos/dessert-chocolat.webp'].map(photoDe);
---
<Base title="La carte" description="La carte de L’Atelier de Bossimé à Loyers (Namur) : lunch 2 ou 3 services, menus de 3 à 7 Moments à composer ou en carte blanche, boissons.">
  <section class="hero wrap" data-hero>
    <p class="meta hero__sur">La carte</p>
    <h1 class="mots" data-mots><span>Lunch et</span><span>Moments</span></h1>
    <p class="hero__accroche">Aucun plat n’est écrit ici : la carte change avec le potager. À table, un livret vous permet de composer vos Moments ; le menu surprise, historique, reste possible.</p>
  </section>

  {site.carte.map((cat, ci) => (
    <section class="section">
      <div class="col">
        <h2 class="statement" data-split="lines">{cat.categorie}</h2>
        <ul class="carte-liste" data-reveal="fade">
          {cat.plats.map((p) => (
            <li class="plat">
              <span class="plat__nom">{p.nom}{p.placeholder && <span class="exemple">exemple</span>}{p.description && <span class="plat__desc">{p.description}</span>}</span>
              {p.prix && <span class="plat__prix">{p.prix}</span>}
            </li>
          ))}
        </ul>
        {ci === 0 && <p class="centre muted" data-reveal="fade">Pressé ? Le lunch peut être servi en une heure, sur demande.</p>}
        {ci === 1 && <p class="centre muted" data-reveal="fade">Allergies ou intolérances : signalez-les à la réservation.</p>}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="col">
      <h2 class="statement" data-split="lines">Les soirées et les chèques-cadeaux</h2>
      <ul class="carte-liste" data-reveal="fade">
        {site.menus.slice(2).map((m) => (
          <li class="plat">
            <span class="plat__nom">{m.nom}{m.placeholder && <span class="exemple">modalités à confirmer</span>}<span class="plat__desc">{m.description}</span></span>
            <span class="plat__prix">{m.prix}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--fin">
    <div class="wrap escalier">
      {photos.map((p) => <figure class="vignette" data-reveal="clip" data-cursor="Voir"><img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" /></figure>)}
    </div>
    <div class="col actions"><a class="btn" href={u('/reservation/')}>Réserver une table</a><a class="btn btn--ligne" href={u('/saisons/')}>Les saisons</a></div>
  </section>
</Base>
