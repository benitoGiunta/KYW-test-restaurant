---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n’existe pas ou plus." canonical={false}>
  <section class="wrap page-404">
    <p class="meta">Erreur 404</p>
    <h1 class="mots"><span>Rien de mûr</span><span>ici</span></h1>
    <p class="lead">La page que vous cherchez n’existe pas ou plus.</p>
    <div class="actions"><a class="btn" href={u('/')}>Retour à l’accueil</a><a class="btn btn--ligne" href={u('/carte/')}>La carte</a></div>
  </section>
</Base>
