---
// En-tête : marque à gauche, navigation avec une ligne mono sous chaque entrée (le fait utile du moment).
import { site } from '../data/site';
import { u } from '../lib/url';
const liens = [
  { href: u('/carte/'), label: 'La carte', sous: 'midi et soir' },
  { href: u('/ecailler/'), label: 'L’écailler', sous: 'du jeudi au lundi', mobileHide: true },
  { href: u('/terrasse/'), label: 'La terrasse', sous: 'chauffée, sur la Meuse', mobileHide: true },
  { href: u('/histoire/'), label: 'La maison', sous: 'Martin et Rémy' },
  { href: u('/reservation/'), label: 'Réserver', sous: '081 65 70 03' },
];
const ici = Astro.url.pathname.replace(/\/+$/, '');
const courant = (href: string) => (href.replace(/\/+$/, '') === ici ? 'page' : undefined);
---
<header class="header">
  <div class="wrap header__inner">
    <a class="header__brand" href={u('/')} aria-label={`${site.nom}, accueil`}>{site.nom}</a>
    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => (
        <a href={l.href} aria-current={courant(l.href)} data-mobile-hide={l.mobileHide ? '' : undefined}>
          <span class="nav__label">{l.label}</span><span class="nav__sous mono">{l.sous}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
