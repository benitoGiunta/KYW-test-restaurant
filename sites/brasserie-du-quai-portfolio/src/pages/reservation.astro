---
import Base from '../layouts/Base.astro';
import Houle from '../components/Houle.astro';
import Maree from '../components/Maree.astro';
import Plan from '../components/Plan.astro';
import { site, adresseLigne, telHref, bonCadeau } from '../data/site';
---
<Base title="Réserver" description={`Réserver une table chez ${site.nom} à Namur : en ligne sur la page Réservation de la maison ou par téléphone au 081 65 70 03.`}>
  <section class="hero hero--texte" aria-labelledby="t-resa">
    <div class="wrap hero__bas">
      <h1 id="t-resa" style="font-size: var(--t-xl)">Une table au bord de la Meuse</h1>
      <p class="lead" style="margin-top: calc(var(--u) * 3)">En ligne sur {site.reservation.outil}, ou par téléphone, aux heures d’ouverture.</p>
    </div>
  </section>

  <section class="sec sec--eau" aria-label="Réserver">
    <Houle fill="eau" />
    <div class="wrap resa">
      <div class="stack">
        <a class="btn btn--plein btn--large" href={site.reservation.url} rel="noopener" data-magnetic="0.15">Réserver en ligne</a>
        <p class="mono muted" style="margin-top: calc(var(--u) * 3)">Téléphone</p>
        <p class="resa__tel"><a href={telHref()}>{site.telephone}</a></p>
        <p class="mono muted" style="margin-top: calc(var(--u) * 3)">E-mail</p>
        <p><a class="link" href={`mailto:${site.email.valeur}`}>{site.email.valeur}</a>{site.email.placeholder ? <span class="muted"> (adresse illustrative)</span> : null}</p>
        <p class="mono muted" style="margin-top: calc(var(--u) * 3)">Adresse</p>
        <address style="font-style: normal">{adresseLigne()}</address>
        <p class="mono muted" style="margin-top: calc(var(--u) * 3)">Bon cadeau</p>
        <p><a class="link" href={bonCadeau.url} rel="noopener">Offrir un bon cadeau, en ligne</a></p>
      </div>
      <form class="form" data-reveal="up" data-reservation action={site.reservation.url} method="get" aria-label="Demande de réservation">
        <p class="muted">Formulaire de démonstration sans envoi : la validation vous conduit vers {site.reservation.outil}.</p>
        <label>Nom <input type="text" name="nom" autocomplete="name" required /></label>
        <div class="deux">
          <label>Date <input type="date" name="date" required /></label>
          <label>Heure <input type="time" name="heure" required /></label>
        </div>
        <label>Couverts <input type="number" name="couverts" min="1" max="12" value="2" required /></label>
        <label>Message <textarea name="message" rows="3"></textarea></label>
        <div class="actions" style="margin-top: 0"><button class="btn btn--plein" type="submit">Continuer vers la réservation</button></div>
        <p class="mono muted" role="status" aria-live="polite" data-etat-form></p>
      </form>
    </div>
  </section>

  <section class="sec sec--ciel" aria-label="Horaires">
    <Houle fill="ciel" />
    <div class="wrap"><Maree /></div>
  </section>

  <section class="sec sec--eau sec--fin" aria-label="Le plan">
    <Houle fill="eau" />
    <div class="wrap"><Plan /></div>
  </section>
</Base>

<script>
  import { onPage } from '../engine';
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-reservation]');
    if (!form) return;
    const etat = form.querySelector<HTMLElement>('[data-etat-form]');
    const date = form.querySelector<HTMLInputElement>('input[type="date"]');
    if (date) date.min = new Date().toISOString().slice(0, 10); // pas de réservation dans le passé
    const go = (e: SubmitEvent) => {
      e.preventDefault();
      if (etat) etat.textContent = 'Merci. La page de réservation de la maison s’ouvre dans un nouvel onglet ; rien n’a été envoyé depuis cette maquette.';
      window.open(form.action, '_blank', 'noopener');
    };
    form.addEventListener('submit', go);
    return () => form.removeEventListener('submit', go);
  });
</script>
