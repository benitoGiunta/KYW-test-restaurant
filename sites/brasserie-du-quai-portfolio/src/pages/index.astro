---
import Base from '../layouts/Base.astro';
import Houle from '../components/Houle.astro';
import Maree from '../components/Maree.astro';
import Plan from '../components/Plan.astro';
import { site, photoDe, arrivages, regles, univers, citationTerrasse, telHref, carteSalle, bonCadeau, presse } from '../data/site';
import { u, asset } from '../lib/url';
const hero = photoDe('/photos/terrasse-meuse.webp'); // la terrasse face à la Meuse : l'horizon du gabarit, en vrai
const plateau = photoDe('/photos/huitres.webp');
const terrasse = photoDe('/photos/salle-baies-vitrees.webp');
// Quelques plats de la carte réelle (un par famille), avec leur prix.
const choix = [
  carteSalle[0].plats[0], carteSalle[0].plats[4], carteSalle[1].plats[2],
  carteSalle[1].plats[4], carteSalle[2].plats[5], carteSalle[2].plats[3],
];
const nomL2 = site.nom.split(' du ');
---
<Base theme="photo">
  <link slot="head" rel="preload" as="image" href={asset(hero.src)} fetchpriority="high" />
  <section class="hero" data-hero aria-labelledby="titre-hero">
    <div class="hero__media" data-hero-media>
      <img src={asset(hero.src)} alt={hero.alt} width={hero.largeur} height={hero.hauteur} fetchpriority="high" decoding="async" data-critical />
    </div>
    <div class="hero__ctas">
      <a class="btn" href={u('/reservation/')} data-magnetic="0.2">Réserver</a>
      <a class="btn" href={u('/terrasse/')}>La terrasse</a>
      <a class="btn" href={bonCadeau.url} rel="noopener">Bon cadeau</a>
    </div>
    <div class="hero__bas">
      <h1 class="nom" id="titre-hero">
        <span class="nom__l1" data-fit><span class="nom__w" data-fit>{nomL2[0]}</span> <span class="nom__w" data-fit>du {nomL2[1]}</span></span>
      </h1>
      <div class="wrap">
        <ul class="hero__univers mono" data-hero-apres>
          {univers.map((m) => <li>{m.mot}</li>)}
        </ul>
      </div>
    </div>
    <svg class="hero__sep" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path data-houle d="M0,40 L1440,40 L1440,80 L0,80 Z" /></svg>
  </section>

  <section class="sec sec--ciel hero__accroche" aria-label="Accroche">
    <div class="wrap grid12">
      <div class="col-texte">
        <p class="lead">{site.baseline}</p>
        <p class="muted" style="margin-top: calc(var(--u) * 2); max-width: 48ch">{site.histoire[0]} Une cuisine de brasserie authentique et variée, de produits frais, et un banc d’écailler du jeudi au lundi.</p>
        <div class="actions">
          <a class="btn btn--plein" href={u('/reservation/')}>Réserver une table</a>
          <a class="btn" href={u('/carte/')}>Voir la carte</a>
        </div>
      </div>
      <div class="col-droite">
        <Maree />
      </div>
    </div>
  </section>

  <section class="sec sec--eau" aria-labelledby="t-ecailler">
    <Houle fill="eau" />
    <div class="wrap paire">
      <figure class="media media--bord" data-reveal="clip" data-cursor="Voir">
        <img src={asset(plateau.src)} alt={plateau.alt} width={plateau.largeur} height={plateau.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
        <figcaption class="mono">Huîtres sur glace, citron · photo de la maison</figcaption>
      </figure>
      <div>
        <span class="eyebrow mono" data-reveal="fade">L’écailler, du jeudi au lundi</span>
        <h2 id="t-ecailler" style="font-size: var(--t-xl)" data-split="words">Normandes, Fines de Claire, Gillardeaux</h2>
        <ol class="index" style="margin-top: calc(var(--u) * 3)" data-reveal="up">
          {arrivages.map((a, i) => (
            <li>
              <span class="index__num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="index__nom">{a.nom}<span class="index__desc">{a.detail}</span></span>
              <span class="index__prix"><span class="mono">{a.prix}</span></span>
            </li>
          ))}
        </ol>
        <p class="actions"><a class="link flèche" href={u('/ecailler/')}>Le banc d’écailler et les plateaux</a></p>
      </div>
    </div>
  </section>

  <section class="sec sec--ciel" aria-labelledby="t-carte">
    <Houle fill="ciel" />
    <div class="wrap grid12">
      <div class="col-texte">
        <h2 id="t-carte" style="font-size: var(--t-xl)" data-split="words">Une vraie carte de brasserie</h2>
        <p class="muted" style="margin-top: calc(var(--u) * 2); max-width: 44ch">Chaque semaine, une sélection de suggestions de saison complète la carte.</p>
      </div>
      <div class="col-large">
        <ol class="index" style="margin-top: calc(var(--u) * 2)" data-reveal="up">
          {choix.map((p, i) => (
            <li>
              <span class="index__num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="index__nom">{p.nom}{p.description ? <span class="index__desc">{p.description}</span> : null}</span>
              <span class="index__prix">{p.prix}</span>
            </li>
          ))}
        </ol>
        <div class="actions">
          <a class="btn" href={u('/carte/')}>La carte complète</a>
          <span class="badge badge--sable" style="align-self: center">frites à la graisse de bœuf</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--eau terrasse" aria-label="La salle et la terrasse">
    <Houle fill="eau" />
    <figure class="media media--fond media--sous-eau" aria-hidden="true">
      <img src={asset(terrasse.src)} alt="" width={terrasse.largeur} height={terrasse.hauteur} loading="lazy" decoding="async" data-parallax="0.12" />
    </figure>
    <div class="wrap">
      <p class="citation" data-split="chars">{citationTerrasse.texte}</p>
      <p class="mono">La salle, côté Meuse · <a class="link" href={u('/terrasse/')} style="color: inherit">la terrasse</a></p>
    </div>
  </section>

  <section class="sec sec--ciel" aria-labelledby="t-regles">
    <Houle fill="ciel" />
    <div class="wrap grid12">
      <div class="col-texte">
        <h2 id="t-regles" style="font-size: var(--t-l); font-weight: 500" data-split="words">Ce qu’il faut savoir avant de s’asseoir</h2>
      </div>
      <ul class="badges col-large" style="margin-top: var(--u)">
        {regles.map((r, i) => (
          <li class={`badge ${r.placeholder ? 'badge--illustratif' : 'is-ok'}`} data-reveal="up" data-delay={String(i * 0.06)}>{r.texte}{r.placeholder ? ' (à confirmer)' : ''}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec--eau" aria-label="Le plan">
    <Houle fill="eau" />
    <div class="wrap"><Plan /></div>
  </section>

  <section class="sec sec--ciel sec--fin" aria-labelledby="t-resa">
    <Houle fill="ciel" />
    <div class="wrap resa">
      <div>
        <h2 id="t-resa" style="font-size: var(--t-xl)" data-split="words">Une table au bord de la Meuse</h2>
        <p class="muted" style="margin-top: calc(var(--u) * 2); max-width: 44ch">En ligne sur {site.reservation.outil}, ou par téléphone.</p>
        <div class="actions"><a class="btn btn--plein btn--large" href={site.reservation.url} rel="noopener" data-magnetic="0.15">Réserver en ligne</a></div>
      </div>
      <div class="stack" style="padding-top: calc(var(--u) * 4)">
        <p class="mono muted">Téléphone</p>
        <p class="resa__tel"><a href={telHref()}>{site.telephone}</a></p>
        <p class="mono muted" style="margin-top: calc(var(--u) * 3)">Bon cadeau</p>
        <p><a class="link" href={bonCadeau.url} rel="noopener">Offrir un bon cadeau, en ligne</a></p>
        <p class="mono muted" style="margin-top: calc(var(--u) * 3)">{presse.media}</p>
        <p><a class="link" href={presse.url} rel="noopener">{presse.titre}</a></p>
        <p><a class="link flèche" href={u('/reservation/')}>Toutes les façons de réserver</a></p>
      </div>
    </div>
  </section>
</Base>
