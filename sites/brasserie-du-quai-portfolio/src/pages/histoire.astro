---
import Base from '../layouts/Base.astro';
import Houle from '../components/Houle.astro';
import { site, photoDe, notes, presse } from '../data/site';
import { u, asset } from '../lib/url';
const salle = photoDe('/photos/salle-panorama.webp');
const etapes = [
  { quand: 'Le lieu', quoi: 'Au pied du pont du Luxembourg, sur les berges de la Meuse : de grandes baies vitrées et une grande terrasse au bord de l’eau.', aConfirmer: false },
  { quand: 'Ouverture', quoi: 'Année d’ouverture à confirmer par la maison.', aConfirmer: true },
  { quand: '2026', quoi: 'La maison figure dans la sélection Belgique du Guide MICHELIN.', aConfirmer: false },
  { quand: 'Juillet 2026', quoi: 'Le chef de longue date part à la retraite ; Martin et Rémy reprennent la cuisine.', aConfirmer: false },
];
const galerie = ['/photos/bar.webp', '/photos/cave-a-vins.webp', '/photos/deco-machine-a-ecrire.webp'].map(photoDe);
---
<Base title="La maison" description={`${site.nom} à Namur : une brasserie au pied du pont du Luxembourg, Martin et Rémy en cuisine depuis juillet 2026, Pierre-Alexandre et son équipe en salle.`}>
  <section class="hero hero--texte" aria-labelledby="t-histoire">
    <div class="wrap hero__bas">
      <span class="eyebrow mono">La maison</span>
      <h1 id="t-histoire" style="font-size: var(--t-xl)">Une brasserie posée au bord de la Meuse</h1>
      <p class="lead" style="margin-top: calc(var(--u) * 3)">{site.histoire[0]}</p>
    </div>
  </section>

  <section class="sec sec--eau" aria-label="Le lieu">
    <Houle fill="eau" />
    <div class="wrap paire">
      <figure class="media media--bord" data-reveal="clip" data-cursor="Voir">
        <img src={asset(salle.src)} alt={salle.alt} width={salle.largeur} height={salle.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
      </figure>
      <div class="prose">
        <span class="eyebrow mono">Le lieu, la cuisine</span>
        <p>{site.histoire[1]}</p>
        <p>{site.histoire[2]}</p>
        <p>{site.histoire[3]}</p>
      </div>
    </div>
  </section>

  <section class="sec sec--ciel" aria-labelledby="t-chrono">
    <Houle fill="ciel" />
    <div class="wrap grid12">
      <div class="col-texte">
        <span class="eyebrow mono" data-reveal="fade">Au fil de l’eau</span>
        <h2 id="t-chrono" style="font-size: var(--t-l); font-weight: 500">Quatre repères</h2>
      </div>
      <ol class="chrono col-large" data-reveal="up">
        {etapes.map((e) => <li><span class="mono muted">{e.quand}{e.aConfirmer ? ' (à confirmer)' : ''}</span><span>{e.quoi}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="sec sec--eau" aria-labelledby="t-equipe">
    <Houle fill="eau" />
    <div class="wrap">
      <span class="eyebrow mono" data-reveal="fade">L’équipe</span>
      <h2 id="t-equipe" style="font-size: var(--t-l); font-weight: 500; margin-bottom: calc(var(--u) * 4)">En cuisine, à l’écailler, en salle</h2>
      <ul class="equipe" style="list-style: none; padding: 0">
        {site.equipe.map((m, i) => {
          const p = m.photo ? photoDe(m.photo) : null;
          return (
            <li data-reveal="up" data-delay={String(i * 0.08)}>
              {p ? (
                <figure class="media"><img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" /></figure>
              ) : (
                <div class="media media--vide" aria-hidden="true">{m.nom[0]}</div>
              )}
              <h3>{m.nom}</h3>
              <p class="muted">{m.role}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="sec sec--ciel" aria-labelledby="t-avis">
    <Houle fill="ciel" />
    <div class="wrap grid12">
      <div class="col-texte">
        <span class="eyebrow mono" data-reveal="fade">Ce qu’en disent les clients</span>
        <h2 id="t-avis" style="font-size: var(--t-l); font-weight: 500">L’écailler, le cadre, la terrasse</h2>
        <ul class="notes" style="list-style: none; padding: 0">
          {notes.map((n, i) => <li data-reveal="up" data-delay={String(i * 0.08)}><span class="notes__chiffre">{n.note}</span><span class="mono muted">{n.source}, {n.nombre}</span></li>)}
        </ul>
        <p class="muted" style="margin-top: calc(var(--u) * 3)"><a class="link" href={presse.url} rel="noopener">{presse.media}, {presse.titre}</a></p>
      </div>
      <div class="col-droite">
        {site.avis.map((a) => (
          <blockquote class="avis" style="margin-bottom: calc(var(--u) * 3)" data-reveal="fade">
            <p>{a.texte}</p>
            <cite>{a.source} (résumé, pas une citation mot à mot)</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--eau sec--fin" aria-label="En images">
    <Houle fill="eau" />
    <div class="wrap">
      <div class="galerie">
        {galerie.map((p) => (
          <figure class="media" data-reveal="clip" data-cursor="Voir">
            <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--plein" href={u('/reservation/')}>Réserver une table</a></div>
    </div>
  </section>
</Base>
