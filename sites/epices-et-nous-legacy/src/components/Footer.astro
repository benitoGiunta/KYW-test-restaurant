---
import { resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{/* Pied du site : section et non footer, le seul contentinfo est celui de KywFooter. Forme : letter close. */}
<section class="close" aria-label="Pour finir">
  <div class="container close__grid">
    <p class="close__lettre">Ici, chaque assiette raconte une histoire : celle des produits locaux, travaillés avec soin, relevés d’une touche d’audace et de convivialité.</p>
    <p class="close__signature"><span>Le duo passionné !</span> Sophie et Denis Delvigne</p>
    <ul class="close__liens">
      <li><a href={resto.telHref}>{resto.tel}</a></li>
      <li><a href={resto.facebook} rel="noopener">Facebook</a></li>
      <li><a href={resto.michelin} rel="noopener">Guide Michelin</a></li>
      <li><a href={resto.gm} rel="noopener">Gault&amp;Millau</a></li>
      <li><a href={resto.siteActuel} rel="noopener">Site d’origine</a></li>
    </ul>
    <p class="close__adresse">{resto.adresse[0]}, {resto.adresse[1]}</p>
  </div>
</section>
