---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable | Épices & Nous" description="Cette page n’existe pas : retour à l’accueil d’Épices & Nous, restaurant à Erpent.">
  <section class="page-hero">
    <div class="container">
      <h1>Cette page n’est pas à la carte.</h1>
      <p class="lead">L’adresse demandée n’existe pas.</p>
      <p><a class="btn btn--accent" href={base}>Retour à l’accueil</a> <a class="link" href={`${base}carte/`}>La carte</a></p>
    </div>
  </section>
</Base>
