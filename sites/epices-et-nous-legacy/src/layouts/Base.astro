---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import { resto } from '../data/site';
import '../styles/page.css';
interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: resto.siteActuel, telephone: '+32 81 31 32 24',
  servesCuisine: 'Française',
  address: { '@type': 'PostalAddress', streetAddress: 'Chaussée de Marche 561', postalCode: '5101', addressLocality: 'Erpent (Namur)', addressCountry: 'BE' },
  sameAs: [resto.facebook],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5c5548" />
    <link rel="icon" href={`${base}logo.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=sentient@300,400&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={page}>
    <Nav page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <KywFooter base={import.meta.env.BASE_URL} />
    <script>
      // Un reveal, le menu mobile (popover) et le jour courant. Tout est lisible sans script.
      const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cibles = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduit || !('IntersectionObserver' in window)) {
        cibles.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
        cibles.forEach((el) => io.observe(el));
      }

      const nav = document.getElementById('nav-principal');
      const bouton = document.querySelector<HTMLButtonElement>('.menu-btn');
      if (nav && bouton && 'showPopover' in nav) {
        nav.addEventListener('toggle', (e) => bouton.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
        nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) nav.hidePopover(); });
        matchMedia('(min-width: 60.0625rem)').addEventListener('change', (m) => { if (m.matches && nav.matches(':popover-open')) nav.hidePopover(); });
      }

      const jour = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Brussels' })).getDay();
      document.querySelectorAll<HTMLElement>('.schedule__row[data-jours]').forEach((row) => {
        if ((row.dataset.jours ?? '').split(' ').includes(String(jour))) {
          row.setAttribute('aria-current', 'date');
          const dt = row.querySelector('dt');
          if (dt) { const m = document.createElement('span'); m.className = 'schedule__now'; m.textContent = 'Aujourd’hui'; dt.append(m); }
        }
      });
    </script>
  </body>
</html>
