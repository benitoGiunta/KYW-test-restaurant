---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import { site, adresseLigne, horaireTexte, telHref } from '../data/site';
---
<Base title="Réserver et nous contacter" description={`Réserver une table chez ${site.nom} à ${site.adresse.commune} : en ligne via ${site.reservation.outil} ou par téléphone au ${site.telephone}.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Réserver</h1>
      <p class="lead">En ligne via {site.reservation.outil}, ou par téléphone. Le restaurant est fermé le mardi.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--corail is-flottant" style="--x:86%;--y:0%;--r:12deg;--taille:110px" aria-hidden="true"><Objet id="lanterne" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="actions" style="margin-top:0">
        <a class="btn btn--plein" href={site.reservation.url} rel="noopener">Réserver sur {site.reservation.outil}</a>
        <a class="btn" href={telHref()}>Appeler le {site.telephone}</a>
      </div>
    </div>
  </section>

  <section class="section section--blanc">
    <div class="wrap">
      <h2 class="section__titre">Votre demande</h2>
      <p class="muted" style="margin-bottom: calc(var(--u) * 2.5)">Formulaire de démonstration : la demande n’est pas transmise. Pour réserver, passez par {site.reservation.outil} ou appelez le {site.telephone}.</p>
      <form class="form" data-reservation data-outil={site.reservation.outil} data-tel={site.telephone} data-horaires={JSON.stringify(site.horaires.map((h) => ({ j: h.jour, c: h.creneaux })))} data-reveal="up" action={site.reservation.url} method="get">
        <label>Nom <input type="text" name="nom" autocomplete="name" required /></label>
        <label>Téléphone <input type="tel" name="tel" autocomplete="tel" /></label>
        <label>Date <input type="date" name="date" required /></label>
        <label>Heure <input type="time" name="heure" required /></label>
        <label>Couverts <input type="number" name="couverts" min="1" max="40" value="2" required /></label>
        <label class="large">Message <textarea name="message" rows="3"></textarea></label>
        <div class="actions"><button class="btn btn--plein" type="submit">Vérifier ma demande</button><p class="form__etat" role="status" data-form-etat></p></div>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="hcarte">
                <h2 class="section__titre" style="margin-bottom:0">Quand venir</h2>
        <dl class="horaires">
          {site.horaires.map((h) => (
            <>
              <dt>{h.jour}</dt>
              <span class="pts" aria-hidden="true"></span>
              <dd class:list={{ ferme: !h.creneaux.length }}>{h.creneaux.length ? horaireTexte(h) : 'fermé'}</dd>
            </>
          ))}
        </dl>
        <p class="hcarte__ligne"><span>Adresse</span><span>{adresseLigne()}</span></p>
        <p class="hcarte__ligne"><span>Téléphone</span><a class="link" href={telHref()}>{site.telephone}</a></p>
        <p class="hcarte__ligne"><span>Enfants</span><span>salle de jeux pendant le repas</span></p>
        <div class="actions">
          <a class="btn" href={site.reseaux[0].url} rel="noopener">Itinéraire</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { onPage } from '../engine';
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-reservation]');
    if (!form) return;
    const etat = document.querySelector<HTMLElement>('[data-form-etat]');
    const msg = (t: string, ok: boolean) => { if (!etat) return; etat.textContent = t + ' '; etat.dataset.ok = ok ? '1' : '0'; const a = document.createElement('a'); a.className = 'link'; a.href = form.action; a.rel = 'noopener'; a.textContent = 'Réserver sur ' + form.dataset.outil; etat.append(a, ' ou appeler le ' + (form.dataset.tel || '') + '.'); };
    const go = (e: SubmitEvent) => {
      e.preventDefault();
      const d = (form.elements.namedItem('date') as HTMLInputElement).value;
      const h = (form.elements.namedItem('heure') as HTMLInputElement).value;
      const service = JSON.parse(form.dataset.horaires || '[]') as { j: string; c: { ouverture: string; fermeture: string }[] }[];
      const jours = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
      const jour = service.find((x) => x.j === jours[new Date(d + 'T12:00:00').getDay()]);
      if (!jour || !jour.c.length) { msg('Le restaurant est fermé ce jour-là.', false); return; }
      if (!jour.c.some((c) => c.ouverture <= h && h < c.fermeture)) { msg('Cette heure est hors des heures de service (' + jour.c.map((c) => c.ouverture + '-' + c.fermeture).join(', ') + ').', false); return; }
      msg('Rien n’a été envoyé : cette maquette ne transmet pas la demande.', true);
    };
    form.addEventListener('submit', go);
    return () => form.removeEventListener('submit', go);
  });
</script>
