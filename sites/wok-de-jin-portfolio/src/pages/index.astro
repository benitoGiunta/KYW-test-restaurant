---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette, photoDe, horaireTexte, adresseLigne, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const g = guinguette;
const sashimi = photoDe('/photos/sashimi-saumon.webp');
const plaque = ['/photos/chef-wok.webp', '/photos/chef-teppanyaki.webp'].map(photoDe);
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const [m1, m2] = g.manifeste.titre;
const r = g.reveillon;
---
<Base>
  <!-- Hero poster : tout est peint au premier rendu ; les objets tombent puis deviennent saisissables -->
  <section class="hero wrap" data-hero>
    <div class="hero__inner" data-hero-texte>
      <h1 class="hero__titre"><span>{g.heroTitre[0]}</span><span class="l2">{g.heroTitre[1]}</span></h1>
      <p class="hero__slogan">{g.slogan.texte}{g.slogan.placeholder && <span class="illu">exemple</span>}</p>
      <p class="hero__adresse">{site.nom} · {adresseLigne()}</p>
      <div class="actions">
        <a class="btn btn--plein" href={u('/reservation/')} data-magnetic="0.2">Réserver une table</a>
        <a class="btn" href={u('/tarifs/')}>Voir les tarifs</a>
      </div>
    </div>
    <div class="hero__zone" data-hero-zone>
      {g.objets.map((o, i) => (
        <button type="button" class:list={['obj', { 'obj--mobile': o.mobile, 'obj--corail': i % 3 === 0, 'obj--canard': i % 3 === 1 }]} data-obj aria-label={`${o.label}, déplaçable aux flèches`} style={`--x:${o.x}%;--y:${o.y}%;--r:${o.r}deg;--taille:${o.taille}px;${o.mx !== undefined ? `--mx:${o.mx}%;` : ''}--delai:${(i * 0.6).toFixed(1)}s`}>
          <Objet id={o.id} classe="obj__svg" />
        </button>
      ))}
    </div>
  </section>

  <!-- Le buffet -->
  <section class="section" id="buffet">
    <div class="wrap maison__grille">
      <figure class="tirage" style="--w:100%; cursor: default">
        <img src={asset(sashimi.src)} alt={sashimi.alt} width={sashimi.largeur} height={sashimi.hauteur} loading="lazy" decoding="async" />
        <figcaption>Sashimi de saumon</figcaption>
      </figure>
      <div class="maison__texte" data-reveal="fade">
        <Ornements />
        <p class="meta">Le buffet</p>
        <h2 class="section__titre">Tout à volonté, <em>chaud et froid</em></h2>
        <div class="prose">
          {g.buffet.texte.map((t) => <p>{t}</p>)}
        </div>
        <ul role="list" class="puces">
          {g.buffet.specialites.map((t) => <li class="vege">{t}</li>)}
        </ul>
        <div class="actions"><a class="btn" href={u('/maison/')}>La salle et les tablées</a></div>
      </div>
    </div>
  </section>

  <!-- La table : signature -->
  <section class="section section--canard table" id="table" data-table aria-label="La table : photos à déplacer">
    <div class="table__titre wrap">
      <h2>La grande tablée</h2>
      <p>Attrapez un tirage, posez-le où vous voulez.</p>
    </div>
    <div class="table__scene" data-table-scene>
      {g.tirages.map((t, i) => (
        <figure class="tirage" data-tirage tabindex="0" aria-label={`${t.legende}, photo déplaçable aux flèches`} style={`--x:${t.x}%;--y:${t.y}%;--r:${t.r}deg`}>
          <img src={petite(t.src)} alt={t.alt} width="640" height="640" loading="lazy" decoding="async" draggable="false" />
          <figcaption>{t.legende}</figcaption>
        </figure>
      ))}
      {(['theiere', 'sushi', 'baguettes'] as const).map((id, i) => (
        <button type="button" class="obj" data-obj aria-label={`${({ theiere: 'Théière', sushi: 'Nigiri', baguettes: 'Baguettes' })[id]} dessiné au trait, déplaçable aux flèches`} style={`--x:${[48, 8, 88][i]}%;--y:${[30, 80, 78][i]}%;--r:${[12, -20, 40][i]}deg;--taille:110px`}>
          <Objet id={id} classe="obj__svg" />
        </button>
      ))}
    </div>
    <div class="table__rail rail" role="region" tabindex="0" aria-label="Photos de la table, défilement horizontal">
      {g.tirages.slice(0, 8).map((t) => (
        <figure class="tirage" style={`--r:${t.r}deg`}>
          <img src={petite(t.src)} alt={t.alt} width="640" height="640" loading="lazy" decoding="async" />
          <figcaption>{t.legende}</figcaption>
        </figure>
      ))}
    </div>
    <div class="badge" aria-hidden="true">
      <svg viewBox="0 0 120 120"><defs><path id="cercle" d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0" /></defs><text><textPath href="#cercle">attrapez-moi · attrapez-moi · attrapez-moi · </textPath></text></svg>
      <svg class="badge__main" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M30 60 V30 a6 6 0 0 1 12 0 V52" /><path d="M42 50 V26 a6 6 0 0 1 12 0 V52" /><path d="M54 50 V30 a6 6 0 0 1 12 0 V56" /><path d="M66 54 V40 a6 6 0 0 1 12 0 V68 a26 26 0 0 1 -26 26 h-6 a24 24 0 0 1 -20 -11 L18 66 a6 6 0 0 1 10 -7 L30 62" /></svg>
    </div>
  </section>

  <!-- Wok et teppanyaki -->
  <section class="section" id="plaque">
    <div class="wrap maison__grille">
      <div class="maison__texte" data-reveal="fade">
        <p class="meta">Cuisine ouverte</p>
        <h2 class="section__titre">{g.plaque.titre[0]} <em>{g.plaque.titre[1]}</em></h2>
        <div class="prose"><p>{g.plaque.texte}</p></div>
      </div>
      <div class="grille-photos">
        {plaque.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{['Au wok', 'À la plaque'][i]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Tarifs : carte blanche -->
  <section class="section section--blanc" id="tarifs">
    <div class="wrap">
      <p class="meta" style="text-align:center">Les tarifs</p>
      <h2 class="section__titre" style="text-align:center">Un prix, <em>tout à volonté</em></h2>
      <div class="carte" data-reveal="scale">
        <div class="carte__grille">
          <div>
            <h3 class="cat__titre"><Objet id="bol" />Buffet seul</h3>
            <p class="cat__note">{g.tarifs.note}</p>
            <ul role="list">
              {g.tarifs.seul.map((t) => (
                <li class="plat"><span class="plat__nom">{t.moment}</span><span class="plat__points" aria-hidden="true"></span><span class="plat__prix">{t.prix}</span></li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="cat__titre"><Objet id="theiere" />Buffet et boissons</h3>
            <p class="cat__note">{g.tarifs.note}</p>
            <ul role="list">
              {g.tarifs.boissons.map((t) => (
                <li class="plat"><span class="plat__nom">{t.moment}</span><span class="plat__points" aria-hidden="true"></span><span class="plat__prix">{t.prix}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="muted" style="margin-top:calc(var(--u)*3);font-size:var(--t-s)">Boissons comprises : {g.tarifs.boissonsListe}</p>
        <p class="muted" style="margin-top:var(--u);font-size:var(--t-s)">Enfants de 0 à 3 ans : gratuit. De 4 à 11 ans : demi-tarif, sur présentation de la carte d’identité.</p>
      </div>
      <div class="actions" style="justify-content:center"><a class="btn" href={u('/tarifs/')}>Tous les tarifs</a></div>
    </div>
  </section>

  <!-- Réveillon : manifeste corail -->
  <section class="section section--corail manifeste" id="reveillon">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 data-split="lines,words">{m1}<br />{m2.replace(g.manifeste.motItalique, '').trim()} <em class="ital">{g.manifeste.motItalique}</em></h2>
      <p class="lead">Le {r.date}, {r.heure} : {r.prix} par personne, boissons comprises, DJ, cochon de lait rôti, dinde aux cranberries, escargots, sushis et fruits de mer.</p>
      <div class="actions">
        <a class="btn" href={u('/reveillon/')}>Le réveillon en détail</a>
        <a class="btn" href={u('/reservation/')}>Réserver une table</a>
      </div>
      <span class="obj is-flottant obj--mobile" style="--x:2%;--y:8%;--r:-15deg;--taille:120px;--delai:0.4s" aria-hidden="true"><Objet id="lanterne" classe="obj__svg" /></span>
      <span class="obj is-flottant" style="--x:88%;--y:55%;--r:18deg;--taille:110px;--delai:1.4s" aria-hidden="true"><Objet id="theiere" classe="obj__svg" /></span>
    </div>
  </section>

  <!-- Horaires -->
  <section class="section" id="horaires">
    <div class="wrap">
      <div class="hcarte" data-reveal="up">
        <p class="meta">Horaires</p>
        <h2 class="section__titre" style="margin-bottom:0">Quand <em>venir</em></h2>
        <dl class="horaires">
          {site.horaires.map((h) => (
            <>
              <dt>{h.jour}</dt>
              <span class="pts" aria-hidden="true"></span>
              <dd class:list={{ ferme: !h.creneaux.length }}>{h.creneaux.length ? horaireTexte(h) : 'fermé'}</dd>
            </>
          ))}
        </dl>
        <p class="hcarte__ligne"><span>Enfants</span><span>salle de jeux pendant le repas</span></p>
        <p class="hcarte__ligne"><span>Téléphone</span><a class="link" href={telHref()}>{site.telephone}</a></p>
        <p class="hcarte__ligne"><span>Adresse</span><span>{adresseLigne()}</span></p>
        <div class="actions">
          <a class="btn btn--plein" href={u('/reservation/')}>Réserver</a>
          <a class="btn" href={`https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lon}#map=18/${site.geo.lat}/${site.geo.lon}`} rel="noopener">Itinéraire</a>
        </div>
      </div>
    </div>
  </section>
</Base>
