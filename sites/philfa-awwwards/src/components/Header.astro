---
import { u } from '../lib/url';
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const courant = (p: string) => (path === u(p).replace(/\/+$/, '') + '/' ? 'page' : undefined);
---
<header class="tete">
  <a class="tete__marque" href={base} aria-label="PhilFa, accueil" aria-current={path === base ? 'page' : undefined}><span class="phil-mot">Phil</span><span class="fa-mot">Fa</span></a>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      <li><a class="nl" href={u('/carte/')} aria-current={courant('/carte/')}>La carte</a></li>
      <li class="tete__sec"><a class="nl" href={u('/histoire/')} aria-current={courant('/histoire/')}>L’histoire</a></li>
      <li><a class="cta cta--petit" href={u('/reservation/')} aria-current={courant('/reservation/')}>Réserver</a></li>
      <li class="tete__mob"><button type="button" class="tete__menu nl" aria-expanded="false" aria-controls="volet">Menu</button></li>
    </ul>
  </nav>
  <div class="volet" id="volet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <div class="volet__phil t-phil">
      <button type="button" class="volet__fermer nl">Fermer</button>
      <ul>
        <li><a class="volet__ligne" href={base} aria-current={path === base ? 'page' : undefined}>Accueil</a></li>
        <li><a class="volet__ligne" href={u('/carte/')} aria-current={courant('/carte/')}>La carte</a></li>
        <li><a class="volet__ligne" href={u('/histoire/')} aria-current={courant('/histoire/')}>L’histoire</a></li>
      </ul>
    </div>
    <div class="volet__fa t-fa">
      <ul>
        <li><a class="volet__ligne" href={u('/reservation/')} aria-current={courant('/reservation/')}>Réserver</a></li>
        <li><a class="volet__ligne volet__tel num" href={site.telephoneHref}>Appeler le {site.telephoneLisible}</a></li>
      </ul>
    </div>
  </div>
</header>
