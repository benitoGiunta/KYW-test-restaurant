---
// Le double choix du menu du moment : chaque étape propose deux plats, l'un sur la moitié Phil, l'autre sur la moitié Fa.
import { menuDuMoment } from '../data/site';
---
{menuDuMoment.etapes.map((e) => (
  <div class="etape cousu" role="group" aria-label={`${e.nom}, deux choix`}>
    <p class="etape__nom">{e.nom}</p>
    <button type="button" class="choix t-phil" aria-pressed="false"><span class="choix__ou" aria-hidden="true">Ou bien</span><span class="choix__plat">{e.choix[0]}</span></button>
    <button type="button" class="choix t-fa" aria-pressed="false"><span class="choix__ou" aria-hidden="true">Ou bien</span><span class="choix__plat">{e.choix[1]}</span></button>
  </div>
))}
