---
import { services, joursOuverts, joursFermes } from '../data/site';
---
<ul class="horaires">
  {joursOuverts.map((j) => <li><span>{j}</span><span class="num">{services.map((s) => s.lisible).join(' et ')}</span></li>)}
  {joursFermes.map((j) => <li class="ferme"><span>{j}</span><span>Fermé</span></li>)}
</ul>
