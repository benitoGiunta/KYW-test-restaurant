---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { Image } from 'astro:assets';
import logo from '../assets/photos/13-logo-restaurant.png';
import { u } from '../lib/url';
import { site, equipe } from '../data/site';
---
<Base title="L’histoire" description="L’histoire de PhilFa, brasserie de la rue de Marchovelette à Namur : ouverte en 2013, repensée en 2020, tenue par Philippe Legrand et Fabian Rammeloo." page="histoire">
  <section class="titre-page" aria-labelledby="titre-histoire">
    <h1 class="display display--mega" id="titre-histoire" data-split="chars" data-intro>L’histoire</h1>
    <p class="chapo" data-reveal="up" data-intro data-delay="0.35">Une brasserie du centre de Namur, tenue à deux.</p>
  </section>

  <section class="deux cousu" aria-label="Les deux patrons">
    <div class="t-phil"><p class="role">Patron, en cuisine</p><p class="nom">Philippe<br />Legrand</p></div>
    <div class="t-fa"><p class="role">Patron, en cuisine</p><p class="nom">Fabian<br />Rammeloo</p></div>
  </section>

  <section class="recit t-papier" aria-labelledby="titre-recit">
    <div class="recit__texte">
      <h2 class="display display--xl" id="titre-recit" data-split="lines" style="margin-bottom: var(--serre)">La maison</h2>
      <p>PhilFa ouvre en {site.ouvertDepuis}, rue de Marchovelette, au centre de Namur. En {site.renoveEn}, la maison est rénovée et repensée : le concept actuel, un cadre feutré, du velours moutarde et rose, des plantes, une cave vitrée.</p>
      <p>On y vient pour une cuisine de brasserie qui suit les saisons et prend quelques épices du monde, en salle de {site.places.salle} places ou en terrasse de {site.places.terrasse} places.</p>
    </div>
    <figure class="recit__photo"><div class="cadre" data-reveal="clip"><Photo cle="couloir" widths={[480, 800, 1200]} sizes="(max-width: 52rem) 100vw, 40vw" /></div></figure>
    <ol class="frise" aria-label="Dates">
      <li><b>{site.ouvertDepuis}</b><p>Ouverture de PhilFa, rue de Marchovelette.</p></li>
      <li><b>{site.renoveEn}</b><p>La maison est rénovée et repensée avec son concept actuel.</p></li>
      <li><b>2025</b><p>Entrée au guide Gault&amp;Millau Belgique : 12/20, une toque.</p></li>
    </ol>
  </section>

  <section class="equipe t-phil" aria-labelledby="titre-equipe">
    <h2 class="display display--l" id="titre-equipe" data-split="lines">L’équipe</h2>
    <ul>{equipe.map((e) => <li><b>{e.nom}</b><span>{e.role}</span></li>)}</ul>
  </section>

  <section class="t-fa" aria-label="Logo" style="padding: var(--normal) var(--gutter); display: flex; gap: var(--normal); align-items: center; justify-content: space-between; flex-wrap: wrap;">
    <Image class="logo-plaque" src={logo} alt="Logo PhilFa Restaurant : une plaque vert olive inclinée, PhilFa en crème et jaune, un pictogramme de couverts." widths={[480, 800]} sizes="24rem" format="webp" />
    <p style="max-width: 28ch; font-size: var(--t-m); line-height: 1.25; margin: 0">Une table vous attend du mardi au samedi. <a class="lien" href={u('/reservation/')}>Réserver</a></p>
  </section>
</Base>
