---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n’existe pas : la rue de Marchovelette compte un 21 et un 23, mais pas celle-ci." page="404">
  <section class="porte" aria-labelledby="titre-404">
    <div class="t-phil">
      <p class="no" aria-hidden="true">21</p>
      <p>Ni cette porte-ci…</p>
      <a class="cta" href={u('/')}>Retour à l’accueil</a>
    </div>
    <div class="t-fa">
      <p class="no" aria-hidden="true">23</p>
      <p>…ni celle-là. Cette page n’existe pas.</p>
      <a class="cta" href={u('/carte/')}>Voir la carte</a>
    </div>
  </section>
  <h1 class="sr-only" id="titre-404">Page introuvable : ni le 21, ni le 23</h1>
</Base>
