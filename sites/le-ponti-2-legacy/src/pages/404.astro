---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable, Le Ponti 2" description="Cette page n’existe pas. Retour à la carte ou à l’accueil du Ponti 2." page="404">
  <section class="pagehead">
    <div class="container pagehead__grid">
      <h1>Page introuvable</h1>
      <p class="lead">Cette adresse ne mène à aucune page du site.</p>
      <p class="actions"><a class="btn" href={base}>Retour à l’accueil</a><a class="link" href={`${base}menu/`}>La carte</a></p>
    </div>
  </section>
</Base>
