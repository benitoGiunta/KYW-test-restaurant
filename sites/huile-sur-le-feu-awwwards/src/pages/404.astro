---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas : le flacon est vide. Retour à la carte ou à l’accueil de L’Huile sur le Feu, Namur.">
  <section class="wrap erreur" aria-labelledby="titre-404">
    <span class="goutte" aria-hidden="true" style="width: 2.4rem; height: 2.4rem; background: transparent; border: 2px solid var(--c-accent)"></span>
    <h1 class="mega" id="titre-404">Le flacon <em>est vide.</em></h1>
    <p class="hero__baseline" style="max-width: 30rem">Cette page n’existe pas. Il reste de l’huile ailleurs.</p>
    <div class="cta-groupe">
      <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
      <a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </div>
  </section>
</Base>
