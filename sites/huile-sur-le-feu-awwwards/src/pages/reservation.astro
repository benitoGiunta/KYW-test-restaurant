---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Horaires from '../components/Horaires.astro';
import { euro } from '../lib/format';
import { site, services, menus } from '../data/site';
---
<Base page="reservation" title="Réservation" description="Réserver une table à L’Huile sur le Feu, rue de Marchovelette 19 à Namur : en ligne, par téléphone ou par e-mail, du mardi au samedi, midi et soir.">
  <section class="wrap titre-page grille" aria-labelledby="titre-reservation">
    <div class="titre-page__txt">
      <h1 class="mega" id="titre-reservation" data-split="lines" data-intro>Une <em>table</em></h1>
      <p class="hero__baseline" style="margin-top: var(--serre); max-width: 30rem">Réservez en ligne, appelez-nous, ou écrivez-nous. Fermé le dimanche et le lundi.</p>
      <div class="cta-groupe" style="margin-top: var(--normal)">
        <a class="cta" href={site.reservationUrl} rel="noopener"><span class="cta__txt">Réserver en ligne</span></a>
        <a class="cta cta--contour" href={site.telephoneHref}><span class="cta__txt">Appeler le <span class="nw">{site.telephoneLisible}</span></span></a>
      </div>
    </div>
    <div class="titre-page__media--large cadre" data-reveal="clip" data-intro data-delay="0.15"><Photo cle="salle" sizes="(max-width: 820px) 100vw, 33vw" prioritaire /></div>
  </section>

  <section class="wrap sect" aria-labelledby="titre-heures">
    <h2 class="display t-xl" data-split="lines" id="titre-heures">Deux services, <em>cinq jours</em></h2>
    <div class="flacons">
      {services.map((s) => (
        <div class="flacon">
          <span class="goutte" aria-hidden="true"></span>
          <strong>{s.nom}</strong>
          <span class="t-m nw">{s.libelle}</span>
        </div>
      ))}
    </div>
    <div style="margin-top: var(--normal)"><Horaires /></div>
  </section>

  <section class="papier sect--aere sect" aria-labelledby="titre-venir">
    <div class="wrap paire grille">
      <div class="paire__texte paire__texte--g">
        <h2 class="display t-xl" data-split="lines" id="titre-venir">Venir <em>rue de Marchovelette</em></h2>
        <dl class="fiche">
          <dt>Adresse</dt><dd><address style="font-style: normal">{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></dd>
          <dt>Téléphone</dt><dd><a class="lien nw" href={site.telephoneHref}>{site.telephone}</a></dd>
          <dt>E-mail</dt><dd><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></dd>
          <dt>Menus</dt><dd>{menus.map((m) => `${m.nom} ${euro(m.prix)}`).join(' ; ')}</dd>
        </dl>
        <form class="formulaire" action={`mailto:${site.email}`} method="post" enctype="text/plain">
          <label>Votre nom<input type="text" name="nom" autocomplete="name" required /></label>
          <label>Date et nombre de personnes<input type="text" name="demande" placeholder="Exemple : vendredi soir, 4 personnes" required /></label>
          <button class="cta" type="submit"><span class="cta__txt">Ouvrir mon e-mail</span></button>
        </form>
      </div>
      <div class="paire__b cadre ratio-34"><Photo cle="facade" sizes="(max-width: 820px) 100vw, 40vw" /></div>
    </div>
  </section>
</Base>
