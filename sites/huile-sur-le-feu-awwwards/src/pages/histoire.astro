---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { histoire, equipe, site } from '../data/site';
---
<Base page="histoire" title="L’histoire" description="L’histoire de L’Huile sur le Feu : Giuseppe Santamaria, les Pouilles, l’huile d’olive comme point de départ de chaque plat, rue de Marchovelette à Namur.">
  <section class="wrap titre-page grille" aria-labelledby="titre-histoire">
    <div class="titre-page__txt">
      <h1 class="mega" id="titre-histoire" data-split="lines" data-intro>Des Pouilles <em>à Namur</em></h1>
    </div>
    <div class="titre-page__media cadre" data-reveal="clip" data-intro data-delay="0.15"><Photo cle="branche" sizes="(max-width: 820px) 100vw, 33vw" prioritaire /></div>
  </section>

  <section class="wrap sect grille" aria-label="Le récit">
    <div class="recit" data-reveal>
      {histoire.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="sect--aere sect" aria-label="L’oliveraie">
    <div class="wrap">
      <div class="cadre ratio-169" data-reveal="clip"><Photo cle="oliveraie" widths={[800, 1200, 1600]} sizes="100vw" /></div>
    </div>
  </section>

  <section class="papier sect--aere sect" aria-labelledby="titre-fondateur">
    <div class="wrap paire grille">
      <div class="paire__texte paire__texte--g">
        <h2 class="display t-xl" data-split="lines" id="titre-fondateur">La maison de <em>{equipe[0].nom}</em></h2>
        <dl class="fiche">
          <dt>Fondateur</dt><dd>{equipe[0].nom}</dd>
          <dt>Adresse</dt><dd>Au {site.adresse.numero} de la rue de Marchovelette, à Namur</dd>
        </dl>
      </div>
      <div class="paire__b cadre ratio-43"><Photo cle="presse" sizes="(max-width: 820px) 100vw, 40vw" /></div>
      <div class="paire__a cadre ratio-43"><Photo cle="lustre" sizes="(max-width: 820px) 100vw, 45vw" /></div>
      <div class="paire__b paire__b--etroit cadre ratio-34"><Photo cle="facade" sizes="(max-width: 820px) 100vw, 33vw" /></div>
    </div>
  </section>
</Base>
