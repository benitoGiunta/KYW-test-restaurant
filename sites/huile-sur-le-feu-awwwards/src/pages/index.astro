---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Horaires from '../components/Horaires.astro';
import { u } from '../lib/url';
import { euro } from '../lib/format';
import { site, huiles, menus } from '../data/site';
---
<Base page="accueil" title="" description={site.description}>
  <section class="wrap hero grille" aria-labelledby="titre-accueil">
    <div class="hero__titre">
      <h1 class="mega" id="titre-accueil" data-intro><span class="nw">L’Huile</span><br /><em>sur le Feu</em></h1>
    </div>
    <div class="hero__media cadre">
      <Photo cle="flambage" sizes="(max-width: 820px) 100vw, 33vw" prioritaire />
    </div>
    <div class="hero__bas">
      <p class="hero__baseline">{site.baseline}. Cuisine méditerranéenne et pâtes fraîches, à Namur.</p>
      <div class="cta-groupe">
        <a class="cta" href={site.reservationUrl} rel="noopener" data-magnetic><span class="cta__txt">Réserver une table</span></a>
        <a class="cta cta--contour" href={site.telephoneHref}><span class="cta__txt">Appeler le <span class="nw">{site.telephoneLisible}</span></span></a>
      </div>
      <p class="petit">Du mardi au samedi, midi et soir. {site.adresse.rue} {site.adresse.numero}, {site.adresse.commune}.</p>
    </div>
  </section>

  <section class="wrap sect--aere sect grille" aria-label="Le principe de la maison">
    <p class="statement" data-split>L’huile n’est pas la touche finale. C’est le <em>point de départ</em> du plat.</p>
    <p class="statement-suite">Truffe blanche, piment, mandarine, menthe, ail, persil : chaque assiette reçoit l’huile choisie pour elle.</p>
  </section>

  <section class="wrap sect" aria-labelledby="titre-huiles">
    <h2 class="display t-l" id="titre-huiles">À chaque plat <em>son huile</em></h2>
    <ul class="index">
      {huiles.map((h) => (
        <li class="index__ligne" data-huile={h.cle}>
          <p class="index__nom"><span class="goutte" aria-hidden="true"></span>{h.nom}</p>
          <p class="index__accord">{h.accord}</p>
        </li>
      ))}
    </ul>
    <p class="cta-groupe" style="margin-top: var(--normal)"><a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">Voir toute la carte</span></a></p>
  </section>

  <section class="papier sect--aere sect" aria-labelledby="titre-boutique">
    <div class="wrap paire grille">
      <div class="paire__a cadre ratio-34"><Photo cle="allee" sizes="(max-width: 820px) 100vw, 45vw" /></div>
      <div class="paire__texte">
        <h2 class="display t-xl" id="titre-boutique">Les huiles vivent aussi <em>sur les étagères</em></h2>
        <p style="margin-top: var(--serre); max-width: 34rem">Les huiles viennent d’Oliviers & Co et se retrouvent dans la boutique, dans la même maison que la salle : à table comme en boutique.</p>
        <div class="cadre ratio-43" style="margin-top: var(--normal)"><Photo cle="flacons" sizes="(max-width: 820px) 100vw, 40vw" /></div>
      </div>
    </div>
  </section>

  <section class="wrap sect--aere sect" aria-label="La maison en images">
    <div class="mur grille">
      <div class="cadre"><Photo cle="salle" sizes="(max-width: 820px) 100vw, 40vw" /></div>
      <div class="cadre"><Photo cle="bruschette" sizes="(max-width: 820px) 50vw, 30vw" /></div>
      <div class="cadre"><Photo cle="cocktail" sizes="(max-width: 820px) 50vw, 25vw" /></div>
      <div class="cadre"><Photo cle="salade" sizes="(max-width: 820px) 100vw, 40vw" /></div>
      <div class="cadre"><Photo cle="sauceOrange" sizes="(max-width: 820px) 100vw, 40vw" /></div>
    </div>
    <p class="legende">{site.credit}.</p>
  </section>

  <section class="wrap sect" aria-labelledby="titre-menus">
    <h2 class="display t-xl" id="titre-menus">Les menus et <em>les heures</em></h2>
    <div class="donnees grille" style="margin-top: var(--normal)">
      {menus.map((m) => (
        <div class="menu-bloc">
          <h3 class="t-m display">{m.nom}</h3>
          <p class="menu-bloc__prix">{euro(m.prix)}<small>par personne</small></p>
        </div>
      ))}
      <div class="menu-bloc" style="grid-column: 1 / -1">
        <h3 class="t-m display">Du mardi au samedi</h3>
        <Horaires />
      </div>
    </div>
  </section>
</Base>
