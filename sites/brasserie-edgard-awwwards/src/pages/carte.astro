---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site } from '../data/site';
import { categories, suggestions, menus, prixTexte, eur, type Plat } from '../data/carte';
import type { CleePhoto } from '../lib/photos';

const lunch = menus.filter((m) => m.nom.startsWith('Plat du jour') || m.nom.startsWith('Lunch'));
const groupe = menus.filter((m) => m.nom.startsWith('Menu groupe'));
const nomCourt = (n: string) => n.replace(/^Menu groupe : /, '').replace(/ \((.*)\)$/, '').replace(/^./, (c) => c.toUpperCase());
const sections: { id: string; titre: string; note?: string; photo?: CleePhoto; plats: Plat[] }[] = [
  { id: 'suggestions', titre: 'Suggestions du moment', note: 'Les suggestions affichées sur le site de la brasserie au 20 novembre.', photo: 'irish', plats: suggestions },
  { id: 'lunch', titre: 'Lunch', note: 'Du lundi au vendredi, à midi.', plats: lunch },
  { id: 'entrees', titre: 'Entrées', photo: 'coupelles', plats: categories.find((c) => c.id === 'entrees')!.plats },
  { id: 'boucher', titre: 'Le coin du boucher', photo: 'viande', plats: categories.find((c) => c.id === 'le-coin-du-boucher')!.plats },
  { id: 'poissonnier', titre: 'Le coin du poissonnier', plats: categories.find((c) => c.id === 'le-coin-du-poissonnier')!.plats },
  { id: 'pates', titre: 'Pâtes fraîches', photo: 'volaille', plats: categories.find((c) => c.id === 'pates-fraiches')!.plats },
  { id: 'salades', titre: 'Salades', photo: 'salade', plats: categories.find((c) => c.id === 'salades')!.plats },
  { id: 'enfants', titre: 'Enfants', plats: categories.find((c) => c.id === 'enfants')!.plats },
  { id: 'desserts', titre: 'Desserts', photo: 'dessert', plats: categories.find((c) => c.id === 'desserts')!.plats },
  { id: 'groupes', titre: 'Menus de groupe', note: `Table de plus de ${site.groupes.min} personnes, ${site.groupes.max} au maximum.`, plats: groupe },
];
const total = sections.reduce((n, s) => n + s.plats.length, 0);
---
<Base page="carte" title="La carte" description="La carte de la Brasserie Edgard à Saint-Servais : carpaccios, croquettes maison, coin du boucher, du poissonnier, pâtes fraîches, desserts, lunch et menus de groupe, avec les prix.">
  <section class="entete wrap">
    <h1 class="entete__titre display" data-split="lines" data-intro>La carte</h1>
    <p class="entete__texte">{total} lignes de brasserie, du carpaccio à la dame blanche. Prix relevés sur le site de la brasserie le 20&nbsp;novembre&nbsp;2026, à confirmer sur place. Emporter : supplément d’emballage de {eur(site.emporterSupplement)}.</p>
  </section>

  <nav class="carte-nav wrap" aria-label="Rubriques de la carte">
    <ul>
      {sections.map((s) => <li><a class="carte-nav__lien" href={`#${s.id}`}>{s.titre}</a></li>)}
    </ul>
  </nav>

  <div class="carte wrap">
    {sections.map((s) => (
      <section class="rubrique" id={s.id} aria-labelledby={`h-${s.id}`}>
        <header class="rubrique__tete">
          <h2 class="rubrique__titre display" data-split="lines" id={`h-${s.id}`}>{s.titre}</h2>
          {s.note && <p class="rubrique__note">{s.note}</p>}
          {s.photo && <div class="rubrique__photo" data-reveal="clip"><Photo cle={s.photo} sizes="(min-width: 900px) 24vw, 70vw" widths={[400, 700]} /></div>}
        </header>
        <ul class="plats-liste">
          {s.plats.map((p) => (
            <li class="ligne">
              <div class="ligne__texte">
                <h3 class="ligne__nom">{s.id === 'groupes' ? nomCourt(p.nom) : p.nom}</h3>
                {p.desc && <p class="ligne__desc">{p.desc}</p>}
              </div>
              <p class="ligne__prix">{prixTexte(p)}{s.id === 'groupes' && <span class="ligne__u"> par personne</span>}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="reserve wrap" aria-labelledby="t-reserve">
    <h2 class="reserve__titre display" data-split="lines" id="t-reserve">Une table ?</h2>
    <p><a class="cta" href={u('/reservation/')}><span class="cta__txt">Réserver</span></a></p>
  </section>
</Base>
