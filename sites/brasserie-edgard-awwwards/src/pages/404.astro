---
import Base from '../layouts/Base.astro';
import Dial from '../components/Dial.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas ou n’est plus à cette adresse. Retournez à l’accueil de la Brasserie Edgard ou à la carte.">
  <section class="perdu wrap">
    <div class="perdu__cadran"><Dial vide classe="dial--perdu" /></div>
    <h1 class="perdu__titre display">Cette page<br />n’est pas à l’heure.</h1>
    <p class="perdu__texte">L’adresse que vous cherchez n’existe pas, ou plus. La brasserie, elle, est ouverte tous les jours de 10&nbsp;h à 22&nbsp;h&nbsp;30.</p>
    <p class="perdu__actions">
      <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
      <a class="cta cta--ligne" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </p>
  </section>
</Base>
