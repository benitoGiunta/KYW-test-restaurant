---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas : il est minuit moins le quart et la table est vide. Retour à la carte ou à l’accueil d’Oh la Vache !, Erpent.">
  <section class="wrap erreur nuit" aria-labelledby="titre-404" data-state="1">
    <p class="erreur__heure display" aria-hidden="true">23 : 45</p>
    <h1 class="mega" id="titre-404" data-split="words" data-intro>Minuit moins le quart. <em>Cette page est partie.</em></h1>
    <p class="hero__baseline">Rien à cette adresse. La salle, elle, est toujours ouverte.</p>
    <div class="cta-groupe">
      <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
      <a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </div>
  </section>
</Base>
