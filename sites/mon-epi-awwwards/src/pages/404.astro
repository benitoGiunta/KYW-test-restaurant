---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page de Monepi est restée dans le son : retournez à l’accueil ou à la carte.">
  <section class="perdu">
    <div class="wrap">
      <p class="taux display num" style="font-size:var(--t-xl)" aria-hidden="true">0&nbsp;%</p>
      <h1 class="display" data-split="lines" data-intro>Restée dans le son</h1>
      <p>Cette page n’a pas passé le tamis : elle est restée avec le son, loin de la farine. Revenez à l’accueil ou choisissez votre pain sur la carte.</p>
      <p><a class="btn btn--plein" href={u('/')}>Retour à l’accueil</a>&nbsp; <a class="btn" href={u('/carte/')}>La carte</a></p>
    </div>
  </section>
</Base>
