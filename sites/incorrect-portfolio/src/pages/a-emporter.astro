---
// Les modalités de la vente à emporter sont inconnues : étapes illustratives (site.etapes.aEmporterPlaceholder).
import Base from '../layouts/Base.astro';
import Affiche from '../components/Affiche.astro';
import Bento from '../components/Bento.astro';
import { site, telHref, pizzas } from '../data/site';
---
<Base title="À emporter" description={`Les pizzas d’Incorrect à emporter, à ${site.adresse.commune} : la vente à emporter est signalée par Le Fooding, modalités à confirmer (page illustrative).`} fin="vert">
  <Affiche tone="jaune" plein label="titre">
    <div class="wrap">
      <h1 id="titre" class="display display--mega affiche__titre" data-split="chars" data-intro>À emporter</h1>
      <p class="lead">Les pizzas au levain, dans une boîte, pour les manger chez vous.</p>
      <p class="exemple" data-reveal="fade" data-intro data-delay="0.5" style="margin-top: var(--gutter)">Illustratif : la vente à emporter est signalée par Le Fooding, les modalités sont à confirmer avec la maison</p>
    </div>
  </Affiche>

  <Affiche tone="rouge" prev="jaune" label="etapes-titre">
    <div class="wrap">
      <h2 id="etapes-titre" class="display display--xl affiche__titre" data-split="words">En trois gestes (exemple)</h2>
      <div class="etapes">
        <ol data-cercles>
          {site.etapes.aEmporter.map((e) => <li><span class="cercle" aria-hidden="true"></span><div><strong>{e.titre}</strong><p>{e.texte}</p></div></li>)}
        </ol>
      </div>
    </div>
  </Affiche>

  <Affiche tone="creme" prev="rouge" label="boites-titre">
    <div class="wrap">
      <h2 id="boites-titre" class="display display--mega affiche__titre" data-split="chars">Les pizzas</h2>
      <Bento plats={pizzas()} />
    </div>
  </Affiche>

  <Affiche tone="vert" prev="creme" label="commande-titre">
    <div class="wrap">
      <h2 id="commande-titre" class="display display--mega display--mot affiche__titre" data-split="chars">Commander</h2>
      <p class="lead" style="margin-bottom: var(--gutter)">Par téléphone, pour convenir de l’heure de retrait.</p>
      <div class="actions">
        <a class="btn btn--primary" href={telHref()}>{site.telephone}</a>
      </div>
    </div>
  </Affiche>
</Base>

<style>
  @media (max-width: 767px) { .etapes ol { grid-template-columns: 1fr !important; } }
</style>
