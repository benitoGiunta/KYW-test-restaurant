---
// Le Dwight Schrute (tartine au levain) dessiné en 5 couches (aplats de la palette, filet ink, ombre dure). Chaque couche porte
// data-couche="01..05" : le driver « empile » (src/motion/drivers.ts) ne lit que cet attribut, de sorte qu'un client
// qui fournit 5 PNG détourés remplace les <g> par des <img data-couche> sans toucher au code.
interface Props { class?: string; id?: string; title: string }
const { class: cls = '', id, title } = Astro.props;
---
<svg class:list={['plat', cls]} id={id} viewBox="0 0 520 420" role="img" aria-label={title}>
  <title>{title}</title>
  <g data-couche="01">
    <rect x="70" y="150" width="400" height="230" rx="60" fill="var(--ink)" transform="translate(10 10)" />
    <rect x="70" y="150" width="400" height="230" rx="60" fill="var(--creme)" stroke="var(--ink)" stroke-width="4" />
    <rect x="92" y="172" width="356" height="186" rx="44" fill="none" stroke="var(--jaune)" stroke-width="4" stroke-dasharray="2 14" stroke-linecap="round" />
  </g>
  <g data-couche="02">
    <path d="M112 262 c0 -52 52 -78 150 -78 c100 0 158 26 160 76 c2 52 -60 78 -154 78 c-98 0 -156 -26 -156 -76z" fill="var(--betterave)" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round" />
    <path d="M150 226 c40 -20 120 -26 190 -10" fill="none" stroke="var(--creme)" stroke-width="5" stroke-linecap="round" opacity="0.55" />
  </g>
  <g data-couche="03">
    <path d="M170 246 c-6 -22 16 -38 34 -30 c10 -16 38 -14 42 6 c20 -4 34 14 24 30 c-4 20 -34 26 -52 16 c-20 10 -42 -2 -48 -22z" fill="#fffaf0" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round" />
    <path d="M300 262 c-6 -22 16 -38 34 -30 c10 -16 38 -14 42 6 c20 -4 34 14 24 30 c-4 20 -34 26 -52 16 c-20 10 -42 -2 -48 -22z" fill="#fffaf0" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round" />
  </g>
  <g data-couche="04">
    <circle cx="214" cy="236" r="5" fill="var(--ink)" /><circle cx="230" cy="250" r="4" fill="var(--ink)" /><circle cx="196" cy="256" r="4" fill="var(--ink)" /><circle cx="346" cy="250" r="5" fill="var(--ink)" /><circle cx="362" cy="268" r="4" fill="var(--ink)" /><circle cx="330" cy="272" r="4" fill="var(--ink)" />
    <circle cx="250" cy="300" r="4" fill="var(--vert)" /><circle cx="278" cy="314" r="5" fill="var(--vert)" /><circle cx="262" cy="214" r="4" fill="var(--vert)" /><circle cx="150" cy="276" r="4" fill="var(--vert)" /><circle cx="400" cy="280" r="4" fill="var(--vert)" />
  </g>
  <g data-couche="05">
    <path d="M250 200 c6 -46 34 -76 62 -88 M250 200 c-20 -34 -50 -52 -80 -56 M250 200 c2 -30 -4 -62 -18 -86" fill="none" stroke="var(--vert)" stroke-width="5" stroke-linecap="round" />
    <circle cx="312" cy="112" r="9" fill="var(--jaune)" stroke="var(--ink)" stroke-width="4" /><circle cx="170" cy="144" r="9" fill="var(--jaune)" stroke="var(--ink)" stroke-width="4" /><circle cx="232" cy="114" r="9" fill="var(--jaune)" stroke="var(--ink)" stroke-width="4" />
    <path d="M330 150 c20 -16 40 -14 54 0 M120 190 c-16 -10 -24 -26 -22 -40" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" />
  </g>
</svg>
