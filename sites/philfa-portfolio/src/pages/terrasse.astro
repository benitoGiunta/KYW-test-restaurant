---
// Terrasse et salle : terrasse de 20 places ombragée à l'avant et salle de 55 places (philfa.be, gaultmillau.be).
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const dehors = ['/photos/terrasse.webp', '/photos/facade.webp'].map(photoDe);
const dedans = ['/photos/salle-table-longue.webp', '/photos/salle-lampe-table.webp', '/photos/table-niches-colorees.webp', '/photos/bar-cave-vitree.webp'].map(photoDe);
---
<Base title="Terrasse et salle" description={`La terrasse ombragée de 20 places et la salle feutrée de 55 places de ${site.nom} à ${site.adresse.commune}.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse et salle</h1>
      <p class="lead">Vingt places dehors, cinquante-cinq places dedans : choisissez votre table.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Dehors, <em class="ital">à l'ombre</em></h2>
      <p class="lead">{g.terrasse.texte}</p>
      <ul role="list" style="display:flex;flex-wrap:wrap;gap:0.6em;justify-content:center;margin-top:calc(var(--u)*3)">
        {g.terrasse.points.map((t) => <li class="vege" style="font-size:var(--t-s);padding:0.4em 1em">{t}</li>)}
      </ul>
      <div class="grille-photos" style="margin-top:calc(var(--u)*4)">
        {dehors.map((p, i) => (
          <figure class="tirage" style={`--r:${[-3, 4][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.alt.split(',')[0]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section__titre">La salle, <em>cinquante-cinq places</em></h2>
      <div class="maison__grille">
        <div class="prose">
          <p>{g.salle.texte}</p>
          <p>La cuisine est ouverte du mardi au samedi, midi et soir. Pour réserver, passez par <a class="link" href={site.reservation.url} rel="noopener">{site.reservation.outil}</a> ou consultez la <a class="link" href={u('/reservation/')}>page contact</a>.</p>
        </div>
        <div class="grille-photos">
          {dedans.map((p, i) => (
            <figure class="tirage" style={`--r:${[-4, 3, -2, 4][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
              <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
              <figcaption>{p.alt.split(',')[0]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
