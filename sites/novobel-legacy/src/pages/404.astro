---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable · Novobel" description="Cette page n’existe pas.">
  <section class="band band--head">
    <div class="container pagehead">
      <h1>Cette page n’existe pas.</h1>
      <p class="lead"><a href={base}>Retour à l’accueil</a></p>
    </div>
  </section>
</Base>
