---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { societe, metiers, etapes, photos } from '../data/site';
const slug = (t: string) => t.toLowerCase();
---
<Base page="services" title="Services · Novobel, rénovation à Namur" description="Rénovation complète, gros œuvre, finitions, installations techniques et gestion de projet clé en main : les services de Novobel à Namur.">
  <section class="band band--head">
    <div class="container pagehead">
      <h1>La qualité et la minutie, du gros œuvre aux finitions.</h1>
      <p class="lead">Novobel accompagne ses clients dans la transformation et l’embellissement de leurs espaces, qu’il s’agisse de petits projets ou de chantiers de grande envergure.</p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <h2>Ce que nous proposons</h2>
      <ol class="rows">
        {metiers.map((m, i) => (
          <li class="row">
            <span class="row__n num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="row__t">{m.titre}</h3>
            <p class="row__d">{m.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--steps">
    <div class="container steps">
      <Photo slot="visite" img={photos.visite} sizes="(min-width: 60rem) 40vw, 100vw" pos="50% 50%" class="steps__photo" />
      <div class="steps__list">
        {etapes.map((e) => (
          <article class="step" id={slug(e.titre)}>
            <h3>{e.titre}</h3>
            <p class="step__sub">{e.sous}</p>
            <p>{e.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--devis">
    <div class="container devis">
      <h2>Devis gratuit sous 24 h</h2>
      <div class="devis__text">
        <p class="lead">Aucun projet n’est trop grand pour Novobel. Contactez-nous sans plus attendre pour fixer un rendez-vous.</p>
        <p class="actions">
          <a class="btn btn--primary" href={`mailto:${societe.email}?subject=Demande%20de%20devis`}>Demander un devis</a>
          <a class="btn btn--ghost" href={societe.telHref}>{societe.tel}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
