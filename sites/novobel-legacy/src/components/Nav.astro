---
import { nav, societe } from '../data/site';
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (n: { href: string; home?: boolean }) => (n.home ? `${base}${n.href}` : `${base}${n.href}`);
---
<header class="slab">
  <div class="container slab__in">
    <a class="slab__mark" href={base} aria-label="Novobel, accueil">
      <span class="slab__name">Novobel</span>
      <span class="slab__sub">Construction et rénovation</span>
    </a>
    <details class="slab__menu">
      <summary>Menu</summary>
      <nav aria-label="Principale">
        <ul>
          {nav.map((n) => (
            <li><a href={href(n)} aria-current={page === n.id ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
    <a class="btn btn--primary slab__cta" href={`mailto:${societe.email}?subject=Demande%20de%20devis`}>Devis gratuit</a>
  </div>
</header>
