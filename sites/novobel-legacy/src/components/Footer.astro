---
import { societe, nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="mast" id="contact">
  <div class="container mast__in">
    <div class="mast__lead">
      <p class="mast__name">Novobel</p>
      <p class="mast__line">Rénovation et construction à Namur, de l’étude à la remise des clés.</p>
    </div>
    <dl class="mast__facts">
      <div><dt>Adresse</dt><dd>{societe.adresse.rue}<br />{societe.adresse.cp} {societe.adresse.ville}, {societe.adresse.pays}</dd></div>
      <div><dt>Téléphone</dt><dd><a href={societe.telHref}>{societe.tel}</a></dd></div>
      <div><dt>E-mail</dt><dd><a href={`mailto:${societe.email}`}>{societe.email}</a></dd></div>
      <div><dt>Réseaux</dt><dd><a href={societe.facebook} rel="noopener" target="_blank">Facebook</a></dd></div>
      <div><dt>Horaires d’accueil</dt><dd><span class="fill">À compléter avec le client</span></dd></div>
    </dl>
    <nav class="mast__nav" aria-label="Pied de page">
      <ul>
        {nav.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}
      </ul>
    </nav>
    <p class="mast__credits">Photographies du site d’origine, probablement de stock, à remplacer par des photos de chantiers Novobel.</p>
  </div>
</footer>
