---
interface Props { slot: string; img: { src: string; w: number; h: number; alt: string }; eager?: boolean; sizes?: string; caption?: string; pos?: string; class?: string; credit?: boolean }
const { slot, img, eager = false, sizes = '(min-width: 60rem) 60vw, 100vw', caption, pos = '50% 50%', class: cls = '', credit = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<figure class={`photo ${cls}`}>
  <div class="photo__frame" data-slot={slot} data-alt={img.alt} data-credits={credit ? 'Photo illustrative' : undefined} style={`aspect-ratio:${img.w}/${img.h}`}>
    <img src={`${base}${img.src}`} alt={img.alt} width={img.w} height={img.h} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" style={`object-position:${pos}`} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
