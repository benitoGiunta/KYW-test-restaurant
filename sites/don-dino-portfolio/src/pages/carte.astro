---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import { site, guinguette, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const g = guinguette;
const picto = (cat: string) => g.pictos.find((p) => cat.startsWith(p.categorie))?.picto ?? 'fourchette';
const photos = ['/photos/pizza-planche.webp', '/photos/spaghetti.webp', '/photos/moules-gratinees.webp', '/photos/escalope-salade.webp'].map(photoDe);
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const slug = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const rubriques = [...site.carte, ...g.carteExemple].map((c) => c.categorie);
---
<Base title="La carte" description={`La carte et les formules de ${site.nom} à ${site.adresse.commune} : pizzas, pâtes, gratinés, viandes, poissons. Prix en euros.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>La carte</h1>
      <p class="lead">Pizzas, pâtes, gratinés, salades, poissons, veau, bœuf et agneau : l'éventail d'une brasserie italienne, avec des suggestions de saison.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--corail is-flottant" style="--x:84%;--y:4%;--r:14deg;--taille:110px" aria-hidden="true"><Objet id="fourchette" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="carte">
        <h2 class="sr-only">Le menu</h2>
        <div class="carte__outils" data-carte-filtre>
          <nav class="carte__rubriques" aria-label="Aller à une rubrique">
            {rubriques.map((r) => <a class="pastille" href={`#rub-${slug(r)}`} data-rub>{r}</a>)}
          </nav>
          <div class="carte__recherche">
            <label for="carte-q" class="meta">Chercher un plat</label>
            <div class="carte__champ">
              <input id="carte-q" type="search" name="q" autocomplete="off" placeholder="Pizza, scampi, tiramisu…" data-carte-q />
              <button type="button" class="pastille" data-carte-effacer hidden>Effacer</button>
            </div>
          </div>
          <p class="carte__compte" role="status" aria-live="polite" data-carte-compte></p>
        </div>
        <div class="carte__grille">
          {site.carte.map((c) => (
            <div data-cat id={`rub-${slug(c.categorie)}`}>
              <h3 class="cat__titre"><Objet id={picto(c.categorie)} />{c.categorie}</h3>
              <ul role="list">
                {c.plats.map((p) => (
                  <li class="plat" data-plat>
                    <span class="plat__nom">{p.nom}{p.placeholder && <span class="illu">exemple</span>}{p.description && <span class="plat__desc">{p.description}</span>}</span>
                    <span class="plat__points" aria-hidden="true"></span>
                    {p.prix && <span class="plat__prix">{p.prix}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="bandeau-ex" style="margin-top: calc(var(--u) * 5)" data-cat-note>Desserts et boissons : exemples illustratifs, absents de la carte en ligne</p>
        <div class="carte__grille">
          {g.carteExemple.map((c) => (
            <div data-cat id={`rub-${slug(c.categorie)}`}>
              <h3 class="cat__titre"><Objet id={picto(c.categorie)} />{c.categorie}</h3>
              <ul role="list">
                {c.plats.map((p) => (
                  <li class="plat" data-plat>
                    <span class="plat__nom">{p.nom}<span class="illu" aria-label="exemple">*</span>{p.vege && <span class="vege">végé</span>}<span class="plat__desc">{p.description}</span></span>
                    <span class="plat__points" aria-hidden="true"></span>
                    <span class="plat__prix">{p.prix}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--canard">
    <div class="wrap">
      <h2 class="section__titre">Dans <em>l'assiette</em></h2>
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3, -2, 5][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.alt.split(',')[0]}</figcaption>
          </figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--lin" href={u('/reservation/')}>Réserver une table</a></div>
    </div>
  </section>
</Base>
