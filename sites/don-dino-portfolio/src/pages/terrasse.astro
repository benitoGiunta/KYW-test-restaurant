---
// Terrasse, groupes et privatisation : faits du dossier (terrasse mentionnée sans détail, parking, accès, groupes sur devis).
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g, photoDe, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const photos = ['/photos/salle-comptoir.webp', '/photos/bar-tireuses.webp', '/photos/salle-pizza.webp'].map(photoDe);
---
<Base title="Terrasse et groupes" description={`Terrasse, parking, groupes et privatisation chez ${site.nom} à ${site.adresse.commune} : anniversaires, fêtes, mariages, cocktails, sur devis.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse et groupes</h1>
      <p class="lead">Une brasserie pizzeria spacieuse, avec un bar, une terrasse pour les beaux jours et de la place pour les tablées.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Dehors, <em class="ital">dès qu'il fait beau</em></h2>
      <p class="lead">Le restaurant dispose d'une terrasse et d'un parking extérieur privé.</p>
      <ul role="list" style="display:flex;flex-wrap:wrap;gap:0.6em;justify-content:center;margin-top:calc(var(--u)*3)">
        {g.terrasse.points.map((t) => <li class="vege" style="font-size:var(--t-s);padding:0.4em 1em">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section__titre">Groupes et <em>privatisation</em></h2>
      <div class="maison__grille">
        <div class="prose">
          <p>{g.groupes.texte}</p>
          <p>Pour un devis, passez par la <a class="link" href={u('/reservation/')}>demande en ligne</a> ou appelez le <a class="link" href={telHref()}>{site.telephone}</a>.</p>
          <ul role="list" style="display:flex;flex-wrap:wrap;gap:0.6em;margin-top:calc(var(--u)*2)">
            {g.groupes.occasions.map((t) => <li class="vege" style="font-size:var(--t-s);padding:0.4em 1em">{t}</li>)}
          </ul>
        </div>
        <div class="grille-photos">
          {photos.map((p, i) => (
            <figure class="tirage" style={`--r:${[-4, 3, -2][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
              <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
              <figcaption>{p.alt.split(',')[0]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
