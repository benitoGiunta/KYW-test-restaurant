---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n’existe pas sur le site de Wok de Jin. Retournez à l’accueil ou consultez le buffet et les horaires." page="404">
  <section class="wrap page-tete erreur">
    <p class="lib">Erreur 404</p>
    <h1 class="display page-titre">Case fermée.</h1>
    <p class="lede">Cette page n’existe pas, comme le mardi dans notre semaine : le wok est éteint. Revenez à l’accueil, il y a de la place à table.</p>
    <p class="actions">
      <a class="cta" href={u('/')}>Retour à l’accueil</a>
      <a class="cta cta--vide" href={u('/carte/')}>Voir le buffet</a>
    </p>
  </section>
</Base>
