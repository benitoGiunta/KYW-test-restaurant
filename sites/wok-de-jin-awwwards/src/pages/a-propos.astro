---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, famille } from '../data/site';
---
<Base title="La maison" description="La salle de Wok de Jin à Jambes : chaises rouges, grandes tables pour les groupes, salle de jeux pour les enfants et cuisine ouverte au wok et au teppanyaki." page="a-propos">
  <section class="wrap page-tete">
    <p class="lib">La maison</p>
    <h1 class="display page-titre">Une salle rouge, une cuisine ouverte.</h1>
    <p class="lede">Wok de Jin est un restaurant à volonté de Jambes, avenue du Bourgmestre Jean Materne. La salle est grande, le décor chinois, et les cuisiniers travaillent à la vue de tous.</p>
  </section>

  <section class="sec" aria-label="La salle">
    <div class="wrap mur">
      <figure style="grid-column: 1 / 8;"><div class="cadre cadre--43"><Photo cle="salleRouge" widths={[800, 1200, 1600]} sizes="(max-width: 47.99rem) 100vw, 58vw" prioritaire /></div><figcaption class="legende-photo">{site.credit}</figcaption></figure>
      <figure style="grid-column: 9 / 13; margin-top: var(--aere);"><div class="cadre cadre--34"><Photo cle="tableDressee" widths={[480, 800, 1200]} sizes="(max-width: 47.99rem) 100vw, 30vw" /></div><figcaption class="legende-photo">{site.credit}</figcaption></figure>
    </div>
  </section>

  <section class="sec nuit" aria-labelledby="famille-titre">
    <div class="wrap paire paire--inv">
      <figure class="paire__a">
        <div class="cadre cadre--11"><Photo cle="jeux" widths={[480, 800, 1200]} sizes="(max-width: 47.99rem) 100vw, 40vw" /></div>
        <figcaption class="legende-photo">La salle de jeux. {site.credit}</figcaption>
      </figure>
      <div class="paire__b">
        <h2 class="display sec__titre" id="famille-titre">Pour les familles et les groupes.</h2>
        <ul class="liste-prix">
          {famille.map((f) => <li><span><b style="font-family: var(--f-body); font-weight: 600; font-size: inherit;">{f.titre}.</b> {f.texte}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="buffet-titre">
    <div class="wrap paire">
      <figure class="paire__a">
        <div class="cadre cadre--43"><Photo cle="salleBuffet" widths={[480, 800, 1200]} sizes="(max-width: 47.99rem) 100vw, 40vw" /></div>
        <figcaption class="legende-photo">La salle et l’îlot du buffet. {site.credit}</figcaption>
      </figure>
      <div class="paire__b">
        <h2 class="display sec__titre" id="buffet-titre">Le buffet au centre.</h2>
        <p class="txt">L’îlot du buffet occupe la salle : sushis, mer, wok, teppanyaki et desserts. On y retourne autant de fois qu’on veut.</p>
        <p class="actions"><a class="cta" href={u('/reservation/')}>Réserver une table</a><a class="cta cta--vide" href={u('/carte/')}>Voir le buffet</a></p>
      </div>
    </div>
  </section>
</Base>
