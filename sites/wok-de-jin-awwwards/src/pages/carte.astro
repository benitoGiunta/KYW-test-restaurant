---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, tarifs, comptoirs, boissonsFormule, prix } from '../data/site';
const lignes = [
  { photo: 'sushis', alt: false, titre: 'Sushis', texte: 'Nigiris, makis et créations de la maison. Le buffet de sushis réunit aussi poissons et fruits de mer.', inv: false, cadre: 'cadre--11', pied: 'Le tapis de sushis' },
  { photo: 'mer', titre: 'Mer', texte: 'Poissons et fruits de mer en bacs, à volonté, sur le buffet froid.', inv: true, cadre: 'cadre--34', pied: 'Les bacs de la mer' },
  { photo: 'wokIngredients', titre: 'Wok', texte: 'Vous choisissez viandes et légumes dans les bacs ; le cuisinier les saute devant vous.', inv: false, cadre: 'cadre--34', pied: 'Les ingrédients du wok' },
  { photo: 'teppanyaki', titre: 'Teppanyaki', texte: 'Même principe sur la plaque : vos ingrédients, cuits à la minute.', inv: true, cadre: 'cadre--34', pied: 'La plaque' },
  { photo: 'desserts', titre: 'Sucré', texte: 'Macarons, pâtisseries et chocolats pour finir le repas.', inv: false, cadre: 'cadre--34', pied: 'Le comptoir sucré' },
] as const;
---
<Base title="Le buffet et les tarifs" description="Le buffet à volonté de Wok de Jin à Jambes : sushis, mer, wok, teppanyaki et desserts, avec les tarifs midi, soir et week-end, boissons comprises ou non." page="carte">
  <section class="wrap page-tete">
    <p class="lib">Le buffet</p>
    <h1 class="display page-titre">À volonté, par comptoir.</h1>
    <p class="lede">{comptoirs.length} comptoirs, un seul prix par service. Pas de liste de plats : vous vous servez, vous revenez, vous goûtez autre chose.</p>
  </section>

  <section class="sec" aria-label="Les comptoirs">
    <div class="wrap" style="display: grid; gap: var(--aere);">
      {lignes.map((l) => (
        <div class={l.inv ? 'paire paire--inv' : 'paire'}>
          <figure class="paire__a">
            <div class={`cadre ${l.cadre}`} data-reveal="clip"><Photo cle={l.photo} widths={[480, 800, 1170]} sizes="(max-width: 47.99rem) 100vw, 40vw" /></div>
            <figcaption class="legende-photo">{l.pied}. {site.credit}</figcaption>
          </figure>
          <div class="paire__b">
            <h2 class="display sec__titre" data-split="lines,words,chars">{l.titre}</h2>
            <p class="txt">{l.texte}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec nuit" aria-labelledby="tarifs-titre">
    <div class="wrap fiches">
      <div class="fiche fiche--large">
        <h2 class="display sec__titre" data-split="lines,words,chars" id="tarifs-titre">Buffet seul</h2>
        <ul class="liste-prix">
          {(['t1', 't2', 't3'] as const).map((t) => <li><span>{tarifs[t].contexte ? `${tarifs[t].libelle}, ${tarifs[t].contexte}` : tarifs[t].libelle}</span><b>{prix(tarifs[t].buffet)}</b></li>)}
        </ul>
      </div>
      <div class="fiche fiche--large">
        <h2 class="display sec__titre" data-split="lines,words,chars">Avec boissons</h2>
        <ul class="liste-prix">
          {(['t1', 't2', 't3'] as const).map((t) => <li><span>{tarifs[t].contexte ? `${tarifs[t].libelle}, ${tarifs[t].contexte}` : tarifs[t].libelle}</span><b>{prix(tarifs[t].boissons)}</b></li>)}
        </ul>
        <p class="petit">Comprend : {boissonsFormule}.</p>
      </div>
      <div class="fiche fiche--large">
        <h3>Enfants</h3>
        <p>De 0 à 3 ans, gratuit. De 4 à 11 ans, demi-tarif, sur présentation de la carte d’identité.</p>
      </div>
      <div class="fiche fiche--large">
        <h3>Anniversaire</h3>
        <p>Moins 50 % sur le buffet, boissons exclues, sur présentation d’une pièce d’identité, à trois jours près.</p>
      </div>
      <p class="petit fiche--large" style="grid-column: 1 / -1;">Prix par personne, relevés sur le site du restaurant le 19 novembre 2026. Le tarif week-end s’applique aussi aux jours fériés.</p>
    </div>
  </section>

  <section class="sec" aria-label="Réserver">
    <div class="wrap">
      <p class="actions">
        <a class="cta" href={u('/reservation/')}>Réserver une table</a>
        <a class="cta cta--vide" href={site.telephoneHref}>Appeler le {site.telephoneLisible}</a>
      </p>
    </div>
  </section>
</Base>
