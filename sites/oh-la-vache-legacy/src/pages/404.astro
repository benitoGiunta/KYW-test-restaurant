---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable, Oh la Vache !" description="Cette page n’existe pas : retrouvez l’accueil, la carte ou les horaires d’Oh la Vache !.">
  <section class="section" aria-labelledby="t404"><div class="container">
    <h1 id="t404">Cette page n’existe pas</h1>
    <p class="lead">La carte et les horaires sont sur l’accueil.</p>
    <div class="actions"><a class="btn btn--primary" href={base}>Retour à l’accueil</a><a class="link" href={`${base}#carte`}>Voir la carte</a></div>
  </div></section>
</Base>
