---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const liens = [['#horaires', 'Horaires'], ['#carte', 'La carte'], ['#photos', 'Photos'], ['#reserver', 'Contact']];
---
<header class="nav">
  <a class="nav__brand" href={base} aria-label="Oh la Vache, accueil">Oh la Vache&#8239;!</a>
  <nav aria-label="Principale" class="nav__links">
    {liens.map(([h, t]) => <a href={h}>{t}</a>)}
  </nav>
  <div class="nav__end">
    <a class="btn btn--ghost nav__cta" href={site.tel.href}>Réserver<span class="nav__num">&nbsp;au&nbsp;{site.tel.affiche}</span></a>
    <button class="nav__burger" type="button" popovertarget="menu" aria-controls="menu" aria-expanded="false" aria-label="Menu">
      <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 22 22"><path class="b1" d="M3 7h16" /><path class="b2" d="M3 15h16" /></svg>
    </button>
  </div>
  <nav id="menu" class="menu" popover aria-label="Menu">
    {liens.map(([h, t]) => <a href={h}>{t}</a>)}
    <a class="menu__tel" href={site.tel.href}>Appeler le {site.tel.affiche}</a>
  </nav>
</header>
