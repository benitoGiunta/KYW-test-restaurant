---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="nav">
  <a class="nav__brand" href={base} aria-label="Oh la Vache, accueil">Oh la Vache&#8239;!</a>
  <nav aria-label="Principale" class="nav__links">
    <a href="#horaires">Horaires</a>
    <a href="#carte">La carte</a>
    <a href="#photos">Photos</a>
    <a href="#reserver">Contact</a>
  </nav>
  <a class="btn btn--ghost nav__cta" href={site.tel.href}>Réserver<span class="nav__num">&nbsp;au&nbsp;{site.tel.affiche}</span></a>
</header>
