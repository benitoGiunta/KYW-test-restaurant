---
import { site } from '../data/site';
---
<footer class="mast">
  <div class="container mast__grid">
    <p class="mast__name">Oh la Vache&#8239;!</p>
    <div class="mast__col">
      <p>{site.adresse.rue}<br />{site.adresse.ville}</p>
      <p><a class="link" href={site.tel.href}>{site.tel.affiche}</a></p>
    </div>
    <div class="mast__col">
      <p><a class="link" href={site.facebook} rel="noopener">Facebook</a></p>
      <p><a class="link" href={site.instagram} rel="noopener">Instagram</a></p>
    </div>
    <p class="mast__credits" data-credits="Photos : Oh la Vache !">Photos : Oh la Vache&#8239;!</p>
  </div>
</footer>
