---
import Photo from './Photo.astro';
import { site } from '../data/site';
---
<section class="section close" id="reserver" aria-labelledby="h-reserver">
  <div class="container close__grid">
    <div class="card">
      <h2 id="h-reserver">Réserver une table</h2>
      <p class="lead">La réservation se fait par téléphone.</p>
      <a class="phone" href={site.tel.href}>{site.tel.affiche}</a>
      <p class="small">Nous cherchons une personne de salle (H/F). Véhicule conseillé : pas de bus ni de train à proximité.</p>
      <p class="small"><a class="link" href={site.mailto}>Écrire au restaurant</a></p>
    </div>
    <Photo name="salle-rouge" slot="reservation" w={1000} h={1333} pos="50% 55%" sizes="(min-width: 60rem) 36vw, 100vw"
      alt="Salle sous tente éclairée de rouge, tables dressées" />
  </div>
</section>
