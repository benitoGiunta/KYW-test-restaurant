---
import Photo from './Photo.astro';
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="titre">
  <Photo name="facade" slot="hero" w={1920} h={1275} eager pos="38% 50%" sizes="100vw"
    alt="Façade du restaurant Oh la Vache ! à Erpent, avec son enseigne noire et blanche au motif de vache" />
  <div class="hero__plate" data-reveal data-reveal-now>
    <h1 id="titre">Grill d’Erpent, ouvert <span class="nb">7 jours sur 7</span></h1>
    <p class="lead">Fondues, pierrades, raclettes et viandes grillées, Chaussée de Marche 581.</p>
    <div class="actions">
      <a class="btn btn--primary" href={site.tel.href}>Réserver au {site.tel.affiche}</a>
      <a class="link" href="#carte">Voir la carte</a>
    </div>
  </div>
  <p class="hero__cap">Façade et enseigne, Erpent</p>
</section>
