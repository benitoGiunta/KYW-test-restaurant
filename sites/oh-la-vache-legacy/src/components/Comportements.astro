<script>
  const racine = document.documentElement;
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Horaires : la ligne du jour (heure de Bruxelles), repérée sans couleur seule.
  const jour = new Intl.DateTimeFormat('fr-BE', { weekday: 'long', timeZone: 'Europe/Brussels' }).format(new Date());
  document.querySelectorAll<HTMLElement>('.schedule__row').forEach((r) => {
    if (r.querySelector('dt')?.textContent?.trim().toLowerCase() === jour.toLowerCase()) r.setAttribute('aria-current', 'date');
  });

  // Un seul reveal : IntersectionObserver, une fois ; l'entrée du hero part au chargement.
  const cibles = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reduit || !('IntersectionObserver' in window)) {
    cibles.forEach((c) => c.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -10% 0px' });
    cibles.forEach((c) => { if (c.hasAttribute('data-reveal-now')) requestAnimationFrame(() => c.classList.add('is-in')); else io.observe(c); });
  }

  // Menu mobile : l'état suit le popover ; un lien referme ; passer en grand écran referme.
  const menu = document.getElementById('menu');
  const burger = document.querySelector<HTMLElement>('.nav__burger');
  if (menu && burger) {
    menu.addEventListener('toggle', (e) => burger.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
    matchMedia('(min-width: 60rem)').addEventListener('change', (m) => { if (m.matches && menu.matches(':popover-open')) menu.hidePopover(); });
  }
</script>
