---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Lieux from '../components/Lieux.astro';
import { site, lieux, telHref } from '../data/site';
const p = lieux.provisoire;
---
<Base title="Réserver et nous contacter" description={`Réserver une table chez ${site.nom} : en ligne via ${site.reservation.outil} ou par téléphone au ${p.telAffiche}. Accueil provisoire à ${p.commune}, restaurant de Wépion fermé.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Réserver</h1>
      <p class="lead">En ligne via {site.reservation.outil}, ou par téléphone au {p.telAffiche}. Pour l'instant, l'équipe vous accueille à {p.commune}, le restaurant de Wépion étant fermé.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--corail is-flottant" style="--x:86%;--y:0%;--r:12deg;--taille:110px" aria-hidden="true"><Objet id="verre" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="actions" style="margin-top:0">
        <a class="btn btn--plein" href={site.reservation.url} rel="noopener">Réserver sur {site.reservation.outil}</a>
        <a class="btn" href={telHref(p.telephone)}>Appeler le {p.telAffiche}</a>
      </div>
    </div>
  </section>

  <section class="section section--blanc">
    <div class="wrap">
      <h2 class="section__titre">Votre <em>demande</em></h2>
      <p class="muted" style="margin-bottom: calc(var(--u) * 2.5)">La réservation se fait sur {site.reservation.outil} ou par téléphone.</p>
      <div class="actions" data-reveal="up">
        <a class="btn btn--plein" href={site.reservation.url} rel="noopener">Réserver sur {site.reservation.outil}</a>
        <a class="btn" href={telHref(p.telephone)}>{p.telAffiche}</a>
      </div>
    </div>
  </section>

  <section class="section" id="lieux">
    <div class="wrap">
      <p class="meta">Où nous trouver</p>
      <h2 class="section__titre">Pour <em>venir</em></h2>
      <Lieux />
    </div>
  </section>
</Base>

