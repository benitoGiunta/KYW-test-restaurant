---
// Terrasse et salles : photos du site du Lodge ; nombre de places, jours et saison de la terrasse inconnus (à confirmer).
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, lieux, photoDe, telHref } from '../data/site';
import { asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const photos = ['/photos/salle-voutee.webp', '/photos/salle-claire.webp', '/photos/salle-vue-meuse.webp'].map(photoDe);
const terrasse = photoDe('/photos/terrasse-meuse.webp');
const p = lieux.provisoire;
---
<Base title="Terrasse et salles" description={`La terrasse sur la Meuse et les salles de ${site.nom} à ${site.adresse.commune}, aujourd'hui fermées après l'incendie de mai 2026.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse</h1>
      <p class="lead">Sous un store, face à la Meuse et aux rochers : la terrasse et les salles du Lodge, à Wépion. Fermées depuis l'incendie, en attendant la réouverture.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Dehors, <em class="ital">face à la Meuse</em></h2>
      <p class="lead">La terrasse du Lodge donne sur le fleuve. Le nombre de places, les jours et la saison d'ouverture ne sont pas communiqués.</p>
      <figure class="tirage" style="--w:min(100%, 26rem);--r:-3deg;margin:calc(var(--u)*4) auto 0;cursor:default">
        <img src={asset(terrasse.src)} alt={terrasse.alt} width={terrasse.largeur} height={terrasse.hauteur} loading="lazy" decoding="async" />
        <figcaption>La terrasse, sous le store</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section__titre">Les <em>salles</em></h2>
      <div class="maison__grille">
        <div class="prose">
          <p>Deux ambiances à l'intérieur : une salle claire à grande baie vitrée, et une salle aux fenêtres cintrées et aux tables rondes. Des tables près de la fenêtre regardent aussi la Meuse.</p>
          <p>Le restaurant compte 160 couverts, selon l'annuaire Trouve Ton Resto.</p>
        </div>
        <div class="grille-photos">
          {photos.map((ph, i) => (
            <figure class="tirage" style={`--r:${[-4, 3, -2][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
              <img src={petite(ph.src)} alt={ph.alt} width="640" height="640" loading="lazy" decoding="async" />
              <figcaption>{ph.alt.split(',')[0]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
