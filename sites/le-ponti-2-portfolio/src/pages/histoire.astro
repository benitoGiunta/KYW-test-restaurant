---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const g = guinguette;
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const trio = photoDe('/photos/pates.webp');
const galerie = g.tirages.filter((t) => ['pizza-fond', 'facade-rue', 'escalope-table', 'pates-vin', 'pizza-comptoir', 'facade-enseigne'].some((n) => t.src.endsWith(n + '.webp')));
const histoire = site.histoire;
---
<Base title="La maison" description={`${site.nom} à Jambes (Namur) : restaurant italien et pizzeria, esprit familial, desserts faits maison, ouvert du mardi au dimanche.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>La maison</h1>
      <p class="lead">{site.baseline}</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:86%;--y:0%;--r:-10deg;--taille:120px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap maison__grille">
      <figure class="tirage" style="--w:100%; cursor: default; --r:-3deg">
        <img src={asset(trio.src)} alt={trio.alt} width={trio.largeur} height={trio.hauteur} loading="eager" decoding="async" />
        <figcaption>Pâtes à table</figcaption>
      </figure>
      <div class="maison__texte">
        <Ornements />
        <h2 class="section__titre">Italien, <em>de quartier</em></h2>
        <div class="prose">{histoire.map((p) => <p>{p}</p>)}</div>
      </div>
    </div>
  </section>

  <section class="section section--canard">
    <div class="wrap">
      <h2 class="section__titre">Les plats, <em>la façade</em></h2>
      <div class="grille-photos">
        {galerie.map((p, i) => (
          <figure class="tirage" style={`--r:${[-3, 4, -2, 3, -5, 2][i]}deg`} data-reveal="up" data-delay={String((i % 3) * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.legende}</figcaption>
          </figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--lin" href={u('/reservation/')}>Réserver une table</a></div>
    </div>
  </section>
</Base>
