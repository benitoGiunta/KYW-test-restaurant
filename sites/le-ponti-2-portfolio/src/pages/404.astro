---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n'existe pas ou plus.">
  <section class="wrap page-404">
    <span class="obj obj--mobile obj--corail is-flottant" style="position:static;--r:-12deg;--taille:120px;margin:0 auto var(--u)" aria-hidden="true"><Objet id="citron" classe="obj__svg" /></span>
    <p class="meta">Erreur 404</p>
    <h1>Cette table <em class="ital">n'existe pas</em></h1>
    <p class="lead" style="margin:calc(var(--u)*2) auto 0">La page que vous cherchez n'existe pas ou plus.</p>
    <div class="actions"><a class="btn btn--plein" href={u('/')}>Retour à l'accueil</a><a class="btn" href={u('/carte/')}>La carte</a></div>
  </section>
</Base>
