---
// Terrasse : seule info prouvée = « lorsque la météo le permet » (site actuel). Places et jours restent à confirmer.
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g } from '../data/site';
import { u, asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const photos = g.tirages.filter((t) => ['facade-enseigne', 'facade-rue'].some((n) => t.src.endsWith(n + '.webp')));
---
<Base title="Terrasse" description={`La terrasse de ${site.nom} à Jambes (Namur), ouverte lorsque la météo le permet, pour les pizzas, les pâtes et les cocktails.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse</h1>
      <p class="lead">{g.terrasse.texte}</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Dehors, <em class="ital">dès qu’il fait beau</em></h2>
      <p class="lead">Un Spritz Ponti, une pizza, un plat de pâtes : la terrasse ouvre lorsque la météo le permet.</p>
      <p class="muted" style="margin-top:calc(var(--u)*2);font-size:var(--t-s)">{g.terrasse.aConfirmer}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.legende} (photo de la façade)</figcaption>
          </figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--plein" href={u('/reservation/')}>Réserver une table</a></div>
    </div>
  </section>
</Base>
