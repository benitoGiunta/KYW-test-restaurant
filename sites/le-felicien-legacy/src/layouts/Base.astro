---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import { resto, horaires } from '../data/site';
interface Props { title: string; description: string; page: string; accueil?: boolean }
const { title, description, page, accueil = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}photos/pates-brasserie.webp`, Astro.site).href;
const jours = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const clean = (t: string) => t.replace(/ /g, ' ');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: resto.nom,
  url: resto.site,
  image: ogImage,
  telephone: '+32 81 39 53 23',
  email: resto.email,
  servesCuisine: 'Brasserie belge et française',
  address: { '@type': 'PostalAddress', streetAddress: 'Avenue d’Ecolys 2 bte 3', postalCode: '5020', addressLocality: 'Suarlée', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: 50.485, longitude: 4.7953 },
  hasMap: resto.carte,
  sameAs: [resto.facebook, resto.instagram],
  openingHoursSpecification: horaires.flatMap((j) => [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${jours[j.jour]}`, opens: '12:00', closes: '14:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${jours[j.jour]}`, opens: '18:00', closes: clean(j.soir).includes('22') ? '22:00' : '21:30' },
  ]),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3ecd9" />
    <link rel="icon" href={`${base}logo.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=Archivo:wght@400;500&family=Archivo+Narrow:wght@600&display=swap" rel="stylesheet" />
    {page !== '404' && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={resto.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Assiette de pâtes et légumes sur un comptoir" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      @import "../styles/page.css";
    </style>
  </head>
  <body data-page={page}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer accueil={accueil} />
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <script is:inline>
      (function () {
        var map = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        var j = new Date().getDay();
        try { var w = new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: 'Europe/Brussels' }).format(new Date()); if (w in map) j = map[w]; } catch (e) {}
        document.querySelectorAll('[data-jour]').forEach(function (el) { if (Number(el.dataset.jour) === j) { el.classList.add('is-now'); el.setAttribute('aria-current', 'date'); } });
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length || !('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting || e.boundingClientRect.top < 0) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -10% 0px' });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
    <KywFooter base={import.meta.env.BASE_URL} />
  </body>
</html>
