---
import { resto, nav } from '../data/site';
interface Props { page: string }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="mast">
  <div class="container mast__in">
    <button class="btn btn--line mast__toggle" type="button" popovertarget="menu" aria-controls="menu" aria-expanded="false">Menu</button>
    <a class="mast__logo" href={base} aria-label="Le Félicien, brasserie, accueil">
      <img src={`${base}logo.svg`} width="220" height="110" alt="" fetchpriority="high" />
    </a>
    <nav class="mast__nav" id="menu" popover aria-label="Principal">
      <ul class="mast__links mast__links--l">
        {nav.slice(0, 2).map((n) => <li><a href={`${base}${n.href}`} aria-current={page === n.id ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <ul class="mast__links mast__links--r">
        <li><a href={`${base}${nav[2].href}`} aria-current={page === nav[2].id ? 'page' : undefined}>{nav[2].label}</a></li>
        <li class="mast__book"><a class="btn btn--line" href={resto.reservation} rel="noopener">Réserver une table</a></li>
      </ul>
    </nav>
    <a class="btn btn--line mast__book-m" href={resto.reservation} rel="noopener" aria-label="Réserver une table">Réserver</a>
  </div>
</header>
<script is:inline>
  (function () {
    var m = document.getElementById('menu'), b = document.querySelector('.mast__toggle');
    if (!m || !b) return;
    m.addEventListener('toggle', function (e) { b.setAttribute('aria-expanded', e.newState === 'open' ? 'true' : 'false'); });
    m.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a') && m.matches(':popover-open')) m.hidePopover(); });
  })();
</script>
