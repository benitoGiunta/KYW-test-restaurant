---
import Base from '../layouts/Base.astro';
import { resto, groupes } from '../data/site';
---
<Base page="carte" title="La carte d’automne, Le Félicien à Suarlée (Namur)" description="Toute la carte d’automne du Félicien : entrées, plats, pâtes, veggie, desserts et bar, avec les prix.">
  <section class="page-hero" aria-labelledby="h-carte">
    <div class="container page-hero__in">
      <h1 id="h-carte">La carte d’automne.</h1>
      <p class="lead">Un doute sur les allergènes&nbsp;? Posez la question à l’équipe.</p>
      <p class="page-hero__actions">
        <a class="btn btn--primary" href={resto.reservation} rel="noopener">Réserver une table</a>
        <a class="btn btn--quiet" href={resto.pdf} rel="noopener">Carte en PDF</a>
      </p>
    </div>
  </section>

  <nav class="jump" aria-label="Sections de la carte" data-switch>
    <div class="container">
      <ul>
        {groupes.map((g) => <li><a href={`#${g.id}`} id={`t-${g.id}`}>{g.nom}</a></li>)}
      </ul>
    </div>
  </nav>

  {groupes.map((g) => (
    <section class="sec sec--rule carte-sec" id={g.id} aria-labelledby={`h-${g.id}`}>
      <div class="container rows-block">
        <div class="rows-block__head">
          <h2 id={`h-${g.id}`}>{g.nom}</h2>
        </div>
        <div class="parts">
          {g.parties.map((c) => (
            <div class="part">
              {c.sous && <h3 class="part__title">{c.sous[0].toUpperCase() + c.sous.slice(1)}</h3>}
              <ul class="rows">
                {c.plats.map((p) => (
                  <li class="row">
                    <div class="row__main">
                      <h4>{p.nom}</h4>
                      {p.desc && <p>{p.desc}</p>}
                    </div>
                    {p.prix && <span class="row__px">{p.prix}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}
<script is:inline>
  (function () {
    var nav = document.querySelector('[data-switch]');
    if (!nav) return;
    var tabs = Array.prototype.slice.call(nav.querySelectorAll('a'));
    var panels = tabs.map(function (t) { return document.getElementById(t.getAttribute('href').slice(1)); });
    if (panels.some(function (p) { return !p; })) return;
    nav.setAttribute('role', 'none');
    var list = nav.querySelector('ul');
    list.setAttribute('role', 'tablist'); list.setAttribute('aria-label', 'Sections de la carte');
    tabs.forEach(function (t, i) {
      t.parentNode.setAttribute('role', 'presentation');
      t.setAttribute('role', 'tab'); t.setAttribute('aria-controls', panels[i].id);
      panels[i].setAttribute('role', 'tabpanel'); panels[i].setAttribute('aria-labelledby', t.id);
    });
    function select(i, focus, push) {
      tabs.forEach(function (t, k) {
        var on = k === i;
        t.setAttribute('aria-selected', on ? 'true' : 'false'); t.tabIndex = on ? 0 : -1; panels[k].hidden = !on;
      });
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (push) history.replaceState(null, '', '#' + panels[i].id);
    }
    tabs.forEach(function (t, i) { t.addEventListener('click', function (e) { e.preventDefault(); select(i, false, true); }); });
    list.addEventListener('keydown', function (e) {
      var i = tabs.indexOf(document.activeElement), n = tabs.length;
      if (i < 0) return;
      var k = e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i + n - 1) % n : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
      if (k < 0) return;
      e.preventDefault(); select(k, true, true);
    });
    function fromHash() { var k = panels.map(function (p) { return '#' + p.id; }).indexOf(location.hash); select(k < 0 ? 0 : k, false, false); }
    window.addEventListener('hashchange', fromHash);
    fromHash();
  })();
</script>
</Base>
