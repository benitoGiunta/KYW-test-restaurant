---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Le Félicien" description="Cette page n’existe pas ou a changé d’adresse.">
  <section class="page-hero" aria-labelledby="h-404">
    <div class="container page-hero__in">
      <h1 id="h-404">Page introuvable.</h1>
      <p class="lead">Cette adresse n’existe pas ou a changé.</p>
      <p class="page-hero__actions"><a class="btn btn--primary" href={base}>Retour à l’accueil</a><a class="btn btn--quiet" href={`${base}la-carte/`}>Voir la carte</a></p>
    </div>
  </section>
</Base>
