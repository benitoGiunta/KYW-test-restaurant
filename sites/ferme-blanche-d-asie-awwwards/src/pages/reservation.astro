---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, services, menus, eur0 } from '../data/site';
---
<Base title="Réservation" description="Réserver une table à La Ferme Blanche d’Asie, à Malonne : par téléphone au 081 44 64 89, par e-mail ou sur place. Ouvert tous les jours, parking privé." page="reservation">
  <section class="wrap page-tete" aria-labelledby="titre">
    <p class="page-lieu">Par téléphone ou par e-mail</p>
    <h1 id="titre" class="display page-titre">Réserver</h1>
    <p class="page-chapo">La réservation se fait par téléphone ou sur place. Pour les groupes et les salles privées, un acompte est demandé.</p>
    <p class="hero__actions">
      <a class="cta cta--or" href={site.telephoneHref}><span class="cta__txt">Appeler le {site.telephoneLisible}</span></a>
      <a class="cta cta--vide" href={`mailto:${site.email}?subject=${encodeURIComponent('Réservation')}`}><span class="cta__txt">Écrire un e-mail</span></a>
    </p>
  </section>

  <section class="wrap resa-grille" aria-label="Informations pratiques">
    <div class="resa__bloc">
      <h2 class="resa__titre">Horaires</h2>
      <ul class="resa__horaires">
        {services.map((s) => <li><span>{s.jours}</span><span>{s.midi}<br />{s.soir}</span></li>)}
      </ul>
      <p class="resa__doux">Ouvert tous les jours, jours fériés et veilles compris.</p>
    </div>
    <div class="resa__bloc">
      <h2 class="resa__titre">Adresse</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <p>Parking privé sur place. Terrasse et jardin aux beaux jours.</p>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>
    <div class="resa__bloc">
      <h2 class="resa__titre">Groupes et fêtes</h2>
      <p>Salle V.I.P. de 26 personnes, grande salle privée d’environ 300 personnes. Menu de Noël à {eur0(menus[1].prix)}, réveillon à {eur0(menus[2].prix)} avec un acompte de 20 € par personne.</p>
      <p>Retrouvez-nous aussi sur <a class="lien" href={site.facebook} rel="noopener">Facebook</a>.</p>
    </div>
  </section>

  <section class="wrap resa-photo" aria-label="Le restaurant">
    <figure><Photo cle="jardin" widths={[480, 800, 1200]} sizes="(max-width: 48rem) 100vw, 80vw" /><figcaption>{site.credit}</figcaption></figure>
  </section>
</Base>
