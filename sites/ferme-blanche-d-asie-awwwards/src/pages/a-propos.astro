---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, salles, notes } from '../data/site';
---
<Base title="La maison" description="La Ferme Blanche d’Asie à Malonne : cinq salles dont une salle V.I.P. de 26 personnes, terrasse, jardin, parking privé et commande sur tablette." page="a-propos">
  <section class="wrap page-tete" aria-labelledby="titre">
    <p class="page-lieu">Allée de la Maison Blanche, Malonne</p>
    <h1 id="titre" class="display page-titre">La maison</h1>
    <p class="page-chapo">Un bâtiment blanc sous un toit d’ardoise, un jardin avec son kiosque, une terrasse bordée de bambous : le restaurant asiatique de Malonne reçoit en famille, entre amis ou en grand groupe.</p>
  </section>

  <section class="wrap duo-photos" aria-label="Le bâtiment">
    <figure class="duo-photos__a"><Photo cle="terrasse" prioritaire widths={[480, 800, 1200]} sizes="(max-width: 48rem) 100vw, 58vw" /><figcaption>La terrasse sous parasols.</figcaption></figure>
    <figure class="duo-photos__b"><Photo cle="salon" widths={[480, 800]} sizes="(max-width: 48rem) 100vw, 34vw" /><figcaption>Le coin salon, à l’entrée de la salle.</figcaption></figure>
  </section>

  <section class="clair salles-sec" aria-labelledby="salles-t">
    <div class="wrap salles-grille">
      <h2 id="salles-t" class="display salles-titre">Des salles pour chaque table.</h2>
      <ul class="salles">
        {salles.map((s) => <li class="salle"><h3 class="salle__nom">{s.nom}</h3><p>{s.texte}</p></li>)}
      </ul>
      <p class="salles-note">Les salles V.I.P. et privée se réservent par téléphone ou sur place, avec un acompte. Au <a class="lien" href={site.telephoneHref}>{site.telephoneLisible}</a>.</p>
    </div>
  </section>

  <section class="wrap pratique" aria-labelledby="prat-t">
    <h2 id="prat-t" class="display pratique__titre">Pratique</h2>
    <dl class="pratique__liste">
      <div><dt>Commande</dt><dd>Sur tablette, à table, signalent des clients : chacun choisit son rythme.</dd></div>
      <div><dt>Stationnement</dt><dd>Parking privé devant le restaurant.</dd></div>
      <div><dt>Confort</dt><dd>Salle climatisée, service rapide.</dd></div>
      <div><dt>Paiement</dt><dd>{site.paiements}.</dd></div>
      <div><dt>Accueil</dt><dd>En {site.langues}.</dd></div>
      <div><dt>À emporter</dt><dd>{site.emporter}, commande au {site.telephoneLisible}.</dd></div>
    </dl>
    <p class="pratique__notes">{notes.resto} · {notes.ttr}</p>
    <p class="pratique__cta"><a class="cta cta--or" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a> <a class="cta cta--vide" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a></p>
  </section>
</Base>
