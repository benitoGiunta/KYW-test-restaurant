---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { site, carte, menus, nbPlats, eur, eur0 } from '../data/site';
---
<Base title="La carte" description={`La carte de La Ferme Blanche d’Asie à Malonne : ${nbPlats} plats numérotés, potages, entrées, plats, menu découverte à 29 € et menus de fêtes.`} page="carte">
  <section class="wrap page-tete" aria-labelledby="titre">
    <p class="page-lieu">Carte numérotée, prix en euros</p>
    <h1 id="titre" class="display page-titre">La carte</h1>
    <p class="page-chapo">{nbPlats} plats, numérotés comme sur la tablette. Les plats à emporter bénéficient de -10 %, commande au <a class="lien" href={site.telephoneHref}>{site.telephoneLisible}</a>.</p>
    <ul class="ancres" aria-label="Aller à un plateau">
      {carte.map((c, i) => <li><a class="lien-util" href={`#c${i}`}>{c.categorie}</a></li>)}
      <li><a class="lien-util" href="#menus">Les menus</a></li>
    </ul>
  </section>

  {carte.map((c, i) => (
    <section id={`c${i}`} class={`rayon wrap ${i % 2 ? 'rayon--clair' : ''}`} aria-labelledby={`t${i}`}>
      <header class="rayon__tete">
        <span class="rayon__rond" aria-hidden="true">{c.plats.length}</span>
        <h2 id={`t${i}`} class="display rayon__titre">{c.categorie}</h2>
      </header>
      <ol class={`plats ${c.plats.length > 8 ? 'plats--deux' : ''}`}>
        {c.plats.map((p) => (
          <li class="plat">
            <span class="plat__num">{p.num ?? ''}</span>
            <span class="plat__corps"><span class="plat__nom">{p.nom}</span>{p.description && <span class="plat__desc">{p.description}</span>}</span>
            <span class="plat__prix">{eur(p.prix)}</span>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section id="menus" class="rayon rayon--menus wrap" aria-labelledby="tm">
    <header class="rayon__tete">
      <span class="rayon__rond" aria-hidden="true">{menus.length}</span>
      <h2 id="tm" class="display rayon__titre">Les menus</h2>
    </header>
    <div class="menus">
      {menus.map((m) => (
        <article class="menu">
          <p class="menu__prix">{eur0(m.prix)}<span> {m.par}</span></p>
          <h3 class="menu__nom">{m.nom}</h3>
          <p class="menu__detail">{m.detail}</p>
          <p class="menu__texte">{m.texte}</p>
        </article>
      ))}
    </div>
    <p class="rayon__note">Les allergènes ne sont indiqués que pour les potages : demandez conseil au restaurant, au <a class="lien" href={site.telephoneHref}>{site.telephoneLisible}</a>.</p>
    <p class="rayon__cta"><a class="cta cta--or" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a></p>
  </section>
</Base>
