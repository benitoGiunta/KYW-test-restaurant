---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n’existe pas sur le site de La Ferme Blanche d’Asie. Retournez à l’accueil ou à la carte." page="404">
  <section class="wrap page-tete erreur">
    <div class="erreur__rond" aria-hidden="true">404</div>
    <h1 class="display page-titre">Plateau vide.</h1>
    <p class="page-chapo">Cette adresse n’existe pas : le plateau a tourné sans s’arrêter ici. Revenez à la table.</p>
    <p class="hero__actions">
      <a class="cta cta--or" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
      <a class="cta cta--vide" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
    </p>
  </section>
</Base>
