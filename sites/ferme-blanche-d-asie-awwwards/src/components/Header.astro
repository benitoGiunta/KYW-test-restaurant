---
import { u } from '../lib/url';
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const courant = (p: string) => (path === u(p).replace(/\/+$/, '') + '/' ? 'page' : undefined);
const liens = [
  { href: '/carte/', label: 'La carte' },
  { href: '/a-propos/', label: 'La maison' },
];
const menu = [{ href: '/', label: 'Accueil' }, ...liens, { href: '/reservation/', label: 'Réservation' }];
---
<header class="tete">
  <a class="tete__marque" href={base} aria-current={path === base ? 'page' : undefined}>
    <span class="tete__sceau" data-rot aria-hidden="true"></span><span class="tete__nom">Ferme Blanche d’Asie</span>
  </a>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => <li class="tete__desk"><a class="nl" href={u(l.href)} aria-current={courant(l.href)}>{l.label}</a></li>)}
      <li><a class="cta cta--petit" href={u('/reservation/')} aria-current={courant('/reservation/')}><span class="cta__txt">Réserver</span></a></li>
      <li class="tete__mob"><button class="tete__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-ouvrir>Menu</button></li>
    </ul>
  </nav>
  <dialog id="menu" class="panneau" aria-label="Menu">
    <div class="panneau__haut">
      <span class="panneau__marque">Ferme Blanche d’Asie</span>
      <button class="panneau__fermer" type="button" data-menu-fermer>Fermer</button>
    </div>
    <div class="panneau__anneau" aria-hidden="true">
      <svg class="panneau__svg" data-rot data-rapport="0.5" viewBox="0 0 100 100" focusable="false">
        <circle cx="50" cy="50" r="40" />
        <circle class="panneau__cran" cx="50" cy="10" r="2.2" />
      </svg>
    </div>
    <ul class="panneau__liste">
      {menu.map((l, i) => <li><a class="panneau__lien display" href={u(l.href)} aria-current={courant(l.href)} autofocus={i === 0 ? true : undefined}><span>{l.label}</span></a></li>)}
    </ul>
    <p class="panneau__pied"><a class="cta cta--or" href={site.telephoneHref}><span class="cta__txt">Appeler le {site.telephoneLisible}</span></a></p>
  </dialog>
</header>
