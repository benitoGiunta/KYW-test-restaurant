---
import Base from '../layouts/Base.astro';
import { site, telHref, servicesTexte } from '../data/site';
import { u } from '../lib/url';
const e = site.emporter;
const services = servicesTexte();
---
<Base title="À emporter" description="Les plats et les pizze de La Dolce Vita à Wépion à emporter : livraison gratuite dès 2 plats, de 18 h à 22 h, carte de fidélité sur demande." theme="four">
  <section class="s-four page-hero page-hero--four" data-theme-zone="four">
    <div class="wrap">
      <p class="eyebrow">À emporter</p>
      <h1 data-split="words">Chez vous</h1>
      <p class="lead">{e.intro} Pizze, pasta et dolci voyagent aussi bien que la carte est longue.</p>
    </div>
  </section>

  <section class="section" data-theme-zone="farine">
    <div class="wrap g12">
      <div style="grid-column: 1 / 8">
        <div class="cat__head">
          <h2 data-split="words">Les conditions</h2>
          <span class="cat__num">{String(e.lignes.length).padStart(2, '0')}</span>
        </div>
        <ul class="fournees" role="list" data-reveal="up">
          {e.lignes.map((l) => <li><span>{l.libelle}</span><span class="heure">{l.valeur}</span></li>)}
        </ul>
      </div>
      <div class="stack" style="grid-column: 9 / 13" data-reveal="up" data-delay="0.1">
        <h3>Commander</h3>
        <p class="muted">Contact du restaurant :</p>
        <p><a class="btn" href={telHref()}>{site.telephone}</a></p>
        {services.map((s) => <p class="muted">{`${s.libelle} · ${s.jours} · ${s.heures}`}</p>)}
        <p><a class="link" href={u('/carte/')}>Voir la carte</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (max-width: 767px) { .g12 > * { grid-column: 1 / 13 !important; } }
</style>
