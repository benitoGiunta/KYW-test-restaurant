---
import Base from '../layouts/Base.astro';
import Fiche from '../components/Fiche.astro';
import { site, photoDe, compteCategorie } from '../data/site';
import { u, asset } from '../lib/url';
const cats = site.carte.filter((c) => site.pizze.categories.includes(c.categorie));
const photo = photoDe('/photos/pizza-margherita.webp');
let n = 0;
---
<Base title="Les pizze" description={`Les pizze de La Dolce Vita à ${site.adresse.commune} : de la margherita aux preferite de la maison, sur place et à emporter, avec les prix.`}>
  <section class="wrap page-hero">
    <p class="eyebrow">Pizzeria</p>
    <h1 data-split="words">Les pizze</h1>
    <p class="lead">De la margherita aux preferite de la maison, sur place comme à emporter.</p>
  </section>

  <section class="wrap" style="padding-bottom: calc(var(--u) * 6)">
    <figure style="margin: 0">
      <img src={asset(photo.src)} alt={photo.alt} width={photo.largeur} height={photo.hauteur} fetchpriority="high" decoding="async" style="width: 100%; max-height: 32rem; object-fit: cover; display: block" />
    </figure>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      {cats.map((c) => (
        <div class="cat">
          <div class="cat__head">
            <h2 data-split="words">{c.categorie}</h2>
            <span class="cat__num">{compteCategorie(c)}</span>
          </div>
          <div class="cat__grid">
            {c.plats.map((p, i) => { n++; return (
              <Fiche nom={p.nom} description={p.description} prix={p.prix} tag={p.tags?.[0]} placeholder={p.placeholder} delai={(i % 2) * 0.08} />
            ); })}
          </div>
        </div>
      ))}
      <div class="cat">
        <div class="cat__head">
          <h2 data-split="words">Suppléments</h2>
        </div>
        <ul class="fournees" role="list" data-reveal="up">
          {site.pizze.supplements.map((s) => <li><span>{s.libelle}</span><span class="heure">{s.prix}</span></li>)}
        </ul>
      </div>
      <div class="actions">
        <a class="btn" href={u('/carte/')}>Le reste de la carte</a>
        <a class="link" href={u('/a-emporter/')}>Pizze à emporter</a>
      </div>
    </div>
  </section>
</Base>
