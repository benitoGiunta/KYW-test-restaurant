---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Le Panorama" description="Cette page n’existe pas.">
  <div class="container page-head" style="min-height:50vh;align-content:center">
    <h1>Cette page n’existe pas</h1>
    <p class="lead">Retour à l’accueil ou à la carte.</p>
    <div class="actions"><a class="btn" href={base}>Accueil</a><a class="btn-link" href={base + 'la-carte/'}>La carte</a></div>
  </div>
</Base>
