---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import Horaires from '../components/Horaires.astro';
import { resto } from '../data/site';
import { carte } from '../data/carte';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const flam = carte.find((c) => c.id.startsWith('au-four'))!.plats.slice(0, 3);
const entrees = carte.find((c) => c.id === 'entrees-chaudes')!.plats.find((p) => p.nom.startsWith('Croquettes'))!;
const tartare = carte.find((c) => c.id === 'instant-de-folie')!.plats[0];
const choix = [...flam.slice(0, 1), entrees, tartare];
---
<Base page="index" title="Le Panorama, restaurant au sommet de la Citadelle de Namur" description="Brasserie bistronomique au sommet de la Citadelle de Namur : vue à 360° sur la ville et la Meuse, carte signée par le chef Yves Mattagne.">
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1>Au sommet de la Citadelle</h1>
          <p class="lead">Vue à 360° sur Namur, carte signée Yves&nbsp;Mattagne.</p>
          <div class="actions">
            <a class="btn" href={base + 'reservation-contact/'}>Réserver une table</a>
            <a class="btn-link" href={base + 'la-carte/'}>Voir la carte</a>
          </div>
        </div>
        <div class="hero-photo"><Fig k="vue" hero sizes="(min-width: 60rem) 58vw, 100vw" pos="50% 60%" /></div>
      </div>
      <dl class="counter">
        <div><dt>Adresse</dt><dd>{resto.adresse[0]}<br />{resto.adresse[1]}</dd></div>
        <div><dt>Réserver</dt><dd><a href={resto.telHref}>{resto.tel}</a></dd></div>
        <div><dt>Accès</dt><dd>À une centaine de mètres du téléphérique</dd></div>
      </dl>
    </div>
  </section>

  <section class="sec sec-bar" style="margin-top:var(--section-gap-s)" aria-labelledby="lieu">
    <div class="container split rev">
      <div class="txt">
        <h2 id="lieu">Un point de vue à 360° sur la ville</h2>
        <p>Au sommet de la Citadelle, sur la Route Merveilleuse, le Panorama a fait peau neuve. L’ambiance est élégante et chaleureuse, en salle entièrement rénovée ou en terrasse, du lundi au dimanche.</p>
        <div class="actions"><a class="btn-link" href={base + 'le-panorama/'}>Découvrir le lieu</a></div>
      </div>
      <Fig k="platanes" />
    </div>
  </section>

  <section class="sec sec-bar" aria-labelledby="carte">
    <div class="container cols">
      <div class="a">
        <h2 id="carte">La carte, de l’apéro aux plats du monde</h2>
        <p>Une cuisine tournée vers le monde, faite de produits locaux, et des classiques de brasserie revus façon bistronomie. La carte d’automne 2026 compte onze rubriques.</p>
        <div class="actions"><a class="btn" href={base + 'la-carte/'}>Toute la carte</a></div>
      </div>
      <div class="b">
        <ul class="rows">
          {choix.map((p) => (
            <li class={`row${String(p.prix).length > 9 ? ' dbl' : ''}`}><div class="t"><strong>{p.nom}</strong>{p.desc && <span>{p.desc}</span>}</div><span class="p">{p.prix}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band sec" aria-label="Le chef et la bière Pano">
    <div class="container twin">
      <div>
        <h2>Une carte signée Yves Mattagne</h2>
        <p>Le chef doublement étoilé signe la carte et lui apporte sa touche personnelle : ici on mange, mais on respire, on goûte et on regarde aussi.</p>
      </div>
      <div>
        <h2>Tarte flambée au four à bois</h2>
        <p>La Flammeküeche est cuite au four à bois, selon la recette apprise auprès du chef alsacien Patrice Bluntzer, de l’auberge Saint-Martin à Kintzheim.</p>
      </div>
      <div>
        <h2>La Pano, bière blanche du lieu</h2>
        <p>Brassée avec La Houppe, la Pano n’est servie qu’au Panorama. Elle accompagne les plats ou l’apéritif, face à la vue.</p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="horaires">
    <div class="container cols">
      <div class="a">
        <h2 id="horaires">Ouvert tous les jours</h2>
        <p>Pas de réservation pour la terrasse. Pour les groupes dès 7 personnes, écrivez à <a href={`mailto:${resto.groupes}`}>{resto.groupes}</a>.</p>
      </div>
      <div class="b"><Horaires /></div>
    </div>
  </section>

  <section class="sec sec-bar" aria-labelledby="fin">
    <div class="container split">
      <div class="txt">
        <h2 id="fin">Réservez votre table au sommet</h2>
        <p>Par téléphone au <a href={resto.telHref}>{resto.tel}</a> ou en ligne.</p>
        <div class="actions"><a class="btn" href={base + 'reservation-contact/'}>Réserver une table</a><a class="btn-link" href={resto.maps} rel="noopener">Itinéraire</a></div>
      </div>
      <Fig k="guirlandes" />
    </div>
  </section>
</Base>
