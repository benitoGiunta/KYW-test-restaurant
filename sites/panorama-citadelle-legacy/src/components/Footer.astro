---
import { resto, nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="foot">
  <div class="container">
    <div class="foot-grid">
      <div>
        <a class="brand" href={base}>Le Panorama<span>Citadelle de Namur</span></a>
        <p>{resto.baseline}.</p>
      </div>
      <div>
        <h2>Pages</h2>
        {nav.map((n) => <a href={base + n.href}>{n.label}</a>)}
      </div>
      <div>
        <h2>Nous trouver</h2>
        <p>{resto.adresse[0]}<br />{resto.adresse[1]}</p>
        <a href={resto.maps} rel="noopener">Itinéraire</a>
        <a href={resto.telHref}>{resto.tel}</a>
        <a href={`mailto:${resto.groupes}`}>{resto.groupes}</a>
      </div>
      <div>
        <h2>Suivre</h2>
        <a href={resto.facebook} rel="noopener">Facebook</a>
        <a href={resto.instagram} rel="noopener">Instagram</a>
      </div>
    </div>
    <p class="small foot-credits" data-credits>Photographies : le restaurant.</p>
  </div>
</footer>
