---
import { photos } from '../data/site';
interface Props { k: keyof typeof photos; hero?: boolean; cls?: string; sizes?: string; pos?: string; cap?: boolean }
const { k, hero = false, cls = '', sizes = '(min-width: 60rem) 50vw, 100vw', pos = 'center', cap = true } = Astro.props;
const p = photos[k];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = (w: number) => `${base}photos/${p.n}-${w}.webp`;
const h = Math.round((p.h / p.w) * 1600);
---
<figure class={`fig ${cls}`.trim()}>
  <div data-slot={`photo-${k}`} data-alt={p.alt} data-credits="Photographie du restaurant">
    <img src={src(1600)} srcset={`${src(800)} 800w, ${src(1600)} 1600w`} sizes={sizes} width="1600" height={h} alt={p.alt} style={`object-position:${pos}`} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : undefined} decoding={hero ? 'sync' : 'async'} />
  </div>
  {cap && <figcaption>{p.cap}</figcaption>}
</figure>
