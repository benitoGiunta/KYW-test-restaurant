---
import { nav, resto } from '../data/site';
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cur = { index: '', 'le-panorama': 'le-panorama/', 'la-carte': 'la-carte/', 'reservation-contact': 'reservation-contact/' }[page as string];
---
<header class="site-head">
  <div class="container">
    <a class="brand" href={base}>Le Panorama<span>Citadelle de Namur</span></a>
    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        {nav.slice(1, 3).map((n) => <li><a href={base + n.href} aria-current={cur === n.href ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a class="btn" href={base + 'reservation-contact/'}>Réserver</a></li>
      </ul>
    </nav>
  </div>
</header>
