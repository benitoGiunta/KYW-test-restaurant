---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas ou plus sur le site de ${site.nom}. Retrouvez la carte, la maison et la réservation depuis l'accueil.`}>
  <section class="page-simple wrap">
    <p class="petite-cap">Erreur 404</p>
    <h1 data-split="lines" data-intro>Cette page n'est pas au menu</h1>
    <p class="lead">La page demandée est introuvable. La carte, la maison et la réservation sont à leur place.</p>
    <div class="actions">
      <a class="btn" href={u('/')}>Retour à l'accueil</a>
      <a class="btn btn--ghost" href={u('/menu/')}>La carte</a>
    </div>
  </section>
</Base>
