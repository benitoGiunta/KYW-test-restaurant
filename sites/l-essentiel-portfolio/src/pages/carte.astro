---
// Menus : cadence de blocs 50/50 photo / aplat ; accords mets et boissons (prix du dossier).
import Base from '../layouts/Base.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
// Les photos de salle illustrent l'ambiance : le dossier ne relie aucune photo de plat à un menu.
const visuels = [photoDe('/photos/salle-brique.webp'), photoDe('/photos/salle-rideaux.webp'), photoDe('/photos/salle-chaises.webp'), photoDe('/photos/salle-table-ronde.webp')];
const [deux, affaire, plaisir, balade] = site.menus;
const ordre = [affaire, plaisir, balade, deux];
const moments = ['Le midi, en semaine', 'Le soir comme le midi', 'Le soir comme le midi', 'À la carte'];
const liens = [u('/reservation/'), u('/reservation/'), u('/reservation/'), u('/menu/')];
const libelles = ['Réserver le midi', 'Réserver une table', 'Réserver une table', 'Voir la carte'];
---
<Base title="Menus" description={`Les menus de L'Essentiel à Temploux : Affaire ${affaire.prix} le midi en semaine, Plaisir ${plaisir.prix} en 4 services, Balade ${balade.prix} en 6 services, ou deux assiettes à la carte.`}>
  <section class="entete-page wrap">
    <p class="petite-cap">Menus</p>
    <h1 data-split="lines" data-intro>Du midi au soir</h1>
    <p class="lead">Quatre façons de se mettre à table. Chaque menu est servi pour la table entière.</p>
  </section>

  {ordre.map((m, i) => (
    <section class:list={['split', { 'split--inverse': i % 2 === 1 }]} aria-labelledby={`formule-${i}`}>
      <figure class="split__media" data-reveal="fade">
        <img src={asset(visuels[i].src)} alt={visuels[i].alt} width={visuels[i].largeur} height={visuels[i].hauteur} loading="lazy" decoding="async" />
      </figure>
      <div class="split__aplat">
        <p class="petite-cap">{moments[i]}</p>
        <h2 id={`formule-${i}`} data-split="lines">{m.nom}</h2>
        <p class="lead" style="font-weight: 400">{m.prix}{m.placeholder && <span class="illu">illustratif</span>}</p>
        <p class="texte">{m.description}</p>
        <a class="filet" data-filet href={liens[i]}><span>{libelles[i]}</span><span class="fleche" aria-hidden="true">→</span></a>
      </div>
    </section>
  ))}

  <section class="section wrap deux-colonnes" aria-labelledby="accords-titre">
    <div>
      <p class="petite-cap">Accords</p>
      <h2 id="accords-titre" style="margin-top: 0.4em">Au verre, à table</h2>
      <p class="muted" style="margin-top: 1em; max-width: 30ch">Prix de l'accord, en plus du menu.</p>
    </div>
    <ul class="menu-liste" style="list-style: none">
      {site.accords.map((a) => (
        <li data-reveal="fade">
          <span class="num" aria-hidden="true"></span>
          <span class="nom">{a.boisson}<small>{a.menu}</small></span>
          <span class="prix">{a.prix}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
