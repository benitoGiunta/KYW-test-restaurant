---
import { site } from '../data/site';
---
<dl class="schedule">
  <div class="schedule__row schedule__row--open"><dt>Vendredi</dt><dd><time>{site.horaires.vendredi}</time></dd></div>
  <div class="schedule__row schedule__row--closed" data-placeholder="true"><dt>Lundi à jeudi</dt><dd>Fermé, à confirmer</dd></div>
  <div class="schedule__row schedule__row--closed" data-placeholder="true"><dt>Samedi et dimanche</dt><dd class="fill">Horaires à confirmer avec la boulangerie</dd></div>
</dl>
