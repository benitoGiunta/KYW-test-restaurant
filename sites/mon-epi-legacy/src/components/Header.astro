---
import { site } from '../data/site';
import { u } from '../lib/url';
const { current = '' } = Astro.props;
---
<header class="site-header">
  <div class="container banner">
    <a class="wordmark" href={u('')}><span class="wordmark__name">Monepi</span><span class="wordmark__sub">Boulangerie</span></a>
    <p class="banner__contact">
      <a href={`tel:${site.telephone.replace(/\s/g, '')}`} class="num">{site.telephoneAffiche}</a>
      <a href={site.facebook} rel="noopener" target="_blank">Facebook</a>
    </p>
  </div>
  <div class="bar">
    <div class="container bar__inner">
      <button class="menu-btn" type="button" popovertarget="menu" aria-controls="menu" aria-expanded="false"><span class="menu-btn__open">Menu</span><span class="menu-btn__close">Fermer</span></button>
      <nav id="menu" class="site-nav" popover aria-label="Navigation principale">
        <ul class="bar__list">
          {site.nav.map((n) => (
            <li><a href={u(n.href)} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
