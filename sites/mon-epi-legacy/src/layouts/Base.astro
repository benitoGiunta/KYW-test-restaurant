---
import KywFooter from '@kyw/footer';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
interface Props { title?: string; description?: string; current?: string }
const { title, description = site.description, current = '' } = Astro.props;
const fullTitle = title ? `${title} | ${site.nom}` : `${site.enseigne} | Pain au levain cuit au feu de bois à Loyers`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kyw-test-restaurant.vercel.app').href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_BE" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=Archivo:wght@400;500&family=Archivo+Narrow:wght@600&display=swap" rel="stylesheet" />
  <style is:global>@import "../styles/page.css";</style>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header current={current} />
    <main id="contenu"><slot /></main>
    <Footer />
    <KywFooter base={import.meta.env.BASE_URL} />
    <script>
      const nav = document.getElementById('menu');
      const btn = document.querySelector('.menu-btn');
      const bar = document.querySelector('.bar');
      if (nav && btn && bar && typeof nav.hidePopover === 'function') {
        const close = () => { if (nav.matches(':popover-open')) nav.hidePopover(); };
        nav.addEventListener('beforetoggle', (e) => {
          if ((e as ToggleEvent).newState === 'open') {
            nav.style.setProperty('--menu-top', bar.getBoundingClientRect().bottom + 'px');
            window.addEventListener('scroll', close, { once: true, passive: true });
          }
        });
        nav.addEventListener('toggle', (e) => btn.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
        nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) close(); });
        matchMedia('(min-width: 60.0625rem)').addEventListener('change', (m) => { if (m.matches) close(); });
      }
    </script>
  </body>
</html>
