---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Icone from '../components/Icone.astro';
import Horaires from '../components/Horaires.astro';
import { site, moments, brunchFamilles, photoDe, itineraire } from '../data/site';
import { u, asset } from '../lib/url';

const icones = ['tasse', 'assiette', 'couverts', 'couverts', 'verre', 'lune'];
const m = Object.fromEntries(moments.map((x) => [x.id, x]));
const cafe = m['m-7h'], pain = m['m-9h'], brunch = m['m-11h30'], dago = m['m-14h'], tea = m['m-15h30'], nuit = m['m-17h30'];
const photoCafe = photoDe(cafe.photo!), photoBrunch = photoDe(brunch.photo!), photoDago = photoDe(dago.photo!), photoTea = photoDe(tea.photo!);
const medaillons = [
  { photo: photoDe('/photos/vitrine.webp'), titre: 'La vitrine', texte: 'Tartes et pâtisseries aux fruits rouges' },
  { photo: photoDe('/photos/tarte-framboises.webp'), titre: 'Tarte aux fruits rouges', texte: 'Framboises et groseilles' },
  { photo: photoDe('/photos/plateau-mini-sandwichs.webp'), titre: 'Mini-sandwichs', texte: 'Plateau à emporter' },
];
const fleche = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<Base theme="aube">
  <div data-accueil>
    <section class="hero" id="accueil" data-ciel="auto" aria-labelledby="titre">
      <div class="wrap">
        <div class="hero__haut">
          <Badge />
          <p class="horloge" aria-label="Heure locale">
            <svg class="horloge__ring" viewBox="0 0 36 36" aria-hidden="true"><circle class="fond" cx="18" cy="18" r="15.9" /><circle class="cran" cx="18" cy="18" r="15.9" pathLength="100" data-horloge-ring /></svg>
            <span class="horloge__hm num" data-horloge-hm>--:--</span>
            <span class="horloge__s num" data-horloge-s aria-hidden="true"></span>
          </p>
        </div>
        <h1 class="hero__nom t-mega" id="titre">Dumont<br />Bouge</h1>
        <p class="hero__baseline lead">Pâtisserie, boulangerie, restauration et tea-room à Bouge : le pain du matin, le brunch de midi, les gâteaux de l'après-midi, tous les jours de 7h à 18h.</p>
        <ul class="chips" data-reveal="up" data-intro data-delay="0.35" aria-label="Les moments de la journée">
          {moments.map((x, i) => (
            <li><a class="chip" href={`#${x.id}`} data-chip={x.id}><Icone nom={icones[i]} /><span class="chip__h">{x.heureTexte}</span><span class="chip__t">{x.titre}</span></a></li>
          ))}
        </ul>
        <p class="maintenant" data-maintenant hidden>
          <a class="maintenant__lien" href="#accueil" data-maintenant-lien><span class="maintenant__point" aria-hidden="true"></span><span data-maintenant-texte>Aller au moment présent</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></a>
        </p>
      </div>
    </section>

    <!-- 7h PETIT-DÉJEUNER : split texte | photo. -->
    <section class="moment moment--split" id={cafe.id} data-ciel={cafe.theme} aria-labelledby="t-7h">
      <div class="wrap cols">
        <div class="c1-6">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{cafe.heureTexte}</p>
            <h2 class="moment__titre" id="t-7h" data-split="words">{cafe.titre}</h2>
          </div>
          <p class="moment__accroche" data-reveal="fade">{cafe.accroche}</p>
          <ul class="lignes" data-reveal="up">
            {cafe.lignes.map((l) => (
              <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
            ))}
          </ul>
          <div class="actions"><a class="btn" href={u('/carte/')}>Toute la carte</a></div>
        </div>
        <figure class="c8-12 photo photo--4x5" data-reveal="clip">
          <img src={asset(photoCafe.src)} alt={photoCafe.alt} width={photoCafe.largeur} height={photoCafe.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
        </figure>
      </div>
    </section>

    <!-- 9h PAIN ET VITRINE : médaillons ronds à titre courbé. -->
    <section class="moment" id={pain.id} data-ciel={pain.theme} aria-labelledby="t-9h">
      <div class="wrap">
        <div class="moment__tete">
          <p class="moment__heure num" data-split="chars">{pain.heureTexte}</p>
          <h2 class="moment__titre" id="t-9h" data-split="words">{pain.titre}</h2>
        </div>
        <div class="cols">
          <p class="c1-6 moment__accroche">{pain.accroche}</p>
          <ul class="c1-10 medaillons" data-medaillons tabindex="0" aria-label="La vitrine de Dumont Bouge">
            {medaillons.map((md, i) => (
              <li>
                <div class="medaillon">
                  <div class="medaillon__photo"><img src={asset(md.photo.src)} alt={md.photo.alt} width={md.photo.largeur} height={md.photo.hauteur} loading="lazy" decoding="async" /></div>
                  <svg class="medaillon__anneau" viewBox="0 0 200 200" aria-hidden="true">
                    <defs><path id={`arc-${i}`} d="M100,100 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0" /></defs>
                    <text><textPath href={`#arc-${i}`} startOffset="0">{md.titre} · Dumont Bouge · {md.titre} · Dumont Bouge ·</textPath></text>
                  </svg>
                </div>
                <p class="medaillon__legende"><b>{md.titre}</b>{md.texte}</p>
              </li>
            ))}
          </ul>
          <div class="c1-6">
            <ul class="lignes" data-reveal="up">
              {pain.lignes.map((l) => (
                <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
              ))}
            </ul>
            <p class="actions"><a class="fleche" href={`${u('/carte/')}#boulangerie`}>Les pains et les gâteaux <Fragment set:html={fleche} /></a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 11h30 BRUNCH : liste index des familles de plats. -->
    <section class="moment" id={brunch.id} data-ciel={brunch.theme} aria-labelledby="t-11h30">
      <div class="wrap cols">
        <div class="c1-5">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{brunch.heureTexte}</p>
            <h2 class="moment__titre" id="t-11h30" data-split="words">{brunch.titre}</h2>
          </div>
          <p class="moment__accroche" data-reveal="fade">{brunch.accroche}</p>
          <ul class="lignes" data-reveal="up">
            {brunch.lignes.map((l) => (
              <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
            ))}
          </ul>
          <div class="actions"><a class="btn" href={u('/brunch/')}>Toute la carte du brunch</a></div>
        </div>
        <div class="c7-12">
          <p class="chapeau">Six familles de plats, de 11h30 à 15h</p>
          <ol class="jours">
            {brunchFamilles.map((f) => (
              <li class="jour" data-reveal="up">
                <span class="jour__nom">{f.nom}</span>
                <span class="jour__plat">{f.exemples}</span>
                <span class="jour__prix">{f.prix}</span>
              </li>
            ))}
          </ol>
          <figure class="photo photo--3x2" style="margin-top: calc(var(--u) * 3)" data-reveal="scale">
            <img src={asset(photoBrunch.src)} alt={photoBrunch.alt} width={photoBrunch.largeur} height={photoBrunch.hauteur} loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <!-- 14h DAGOBERT : bande de cartes. -->
    <section class="moment" id={dago.id} data-ciel={dago.theme} aria-labelledby="t-14h">
      <div class="wrap">
        <div class="moment__tete">
          <p class="moment__heure num" data-split="chars">{dago.heureTexte}</p>
          <h2 class="moment__titre" id="t-14h" data-split="words">{dago.titre}</h2>
        </div>
        <div class="cols" style="margin-bottom: calc(var(--u) * 3)">
          <p class="c1-6 moment__accroche" style="margin-bottom: 0">{dago.accroche}</p>
          <p class="c8-12" data-reveal="fade"><span class="happy"><Icone nom="couverts" />Dagobert en 1/3, 1/2, 3/4 de baguette, pistolet ou sandwich</span></p>
        </div>
        <ul class="bande lignes" data-reveal="up" tabindex="0" aria-label="Sandwichs, salades et paninis, défilables">
          <li class="carte-apero carte-apero--photo"><img src={asset(photoDago.src)} alt={photoDago.alt} width={photoDago.largeur} height={photoDago.hauteur} loading="lazy" decoding="async" /></li>
          {dago.lignes.map((l) => (
            <li class="carte-apero">
              <p class="carte-apero__nom">{l.nom}</p>
              <p>{l.detail && <span class="t-s muted">{l.detail}<br /></span>}<span class="carte-apero__prix">{l.prix}</span></p>
            </li>
          ))}
        </ul>
        <p class="actions"><a class="fleche" href={`${u('/carte/')}#a-emporter`}>Tous les Dagobert <Fragment set:html={fleche} /></a></p>
      </div>
    </section>

    <!-- 15h30 TEA-ROOM : paire asymétrique, ciel corail. -->
    <section class="moment moment--pair" id={tea.id} data-ciel={tea.theme} aria-labelledby="t-15h30">
      <div class="wrap cols">
        <figure class="c1-5 photo photo--4x5" data-reveal="clip">
          <img src={asset(photoTea.src)} alt={photoTea.alt} width={photoTea.largeur} height={photoTea.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
        </figure>
        <div class="c7-12">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{tea.heureTexte}</p>
            <h2 class="moment__titre" id="t-15h30" data-split="words">{tea.titre}</h2>
          </div>
          <p class="moment__accroche" data-reveal="fade">{tea.accroche}</p>
          <ul class="lignes" data-reveal="up">
            {tea.lignes.map((l) => (
              <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
            ))}
          </ul>
          <div class="actions" style="margin-top: calc(var(--u) * 2)">
            <a class="btn btn--solid" href={u('/reservation/')} data-magnetic="0.2">Réserver une table</a>
            <a class="btn" href={`${u('/carte/')}#tea-room`}>Le tea-room</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 17h30 FERMETURE : statement + horaires à flèches. -->
    <section class="moment" id={nuit.id} data-ciel={nuit.theme} aria-labelledby="t-17h30">
      <div class="wrap cols">
        <div class="c1-6">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{nuit.heureTexte}</p>
            <h2 class="moment__titre" id="t-17h30" data-split="words">{nuit.titre}</h2>
          </div>
          <p class="statement" data-split="lines">{nuit.accroche}</p>
          <ul class="lignes" style="margin-top: calc(var(--u) * 4); max-width: 30rem" data-reveal="up">
            {nuit.lignes.map((l) => (
              <li class="ligne"><span class="ligne__nom">{l.nom}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
            ))}
          </ul>
        </div>
        <div class="c8-12" data-reveal="up">
          <p class="chapeau">Horaires de la semaine</p>
          <Horaires />
          <div class="actions">
            <a class="btn btn--soleil" href={u('/reservation/')}>Réserver</a>
            <a class="btn" href={itineraire} rel="noopener">Itinéraire</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
