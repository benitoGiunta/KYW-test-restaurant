---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" borne="hors" title="Sentier perdu" description="Cette page n’existe pas : le sentier s’arrête ici. Retour à la ferme, à la carte ou à la réservation du D’Arville.">
  <section class="sec wrap grid p404" aria-labelledby="titre">
    <div class="p404__route">
      <p class="etiquette">Erreur 404</p>
      <h1 id="titre" class="display display--mega" data-split="lines" data-intro>Sentier perdu.</h1>
      <p class="lede">Cette page n’existe pas : le chemin s’arrête dans la prairie. La ferme est de l’autre côté.</p>
      <div class="actions">
        <a class="btn btn--plein" href={u('/')}>Retour à la ferme</a>
        <a class="btn" href={u('/carte/')}>La carte</a>
        <a class="btn" href={u('/reservation/')}>Réserver</a>
      </div>
    </div>
  </section>
</Base>
