---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, histoire, equipe, congesIntro } from '../data/site';
import { u } from '../lib/url';
---
<Base page="histoire" title="Le domaine" description="L’histoire du D’Arville : une ferme du 19e siècle à Wierde, Estelle et Olivier, la prairie de plus de 5 hectares et la villa Barabas à 200 mètres.">
  <section class="sec wrap page-tete" aria-labelledby="titre">
    <p class="etiquette">Le domaine</p>
    <h1 id="titre" class="display display--mega" style="font-size:var(--t-xl)">{histoire.titre}</h1>
  </section>
  <section class="sec wrap" aria-label="Histoire">
    <div class="grid histoire-corps">
      <div class="texte">
        {histoire.paragraphes.map((p) => <p class="corps">{p}</p>)}
        <p><a class="lien" href={u('/reservation/')}>Venir y dîner</a></p>
      </div>
      <figure class="photo photo--haut"><Photo cle="chef" widths={[480, 800, 1024]} sizes="(max-width: 52rem) 100vw, 30vw" /></figure>
      <figure class="photo histoire-large"><Photo cle="voileRouge" sizes="100vw" widths={[800, 1200, 1600]} /></figure>
    </div>
  </section>
  <section class="sec sec--pierre" aria-labelledby="t-equipe">
    <div class="wrap grid histoire-corps">
      <h2 id="t-equipe" class="display display--xl" style="grid-column:1/-1">À la barre</h2>
      <ul class="equipe">
        {equipe.map((e) => <li><strong>{e.nom}</strong><span>{e.role}</span></li>)}
      </ul>
      <p class="conges">{congesIntro}</p>
    </div>
  </section>
  <section class="sec wrap" aria-labelledby="t-jardin">
    <div class="grid histoire-corps">
      <h2 id="t-jardin" class="display display--xl" style="grid-column:1/-1">Dehors</h2>
      <figure class="photo" style="grid-column:1/span 7;aspect-ratio:3/2"><Photo cle="jardin" sizes="(max-width: 52rem) 100vw, 55vw" widths={[800, 1200]} /></figure>
      <p class="corps" style="grid-column:9/-1">Terrasse sous voile, jardin et point d’eau entourent la ferme.</p>
    </div>
  </section>
</Base>
