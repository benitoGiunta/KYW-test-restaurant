---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, balade, tendance, plats, fromages, autresMenus, boissons, eur } from '../data/site';
import { u } from '../lib/url';
const menus = [balade, tendance];
const [entrees, platsC, desserts] = plats;
---
<Base page="carte" title="La carte" description="La carte du D’Arville à Wierde : menus Balade à 90 € et Tendance de saison à 73 €, entrées, plats de saison, homard du vivier, lièvre, fromages et desserts.">
  <section class="sec wrap page-tete" aria-labelledby="titre">
    <p class="etiquette">Menus d’actualité jusqu’au 20 décembre 2026</p>
    <h1 id="titre" class="display display--mega" data-split="lines" data-intro>La carte</h1>
    <p class="lede">Deux menus qui suivent le service, une carte pour choisir à votre rythme.</p>
  </section>

  <section class="sec wrap deux-menus" aria-labelledby="t-menus">
    <h2 id="t-menus" class="sr-only">Les deux menus</h2>
    <div class="grid">
      {menus.map((m) => (
        <div class="menu-bloc">
          <p class="menu-prix"><strong>Menu « {m.nom} »</strong><span class="prix">{eur(m.prix)}</span></p>
          <ol class="route">
            {m.haltes.map((h) => (
              <li>
                <span class="route__etape">{h.etape}</span>
                <span class="route__plat">{h.plat}</span>
                {h.detail && <span class="route__detail">{h.detail}</span>}
              </li>
            ))}
          </ol>
          <p class="fig-legende">Accord mets, vins et café : {eur(m.accord)} par personne.</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec sec--pierre" aria-labelledby="t-carte">
    <div class="wrap grid carte-grille">
      <h2 data-split="lines" id="t-carte" class="display display--xl" style="grid-column:1/-1">À la carte</h2>
      <div class="cat">
        <div class="cat__tete"><h3 class="display display--l">{entrees.categorie}</h3><p class="cat__note">Toutes à {eur(30)}.</p></div>
        <ul class="index-plats">
          {entrees.plats.map((p) => (
            <li><span class="nom">{p.nom}</span><span class="prix">{p.prix && eur(p.prix)}</span><span class="desc">{p.description}</span></li>
          ))}
        </ul>
      </div>
      <figure class="carte__cote"><div class="photo"><Photo cle="dressage" widths={[480, 800, 1200]} sizes="(max-width: 52rem) 100vw, 30vw" /></div></figure>
      <div class="cat">
        <div class="cat__tete"><h3 class="display display--l">{platsC.categorie}</h3></div>
        <ul class="index-plats">
          {platsC.plats.map((p) => (
            <li><span class="nom">{p.nom}</span><span class="prix">{p.prix && eur(p.prix)}</span><span class="desc">{p.description}</span></li>
          ))}
        </ul>
      </div>
      <div class="cat">
        <div class="cat__tete"><h3 class="display display--l">Fromages</h3></div>
        <ul class="index-plats">
          <li><span class="nom">{fromages.nom}</span><span class="prix">{eur(fromages.prix)}</span><span class="desc">{fromages.description}. {eur(fromages.enRemplacementDuDessert)} en remplacement du dessert.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="t-desserts">
    <div class="grid carte-grille">
      <div class="cat__tete" style="grid-column:1/-1"><h2 data-split="lines" id="t-desserts" class="display display--xl">{desserts.categorie}</h2><p class="cat__note">{desserts.note}</p></div>
      <ul class="desserts">
        {desserts.plats.map((p) => (
          <li><p class="nom">{p.nom}</p><p class="desc">{p.description}</p></li>
        ))}
      </ul>
      <div class="annexes">
        {autresMenus.map((m) => (
          <div><h3 class="etiquette">{m.nom}</h3><p class="prix display display--l">{eur(m.prix)}</p><p class="corps" style="font-size:var(--t-s)">{m.description}</p></div>
        ))}
        <div><h3 class="etiquette">Menu « Bon Plan »</h3><p class="corps">Proposé le jeudi soir, le vendredi midi et le samedi midi. Détails auprès du restaurant.</p></div>
        <div>
          <h3 class="etiquette">À boire</h3>
          <ul class="jours">
            {boissons.map((b) => <li><span>{b.nom}, {b.note}</span><span class="prix">{eur(b.prix)}</span></li>)}
          </ul>
          <p class="corps" style="font-size:var(--t-s)">La carte des vins, « Le cellier du D’Arville », est sur <a class="lien" href={site.carteVinsUrl} rel="noopener">le site du restaurant</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--voile" aria-labelledby="t-appel">
    <div class="wrap grid appel">
      <h2 id="t-appel" class="display appel__titre" style="font-size:var(--t-xl)">Une table pour la balade ?</h2>
      <div class="appel__actions"><a class="btn btn--plein" href={u('/reservation/')}>Réserver</a></div>
    </div>
  </section>
</Base>
