---
interface Props { id: string; w: number; h: number; alt: string; ratio?: string; sizes?: string; eager?: boolean; pos?: string; credit?: string; slot?: string; caption?: string; class?: string }
const { id, w, h, alt, ratio, sizes = '(min-width: 60rem) 60vw, 100vw', eager = false, pos = '50% 50%', slot, caption, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<figure class={`photo ${cls}`}>
  <div class="photo__frame" data-slot={slot ?? id} data-alt={alt} data-credits="Photographie : Don Dino (dondino.be)" style={`aspect-ratio: ${ratio ?? `${w} / ${h}`}`}>
    <img src={`${base}photos/${id}-1600.webp`} srcset={`${base}photos/${id}-800.webp 800w, ${base}photos/${id}-1600.webp 1600w`} sizes={sizes} width={w} height={h} alt={alt} loading={eager ? undefined : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? undefined : 'async'} style={`object-position: ${pos}`} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
