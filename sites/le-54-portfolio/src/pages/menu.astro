---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const degustation = site.carte[0];
const supplements = site.carte[1];
// Les intitulés exacts des services ne sont pas connus (dossier) : aucune numérotation, les plats du moment sont listés tels quels.
const lignes = degustation.plats.map((p) => ({ ...p, numero: null as number | null }));
const photos = ['/photos/plat-tartare.webp', '/photos/plat-veloute.webp', '/photos/dessert-amandes.webp'].map(photoDe);
---
<Base title="Le menu" description={`Le menu du moment chez Le 54, à Dave (Namur) : veau sauce tonnato, bœuf wagyu A5, cochon de lait ou zarzuela. Trois services à 48 €, quatre à 65 €.`}>
  <HeroPage titre="Le menu" chiffre={site.chiffres.services} sur="Trois services à 48 €, quatre à 65 €">
    <p>Le menu du moment, de saison et de marché, renouvelé fréquemment. Toute modification est susceptible d'entraîner un supplément.</p>
  </HeroPage>

  <section class="section" aria-labelledby="menu-titre">
    <div class="wrap menu__grille">
      <h2 class="sr-only" id="menu-titre">{degustation.categorie}</h2>
      <ol class="menu__liste" aria-labelledby="menu-titre">
        {lignes.map((p) => (
          <li class:list={['menu__ligne', { 'menu__ligne--hors': p.numero === null }]} data-reveal="up">
            <span class="menu__numero" aria-hidden="true">{p.numero ? String(p.numero).padStart(2, '0') : '·'}</span>
            <span class="menu__nom">{p.nom}</span>
            {p.description && <span class="menu__desc">{p.description}{p.descriptionPlaceholder && <span class="illu">illustratif</span>}</span>}
          </li>
        ))}
      </ol>
      <aside class="menu__cote" data-reveal="fade">
        <p class="petite-cap">{supplements.categorie}</p>
        <ul class="menu__options">
          {supplements.plats.map((p) => <li><span>{p.nom}{p.description ? `, ${p.description}` : ''}</span>{p.prix && <strong>{p.prix}</strong>}</li>)}
        </ul>
        <p class="muted">{site.reservation.note}</p>
        <p><a class="btn btn--primary" href={u('/reservation/')}>Réserver</a></p>
      </aside>
    </div>
  </section>

  <section class="section section--photos" aria-label="Assiettes">
    <div class="wrap triptyque">
      {photos.map((p, i) => (
        <figure class:list={['triptyque__item', `triptyque__item--${i}`]} data-reveal="clip" data-delay={String(i * 0.1)}>
          <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>
</Base>
