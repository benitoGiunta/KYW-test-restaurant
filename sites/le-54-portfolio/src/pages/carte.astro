---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Formules" description={`Les menus de la maison Le 54, à Dave (Namur) : trois services à ${site.menus[0].prix}, quatre services à ${site.menus[1].prix}, suppléments wagyu et zarzuela.`}>
  <HeroPage titre="Formules" sur="Trois prix, une cuisine">
    <p>Le menu du moment se décline en trois ou quatre services. Le bœuf wagyu A5 et la zarzuela se commandent en supplément.</p>
  </HeroPage>

  <section class="section" aria-label="Les formules">
    <div class="wrap">
      <ol class="formules">
        {site.menus.map((m, i) => (
          <li class="formule" data-reveal="up" data-delay={String(i * 0.08)}>
            <p class="formule__prix" aria-hidden="true">{m.prix.replace(/\s*€/, '')}<span class="formule__euro">€</span></p>
            <div class="formule__texte">
              <h2 class="formule__nom">{m.nom}<span class="sr-only">, {m.prix}</span></h2>
              <p class="petite-cap">{m.services} services, {m.quand}</p>
              <p>{m.description}{m.aConfirmer && <span class="illu">à confirmer</span>}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="formules__pied" data-reveal="fade">
        <p><strong>Suppléments</strong> : bœuf wagyu A5 +40 €, zarzuela Royale +25 €, Impériale +35 € (minimum 2 personnes).</p>
        <div class="actions">
          <a class="btn" href={u('/menu/')}>Le menu en détail</a>
          <a class="btn btn--primary" href={u('/reservation/')}>Réserver</a>
        </div>
      </div>
    </div>
  </section>
</Base>
