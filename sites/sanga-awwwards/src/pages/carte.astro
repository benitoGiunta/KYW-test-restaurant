---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site, carte, bouillons, eur } from '../data/site';
---
<Base title="La carte" description="La carte de Sanga à Namur : cinq ramen au bouillon miso, shio ou shoyu, udon, soba, six donburi, gyoza, boissons. Prix de 1,50 à 18,80 euros." page="carte">
  <section class="strate titre-page strate--sans-sceau" aria-labelledby="titre-carte">
    <div class="wrap">
      <p class="kanji titre-page__kanji" aria-hidden="true" lang="ja" data-split="chars" data-intro>山河</p>
      <h1 class="display display--mega" id="titre-carte">La carte</h1>
      <p class="titre-page__chapo">Ramen, udon, soba et donburi. Prix en euros, sur place et à emporter.</p>
    </div>
  </section>

  <section class="strate strate--crete" aria-label="Plats et boissons">
    <div class="wrap">
      <div class="grille carte__grille">
        <nav class="sommaire" aria-label="Sections de la carte">
          <ul>
            {carte.map((c) => <li><a href={`#${c.cle}`}>{c.titre}<span aria-hidden="true">{c.plats.length}</span></a></li>)}
          </ul>
        </nav>
        <div class="biefs">
          {carte.map((c) => {
            const vedette = c.plats.find((p) => p.photo);
            return (
              <section class="bief" id={c.cle} aria-labelledby={`t-${c.cle}`}>
                <div class="bief__tete">
                  <h2 data-split="lines" class="display display--xl" id={`t-${c.cle}`}>{c.titre}</h2>
                  {c.note && <p class="bief__note">{c.note}</p>}
                  {c.cle === 'ramen' && (
                    <ul class="puces" aria-label="Bouillons au choix">
                      {bouillons.map((b) => <li data-ton={b.ton}><span class="bouillons__goutte" aria-hidden="true"></span>{b.nom}<span class="doux petit">, {b.sens}</span></li>)}
                    </ul>
                  )}
                </div>
                {vedette?.photo && (
                  <figure class="bief__photo" data-reveal="clip">
                    <div class="crete-photo"><Photo cle={vedette.photo} widths={[480, 800, 1200]} sizes="(max-width: 64rem) 100vw, 62vw" /></div>
                    <figcaption class="credit">{site.credit}</figcaption>
                  </figure>
                )}
                <ul class="plats" data-reveal="up">
                  {c.plats.map((p) => (
                    <li class="plat">
                      <h3 class="plat__nom">{p.nom}</h3>
                      <span class="plat__prix prix">{eur(p.prix)}</span>
                      {p.description && <p class="plat__desc">{p.description}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="strate strate--papier strate--crete" aria-labelledby="titre-fin-carte">
    <div class="wrap">
      <h2 data-split="lines" class="display display--xl" id="titre-fin-carte">Une <span class="nw">table&nbsp;?</span></h2>
      <div class="cta-rang" style="margin-top: var(--normal)">
        <a class="cta" href={site.telephoneHref}><span class="cta__txt">Appeler le <span class="nw">{site.telephoneLisible}</span></span></a>
        <a class="cta cta--contour" href={u('/reservation/')}><span class="cta__txt">Comment réserver</span></a>
      </div>
    </div>
  </section>
</Base>
