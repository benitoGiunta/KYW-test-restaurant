---
import Base from '../layouts/Base.astro';
import Horaires from '../components/Horaires.astro';
import { site, eur, livraison } from '../data/site';
---
<Base title="Réserver" description="Réserver une table chez Sanga, rue Saint-Loup 8 à Namur : par téléphone au 081 24 10 38, du mardi au dimanche, midi et soir. Commande en ligne et livraison." page="reservation">
  <section class="strate titre-page strate--sans-sceau" aria-labelledby="titre-resa">
    <div class="wrap">
      <p class="kanji titre-page__kanji" aria-hidden="true" lang="ja" data-split="chars" data-intro>山河</p>
      <h1 class="display display--mega" id="titre-resa">Réserver</h1>
      <p class="titre-page__chapo">Sanga n’a pas d’outil de réservation en ligne : la table se demande par téléphone.</p>
      <div class="cta-rang" style="margin-top: var(--normal)">
        <a class="cta" href={site.telephoneHref}><span class="cta__txt">Appeler le <span class="nw">{site.telephoneLisible}</span></span></a>
        <a class="cta cta--contour" href={site.commandeUrl} rel="noopener"><span class="cta__txt">Commander en ligne</span></a>
      </div>
    </div>
  </section>

  <section class="strate strate--papier strate--crete" aria-labelledby="titre-quand">
    <div class="wrap">
      <h2 data-split="lines" class="display display--xl" id="titre-quand" style="margin-bottom: var(--normal)">Quand</h2>
      <div class="grille donnees__grille">
        <div class="donnees__a"><Horaires /></div>
        <div class="donnees__b">
          <div class="bloc texte">
            <h3>À savoir</h3>
            <p>Deux services, midi et soir, du mardi au dimanche. Le lundi, la maison est fermée.</p>
            <p>Pour une table, appelez avant de venir.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="strate strate--crete" aria-labelledby="titre-ou">
    <div class="wrap">
      <h2 data-split="lines" class="display display--xl" id="titre-ou" style="margin-bottom: var(--normal)">Où</h2>
      <div class="grille donnees__grille">
        <div class="donnees__a bloc">
          <h3>Adresse</h3>
          <address class="display display--l">{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
          <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan dans un nouvel onglet</a></p>
          <p class="doux petit" style="margin-top: 1em">Parking, accès et terrasse : informations non communiquées par la maison.</p>
        </div>
        <div class="donnees__b">
          <div class="bloc">
            <h3>Livraison</h3>
            <ul>
              <li>5000 à 5004 : dès {eur(livraison.zones[0].minimum)}</li>
              <li>5100 et 5020 : dès {eur(livraison.zones[1].minimum)}</li>
            </ul>
            <p class="doux petit">Livraison gratuite dans ces zones.</p>
          </div>
          <div class="bloc">
            <h3>Paiement</h3>
            <p>{livraison.paiement.join(', ')}.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
