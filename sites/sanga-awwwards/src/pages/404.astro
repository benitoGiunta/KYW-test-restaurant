---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { site } from '../data/site';
---
<Base title="Page introuvable" description="Cette page n’existe pas sur le site de Sanga : revenez à l’accueil ou à la carte." page="404">
  <section class="strate perdu strate--sans-sceau" aria-labelledby="titre-404">
    <div class="wrap">
      <div class="perdu__pic" aria-hidden="true" data-intro></div>
      <h1 class="display display--mega" id="titre-404">Rien sur cette rive.</h1>
      <p class="titre-page__chapo">Cette page n’est pas sur la carte. Remontez le courant : l’accueil, ou directement les bols.</p>
      <div class="cta-rang" style="margin-top: var(--normal)">
        <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
        <a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">La carte</span></a>
        <a class="cta cta--contour" href={site.telephoneHref}><span class="cta__txt">Appeler</span></a>
      </div>
    </div>
  </section>
</Base>
