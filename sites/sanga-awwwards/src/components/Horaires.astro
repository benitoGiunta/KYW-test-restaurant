---
import { jours, services } from '../data/site';
---
<ul class="horaires" aria-label="Horaires d’ouverture">
  {jours.map((j) => (
    <li>
      <span class="horaires__jour">{j.nom}</span>
      {j.ferme
        ? <span class="horaires__ferme">Fermé</span>
        : services.map((s) => <span><span class="sr-only">{s.nom} : </span>{s.libelle}</span>)}
    </li>
  ))}
</ul>
