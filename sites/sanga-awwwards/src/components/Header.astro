---
import { u } from '../lib/url';
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const courant = (p: string) => (path === u(p).replace(/\/+$/, '') + '/' ? 'page' : undefined);
const liens = [
  { href: '/carte/', label: 'La carte' },
  { href: '/a-propos/', label: 'La maison', sec: true },
];
const menu = [
  { href: '/', label: 'Accueil' },
  { href: '/carte/', label: 'La carte' },
  { href: '/a-propos/', label: 'La maison' },
  { href: '/reservation/', label: 'Réserver' },
];
---
<header class="tete">
  <a class="tete__marque" href={base} aria-label="Sanga, accueil" aria-current={path === base ? 'page' : undefined}>
    <span class="tete__sceau" aria-hidden="true" lang="ja">{site.kanji}</span><span class="tete__nom">{site.nom}</span>
  </a>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => <li class={l.sec ? 'tete__sec' : 'tete__prem'}><a class="nl" href={u(l.href)} aria-current={courant(l.href)}>{l.label}</a></li>)}
      <li><a class="cta cta--petit" href={u('/reservation/')} aria-current={courant('/reservation/')}><span class="cta__txt">Réserver</span></a></li>
    </ul>
  </nav>
  <button class="tete__menu" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
  <div class="menu" id="menu" hidden>
    <nav class="menu__nav" aria-label="Menu du téléphone">
      <ul class="menu__liens">
        {menu.map((l) => <li><a class="menu__lien" href={u(l.href)} aria-current={l.href === '/' ? (path === base ? 'page' : undefined) : courant(l.href)}><span class="menu__masque"><span class="menu__ligne">{l.label}</span></span></a></li>)}
      </ul>
      <p class="menu__tel"><a class="cta" href={site.telephoneHref}><span class="cta__txt">Appeler le <span class="nw">{site.telephoneLisible}</span></span></a></p>
    </nav>
    <p class="menu__kanji" aria-hidden="true" lang="ja">{site.kanji}</p>
    <button class="menu__fermer" type="button">Fermer</button>
  </div>
</header>
