---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas. Le service est terminé : retournez à l’accueil du Brunchist ou à la carte, à Namur.">
  <section class="band band--fin perdu" aria-labelledby="titre-404" data-heure-fixe="931">
    <div class="wrap">
      <p class="perdu__heure" aria-hidden="true" data-split="chars" data-intro>15&nbsp;h&nbsp;31</p>
      <h1 class="display display--xl" id="titre-404" style="margin-top: 1.5rem" data-split="lines" data-intro data-delay="0.2">Le service est terminé.</h1>
      <p class="lede" style="margin-top: 1rem">Cette page n’existe pas, ou elle est partie avec la dernière tasse.</p>
      <p class="perdu__actions"><a class="cta cta--clair" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a><a class="cta cta--clair" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a></p>
    </div>
  </section>
</Base>
