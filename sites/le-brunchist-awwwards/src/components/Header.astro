---
import { u } from '../lib/url';
import { restaurant } from '../data/site';
interface Props { page?: string }
const { page = '' } = Astro.props;
const liens = [
  { href: '/carte/', nom: 'Carte', id: 'carte' },
  { href: '/histoire/', nom: 'Histoire', id: 'histoire' },
  { href: '/reservation/', nom: 'Venir', id: 'reservation' },
];
---
<header class="entete">
  <div class="wrap entete__in">
    <a class="entete__marque" href={u('/')} aria-label="Le Brunchist, accueil">Le Brunchist</a>
    <nav class="entete__nav" aria-label="Navigation principale">
      <ul>
        {liens.map((l) => <li><a class="nav-lien" href={u(l.href)} aria-current={page === l.id ? 'page' : undefined}>{l.nom}</a></li>)}
      </ul>
    </nav>
    <a class="cta cta--petit" href={restaurant.telephoneHref}><span class="cta__txt">Appeler</span></a>
  </div>
</header>
