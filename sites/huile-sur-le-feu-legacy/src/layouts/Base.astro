---
import '../styles/page.css';
import KywFooter from '@kyw/footer';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import { resto, base, u } from '../data/site';
interface Props { title: string; description: string; pied?: boolean }
const { title, description, pied = true } = Astro.props;
const ogImage = new URL(u('og-flambage.jpg'), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: resto.siteActuel,
  telephone: '+3281241903', email: resto.email, servesCuisine: ['Méditerranéenne', 'Italienne'],
  address: { '@type': 'PostalAddress', streetAddress: `${resto.adresse.rue} ${resto.adresse.numero}`, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
  acceptsReservations: resto.reservation,
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '12:00', closes: '14:30' }, { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '18:00', closes: '21:15' }],
  sameAs: [resto.facebook, resto.instagram],
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Flambage d’une poêle en cuisine ouverte" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
    <script>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Marcellus&display=swap" />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu"><slot /></main>
    {pied && <Pied />}
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <script is:inline>
    (() => {
      // Un seul reveal : opacité et translation, sans script le contenu reste visible.
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const cibles = document.querySelectorAll('.tile, .room figure, .salle__grid > *, .shop__grid > *, .split__ph, .index__list li');
      if (!cibles.length) return;
      const h = innerHeight;
      cibles.forEach((el, i) => { el.setAttribute('data-reveal', ''); el.style.setProperty('--i', String(i % 3)); });
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      cibles.forEach((el) => { el.getBoundingClientRect().top < h ? el.classList.add('is-in') : io.observe(el); });
    })();
    </script>
    <KywFooter base={base} />
  </body>
</html>
