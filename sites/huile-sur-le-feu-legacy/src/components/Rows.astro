---
import { prix, type Plat } from '../data/site';
interface Props { plats: Plat[] }
const { plats } = Astro.props;
---
<ul class="rows">
  {plats.map((p) => (
    <li class="rows__li" data-placeholder={p.placeholder ? 'true' : undefined}>
      <span class="rows__name">{p.nom}</span>
      <span class="rows__price num">{prix(p.prix)}</span>
      {p.description && <span class="rows__desc">{p.description}</span>}
    </li>
  ))}
</ul>
