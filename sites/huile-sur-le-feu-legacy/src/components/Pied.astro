---
import { u, resto, credit } from '../data/site';
---
<section class="pied deep" aria-label="Pied de la maison">
  <div class="container">
    <p class="pied__line">Une huile choisie pour chaque plat.</p>
    <div class="pied__cols">
      <nav aria-label="Plan du site"><ul>
        <li><a href={u('')}>Accueil</a></li><li><a href={u('restaurant/')}>Le restaurant</a></li>
        <li><a href={u('menu/')}>La carte</a></li><li><a href={u('boutique/')}>La boutique</a></li><li><a href={u('contact/')}>Contact</a></li>
      </ul></nav>
      <ul>
        <li><a href={resto.facebook} rel="noopener">Facebook</a></li>
        <li><a href={resto.instagram} rel="noopener">Instagram</a></li>
        <li><a href={resto.telHref}>{resto.tel}</a></li>
        <li><a href={`mailto:${resto.email}`}>{resto.email}</a></li>
      </ul>
      <p class="pied__small">{resto.societe}<br />{resto.tva}<br />{credit}</p>
    </div>
  </div>
</section>
