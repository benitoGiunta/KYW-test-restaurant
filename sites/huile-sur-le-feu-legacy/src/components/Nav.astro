---
import { u, resto } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '');
const liens = [
  { t: 'Accueil', h: u(''), p: u('').replace(/\/$/, '') },
  { t: 'Le restaurant', h: u('restaurant/'), p: u('restaurant') },
  { t: 'La carte', h: u('menu/'), p: u('menu') },
  { t: 'La boutique', h: u('boutique/'), p: u('boutique') },
  { t: 'Contact', h: u('contact/'), p: u('contact') },
];
---
<header class="site-head deep">
  <div class="container site-head__in">
    <a class="brand" href={u('')} aria-label="L’Huile sur le Feu, accueil">
      <img src={u('photos/logo.svg')} width="156" height="46" alt="L’Huile sur le Feu" />
    </a>
    <button class="menu-btn" type="button" popovertarget="menu-principal" aria-controls="menu-principal" aria-expanded="false">Menu</button>
    <nav class="site-nav" id="menu-principal" popover aria-label="Navigation principale">
      <ul>
        {liens.map((l) => <li><a href={l.h} aria-current={path === l.p ? 'page' : undefined}>{l.t}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--flame" href={resto.reservation} rel="noopener">Réserver</a>
  </div>
</header>
<script is:inline>
(() => {
  const nav = document.getElementById('menu-principal'), btn = document.querySelector('.menu-btn');
  if (!nav || !btn) return;
  nav.addEventListener('toggle', (e) => btn.setAttribute('aria-expanded', e.newState === 'open' ? 'true' : 'false'));
  nav.addEventListener('click', (e) => { if (e.target.closest('a') && nav.matches(':popover-open')) nav.hidePopover(); });
})();
</script>
