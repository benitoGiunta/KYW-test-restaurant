---
import Base from '../layouts/Base.astro';
import { u, resto } from '../data/site';
---
<Base title="Page introuvable · L’Huile sur le Feu" description="Cette page n’existe pas.">
  <section class="sect nf">
    <div class="container">
      <h1>Cette page est introuvable</h1>
      <p class="lead">Le lien est peut-être ancien. La carte et la réservation, elles, sont à leur place.</p>
      <p class="actions"><a class="btn" href={u('')}>Retour à l’accueil</a><a class="link" href={u('menu/')}>La carte</a><a class="link" href={resto.reservation} rel="noopener">Réserver</a></p>
    </div>
  </section>
</Base>
