---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PageHead from '../components/PageHead.astro';
import Horaires from '../components/Horaires.astro';
import { u } from '../data/site';
---
<Base title="La boutique, bientôt en ligne · L’Huile sur le Feu, Namur" description="Notre boutique arrive bientôt : les huiles d’olive et les produits Oliviers & Co que nous utilisons en cuisine.">
  <PageHead titre="La boutique" texte="Bientôt en ligne. Vous pourrez y commander les huiles d’olive et les produits Oliviers & Co que nous utilisons en cuisine." photo="16" pos="50% 45%" />

  <section class="sect shop" aria-labelledby="h-shop">
    <div class="container">
      <h2 id="h-shop">Nos huiles, sur les étagères</h2>
      <div class="shop__grid">
        <Photo k="13" pos="50% 50%" class="shop__a" sizes="(min-width: 60rem) 40vw, 100vw" />
        <Photo k="14" pos="50% 50%" class="shop__b" sizes="(min-width: 60rem) 58vw, 100vw" />
        <Photo k="15" pos="50% 60%" class="shop__c" sizes="(min-width: 60rem) 58vw, 100vw" />
      </div>
      <p class="shop__note">En partenariat avec Oliviers &amp; Co.</p>
      <p class="actions"><a class="link" href={u('')}>Retour à l’accueil</a><a class="link" href={u('menu/')}>Voir la carte</a></p>
    </div>
  </section>

  <Horaires />
</Base>
