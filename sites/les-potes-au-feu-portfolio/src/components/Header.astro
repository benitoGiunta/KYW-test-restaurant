---
// En-tête fixe, coupé par la frontière : la copie « face » (papier) est la vraie navigation (clavier, lecteurs d'écran) ;
// l'écho (ink) est aria-hidden et hors tabulation, mais ses liens sont de vrais liens : c'est lui qui reçoit les clics
// sur la moitié moutarde, là où la face est coupée par son clip-path (REVISION-1 F0-02). Sur mobile, une seule copie
// sur fond vert et un bouton de menu.
import { site } from '../data/site';
import { u } from '../lib/url';
const liens = [
  { href: u('/carte/'), label: 'La carte' },
  { href: u('/les-deux-chefs/'), label: 'Les deux chefs' },
  { href: u('/histoire/'), label: 'Notre histoire' },
];
const ici = Astro.url.pathname.replace(/\/+$/, '');
const courant = (href: string) => (href.replace(/\/+$/, '') === ici ? 'page' : undefined);
---
<header class="header" data-header>
  <div class="header__face">
    <a class="header__brand lien" href={u('/')} aria-current={courant(u('/'))}>{site.nom}</a>
    <button class="header__burger" type="button" aria-expanded="false" aria-controls="nav" data-burger>Menu</button>
    <nav class="nav" id="nav" aria-label="Navigation principale">
      {liens.map((l) => <a class="lien" href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
      <a class="btn" href={u('/reservation/')} aria-current={courant(u('/reservation/'))}><span class="roll"><span>Réserver</span><span aria-hidden="true">Réserver</span></span></a>
    </nav>
  </div>
  <div class="header__echo" aria-hidden="true">
    <a class="header__brand lien" href={u('/')} tabindex="-1" aria-current={courant(u('/'))}>{site.nom}</a>
    <span class="header__burger">Menu</span>
    <span class="nav">
      {liens.map((l) => <a class="lien" href={l.href} tabindex="-1" aria-current={courant(l.href)}>{l.label}</a>)}
      <a class="btn" href={u('/reservation/')} tabindex="-1" aria-current={courant(u('/reservation/'))}><span class="roll"><span>Réserver</span><span aria-hidden="true">Réserver</span></span></a>
    </span>
  </div>
</header>

<script>
  import { onPage } from '../engine';
  onPage(() => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
    if (!header || !burger) return;
    const toggle = () => {
      const open = header.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.textContent = open ? 'Fermer' : 'Menu';
    };
    burger.addEventListener('click', toggle);
    // REVISION-1 F2-01 : classe is-defile dès 24 px de défilement (fond d'en-tête, voir base.css).
    const defile = () => document.documentElement.classList.toggle('is-defile', window.scrollY > 24);
    defile();
    window.addEventListener('scroll', defile, { passive: true });
    return () => { burger.removeEventListener('click', toggle); window.removeEventListener('scroll', defile); };
  });
</script>
