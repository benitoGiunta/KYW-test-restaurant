---
// Loader « Quatre mains » : papier, une ligne horizontale qui se trace, puis les deux couleurs se répandent depuis
// le centre vers les bords (setLoaderExit dans motion/setup.ts). Crochets du moteur conservés.
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Chargement">
  <div class="loader__g" data-loader-g></div>
  <div class="loader__d" data-loader-d></div>
  <div class="loader__inner">
    <span class="loader__name" data-loader-out>{site.nom}</span>
    <span class="loader__count" data-loader-out data-loader-count>000</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
