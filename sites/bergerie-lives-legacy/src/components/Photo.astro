---
// Photo du client : figure à gabarit fixe (data-slot), img avec width/height, srcset 800/1600, légende = un fait.
interface Props { p: { id: string; w: number; h: number; w2: number; alt: string }; sizes?: string; eager?: boolean; pos?: string; ratio?: string; caption?: string; class?: string }
const { p, sizes = '(min-width: 60rem) 50vw, 100vw', eager = false, pos = '50% 50%', ratio, caption, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = `${base}photos/${p.id}.webp`;
const small = `${base}photos/${p.id}-800.webp`;
const srcset = p.w2 ? `${small} ${p.w2}w, ${src} ${p.w}w` : undefined;
---
<figure class:list={['ph', cls]} data-slot={p.id} data-alt={p.alt} data-credits="La Bergerie de Lives" style={`aspect-ratio:${ratio ?? `${p.w} / ${p.h}`};--pos:${pos}`}>
  <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} width={p.w} height={p.h} alt={p.alt} loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'auto' : 'async'} fetchpriority={eager ? 'high' : undefined} />
  {caption && <figcaption data-keep>{caption}</figcaption>}
</figure>
