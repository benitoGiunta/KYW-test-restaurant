---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable · La Bergerie de Lives" description="Cette page n’existe pas." page="404">
  <section class="sec pagehead">
    <div class="container">
      <h1>Cette page n’existe pas</h1>
      <p class="lead">Retournez à l’accueil ou réservez directement.</p>
      <div class="actions">
        <a class="btn btn--primary" href={base}>Accueil</a>
        <a class="btn btn--ghost" href={`${base}reservations/`}>Réserver</a>
      </div>
    </div>
  </section>
</Base>
