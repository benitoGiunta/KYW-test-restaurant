---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { resto, photos, mariage, seminaire } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Mariage et location · La Bergerie de Lives, Namur" description="Le domaine privatisé pour votre mariage le temps d’un weekend, et des salles pour vos séminaires et événements privés, près de Namur." page="mariage">
  <section class="hero" aria-labelledby="h-hero">
    <Photo p={photos.ceremonie} eager sizes="100vw" pos="50% 45%" class="hero__ph" ratio="auto" />
    <div class="hero__panel">
      <h1 id="h-hero">{mariage.titre}</h1>
      <p class="lead">{mariage.lead}</p>
      <div class="actions">
        <a class="btn btn--primary" href={`${base}reservations/#visite`}>Réserver une visite</a>
        <a class="btn btn--ghost" href={resto.mariageWix} rel="noopener">Brochure mariage</a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-weekend">
    <div class="container grid12 split">
      <div class="split__txt split__txt--first">
        <h2 id="h-weekend">Un weekend complet</h2>
        {mariage.paragraphes.map((t) => <p class="body">{t}</p>)}
      </div>
      <Photo p={photos.tableDressee} sizes="(min-width: 60rem) 50vw, 100vw" class="split__ph split__ph--last" />
    </div>
  </section>

  <section class="sec sec--tight" aria-labelledby="h-docs">
    <div class="container">
      <h2 id="h-docs">Pour préparer votre jour</h2>
      <ul class="index index--table">
        {mariage.documents.map((d) => (
          <li class="index__row">
            <h3 class="index__name">{d.nom}</h3>
            <p class="index__text">{d.texte}</p>
            <p class="index__links"><a class="link" href={d.interne ? `${base}${d.href}` : d.href} rel={d.interne ? undefined : 'noopener'}>{d.label}</a></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bleed" aria-label="Photographie">
    <Photo p={photos.sortie} sizes="100vw" ratio="21 / 9" pos="50% 40%" caption="Sortie de cérémonie, dans le jardin du domaine." />
  </section>

  <section class="sec band" aria-labelledby="h-semi">
    <div class="container grid12">
      <h2 id="h-semi" class="statement">{seminaire.titre}</h2>
      <div class="aside-text">
        {seminaire.paragraphes.map((t) => <p>{t}</p>)}
        <div class="actions"><a class="btn btn--primary" href={`${base}reservations/`}>Nous contacter</a></div>
      </div>
    </div>
  </section>

  <section class="sec" id="contact" aria-labelledby="h-contact">
    <div class="container grid12">
      <h2 id="h-contact">Visiter le domaine</h2>
      <dl class="facts">
        <div><dt>Adresse</dt><dd>{resto.adresse.rue}<br />{resto.adresse.cp} {resto.adresse.commune}</dd></div>
        <div><dt>Téléphone</dt><dd><a href={resto.telHref}>{resto.tel}</a></dd></div>
        <div><dt>Courriel</dt><dd><a href={`mailto:${resto.email}`}>{resto.email}</a></dd></div>
        <div><dt>Visite</dt><dd>30 minutes, à programmer avec le bouton « Réserver une visite »</dd></div>
      </dl>
      <div class="actions actions--end"><a class="btn btn--primary" href={`${base}reservations/#visite`}>Réserver une visite</a></div>
    </div>
  </section>
</Base>
