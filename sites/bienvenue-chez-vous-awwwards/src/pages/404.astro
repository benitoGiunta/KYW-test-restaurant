---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n’existe pas : vous avez sonné au mauvais étage. Retournez à l’accueil de Bienvenue chez vous, à Namur, ou lisez la carte." chemin="/404">
  <div class="wrap perdu">
    <div class="route">
      <section class="stop stop--plein entete" aria-labelledby="titre">
        <h1 id="titre" class="display">Mauvais <em>palier</em></h1>
        <p class="entete__intro">Cette page n’existe pas. La salle est un étage plus haut, par l’accueil.</p>
        <div class="arrivee__actions" style="margin-top: calc(var(--u) * 4)">
          <a class="btn" href={u('/')}>Retour à l’accueil</a>
          <a class="btn btn--ligne" href={u('/carte/')}>Lire la carte</a>
        </div>
      </section>
    </div>
  </div>
</Base>
