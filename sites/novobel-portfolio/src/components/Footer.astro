---
// Pied de page minimal : nom, adresse, liens ; puis le pied de page KYW obligatoire (une seule mention « Maquette KYW »).
import KywFooter from '@kyw/footer';
import { site, adresseLigne, telHref, mailHref } from '../data/site';
import { u } from '../lib/url';
---
<div class="footer">
  <div class="wrap footer__in">
    <section class="stack" aria-label="Coordonnées">
      <p class="footer__nom">{site.nom} <span class="muted">{site.metier}</span></p>
      <address>{adresseLigne()}</address>
      <p><a class="link" href={telHref()}>{site.telephone}</a></p>
      <p><a class="link" href={mailHref()}>{site.email}</a></p>
    </section>
    <nav aria-label="Pied de page">
      <a class="link" href={u('/services/')}>Services</a>
      <a class="link" href={u('/projets/')}>Projets</a>
      <a class="link" href={u('/maison/')}>La maison</a>
      <a class="link" href={u('/carriere/')}>Carrière</a>
      <a class="link" href={u('/contact/')}>Devis gratuit</a>
      {site.reseaux.map((r) => <a class="link" href={r.url} rel="noopener">{r.nom}</a>)}
    </nav>
  </div>
</div>
<KywFooter base={import.meta.env.BASE_URL} />
