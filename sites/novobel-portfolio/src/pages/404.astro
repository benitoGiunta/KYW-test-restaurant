---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page n'existe pas ou plus sur le site de Novobel. Retrouvez les services, les projets et la demande de devis depuis l'accueil.">
  <section class="entete wrap" style="min-height: 60svh; align-content: center">
    <h1 class="cap">Démoli</h1>
    <p class="lead muted">Cette page n'est plus au plan. L'adresse a peut-être changé, ou contient une coquille. Les services, les projets et le devis gratuit sont toujours là.</p>
    <div class="actions" style="flex-basis: 100%">
      <a class="btn btn--plein" href={u('/')}>Retour à l'accueil</a>
      <a class="btn" href={u('/projets/')}>Les projets</a>
      <a class="btn" href={u('/contact/')}>Devis gratuit</a>
    </div>
  </section>
</Base>
