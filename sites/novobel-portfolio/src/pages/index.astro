---
// Accueil = le tableau de chantier. Nom et accroche peints au premier rendu (aucun data-intro) : le texte est l'élément LCP.
import Base from '../layouts/Base.astro';
import Projets from '../components/Projets.astro';
import Img from '../components/Img.astro';
import { site, totalLogements } from '../data/site';
import { u } from '../lib/url';
---
<Base>
  <section class="ardoise col-carte" aria-label="Présentation">
    <div>
      <h1 class="ardoise__nom cap"><span>{site.nomLignes[0]}</span><span>{site.nomLignes[1]}</span></h1>
      <p class="petite-cap" style="margin-top: var(--u)">{site.metier} · {site.adresse.commune}</p>
      <p class="ardoise__accroche lead">{site.baseline}. {site.introduction[0]}</p>
      <div class="actions" style="margin-top: calc(var(--u) * 2)">
        <a class="btn btn--plein" href={u('/contact/')}>Demander un devis gratuit</a>
        <a class="btn" href={u('/projets/')}>Voir les projets</a>
      </div>
      <ul class="stats">
        <li><strong class="num">{site.projets.length}</strong><span>projets présentés</span></li>
        <li><strong class="num">{totalLogements()}</strong><span>logements aménagés dans ces projets</span></li>
        <li><strong class="num">{site.etapes.length}</strong><span>étapes suivies sur chaque chantier</span></li>
      </ul>
    </div>
    <figure class="ardoise__photo"><Img p={site.photos.silhouettes} sizes="(min-width: 1024px) 40vw, 100vw" eager /></figure>
  </section>

  <section class="section" aria-labelledby="etapes-titre">
    <div class="col-carte"><div>
      <p class="petite-cap">Services</p>
      <h2 class="cap cat__titre" id="etapes-titre">Quatre étapes, un seul interlocuteur</h2>
      <ol class="etapes">
        {site.etapes.map((e) => (
          <li class="etape">
            <span class="etape__n num">{e.n}</span>
            <div class="etape__tete"><h3 class="etape__titre cap">{e.titre}</h3><p class="etape__acc">{e.accroche}</p></div>
            <p class="etape__texte">{e.texte}</p>
          </li>
        ))}
      </ol>
      <a class="ardoise__lien" href={u('/services/')}>Tous les services <span aria-hidden="true">→</span></a>
    </div></div>
  </section>


  <section class="section" aria-labelledby="projets-titre">
    <div class="col-carte"><div>
      <p class="petite-cap">Projets</p>
      <h2 class="cap cat__titre" id="projets-titre">Bureaux et maisons devenus appartements</h2>
      <Projets />
      <a class="ardoise__lien" href={u('/projets/')}>Tous les projets <span aria-hidden="true">→</span></a>
    </div></div>
  </section>

  <section class="clair section" aria-labelledby="maison-titre">
    <div class="wrap deux">
      <figure><Img p={site.photos.mansarde} sizes="(min-width: 1024px) 40vw, 100vw" /></figure>
      <div class="stack">
        <p class="petite-cap">La maison</p>
        <h2 class="cap cat__titre" id="maison-titre">Une approche familiale</h2>
        <p>{site.introduction[1]}</p>
        <ul class="liste-simple">{site.valeurs.map((v) => <li>{v}</li>)}</ul>
        <a class="ardoise__lien" href={u('/maison/')}>La maison Novobel <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cta-titre">
    <div class="wrap cta">
      <h2 class="cap" id="cta-titre">Votre projet, à votre mesure</h2>
      <div class="stack">
        <p class="lead muted">Aucun projet n'est trop grand pour Novobel. Devis gratuit, demande traitée {site.devis.delai}.</p>
        <a class="btn btn--plein" href={u('/contact/')}>Demander un devis gratuit</a>
      </div>
    </div>
  </section>
</Base>
