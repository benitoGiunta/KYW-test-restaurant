---
import { resto, u } from '../data/site';
---
<footer class="pied">
  <div class="container pied__grille">
    <div class="pied__nom">
      <span class="pied__logo" aria-hidden="true" style={`--logo:url(${u('photos/logo.webp')})`}></span>
      <p class="pied__titre">{resto.nom}</p>
      <p>{resto.baseline}.</p>
    </div>
    <address class="pied__col">
      <span>{resto.adresse.rue}</span>
      <span>{resto.adresse.cp} {resto.adresse.ville}</span>
      <a href={resto.telHref}>{resto.tel}</a>
      <a href={`mailto:${resto.mail}`}>{resto.mail}</a>
    </address>
    <div class="pied__col">
      <span>Du jeudi au dimanche</span>
      <a href="#horaires">Voir les horaires</a>
      <a href={resto.facebook} rel="noopener">Facebook</a>
      <a href={resto.instagram} rel="noopener">Instagram</a>
    </div>
  </div>
  <div class="container"><p class="pied__credits" data-credits>Photographies : Escale en Vue. Site d’origine : <a href={resto.siteActuel} rel="noopener">escale-en-vue.be</a>.</p></div>
</footer>
