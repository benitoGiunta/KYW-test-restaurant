---
import Photo from './Photo.astro';
import { resto, saison, photos } from '../data/site';
---
<section class="hero" id="haut" aria-labelledby="hero-titre">
  <div class="container hero__grille">
    <div class="hero__texte">
      <h1 id="hero-titre">Une terrasse au-dessus de la vallée.</h1>
      <p class="lead">Cuisine fraîcheur, créative et locale, du jeudi soir au dimanche après-midi.</p>
      <div class="actions">
        <a class="btn btn--primaire" href={resto.telHref}><span>Réserver au {resto.tel}</span></a>
        <a class="btn btn--contour" href="#horaires"><span>Voir les horaires</span></a>
      </div>
      <p class="hero__saison">{saison.texte}.</p>
    </div>
    <Photo p={photos.planchette} slot="hero" hero sizes="(min-width: 60rem) 45vw, 100vw" pos="50% 60%" class="hero__photo" />
  </div>
</section>
