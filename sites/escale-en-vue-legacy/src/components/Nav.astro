---
import { resto, base } from '../data/site';
const liens = [
  { href: `${base}#horaires`, label: 'Horaires' },
  { href: `${base}#carte`, label: 'À table' },
  { href: `${base}#venir`, label: 'Venir' },
];
---
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="nav">
  <a class="nav__marque" href={base} aria-label={`${resto.nom} : accueil`}>{resto.nom}</a>
  <nav class="nav__liens" aria-label="Sections">
    {liens.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a class="btn btn--primaire nav__cta" href={resto.telHref}><span>Réserver</span></a>
  <button class="nav__menu" type="button" popovertarget="menu" aria-controls="menu" aria-expanded="false" aria-label="Menu">
    <svg class="nav__burger" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><g class="ico-ouvrir" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 8h16M4 16h16" /></g><g class="ico-fermer" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></g></svg>
  </button>
  <nav class="menu" id="menu" popover aria-label="Menu des sections">
    <ul>
      {liens.map((l, i) => <li style={`--i:${i}`}><a href={l.href}>{l.label}</a></li>)}
      <li style="--i:3"><a href={resto.telHref}>Appeler le {resto.tel}</a></li>
    </ul>
  </nav>
</header>
