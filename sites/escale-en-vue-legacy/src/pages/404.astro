---
import Base from '../layouts/Base.astro';
import { base } from '../data/site';
---
<Base title="Page introuvable, Escale en Vue !" description="Cette page n’existe pas. Retour à la terrasse.">
  <section class="horaires"><div class="container horaires__tete">
    <h1>Cette page a pris le large.</h1>
    <p class="lead">Revenez à l’accueil pour les horaires, la carte et l’adresse.</p>
    <div class="actions"><a class="btn btn--primaire" href={base}><span>Retour à l’accueil</span></a></div>
  </div></section>
</Base>
