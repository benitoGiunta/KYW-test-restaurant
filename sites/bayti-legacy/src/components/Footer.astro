---
// Pied en mast : le nom en grand, puis adresses, horaires, contact, réseaux, crédits (layout.md § 7).
import { resto, nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="mast" aria-label="Adresses et contact">
  <div class="container">
    <p class="mast__nom" aria-hidden="true">Bayti</p>
    <div class="mast__grille">
      <div>
        <p class="mast__t">Restaurant Bayti</p>
        <p>{resto.restaurant.rue}, {resto.restaurant.cp} {resto.restaurant.ville}<br />Du mardi au samedi, <span class="num">{resto.restaurant.heures}</span></p>
      </div>
      <div>
        <p class="mast__t">Bayti Le Comptoir</p>
        <p>{resto.comptoir.rue}, {resto.comptoir.cp} {resto.comptoir.ville}<br />Du mardi au samedi, <span class="num">{resto.comptoir.heures}</span></p>
      </div>
      <div>
        <p class="mast__t">Nous joindre</p>
        <p><a class="num" href={resto.telHref}>{resto.tel}</a><br /><a href={`mailto:${resto.email}`}>{resto.email}</a></p>
        <p><a href={resto.facebook} rel="noopener">Facebook</a>, <a href={resto.instagram} rel="noopener">Instagram</a></p>
      </div>
      <div>
        <p class="mast__t">Le site</p>
        <ul class="mast__liens">
          {nav.map((l) => <li><a href={`${base}${l.href}`}>{l.label}</a></li>)}
          <li><a href={resto.reserver} rel="noopener">Réserver</a></li>
        </ul>
      </div>
    </div>
    <p class="mast__credits" data-credits>Photographies : Bayti, reprises de son site.</p>
  </div>
</section>
