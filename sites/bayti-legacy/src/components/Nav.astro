---
import { resto, nav } from '../data/site';
interface Props { page: string }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="nav">
  <div class="container nav__inner">
    <a class="nav__logo" href={base} aria-label="Bayti, accueil">Bayti</a>
    <details class="nav__menu">
      <summary>Menu</summary>
      <nav aria-label="Principal">
        <ul>
          <li><a href={base} aria-current={page === 'accueil' ? 'page' : undefined}>Accueil</a></li>
          {nav.map((l) => <li><a href={`${base}${l.href}`} aria-current={page === l.id ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>
    </details>
    <a class="btn btn--primary nav__cta" href={resto.reserver} rel="noopener">Réserver</a>
  </div>
</header>
