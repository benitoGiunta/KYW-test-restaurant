---
// Nav en dalle (slab) : logo, liens, Réserver. Sous 60rem les liens passent dans un panneau Popover (light-dismiss et Échap natifs).
import { resto, nav } from '../data/site';
interface Props { page: string }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="nav">
  <div class="container nav__inner">
    <a class="nav__logo" href={base} aria-label="Bayti, accueil">Bayti</a>
    <button class="btn btn--tonal nav__toggle" type="button" popovertarget="menu-principal" data-menu-toggle>Menu</button>
    <nav class="nav__menu" id="menu-principal" popover aria-label="Principal">
      <ul>
        <li><a href={base} aria-current={page === 'accueil' ? 'page' : undefined}>Accueil</a></li>
        {nav.map((l) => <li><a href={`${base}${l.href}`} aria-current={page === l.id ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--outline nav__cta" href={resto.reserver} rel="noopener">Réserver</a>
  </div>
</header>
