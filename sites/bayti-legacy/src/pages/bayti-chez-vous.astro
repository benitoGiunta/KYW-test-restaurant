---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Contact from '../components/Contact.astro';
import { resto } from '../data/site';
const points = ['Menus sur mesure, créés avec vous', 'Mise en place et matériel fournis', 'Service de quelques heures avant l’événement', 'De l’intime au grand format'];
---
<Base page="chezvous" title="Bayti chez vous, traiteur d’événements à Namur" description="Bayti vient chez vous : des menus uniques créés sur mesure pour tous types d’événements, de petite à grande ampleur, avec mise en place et matériel.">
  <section class="banner">
    <div class="container banner__grille">
      <div>
        <h1>Bayti chez vous.</h1>
        <p class="lead">Pour tous types d’événements, de petite à grande ampleur, et pour tous les appétits.</p>
        <div class="actions"><a class="btn btn--primary" href="#devis">Demander un devis sur mesure</a></div>
      </div>
      <Photo nom="buffet-evenement" slot="chezvous-hero" sizes="(min-width: 60rem) 40vw, 100vw" priorite position="50% 40%" />
    </div>
  </section>
  <section class="recit">
    <div class="container recit__grille">
      <h2>Vous n’aurez plus qu’à déguster et célébrer.</h2>
      <div class="recit__corps">
        <p>Pour leurs événements, nous mettons un point d’honneur à réaliser des menus uniques pour nos clients. La composition est créée sur mesure et est réalisée à la demande.</p>
        <p>Le jour de votre événement, nous nous rendons chez vous quelques heures avant le début du service munis de notre mise en place et notre matériel.</p>
      </div>
    </div>
  </section>
  <section class="points">
    <div class="container">
      <ul class="index" role="list">
        {points.map((p) => <li><span class="index__t">{p}</span></li>)}
      </ul>
      <p class="points__cta">Contactez-nous pour un devis sur mesure : <a class="num" href={resto.telHref}>{resto.tel}</a>, <a href={`mailto:${resto.email}`}>{resto.email}</a>.</p>
    </div>
  </section>
  <Contact id="devis" titre="Contactez-nous" objet="Demande de devis, Bayti chez vous" />
</Base>
