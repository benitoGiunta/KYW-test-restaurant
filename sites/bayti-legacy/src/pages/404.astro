---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable | Bayti" description="Cette page de la maquette Bayti n’existe pas.">
  <section class="banner banner--texte">
    <div class="container">
      <h1>Cette page n’existe pas.</h1>
      <p class="lead">Retournez à l’accueil de Bayti ou consultez la carte.</p>
      <div class="actions"><a class="btn btn--primary" href={base}>Accueil</a><a class="link" href={`${base}carte-restaurant/`}>La carte du restaurant</a></div>
    </div>
  </section>
</Base>
