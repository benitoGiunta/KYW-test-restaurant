---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Cabine from '../components/Cabine.astro';
import { site, jours, cuisine, groupes } from '../data/site';
---
<Base page="reservation" title="Réserver" description="Réserver une table au Servais à Namur : module en ligne ; téléphone et e-mail du bar. Horaires de la semaine, accès au départ du téléphérique et formules pour groupes.">
  <div class="ligne">
    <Cabine />
    <section class="entete wrap" aria-labelledby="titre-resa">
      <h1 id="titre-resa" class="display entete__titre">Réserver</h1>
      <p class="entete__chapeau" data-split="lines" data-intro data-delay="0.2">Réservez en ligne ; le bar est joignable au {site.telephoneLisible} et à {site.email}.</p>
      <p class="hero__actions">
        <a class="cta" href={site.reservationUrl} rel="noopener"><span class="cta__txt">Réserver en ligne</span></a>
        <a class="cta cta--ligne" href={site.telephoneHref}><span class="cta__txt">Appeler le {site.telephoneLisible}</span></a>
      </p>
      <p class="entete__mail"><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
    </section>

    <section class="infos wrap" id="horaires" aria-labelledby="titre-horaires">
      <div class="infos__col">
        <h2 id="titre-horaires" class="display rayon__titre">Horaires du bar</h2>
        <ul class="horaires">
          {jours.map((j) => <li><span>{j.nom}</span><span>{j.ouvre} à {j.ferme}</span></li>)}
        </ul>
      </div>
      <div class="infos__col">
        <h2 class="display rayon__titre">Cuisine</h2>
        <ul class="horaires">
          {cuisine.map((c) => <li><span>{c.nom}, {c.quand.toLowerCase()}</span><span>{c.libelle}</span></li>)}
        </ul>
      </div>
      <div class="infos__col">
        <h2 class="display rayon__titre">Venir</h2>
        <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
        <p>Le Servais se trouve au départ du téléphérique de Namur. Une terrasse donne sur la façade en pierre, côté rue.</p>
        <p><a class="lien" href={site.carteUrl} rel="noopener">Ouvrir le plan</a></p>
      </div>
    </section>

    <section class="groupes groupes--page wrap" id="groupes" aria-labelledby="titre-groupes">
      <div class="groupes__photo" data-reveal="clip">
        <Photo cle="verriere" widths={[480, 800]} sizes="(max-width: 48rem) 100vw, 34vw" />
        <p class="legende">Photo illustrative, origine à confirmer.</p>
      </div>
      <div class="groupes__texte">
        <h2 id="titre-groupes" class="display titre-section" data-split="lines">Groupes et privatisation</h2>
        <p>La Verrière accueille {groupes.verriere.assis} convives assis, jusqu’à {groupes.verriere.debout} debout, avec bar self-service, musique et projecteur. Le bar entier se privatise à partir de {groupes.verriere.total} personnes. Contact pour les groupes : <a class="lien" href={`mailto:${site.email}`}>{site.email}</a>.</p>
        <ul class="formules">
          {groupes.formules.map((f) => (
            <li class="formule"><span class="formule__nom">{f.nom}</span><span class="formule__prix">dès {f.prix} par personne</span><span class="formule__detail">{f.detail}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>
