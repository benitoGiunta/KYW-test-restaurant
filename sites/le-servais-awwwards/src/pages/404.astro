---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas sur le site du Servais à Namur. Retour à l’accueil ou à la carte.">
  <div class="ligne">
    <section class="entete wrap erreur" aria-labelledby="titre-404">
      <p class="hero__lieu">Erreur 404</p>
      <h1 id="titre-404" class="display erreur__titre">Terminus</h1>
      <p class="entete__chapeau">Cette page n’est pas desservie. La ligne reprend à l’accueil.</p>
      <p class="hero__actions">
        <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
        <a class="cta cta--ligne" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
      </p>
    </section>
  </div>
</Base>
