---
// La cabine du câble (signature). Trois enveloppes : position collante sur le câble, arrivée de l'intro, pendule.
---
<div class="cabine" data-cabine aria-hidden="true">
  <div class="cabine__colle">
    <div class="cabine__arrivee">
      <div class="cabine__corps"><span class="cabine__caisse"><span class="cabine__vitre"></span><span class="cabine__vitre"></span></span></div>
    </div>
  </div>
</div>
