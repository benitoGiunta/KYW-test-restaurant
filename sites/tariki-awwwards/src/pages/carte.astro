---
import Base from '../layouts/Base.astro';
import { soir, midi } from '../data/carte';
import { formuleMidi, site } from '../data/site';
const eur = (n: number) => `${n} €`;
---
<Base page="carte" title="La carte" description="La carte de Tariki : à grignoter, à partager, grillades au feu de bois, desserts, et le midi sandwichs à 9 € ou formule à 17 €.">
  <section class="wrap entete" aria-labelledby="titre-carte">
    <h1 class="entete__titre display" id="titre-carte" style="--mot: 3.82" data-split>La carte</h1>
    <p class="entete__texte">Volontairement courte. Cinq étapes le soir, un sandwich au feu de bois le midi.</p>
  </section>

  <div class="wrap carte">
    <nav class="carte__route" aria-label="Étapes de la carte">
      <ol>
        {soir.map((r) => <li><a href={`#${r.id}`}>{r.titre}<small>{r.etape}</small></a></li>)}
        <li><a href="#midi">Le midi<small>Sandwichs et formule</small></a></li>
      </ol>
    </nav>
    <div class="carte__corps">
      {soir.map((r) => (
        <section class="rubrique" id={r.id} aria-labelledby={`t-${r.id}`}>
          <div class="rubrique__tete">
            <h2 class="rubrique__titre display" id={`t-${r.id}`}>{r.titre}</h2>
            <p class="rubrique__etape">{r.etape}</p>
          </div>
          <ul class="plats">
            {r.plats.map((p) => (
              <li class="plat">
                <h3 class="plat__nom">{p.nom}</h3>
                <p class="plat__desc">{p.description}</p>
                <p class="plat__prix">{eur(p.prix)}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <section class="rubrique" id="midi" aria-labelledby="t-midi">
        <div class="rubrique__tete">
          <h2 class="rubrique__titre display" id="t-midi">Le midi</h2>
          <p class="rubrique__etape">Du mercredi au samedi, 11&nbsp;h&nbsp;30 à 14&nbsp;h</p>
        </div>
        <ul class="plats">
          {midi.map((p) => (
            <li class="plat">
              <h3 class="plat__nom">{p.nom}, sandwich au feu de bois</h3>
              <p class="plat__desc">{p.description}</p>
              <p class="plat__prix">{eur(p.prix)}</p>
            </li>
          ))}
          <li class="plat">
            <h3 class="plat__nom">{formuleMidi.nom}</h3>
            <p class="plat__desc">{formuleMidi.detail}</p>
            <p class="plat__prix">{eur(formuleMidi.prix)}</p>
          </li>
        </ul>
      </section>
      <p class="carte__note">Allergènes signalés sur la carte : fruits à coque, lait, sésame. Carte du soir d’après la page «&nbsp;La carte&nbsp;» du site de Tariki, prix à confirmer au restaurant.</p>
      <div class="cta-groupe">
        <a class="cta" href={site.reservationUrl} rel="noopener">Réserver une table</a>
        <a class="cta cta--contour" href={site.telephoneHref}>Appeler</a>
      </div>
    </div>
  </div>
</Base>
