---
import Base from '../layouts/Base.astro';
import Horaires from '../components/Horaires.astro';
import { site, pageInfos } from '../data/site';
---
<Base page="reservation" title="Réservation" description="Réserver chez Tariki, Rue de l’Ouvrage 2 à Namur : en ligne, par téléphone au 0492 92 18 39 ou par e-mail. Fermé le dimanche.">
  <section class="wrap entete" aria-labelledby="titre-resa">
    <h1 class="entete__titre display" id="titre-resa" style="--mot: 4.16" data-split data-intro>Réserver</h1>
    <p class="entete__texte" data-reveal="up" data-intro data-delay="0.15">Prenez la route jusqu’à notre table.</p>
  </section>

  <div class="wrap resa">
    <div class="resa__actions" data-reveal="up" data-delay="0.2" data-intro>
      <h2>Réserver en ligne</h2>
      <div class="cta-groupe"><a class="cta" href={site.reservationUrl} rel="noopener">Réserver sur le site de Tariki</a></div>
      <h2>Ou par téléphone</h2>
      <a class="resa__tel" href={site.telephoneHref}>{site.telephoneLisible}</a>
      <h2>Ou par e-mail</h2>
      <p><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></p>
      <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <label>Nom<input type="text" name="nom" autocomplete="name" required /></label>
        <label>Date souhaitée<input type="date" name="date" /></label>
        <label>Nombre de personnes<input type="number" name="personnes" min="1" max="20" inputmode="numeric" /></label>
        <label>Service<input type="text" name="service" placeholder="Midi ou soir" /></label>
        <button class="cta" type="submit">Ouvrir mon e-mail</button>
        <p class="petit form__note">Le bouton ouvre votre messagerie avec ces informations. Rien n’est envoyé depuis cette page.</p>
      </form>
    </div>
    <div class="resa__infos" data-reveal="up" data-delay="0.3" data-intro>
      <h2>Adresse</h2>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
      <h2>Horaires</h2>
      <Horaires />
      <h2>Bon à savoir</h2>
      <ul class="resa__acces">{pageInfos.acces.map((a) => <li>{a}</li>)}</ul>
    </div>
  </div>
</Base>
