---
import Base from '../layouts/Base.astro';
import { resto } from '../data/site';
---
<Base title="Événements au Servais, Namur" description="Le Chalet du Servais, les offres de la semaine et les recrutements : ce qui se passe au Servais, rue des Fossés Fleuris à Namur." actif="evenements/">
  <section class="pagehead">
    <div class="container">
      <h1>Événements</h1>
      <p class="lead">Ce qui se prépare au Servais.</p>
    </div>
  </section>
  <section class="section" aria-label="Au programme">
    <div class="container">
      <ul class="rows rows--grands">
        <li class="evt">
          <div class="evt__date"><span>Du 27 novembre</span><span>au 31 décembre</span></div>
          <div class="evt__texte">
            <h2>Le Chalet du Servais</h2>
            <p>Ambiance after ski, musique et spécialités de Noël au cœur de Namur : vin chaud, bulles, tartiflette, terrasse couverte et chalet chauffé.</p>
          </div>
        </li>
        <li class="evt">
          <div class="evt__date"><span>Tous les jours</span><span>de 18 h à 20 h</span></div>
          <div class="evt__texte">
            <h2>3 + 1 sur les cocktails</h2>
            <p>L’offre du bar, chaque jour de la semaine.</p>
          </div>
        </li>
        <li class="evt">
          <div class="evt__date"><span>Tous les mardis</span></div>
          <div class="evt__texte">
            <h2>La bolo à 12 €</h2>
            <p>Le spaghetti bolognaise passe à 12 €.</p>
          </div>
        </li>
        <li class="evt">
          <div class="evt__date"><span>Recrutement</span></div>
          <div class="evt__texte">
            <h2>Le Servais recrute</h2>
            <p>Serveur·se et barman·maid, étudiant ou flexi-job, expérience appréciée. <a class="lien" href={`mailto:${resto.mail}?subject=Candidature`}>Envoyer son CV à {resto.mail}</a>.</p>
          </div>
        </li>
      </ul>
      <p class="note">Les autres rendez-vous sont à suivre sur <a class="lien" href={resto.facebook} rel="noopener">Facebook</a> et <a class="lien" href={resto.instagram} rel="noopener">Instagram</a>.</p>
    </div>
  </section>
</Base>
