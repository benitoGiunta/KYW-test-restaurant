---
import Base from '../layouts/Base.astro';
import Horaires from '../components/Horaires.astro';
import { resto } from '../data/site';
---
<Base title="Contact et accès, Le Servais Namur" description="Contacter le Servais : adresse rue des Fossés Fleuris 33 à Namur, au départ du téléphérique, téléphone, e-mail et réservation." actif="contact/">
  <section class="pagehead">
    <div class="container">
      <h1>Contact</h1>
      <ul class="contacts">
        <li><span>Téléphone</span><a class="lien" href={resto.tel}>{resto.telAffiche}</a></li>
        <li><span>E-mail</span><a class="lien" href={`mailto:${resto.mail}`}>{resto.mail}</a></li>
        <li><span>Réservation</span><a class="lien" href={resto.reservation} rel="noopener">book.leservais.be</a></li>
        <li><span>Réseaux</span><span><a class="lien" href={resto.facebook} rel="noopener">Facebook</a> et <a class="lien" href={resto.instagram} rel="noopener">Instagram</a></span></li>
      </ul>
    </div>
  </section>
  <Horaires titre="Horaires et accès" />
</Base>
