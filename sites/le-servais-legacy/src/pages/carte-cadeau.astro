---
import Base from '../layouts/Base.astro';
import { resto } from '../data/site';
---
<Base title="Carte cadeau du Servais, Namur" description="Offrir un moment au Servais à Namur : la carte cadeau se commande en ligne." actif="carte-cadeau/">
  <section class="pagehead">
    <div class="container">
      <h1>Carte cadeau</h1>
      <p class="lead">La carte cadeau se commande en ligne.</p>
      <div class="actions">
        <a class="btn btn--accent" href={resto.carteCadeau} rel="noopener">Offrir une carte</a>
      </div>
    </div>
  </section>
  <section class="section" aria-label="Conditions">
    <div class="container">
      <p class="fill" data-fill="true">Montants et durée de validité : à confirmer par le Servais.</p>
    </div>
  </section>
</Base>
