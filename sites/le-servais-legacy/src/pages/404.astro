---
import Base from '../layouts/Base.astro';
import { resto, u } from '../data/site';
---
<Base title="Page introuvable, Le Servais" description="Cette page du Servais n’existe pas.">
  <section class="pagehead pagehead--404">
    <div class="container">
      <h1>Page introuvable</h1>
      <p class="lead">Cette adresse ne mène à aucune page du Servais.</p>
      <div class="actions">
        <a class="btn btn--accent" href={u()}>Retour à l’accueil</a>
        <a class="btn btn--ink" href={resto.reservation} rel="noopener">Réserver une table</a>
      </div>
    </div>
  </section>
</Base>
