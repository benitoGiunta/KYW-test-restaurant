---
import { jours, h, cuisine, resto, u } from '../data/site';
const { titre = 'Ouvert 7 jours sur 7', niveau = 2 } = Astro.props;
const H = `h${niveau}`;
---
<section class="horaires" aria-labelledby="horaires-t">
  <div class="container horaires__grille" data-reveal>
    <div class="horaires__tete">
      <Fragment set:html={`<${H} id="horaires-t">${titre}</${H}>`} />
      <p class="lead">Le bar ouvre dès 9{' '}h, la cuisine est ouverte sans interruption de 11{' '}h 30 à 22{' '}h.</p>
      <p class="horaires__statut" data-statut hidden></p>
    </div>
    <dl class="schedule">
      {jours.map((j, i) => (
        <div class="schedule__ligne" data-i={i} data-de={j.de} data-a={j.a}>
          <dt>{j.jour}</dt>
          <dd><time datetime={j.de}>{h(j.de)}</time> à <time datetime={j.a}>{h(j.a)}</time></dd>
        </div>
      ))}
    </dl>
    <div class="horaires__lieu">
      <p class="horaires__cuisine">Cuisine : {cuisine.service}. {cuisine.petitDej}.</p>
      <address>
        <a class="lien" href={resto.maps} rel="noopener">{resto.adresse.rue}, {resto.adresse.cp} {resto.adresse.ville}</a>
        <span>Au départ du téléphérique</span>
      </address>
      <div class="actions">
        <a class="btn btn--accent" href={resto.reservation} rel="noopener">Réserver une table</a>
        <a class="lien" href={resto.tel}>{resto.telAffiche}</a>
      </div>
    </div>
  </div>
</section>
