---
import Photo from './Photo.astro';
import { resto, u } from '../data/site';
---
<section class="hero" aria-labelledby="hero-t">
  <div class="container hero__grille">
    <div class="hero__texte">
      <h1 id="hero-t"><span>Le</span> <span>Servais</span></h1>
      <p class="lead">Bar et brasserie au départ du téléphérique, ouvert 7 jours sur 7.</p>
      <div class="actions">
        <a class="btn btn--accent" href={resto.reservation} rel="noopener">Réserver une table</a>
        <a class="btn btn--ink" href={u('carte/')}>Voir la carte</a>
      </div>
    </div>
    <div class="hero__photo">
      <Photo nom="comptoir" slot="hero" largeurs={[480, 900, 1600]} ratio={5 / 4} sizes="(min-width: 80rem) 700px, 100vw" priority alt="Le comptoir du bar, sous les tuyaux apparents et les suspensions, avec la barmaid au fond" position="50% 40%" />
    </div>
  </div>
</section>
