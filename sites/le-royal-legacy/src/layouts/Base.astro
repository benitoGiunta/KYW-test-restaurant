---
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import KywFooter from '@kyw/footer';
import { resto, service, base } from '../data/site';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ff = (fam, file, w) => `@font-face{font-family:'${fam}';font-style:normal;font-weight:${w};font-display:optional;src:url(${base}fonts/${file}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
const fontFaces = [ff('Yeseva One', 'yeseva-one-latin.woff2', 400), ff('Archivo', 'archivo-latin.woff2', '400 500'), ff('Archivo Narrow', 'archivo-narrow-600-latin.woff2', 600)].join('');
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: new URL(base, Astro.site).href,
  telephone: '+32 81 22 01 33', servesCuisine: ['Brasserie belge'],
  address: { '@type': 'PostalAddress', streetAddress: resto.adresse.rue, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
  sameAs: [resto.facebook, resto.instagram],
  openingHoursSpecification: service.map((s) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: s.de, closes: s.a })),
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={resto.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}photos/facade-1200.webp`, Astro.site).href} />
    <meta property="og:image:alt" content="Façade de la brasserie Le Royal, place du Théâtre à Namur" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preload" href={`${base}fonts/yeseva-one-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/archivo-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/archivo-narrow-600-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
    <style is:global>@import "../styles/page.css";</style>
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <Nav />
    <main id="contenu">
      <slot />
    </main>
    <Pied />
    <KywFooter base={base} />
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var cibles = document.querySelectorAll('.propos__texte, .propos__visuel, .carte__corps, .moules__visuel, .moules__texte, .fetes__tete, .fetes__prix, .fetes__plats, .venir__cols');
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting || e.boundingClientRect.top < 0) { e.target.setAttribute('data-reveal', 'in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -6% 0px' });
        cibles.forEach(function (el) {
          if (el.getBoundingClientRect().top < window.innerHeight) return;
          el.setAttribute('data-reveal', '');
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
