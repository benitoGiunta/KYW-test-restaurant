---
import Base from '../layouts/Base.astro';
import { u, resto } from '../data/site';
---
<Base title="Page introuvable, Le Royal Namur" description="Cette page n’existe pas. Retour à l’accueil de la brasserie Le Royal à Namur.">
  <section class="section erreur">
    <div class="container">
      <h1>Cette page n’existe pas</h1>
      <p class="lead">La carte et les réservations sont sur l’accueil.</p>
      <div class="actions">
        <a class="btn btn--accent" href={u()}>Retour à l’accueil</a>
        <a class="lien" href={resto.tel}>Appeler le {resto.telAffiche}</a>
      </div>
    </div>
  </section>
</Base>
