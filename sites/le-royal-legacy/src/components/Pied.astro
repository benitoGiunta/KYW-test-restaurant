---
import { resto, u } from '../data/site';
---
<footer class="pied">
  <div class="container pied__in">
    <p class="pied__phrase">Rendez-vous Place du Théâtre.</p>
    <div class="pied__infos">
      <img class="pied__logo" src={u('photos/couronne.webp')} width="150" height="150" alt="" />
      <p>{resto.adresse.rue}<br />{resto.adresse.cp} {resto.adresse.ville}</p>
      <p><a class="lien nw" href={resto.tel}>{resto.telAffiche}</a><br /><a class="lien" href={`mailto:${resto.mail}`}>{resto.mail}</a></p>
      <p><a class="lien" href={resto.facebook} rel="noopener">Facebook</a><br /><a class="lien" href={resto.instagram} rel="noopener">Instagram</a></p>
    </div>
    <p class="pied__credits" data-credits>Photographies : Le Royal Namur. Maquette d’après leroyalnamur.be.</p>
  </div>
</footer>
