---
import Photo from './Photo.astro';
import { resto, photos } from '../data/site';
---
<section class="hero" aria-labelledby="titre">
  <div class="hero__texte">
    <div class="hero__bloc">
      <h1 id="titre">Le Royal Namur</h1>
      <p class="lead">{resto.baseline}.</p>
      <div class="actions">
        <a class="btn btn--accent" href={resto.zenchef} rel="noopener">Réserver une table</a>
        <a class="lien" href={resto.tel}>Appeler le {resto.telAffiche}</a>
      </div>
    </div>
  </div>
  <figure class="hero__visuel">
    <Photo p={photos.facade} sizes="(max-width: 60rem) 100vw, 56vw" eager pos="52% 45%" />
  </figure>
</section>
