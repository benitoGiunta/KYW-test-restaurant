---
import { carte, euro, resto } from '../data/site';
const panneaux = [
  { id: 'manger', nom: 'À manger', cats: carte.manger },
  { id: 'boire', nom: 'À boire', cats: carte.boire },
];
---
<section class="section carte" id="carte" aria-labelledby="t-carte">
  <div class="container grid">
    <div class="carte__tete">
      <h2 id="t-carte">La carte</h2>
      <p class="lead">La cuisine de brasserie du Royal, telle qu’elle figure sur la carte d’août 2026.</p>
      <p><a class="lien" href={resto.carteUrl} rel="noopener">Ouvrir la carte en PDF</a></p>
      <div class="tabs" role="tablist" aria-label="Parties de la carte">
        {panneaux.map((p, i) => (
          <button class="tab" role="tab" type="button" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{p.nom}</button>
        ))}
      </div>
    </div>
    <div class="carte__corps">
      {panneaux.map((p, i) => (
        <div class="panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} data-ouvert={i === 0 ? 'true' : 'false'}>
          <h3 class="panel__titre">{p.nom}</h3>
          {p.cats.map((c, ci) => (
            <section class="cat" aria-labelledby={`c-${p.id}-${ci}`}>
              <h4 class="cat__nom" id={`c-${p.id}-${ci}`}>{c.categorie}</h4>
              <ul class="rows">
                {c.plats.map((pl) => (
                  <li class="row">
                    <span class="row__nom">{pl.nom}{pl.description && <small>{pl.description}</small>}</span>
                    <span class="row__prix num">{euro(pl.prix)}</span>
                  </li>
                ))}
              </ul>
              {c.note && <p class="cat__note">{c.note}</p>}
            </section>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.carte .tab'));
    if (!tabs.length) return;
    var show = function (t) {
      tabs.forEach(function (x) {
        var on = x === t;
        x.setAttribute('aria-selected', on ? 'true' : 'false');
        x.tabIndex = on ? 0 : -1;
        var p = document.getElementById(x.getAttribute('aria-controls'));
        if (p) p.dataset.ouvert = on ? 'true' : 'false';
      });
    };
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { show(t); });
      t.addEventListener('keydown', function (e) {
        var n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
        if (n === null) return;
        e.preventDefault();
        var c = tabs[(n + tabs.length) % tabs.length];
        c.focus();
        show(c);
      });
    });
  })();
</script>
