---
import Photo from './Photo.astro';
import { photos, euro } from '../data/site';
---
<section class="section moules" id="moules" aria-labelledby="t-moules">
  <div class="container grid">
    <figure class="moules__visuel">
      <Photo p={photos.terrasse} sizes="(max-width: 60rem) 100vw, 40vw" pos="50% 60%" />
      <figcaption>Terrasse face au Théâtre, l’ardoise des moules jumbo posée devant.</figcaption>
    </figure>
    <div class="moules__texte">
      <h2 id="t-moules">Moules jumbo, terrasse au soleil</h2>
      <p class="lead">Les moules jumbo (1,350 kg) se déclinent en cinq recettes, de {euro(29.9)} à {euro(31.9)}.</p>
      <dl class="faits">
        <div class="fait">
          <dt>Ardoise de la terrasse</dt>
          <dd>Moules jumbo à <span class="num">{euro(20)}</span>, les mardis et jeudis.</dd>
          <dd class="verifier" data-a-verifier="true">Relevé sur une photo du site : conditions à confirmer auprès de la brasserie.</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
