---
import KywFooter from '@kyw/footer';
import { site, nav } from '../data/site';
import { u } from '../lib/url';
---
<section class="foot" aria-label="Coordonnées et plan du site">
  <div class="container foot__grid">
    <div class="foot__id">
      <p class="foot__name">{site.nom}</p>
      <p>{site.baseline}</p>
    </div>
    <address class="foot__col">
      <p class="foot__h">Adresse</p>
      <p>{site.adresse.rue}<br />{site.adresse.ville}</p>
      <p><a href={site.telHref}>{site.tel}</a></p>
    </address>
    <nav class="foot__col" aria-label="Pied de page">
      <p class="foot__h">Le site</p>
      <ul>{nav.map((n) => <li><a href={u(n.href)}>{n.label}</a></li>)}</ul>
    </nav>
    <div class="foot__col">
      <p class="foot__h">Réseaux</p>
      <ul>
        <li><a href={site.facebook} rel="noopener">Facebook</a></li>
        <li><a href={site.instagram} rel="noopener">Instagram</a></li>
        <li><a href={site.tiktok} rel="noopener">TikTok</a></li>
      </ul>
    </div>
    <p class="foot__credits" data-credits>Photographies : Bienvenue chez vous, certaines créations sont mises en valeur par les photos d’Anthony Florio.</p>
  </div>
</section>
<script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelector('img')?.remove(); s.appendChild(im); } };
document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
<KywFooter base={import.meta.env.BASE_URL} />
