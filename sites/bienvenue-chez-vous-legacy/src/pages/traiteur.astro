---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Photo from "../components/Photo.astro";
import Reservation from "../components/Reservation.astro";
import Footer from "../components/Footer.astro";
import Horaires from "../components/Horaires.astro";
import { site, fr } from "../data/site";
import { u } from "../lib/url";
---
<Base title="Traiteur à emporter, Bienvenue chez vous, Namur" description="Le repas gourmand hebdomadaire et la Box Bienvenue chez vous à emporter, sur commande 24 h à l’avance, par le chef Cédric Delsaut à Namur.">
  <Nav current="traiteur/" />
  <main id="contenu">
    <header class="page-head">
      <div class="container split">
        <div>
          <h1>Le restaurant, à emporter.</h1>
          <p class="lead">En permanence toute l’année, 7 jours sur 7. Commande minimum 24 h à l’avance.</p>
        </div>
        <Photo name="emporter" class="page-head__photo" sizes="(min-width: 60rem) 45vw, 100vw" caption="Plat à emporter en bol kraft, légumes et asperges" />
      </div>
    </header>

    <section class="sec" aria-labelledby="hebdo-t">
      <div class="container split split--menu">
        <div>
          <h2 id="hebdo-t">Le repas gourmand hebdomadaire.</h2>
          <p class="lead">« À vous de choisir » : un repas de saison, renouvelé chaque semaine. Je peux vous fournir les vins adaptés, ou vous aider à choisir dans votre cave.</p>
        </div>
        <div>
          <ul class="rows">
            <li class="rows__item"><h3 class="rows__name">Trois services</h3><p class="rows__detail">Avec dessert. Sans dessert : 44&nbsp;€.</p><p class="rows__price num">49&nbsp;€</p></li>
            <li class="rows__item"><h3 class="rows__name">Quatre services</h3><p class="rows__detail">Avec dessert. Sans dessert : 59&nbsp;€.</p><p class="rows__price num">64&nbsp;€</p></li>
            <li class="rows__item"><h3 class="rows__name">Le Confort</h3><p class="rows__detail">Trois mises en appétit, pain maison, beurre de ferme, huile d’olive toscane sélectionnée et quatre mignardises. Par personne.</p><p class="rows__price num">+&nbsp;20&nbsp;€</p></li>
          </ul>
          <p class="small">Exemple de la semaine : Saint-Jacques de Vincent, bœuf Angus séché ; filet de veau saumuré ou filet de biche (biche + 5&nbsp;€) ; dessert du moment. Les plats changent, les prix sont ceux du site d’origine.</p>
        </div>
      </div>
    </section>

    <Photo name="bouchees" class="bleed" ratio="21 / 9" sizes="100vw" pos="50% 50%" caption="Plateau de douze verrines de bouchées" />

    <section class="sec sec--tint" aria-labelledby="box-t">
      <div class="container split">
        <div>
          <h2 id="box-t">La Box Bienvenue chez vous.</h2>
          <p class="lead">Vivre le concept du restaurant au plus proche, en traiteur à emporter, pour deux personnes. Personnalisable sur demande : anniversaire, mariage, Saint-Valentin, fête des mamans.</p>
        </div>
        <div class="well">
          <ul class="rows">
            <li class="rows__item"><h3 class="rows__name">Avec les boissons</h3><p class="rows__detail">Cinq à six créations en mode découverte, les mises en appétit, le pain maison, les mignardises, un apéritif maison, un blanc, un rouge et deux softs.</p><p class="rows__price num">199&nbsp;€</p></li>
            <li class="rows__item"><h3 class="rows__name">Sans les boissons</h3><p class="rows__detail">Pour deux personnes.</p><p class="rows__price num">174&nbsp;€</p></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="events-t">
      <div class="container split">
        <h2 id="events-t">Pour vos événements.</h2>
        <div class="prose">
          <p>Traiteur et organisateur d’événements, en nos lieux ou en extérieur. Créateur de gâteaux et de pièces montées pour toutes vos occasions.</p>
          <p>N’hésitez pas à nous consulter pour toute information : <a href={site.telHref}>{site.tel}</a>.</p>
        </div>
      </div>
    </section>

    <Reservation titre="Commander, ou simplement demander." />
  </main>
  <Footer />
</Base>
