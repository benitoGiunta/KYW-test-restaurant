---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { u } from "../lib/url";
---
<Base title="Page introuvable, Bienvenue chez vous" description="Cette page n’existe pas.">
  <Nav />
  <main id="contenu" class="sec">
    <div class="container">
      <h1>Cette table n’existe pas.</h1>
      <p class="lead">La page cherchée est introuvable. <a href={u()}>Retour à l’accueil</a>.</p>
    </div>
  </main>
  <Footer />
</Base>
