---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Photo from "../components/Photo.astro";
import Reservation from "../components/Reservation.astro";
import Footer from "../components/Footer.astro";
import { site, fr } from "../data/site";
const presse = [
  { media: 'La DH', titre: 'Salzinnes : le resto de Cédric Delsaut déménage', date: '18 mai 2020', url: 'https://www.dhnet.be/regions/namur/salzinnes-le-resto-de-cedric-delsaut-demenage-5ec2879a9' },
  { media: 'Gault&Millau Belgium', titre: 'Fiche du restaurant : Cédric Delsaut, Jeune Chef de l’année 2016', date: '', url: 'https://www.gaultmillau.be/en/restaurants/bienvenue-chez-vous-namur' },
];
---
<Base title="Présentation, Bienvenue chez vous, Namur" description="Un restaurant Passionomique, une boutique et un traiteur : l’histoire de Bienvenue chez vous, créé en 2002 par Cédric Delsaut.">
  <Nav current="presentation/" />
  <main id="contenu">
    <header class="page-head">
      <div class="container split">
        <div>
          <h1>Un restaurant Passionomique.</h1>
          <p class="lead">Au premier étage d’une superbe maison de maître, un cadre intimiste et chaleureux, un accueil souriant, quatre tables simplement.</p>
        </div>
        <Photo name="enseigne" class="page-head__photo" sizes="(min-width: 60rem) 45vw, 100vw" caption="L’enseigne de la rue Pépin" />
      </div>
    </header>

    <section class="sec" aria-labelledby="qui-t">
      <div class="container split">
        <h2 id="qui-t">Qui sommes-nous ?</h2>
        <div class="prose">
          <p>Aux lueurs des bougies, des repas gourmands, très soignés, raffinés, alliant produits de première qualité, finesse et créativité. Et dès les beaux jours, une terrasse calme à l’abri du soleil.</p>
          <p>Une cuisine française à la base classique, travaillée avec une vision contemporaine, mais toujours bien goûteuse et gourmande.</p>
          <p>Créé en 2002, au départ à Bruxelles, le concept s’est installé à Namur ; en 2020, le restaurant a quitté l’avenue Cardinal Mercier, à Salzinnes, pour la rue Pépin.</p>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="mot-t">
      <div class="container band__grid">
        <h2 id="mot-t">« Merci à vous, amis de la table, de me donner chaque jour la possibilité de m’exprimer et de m’épanouir pleinement dans ma passion. »</h2>
        <p class="band__sign">Cédric Delsaut, chef et propriétaire</p>
      </div>
    </section>

    <section class="sec" aria-labelledby="trois-t">
      <div class="container">
        <h2 id="trois-t" class="sec__head">Trois façons d’être chez vous.</h2>
        <ul class="rows rows--cols">
          <li class="rows__item"><h3 class="rows__name">Le restaurant</h3><p class="rows__detail">Un repas en escales, sur réservation, midi et soir.</p></li>
          <li class="rows__item"><h3 class="rows__name">La boutique</h3><p class="rows__detail">De nombreux produits de bouche de première qualité, originaux, d’artisans locaux pour la plupart.</p></li>
          <li class="rows__item"><h3 class="rows__name">Le traiteur</h3><p class="rows__detail">Traiteur et organisateur d’événements, en nos lieux ou en extérieur ; gâteaux et pièces montées.</p></li>
        </ul>
      </div>
    </section>

    <Photo name="facade" class="bleed" ratio="21 / 9" sizes="100vw" pos="50% 35%" caption="La maison de maître, rue Pépin" />

    <section class="sec" aria-labelledby="presse-t">
      <div class="container split">
        <h2 id="presse-t">Dans la presse.</h2>
        <ul class="rows">
          {presse.map((p) => <li class="rows__item rows__item--2"><h3 class="rows__name"><a href={p.url} rel="noopener">{p.media}</a></h3><p class="rows__detail">{fr(p.titre)}{p.date && `, ${p.date}`}</p></li>)}
        </ul>
      </div>
    </section>

    <Reservation />
  </main>
  <Footer />
</Base>
