---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Photo from "../components/Photo.astro";
import Reservation from "../components/Reservation.astro";
import Footer from "../components/Footer.astro";
import Horaires from "../components/Horaires.astro";
import { site, fr } from "../data/site";
import { u } from "../lib/url";
---
<Base title="Boutique, Bienvenue chez vous, Namur" description="La boutique Passionomique de Bienvenue chez vous : des produits de bouche d’artisans locaux, pour offrir ou pour cuisiner.">
  <Nav current="boutique/" />
  <main id="contenu">
    <header class="page-head">
      <div class="container split">
        <div>
          <h1>Une boutique Passionomique.</h1>
          <p class="lead">Des produits de bouche de première qualité, originaux, variés, d’artisans locaux pour la plupart, au design soigné.</p>
        </div>
        <figure class="photo page-head__photo">
          <div class="photo__frame" data-slot="boutique" data-alt="Rayons de la boutique : produits d’artisans, bocaux, bouteilles et paniers gourmands" style="aspect-ratio:4 / 3;">
            <p class="fill" data-keep>Photo de la boutique à fournir.</p>
          </div>
          <figcaption>Emplacement réservé : aucune photo de la boutique dans le dossier.</figcaption>
        </figure>
      </div>
    </header>

    <section class="sec" aria-labelledby="idees-t">
      <div class="container split">
        <h2 id="idees-t">Pour offrir, pour cuisiner.</h2>
        <ul class="rows">
          <li class="rows__item rows__item--2"><h3 class="rows__name">Cadeaux et paniers gourmands</h3><p class="rows__detail">Idéal pour vos cadeaux, vos paniers gourmands, ou tout simplement pour vous faire plaisir.</p></li>
          <li class="rows__item rows__item--2"><h3 class="rows__name">D’un ingrédient brut au plus sympa des cadeaux</h3><p class="rows__detail">Quel que soit le produit recherché, nous pouvons tout vous fournir.</p></li>
          <li class="rows__item rows__item--2"><h3 class="rows__name">Chèque cadeau</h3><p class="rows__detail">Une idée de cadeau pour la table du restaurant.</p></li>
          <li class="rows__item rows__item--2"><h3 class="rows__name">Parking aisé</h3><p class="rows__detail">Annoncé parmi les atouts du lieu sur le site d’origine.</p></li>
        </ul>
      </div>
    </section>

    <section class="band" aria-labelledby="artisans-t">
      <div class="container band__grid">
        <h2 id="artisans-t">Des artisans, souvent locaux, qui nous dénichent le nec plus ultra.</h2>
        <p class="band__sign">Cédric Delsaut, chef et propriétaire</p>
      </div>
    </section>

    <Reservation titre="Passer à la boutique." />
  </main>
  <Footer />
</Base>
