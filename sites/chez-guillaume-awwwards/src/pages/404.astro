---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" page="404" description="Cette page n’existe pas chez Guillaume, restaurant et comedy club à Namur. Revenez à l’accueil, à la carte ou à la réservation pour retrouver la soirée.">
  <section class="top top--poster top--404" aria-labelledby="titre">
    <div class="top__regie">
      <p class="regie">
        <span class="regie__heure regie__heure--vide">--:--</span>
        <span class="regie__libelle"><span class="regie__pastille" aria-hidden="true"></span>Hors conduite</span>
      </p>
    </div>
    <div class="top__corps">
      <svg class="arc" viewBox="0 0 400 220" aria-hidden="true" focusable="false"><path d="M20 210 A180 180 0 0 1 380 210" fill="none" stroke="currentColor" stroke-width="3" /></svg>
      <h1 id="titre" class="display poster__titre">On va voir qui&nbsp;?</h1>
      <p class="texte poster__texte">Personne : cette page n’est pas dans la conduite de la soirée. Le lien est peut-être ancien, ou l’adresse a une faute.</p>
      <div class="hero__ctas">
        <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
        <a class="lien lien--fort" href={u('/carte/')}>Voir la carte</a>
      </div>
    </div>
  </section>
</Base>
