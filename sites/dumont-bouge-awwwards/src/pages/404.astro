---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" page="404" description="Cette page n’est plus au comptoir de Dumont Bouge.">
  <section class="perdu wrap">
    <p class="perdu__h" aria-hidden="true">18 h 01</p>
    <h1 class="display perdu__titre">Cette page est déjà partie</h1>
    <p class="perdu__texte">La fournée est vendue, le comptoir est balayé. Retournez à l’accueil ou regardez ce qu’on sert encore à la carte.</p>
    <p class="perdu__actions"><a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a> <a class="cta cta--fantome" href={u('/carte/')}><span class="cta__txt">La carte</span></a></p>
  </section>
</Base>
