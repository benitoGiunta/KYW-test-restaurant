---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { chapitres } from '../data/site';
const norm = (r: string) => { const i = r.indexOf(' : '); return i < 0 ? { groupe: null, titre: r } : { groupe: r.slice(0, i), titre: r.slice(i + 3) }; };
---
<Base title="La carte" page="carte" description="La carte de Dumont Bouge : pains, gâteaux maison, sandwichs Dagobert, petit-déjeuner, brunch, gaufres, crêpes et boissons du tea-room.">
  <section class="entete wrap">
    <h1 class="display entete__titre">La carte</h1>
    <p class="entete__texte">Du pain de 7 h au brunch de 11 h 30, des gâteaux faits à la main aux gaufres de Bruxelles. Les prix sont ceux du site de la maison.</p>
    <nav class="puces" aria-label="Aller à une partie de la carte">
      <ul>{chapitres.map((c) => <li><a class="puce" href={`#${c.id}`}>{c.titre}</a></li>)}</ul>
    </nav>
  </section>
  {chapitres.map((c) => {
    let dernier: string | null = null;
    return (
      <section class="chap wrap" id={c.id} aria-labelledby={`${c.id}-t`}>
        <h2 class="chap__titre display" id={`${c.id}-t`}>{c.titre}</h2>
        <div class="chap__corps">
          {c.rubriques.map((r) => {
            const n = norm(r.titre);
            const nouveauGroupe = n.groupe && n.groupe !== dernier;
            dernier = n.groupe ?? dernier;
            return (
              <div class="rub">
                {nouveauGroupe && <h3 class="rub__groupe">{n.groupe}</h3>}
                <h4 class="rub__titre">{n.titre}{r.horaire && <span class="rub__h"> · {r.horaire}</span>}</h4>
                {c.id === 'gateaux' && <p class="rub__note">Gâteaux préparés à la main, à commander au <a class="lien" href="tel:+3281229602">081 22 96 02</a>. Prix non publiés.</p>}
                <ul class="plats">
                  {r.plats.map((p) => (
                    <li class="plat">
                      <p class="plat__nom">{p.nom}</p>
                      {p.desc && <p class="plat__desc">{p.desc}</p>}
                      {p.prix && (
                        <p class="plat__prix">
                          {p.prix.map((x) => <span class="px">{x.lib && <span class="px__lib">{x.lib} </span>}{x.montant && <span class="px__m">{x.montant}</span>}</span>)}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </section>
    );
  })}
  <section class="wrap carte-pied">
    <p>Allergie alimentaire ? Nous répondons à vos questions. Un paiement par table, merci.</p>
    <p><a class="cta" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a></p>
  </section>
</Base>
