---
import { u } from '../lib/url';
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const courant = (p: string) => (path === u(p).replace(/\/+$/, '') + '/' ? 'page' : undefined);
const liens = [
  { href: '/carte/', label: 'La carte' },
  { href: '/histoire/', label: 'La maison' },
];
---
<header class="tete">
  <a class="tete__marque" href={base} aria-current={path === base ? 'page' : undefined}>
    <img src={`${base}logo.png`} alt="Dumont Bouge, pâtisserie, boulangerie, restauration, tea-room" width="900" height="367" />
  </a>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => <li><a class="nl" href={u(l.href)} aria-current={courant(l.href)}>{l.label}</a></li>)}
      <li><a class="cta cta--petit" href={u('/reservation/')} aria-current={courant('/reservation/')}><span class="cta__txt">Réserver</span></a></li>
    </ul>
  </nav>
  <button class="tete__menu" type="button" aria-expanded="false" aria-controls="menu"><span>Menu</span></button>
  <div class="menu" id="menu" hidden>
    <p class="menu__h" aria-hidden="true">7 h à 18 h</p>
    <ul class="menu__liste">
      <li><a class="menu__lien" href={base} aria-current={path === base ? 'page' : undefined}>Accueil</a></li>
      {liens.map((l) => <li><a class="menu__lien" href={u(l.href)} aria-current={courant(l.href)}>{l.label}</a></li>)}
      <li><a class="menu__lien" href={u('/reservation/')} aria-current={courant('/reservation/')}>Réserver</a></li>
    </ul>
    <p class="menu__pied"><a class="cta cta--nuit" href={site.telephoneHref}><span class="cta__txt">Appeler le {site.telephoneLisible}</span></a></p>
  </div>
</header>
