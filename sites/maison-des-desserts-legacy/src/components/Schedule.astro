---
import { horaires } from '../data/site';
---
<table class="schedule reveal" data-schedule>
  <caption>Horaires d’ouverture</caption>
  <tbody>
    {horaires.map((d) => (
      <tr class={d.h ? '' : 'is-closed'}>
        <th scope="row">{d.jour}</th>
        <td>{d.h ? <time>{d.h}</time> : 'Fermé'}</td>
      </tr>
    ))}
  </tbody>
</table>
