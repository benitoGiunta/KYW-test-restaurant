---
import Base from '../layouts/Base.astro';
import Schedule from '../components/Schedule.astro';
import { adresse, tel, mail, social } from '../data/site';
---
<Base title="Contact et horaires de La Maison des Desserts, Namur" description="Adresse, téléphone, horaires d’ouverture et formulaire de contact de La Maison des Desserts, rue Haute Marcelle 17 à Namur." current="contact">
  <div class="container">
    <div class="pagehead">
      <h1>Nous contacter</h1>
      <p class="lead">Retrouvez-nous en boutique ou envoyez-nous un message.</p>
    </div>
    <div class="contact">
      <div class="contact__facts">
        <dl class="facts">
          <div><dt>Adresse</dt><dd>{adresse.rue}, {adresse.ville}</dd></div>
          <div><dt>Téléphone</dt><dd><a class="link" href={tel.href}>{tel.aff}</a></dd></div>
          <div><dt>E-mail</dt><dd><a class="link" href={`mailto:${mail}`}>{mail}</a></dd></div>
          <div><dt>Réseaux</dt><dd><a class="link" href={social.instagram}>Instagram</a>, <a class="link" href={social.facebook}>Facebook</a></dd></div>
        </dl>
        <Schedule />
      </div>
      <section class="card" aria-labelledby="form-t">
        <h2 id="form-t">Écrivez-nous</h2>
        <form class="form" method="post" action="" data-endpoint="" novalidate>
          <div class="form__row">
            <div class="field"><label for="nom">Nom</label><input id="nom" name="nom" autocomplete="family-name" required aria-describedby="nom-m" /><span class="field__m" id="nom-m"></span></div>
            <div class="field"><label for="prenom">Prénom</label><input id="prenom" name="prenom" autocomplete="given-name" required aria-describedby="prenom-m" /><span class="field__m" id="prenom-m"></span></div>
          </div>
          <div class="field"><label for="email">Adresse e-mail</label><input id="email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="nom@exemple.be" required aria-describedby="email-m" /><span class="field__m" id="email-m"></span></div>
          <div class="field"><label for="tel">Téléphone</label><input id="tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" placeholder="0470 00 00 00" required aria-describedby="tel-m" /><span class="field__m" id="tel-m"></span></div>
          <div class="field"><label for="message">Message</label><textarea id="message" name="message" required aria-describedby="message-m"></textarea><span class="field__m" id="message-m"></span></div>
          <small>Tous les champs sont obligatoires. L’envoi sera relié à la boîte de la maison à la mise en ligne.</small>
          <p class="form__status" role="status" data-status></p>
          <div><button class="btn btn--primary" type="submit">Envoyer le message</button></div>
        </form>
      </section>
    </div>
  </div>
</Base>
