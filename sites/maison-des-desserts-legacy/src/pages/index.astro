---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Schedule from '../components/Schedule.astro';
import { u, fr } from '../lib/fr';
import { histoire, metiers, faq, fetes, carte, shop, adresse, tel } from '../data/site';
const aperçu = (id: string) => (carte.find((c) => c.id === id)?.plats ?? []).slice(0, 3).map((p) => p.nom);
const sugg = carte[0].plats.filter((p) => p.prix).slice(0, 5);
const indexHero = [['Cuisine de midi', 'cuisine-midi'], ['Pâtisseries et assiettes', 'patisseries'], ['Crêpes et gaufres', 'crepes'], ['Boulangerie', 'boulangerie']];
---
<Base title="La Maison des Desserts, salon de thé et pâtisserie à Namur" description="Salon de thé, pâtisserie, boulangerie et chocolaterie familiale dans une bâtisse du 17e siècle, rue Haute Marcelle à Namur." current="">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1>Pâtisserie artisanale au cœur de Namur</h1>
        <p class="lead">Salon de thé, boulangerie et chocolaterie, rue Haute Marcelle depuis 1993.</p>
        <div class="hero__acts">
          <a class="btn btn--primary" href={u('carte')}>Voir la carte</a>
          <a class="btn" href={shop}>Commander en ligne</a>
        </div>
        <ul class="index" aria-label="Dans la carte">
          {indexHero.map(([l, id]) => <li><a href={u(`carte#${id}`)}>{l}</a></li>)}
        </ul>
      </div>
      <figure class="print hero__print">
        <Photo n="01" slot="hero" sizes="(max-width: 60rem) 100vw, 58vw" eager pos="50% 40%" />
        <figcaption><span>La façade de la maison, rue Haute Marcelle</span><span class="pencil">vitrine de Noël</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="sec" aria-label="Le salon de thé">
    <div class="container room">
      <figure class="plate room__a"><Photo n="03" slot="salle-a" ar="4 / 5" sizes="(max-width: 60rem) 100vw, 58vw" pos="50% 50%" /><figcaption><span>La salle du salon de thé, une colonne au centre</span></figcaption></figure>
      <figure class="plate room__b"><Photo n="05" slot="salle-b" ar="4 / 5" sizes="(max-width: 60rem) 70vw, 30vw" /><figcaption><span>Côté fenêtre</span></figcaption></figure>
    </div>
  </section>

  <section class="sec sec--band" aria-labelledby="histoire">
    <div class="container statement">
      <h2 id="histoire" class="visually-hidden">Notre histoire</h2>
      <p class="display-s">Une chocolaterie née en 1946, un salon de thé depuis 1993.</p>
      <p class="pencil">trois générations, une même maison</p>
      <div class="wall-text reveal">{histoire.map((t) => <p>{fr(t)}</p>)}</div>
    </div>
  </section>

  <section class="sec" aria-labelledby="metiers">
    <div class="container">
      <div class="sec__head"><h2 id="metiers">Trois métiers sous le même toit</h2><p class="lead">Les créations sont fabriquées par les équipes de la maison.</p></div>
      <div class="switch reveal" data-switch>
        <div class="switch__tabs" role="tablist" aria-label="Nos métiers" hidden>
          {metiers.map((m, i) => <button class="switch__tab" role="tab" type="button" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{m.nom}</button>)}
        </div>
        <div class="switch__panels">
          {metiers.map((m, i) => (
            <div class="switch__panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} tabindex="0">
              <h3>{m.nom}</h3>
              <p class="lead">{fr(m.texte)}</p>
              <p class="switch__aper">À la carte : {aperçu(m.ancre).map(fr).join(', ')}</p>
              <p><a class="link" href={u(`carte#${m.ancre}`)}>Voir à la carte</a></p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--band" aria-labelledby="sugg">
    <div class="container split">
      <div class="split__text">
        <h2 id="sugg" style="margin-bottom: var(--space-xl)">Les suggestions de l’automne</h2>
        <ul class="rows dish-list">
          {sugg.map((p) => <li><h3>{fr(p.nom)}</h3><p class="desc">{fr(p.description)}</p><span class="price">{fr(p.prix)}</span></li>)}
        </ul>
        <p style="margin-top: var(--space-xl)"><a class="btn" href={u('carte')}>Toute la carte</a></p>
      </div>
      <figure class="plate split__pic"><Photo n="07" slot="entremets" ar="4 / 5" sizes="(max-width: 60rem) 100vw, 36vw" /><figcaption><span>Entremets au chocolat, étiquette de la maison</span></figcaption></figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="commander">
    <div class="container order">
      <div class="order__qa">
        <h2 id="commander" style="margin-bottom: var(--space-xl)">Commander en ligne</h2>
        <dl style="margin:0">{faq.map((f) => <><dt>{fr(f.q)}</dt><dd>{fr(f.r)}</dd></>)}</dl>
        <p><a class="btn btn--primary" href={shop}>Ouvrir la boutique</a></p>
      </div>
      <div class="order__dates reveal">
        <h3 style="margin-bottom: var(--space-md)">Fêtes de fin d’année</h3>
        <ul class="rows">{fetes.map((f) => <li><span>{fr(f.q)}</span><span class="num">{fr(f.d)}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec sec--band" aria-labelledby="venir">
    <div class="container visit">
      <div class="visit__head">
        <h2 id="venir">Venir nous voir</h2>
        <address class="address">{adresse.rue}<br />{adresse.ville}</address>
        <p><a class="link" href={tel.href}>{tel.aff}</a></p>
      </div>
      <Schedule />
    </div>
  </section>
</Base>
