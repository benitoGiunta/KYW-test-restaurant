---
import Base from '../layouts/Base.astro';
---
<Base title="Emplois à La Maison des Desserts, Namur" description="Aucune offre d’emploi n’est ouverte pour le moment à La Maison des Desserts ; laissez votre adresse pour être prévenu." current="jobs">
  <div class="container">
    <div class="pagehead">
      <h1>Emplois à la maison</h1>
      <p class="lead">Aucune offre n’est ouverte pour le moment.</p>
    </div>
    <div class="jobs">
      <section class="card" aria-labelledby="job-t">
        <h2 id="job-t">Être prévenu</h2>
        <form class="form" method="post" action="" data-endpoint="">
          <div class="field"><label for="job-mail">Adresse e-mail</label><input id="job-mail" name="email" type="email" autocomplete="email" required /></div>
          <small>Nous vous prévenons dès qu’un poste est disponible. Désabonnement en un clic.</small>
          <div><button class="btn btn--primary" type="submit">Me notifier</button></div>
        </form>
      </section>
    </div>
  </div>
</Base>
