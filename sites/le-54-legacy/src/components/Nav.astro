---
import { nav, resto } from '../data/site';
interface Props { page: string }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="nav">
  <div class="container nav__in">
    <a class="nav__mark" href={base} aria-label="Le 54, Dave : accueil"><span class="nav__name">Le 54</span><span class="nav__lieu">Dave</span></a>
    <nav class="nav__links" aria-label="Navigation principale">
      {nav.map((l) => <a href={`${base}${l.href}`} aria-current={page === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a class="btn nav__cta" href={`${base}reservations`}>Réserver</a>
    <button class="nav__burger btn" popovertarget="menu" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">Menu</button>
  </div>
  <nav id="menu" popover class="nav__pop" aria-label="Menu mobile">
    <p class="nav__pop-t">Le 54, Dave</p>
    <a href={base}>Accueil</a>
    {nav.map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
    <a href={`${base}reservations`}>Réservations</a>
    <a class="nav__pop-tel" href={resto.tel1.href}>{resto.tel1.affiche}</a>
    <button class="btn" popovertarget="menu" popovertargetaction="hide" type="button">Fermer</button>
  </nav>
</header>
