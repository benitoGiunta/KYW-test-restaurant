---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import { resto } from '../data/site';
interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}photos/salle-noir-blanc-1600.webp`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: resto.nom,
  url: resto.site,
  image: ogImage,
  telephone: '+32 81 58 04 40',
  email: resto.email,
  servesCuisine: 'Cuisine gastronomique de saison et de marché',
  address: { '@type': 'PostalAddress', streetAddress: 'Rue de Longeau 54', postalCode: '5100', addressLocality: 'Dave (Namur)', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: 50.41887, longitude: 4.88509 },
  priceRange: '48 € - 65 €',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Sunday'], opens: '12:00', closes: '14:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '18:30', closes: '21:00' },
  ],
  sameAs: [resto.facebook, resto.instagram],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeeae1" />
    <link rel="icon" href={`${base}logo.png`} type="image/png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=sentient@300,400&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400&display=swap" rel="stylesheet" />
    {page !== '404' && <link rel="canonical" href={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={resto.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Salle du restaurant en noir et blanc, tables nappées et verres dressés" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      @import "../styles/page.css";
    </style>
  </head>
  <body data-page={page}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <script is:inline>
      (function () {
        var d = document, j = new Date().getDay();
        d.querySelectorAll('[data-jour]').forEach(function (el) { if (Number(el.dataset.jour) === j) { el.classList.add('is-now'); el.setAttribute('aria-current', 'date'); } });
        var m = d.getElementById('menu'), b = d.querySelector('.nav__burger');
        if (m && m.hidePopover) {
          m.addEventListener('toggle', function (e) { if (b) b.setAttribute('aria-expanded', e.newState === 'open' ? 'true' : 'false'); });
          m.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a')) m.hidePopover(); });
          window.matchMedia('(min-width: 52.0625rem)').addEventListener('change', function (q) { if (q.matches && m.matches(':popover-open')) m.hidePopover(); });
        }
        var els = d.querySelectorAll('[data-reveal]');
        function all() { els.forEach(function (el) { el.classList.add('is-in'); }); }
        if (!('IntersectionObserver' in window)) { all(); return; }
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
        window.addEventListener('beforeprint', all);
      })();
    </script>
    <KywFooter base={import.meta.env.BASE_URL} />
  </body>
</html>
