---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import Horaires from '../components/Horaires.astro';
import Reserve from '../components/Reserve.astro';
import { menu, menus, resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="accueil" title="Le 54, restaurant gastronomique à Dave (Namur)" description="Le 54 est une table gastronomique de Dave, à deux pas de Namur : cuisine de saison et de marché, menu en trois ou quatre services.">
  <section class="hero" aria-labelledby="h1">
    <Fig k="salle-noir-blanc" class="hero__pic" sizes="100vw" eager ratio="auto" />
    <div class="container hero__in">
      <div class="plate">
        <h1 id="h1">Le 54, table de Dave</h1>
        <p class="lead">Cuisine de saison et de marché, à deux pas de Namur.</p>
        <p class="plate__acts"><a class="btn" href={`${base}reservations`}>Réserver une table</a><a class="link" href={`${base}lacarte`}>Voir le menu</a></p>
      </div>
    </div>
  </section>

  <section class="statement container" aria-labelledby="st">
    <h2 id="st" class="statement__t">Une cuisine raffinée et savoureuse, qui va à l’essentiel.</h2>
    <div class="statement__side">
      <p class="dropcap">Michel et Véronique Collignon reprennent l’établissement avec leur fils Jonathan en 2010 et lui confèrent une dimension plus gastronomique. Le chef Jonathan Collignon propose une carte de saison fréquemment renouvelée.</p>
      <p><a class="link" href={`${base}a-propos`}>Le chef et la maison</a></p>
    </div>
  </section>

  <section class="menurows container" aria-labelledby="mn">
    <div class="menurows__head">
      <h2 id="mn">Le menu du moment</h2>
      <p class="lead">
        {menus.map((m, i) => <>{i > 0 && ' ou '}<span class="num">{m.nom}&nbsp;: {m.prix}</span></>)}
      </p>
      <p><a class="link" href={`${base}lacarte`}>Toute la carte</a></p>
    </div>
    <ul class="rows">
      {menu.map((m) => (
        <li class="row">
          <h3 class="row__t">{m.titre}</h3>
          {(m.ligne || m.prix) && <p class="row__l">{m.ligne}{m.prix && <span class="num row__p"> {m.prix}</span>}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="showcase" aria-label="Photographie : tartare">
    <Fig k="tartare" class="showcase__pic" sizes="100vw" ratio="21 / 9" label />
  </section>

  <section class="band band--2" aria-labelledby="hr">
    <div class="container visit">
      <div class="visit__head">
        <h2 id="hr">Horaires et adresse</h2>
        <p class="lead">{resto.rue}<br />{resto.ville}</p>
        <p><a class="link" href={resto.carte} rel="noopener">Voir sur la carte</a></p>
        <p class="visit__pr">Parking aisé en face, terrasse, accès pour personnes à mobilité réduite, chiens admis.</p>
      </div>
      <Horaires />
    </div>
  </section>

  <Reserve />
</Base>
