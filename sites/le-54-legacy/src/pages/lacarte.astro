---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import Reserve from '../components/Reserve.astro';
import { menu, menus, notesCarte } from '../data/site';
---
<Base page="lacarte" title="Menus du Le 54 : trois ou quatre services, à Dave" description="Le menu du moment du Le 54 : veau tonnato, bœuf wagyu A5, cochon de lait ou zarzuela, plaisir sucré. Trois services à 48 €, quatre à 65 €.">
  <header class="pagehead container">
    <h1>Menus</h1>
    <p class="lead">Le menu du moment, en trois ou quatre services.</p>
  </header>

  <section class="figures container" aria-label="Prix des menus">
    {menus.map((m) => (
      <p class="figures__i"><span class="figures__v num">{m.prix}</span><span class="figures__l">Menu {m.nom}</span></p>
    ))}
  </section>

  <section class="menupage container" aria-labelledby="mp">
    <h2 id="mp" class="visually-hidden">Le menu du moment</h2>
    <ul class="rows rows--menu">
      {menu.map((m) => (
        <li class="row">
          <h3 class="row__t">{m.titre}</h3>
          <div class="row__l">
            {m.ligne && <p>{m.ligne}{m.prix && <span class="num row__p"> {m.prix}</span>}</p>}
            {m.ou && <p class="row__ou">{m.ou}</p>}
            {m.options && <ul class="row__opt">{m.options.map((o) => <li class="num">{o}</li>)}</ul>}
          </div>
        </li>
      ))}
    </ul>
    <p class="menupage__note">{notesCarte.modif}</p>
    <p class="menupage__note">{notesCarte.allergies}</p>
  </section>

  <section class="showcase" aria-label="Photographie : plat">
    <Fig k="soupe-homard" class="showcase__pic" sizes="100vw" ratio="21 / 9" label />
  </section>

  <Reserve />
</Base>
