---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import Reserve from '../components/Reserve.astro';
import { resto, pratique } from '../data/site';
---
<Base page="a-propos" title="À propos de Le 54 : le chef Jonathan Collignon, à Dave" description="Le chef Jonathan Collignon vous invite à la découverte, à Dave, sur la rive droite de la Meuse, entre Dinant et Namur.">
  <header class="pagehead container" data-reveal>
    <h1>Qui sommes-nous&nbsp;?</h1>
    <p class="lead">Le chef Jonathan Collignon vous invite à la découverte, à Dave.</p>
  </header>

  <section class="split container" aria-label="La maison">
    <div class="split__text" data-reveal>
      <p class="dropcap">Si vous longez la rive droite de la Meuse entre Dinant et Namur, vous ne pourrez pas rater ce lieu qui fait partie intégrante du village depuis des décennies. Michel et Véronique Collignon reprennent l’établissement avec leur fils Jonathan en 2010 et lui confèrent une dimension plus gastronomique.</p>
      <p>Diplômé de l’École hôtelière provinciale de Namur, Jonathan est passé d’abord par Le Vivier d’Oies du chef Godelet&nbsp;; c’est lors d’un stage chez le chef Pauly du Coq aux Champs que la passion l’a définitivement gagné.</p>
      <p>Autodidacte, créatif, soucieux de promouvoir les artisans locaux, il propose une carte de saison fréquemment renouvelée. Sa cuisine, raffinée et savoureuse, va à l’essentiel.</p>
    </div>
    <Fig k="geste-dressage" class="split__pic" sizes="(min-width: 60rem) 50vw, 100vw" ratio="4 / 3" label />
  </section>

  <section class="facts container" aria-labelledby="fa">
    <h2 id="fa" data-reveal>Sur place</h2>
    <ul class="rows rows--facts">
      {pratique.map((p) => <li class="row"><p class="row__t row__t--s">{p}</p></li>)}
      <li class="row"><p class="row__t row__t--s">Gault&amp;Millau&nbsp;: 13,5/20 selon le site du restaurant</p></li>
      <li class="row"><p class="row__t row__t--s">resto.be&nbsp;: 9,2/10 sur 251 avis</p></li>
    </ul>
  </section>

  <Reserve />
</Base>
