---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Le 54" description="Cette page de Le 54 n’existe pas.">
  <header class="pagehead container">
    <h1>Page introuvable</h1>
    <p class="lead">Cette adresse ne mène à rien.</p>
    <p><a class="btn" href={base}>Retour à l’accueil</a></p>
  </header>
</Base>
