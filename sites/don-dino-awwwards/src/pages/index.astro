---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { jours, lisible, site, accesPratique } from '../data/site';
import { plat } from '../lib/plats';
import { u } from '../lib/url';
const pizzas = ['Margherita', 'Dino', 'Pescatora'].map(plat);
const pates = ['Spaghetti bolognaise', 'Lasagne maison à la bolognaise', 'Cannelloni ricotta et épinards'].map(plat);
---
<Base page="accueil">
  <section class="wrap grille hero" aria-labelledby="titre-accueil">
    <h1 class="hero__titre display display--mega" id="titre-accueil" data-split="lines" data-intro>Quatorze services par semaine.</h1>
    <div class="hero__bas">
      <p class="chapo">Brasserie, restaurant, pizzeria à Naninne, sur les hauteurs de Namur. Le patron est en salle, midi et soir, sept jours sur sept.</p>
      <div class="cta-groupe">
        <a class="cta" href={u('/reservation/')}>Réserver une table</a>
        <a class="cta cta--contour" href={site.telephoneHref}>Appeler le&nbsp;<span class="nw">{site.telephoneLisible}</span></a>
      </div>
      <p class="hero__marque"><span class="etat"><span class="horloge" aria-hidden="true"><span class="horloge__aiguille"></span></span><span data-service-label>Ouvert sept jours sur sept, midi et soir</span></span><span>{site.adresse.rue} {site.adresse.numero}, Naninne</span><span>26 pizzas dès 10,50&nbsp;€</span></p>
    </div>
    <div class="hero__media"><Photo cle="pizzaPlanche" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, 33vw" prioritaire /></div>
    <p class="hero__legende credit">{site.credit}</p>
  </section>

  <section class="papier semaine" aria-labelledby="titre-semaine">
    <div class="wrap">
      <div class="grille semaine__tete">
        <h2 class="semaine__titre display display--xl" id="titre-semaine" data-split="lines">Sept jours, deux services.</h2>
        <p class="semaine__note">Le midi de 12&nbsp;h à 14&nbsp;h&nbsp;30, le soir dès 18&nbsp;h. Les vendredis et samedis, le soir se prolonge jusqu’à 23&nbsp;h&nbsp;30.</p>
      </div>
      <div class="sem__cadre" data-sem>
      <span class="sem__filet" aria-hidden="true"></span>
      <ol class="sem" aria-label="Les quatorze services de la semaine">
        {jours.map((j, i) => (
          <li class="sem__jour" data-jour={i}>
            <span class="sem__nom">{j.nom}</span>
            <span class="sem__case" data-service={i * 2}><span class="sem__service">Midi</span><span class="sem__heures nw">{lisible(j.midi)}</span><span class="sem__fil" aria-hidden="true"></span></span>
            <span class={`sem__case${j.soirFin === '23:30' ? ' sem__case--tard' : ''}`} data-service={i * 2 + 1}><span class="sem__service">Soir</span><span class="sem__heures nw">{lisible(j.soir)}</span><span class="sem__fil" aria-hidden="true"></span></span>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <section class="wrap grille paire" aria-labelledby="titre-pizzas">
    <div class="paire__media cadre" data-reveal><Photo cle="jambonCru" sizes="(max-width: 640px) 100vw, 50vw" /></div>
    <div class="paire__texte">
      <h2 class="display display--l" id="titre-pizzas" data-split="lines">Les pizzas, du four à la table</h2>
      <p class="corps">Vingt-six pizzas à la carte, de la Margherita à la Pescatora.</p>
      <ul class="ligne-plats">
        {pizzas.map((p) => <li><span class="pl__nom">{p.nom}</span><span class="pl__prix eu nw">{p.prixTexte}</span><span class="pl__desc">{p.description}</span></li>)}
      </ul>
      <p><a class="lien" href={u('/carte/#pizzas')}>Toutes les pizzas</a></p>
    </div>
  </section>

  <section class="wrap grille trio" aria-labelledby="titre-pates">
    <h2 class="trio__titre display display--l" id="titre-pates" data-split="lines">Pâtes et gratinés maison</h2>
    <p class="corps trio__texte">Spaghetti, lasagne et cannelloni côtoient les escalopes, les poissons et les viandes grillées.</p>
    <div class="trio__photos">
      <div class="trio__ph cadre" data-reveal="clip"><Photo cle="spaghetti" sizes="(max-width: 640px) 78vw, 33vw" /></div>
      <div class="trio__ph cadre" data-reveal="clip" data-delay="0.08"><Photo cle="moules" sizes="(max-width: 640px) 78vw, 33vw" /></div>
      <div class="trio__ph cadre" data-reveal="clip" data-delay="0.16"><Photo cle="escalope" sizes="(max-width: 640px) 78vw, 33vw" /></div>
    </div>
    <ul class="ligne-plats trio__plats">
      {pates.map((p) => <li><span class="pl__nom">{p.nom}</span><span class="pl__prix eu nw">{p.prixTexte}</span>{p.description && <span class="pl__desc">{p.description}</span>}</li>)}
    </ul>
    <p class="trio__lien"><a class="lien" href={u('/carte/')}>Les 115 plats de la carte</a></p>
  </section>

  <section class="wrap grille salle" aria-labelledby="titre-salle">
    <h2 class="salle__titre display display--xl" id="titre-salle" data-split="lines">Le patron est en salle.</h2>
    <div class="salle__a cadre" data-reveal><Photo cle="salle" sizes="(max-width: 640px) 100vw, 40vw" /></div>
    <div class="salle__texte">
      <p class="chapo">{site.patron}, dit « Dino », mène la maison à Naninne depuis 2014, avec un accueil sicilien et de la bonne humeur.</p>
      <p><a class="lien" href={u('/histoire/')}>L’histoire de la maison</a></p>
    </div>
    <div class="salle__b cadre" data-reveal><Photo cle="four" sizes="(max-width: 640px) 100vw, 40vw" /></div>
  </section>

  <section class="papier" aria-labelledby="titre-pratique">
    <div class="wrap grille pratique">
      <h2 class="pratique__titre display display--l" id="titre-pratique" data-split="lines">Venir à Naninne</h2>
      <ul class="pratique__liste">
        {accesPratique.map((a) => <li><h3>{a.titre}</h3><p>{a.texte}</p></li>)}
        <li><h3>Groupes</h3><p>Anniversaires, fêtes et privatisation, sur devis. <a class="lien" href={site.groupesUrl} rel="noopener">Voir sur dondino.be</a></p></li>
      </ul>
    </div>
  </section>
</Base>
