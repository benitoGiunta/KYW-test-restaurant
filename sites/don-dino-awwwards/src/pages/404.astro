---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’est plus à la carte. Retrouvez Don Dino à Naninne, ouvert midi et soir 7 jours sur 7, et réservez votre table.">
  <section class="wrap grille perdu" aria-labelledby="titre-404">
    <h1 class="perdu__titre display display--mega" id="titre-404">Cette page n’est plus à la carte.</h1>
    <div class="perdu__bas">
      <p class="chapo">Le service continue : deux fois par jour, sept jours sur sept.</p>
      <div class="cta-groupe">
        <a class="cta" href={import.meta.env.BASE_URL}>Retour à l’accueil</a>
        <a class="cta cta--contour" href={u('/carte/')}>Voir la carte</a>
      </div>
      <p class="petit">Ou appelez le <a class="lien nw" href={site.telephoneHref}>{site.telephoneLisible}</a>.</p>
    </div>
  </section>
</Base>
