---
import { jours, lisible } from '../data/site';
---
<ul class="horaires" aria-label="Horaires d’ouverture">
  {jours.map((j) => (
    <li>
      <span class="horaires__jour">{j.nom}</span>
      <span class="horaires__plages">
        <span class="nw"><span class="sr-only">Midi : </span>{lisible(j.midi)}</span>
        <span class="nw"><span class="sr-only">Soir : </span>{lisible(j.soir)}</span>
      </span>
    </li>
  ))}
</ul>
