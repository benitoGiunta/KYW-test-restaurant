---
// Terrasse et chalet d'hiver : faits du dossier (réservation dans le restaurant ou dans le chalet d'hiver, terrasse visible sur les photos).
// Places, saison et jours de la terrasse sont inconnus : non affichés.
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
const photos = [['/photos/terrasse-tables.webp', 'La terrasse'], ['/photos/facade-ete.webp', 'La façade en été'], ['/photos/facade-drone.webp', 'Dans le village']].map(([src, legende]) => ({ ...photoDe(src), legende }));
const hiver = [['/photos/chalet-hiver-table.webp', 'Le chalet d’hiver'], ['/photos/plateau-fondue.webp', 'La fondue'], ['/photos/fondue-table.webp', 'Autour du caquelon']].map(([src, legende]) => ({ ...photoDe(src), legende }));
---
<Base title="Terrasse et chalet d'hiver" description={`La terrasse et le chalet d'hiver de ${site.nom} à ${site.adresse.commune} : réservez dans le restaurant ou dans le chalet.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse</h1>
      <p class="lead">Dehors en été, dans le chalet en hiver. {g.chalet}</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Dehors, <em class="ital">sous la toile</em></h2>
      <p class="lead">Les longues tables de la terrasse se dressent devant la façade, au bord de la rue Basse, au cœur du village.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3, -2][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.legende}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--canard">
    <div class="wrap">
      <h2 class="section__titre">Le chalet <em>d'hiver</em></h2>
      <div class="maison__grille">
        <div class="prose">
          <p>Quand il fait froid, une table se réserve aussi dans le chalet d'hiver, tout en bois. C'est la saison des fondues, à partager autour du caquelon.</p>
          <p>Réservez en ligne ou appelez le restaurant au <a class="link" href={`tel:${site.telephone.replace(/\s+/g, '')}`}>{site.telephone}</a>.</p>
          <div class="actions"><a class="btn btn--lin" href={u('/reservation/')}>Réserver</a></div>
        </div>
        <div class="grille-photos">
          {hiver.map((p, i) => (
            <figure class="tirage" style={`--r:${[-4, 3, -2][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
              <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
              <figcaption>{p.legende}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
