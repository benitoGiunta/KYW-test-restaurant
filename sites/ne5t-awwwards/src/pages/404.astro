---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description="Cette page est introuvable : retour à l’accueil d’Intuition, NE5T Hôtel & Spa, à Namur." etat="404">
  <section class="wrap perdue">
    <h1 class="display">Celle-ci n’a laissé aucune impression.</h1>
    <p class="perdue__pierre">Pierre numéro 404 : introuvable, à remettre à sa place.</p>
    <div class="perdue__actions">
      <a class="btn btn--plein" href={u('/')}><span class="btn__txt">Revenir à l’accueil</span></a>
      <a class="btn" href={u('/carte/')}><span class="btn__txt">Lire la carte</span></a>
    </div>
  </section>
</Base>
