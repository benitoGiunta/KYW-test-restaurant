---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, impressions, formules, eur, faits, maison } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Gastronomie décomplexée à Namur" description="Intuition, la table du NE5T Hôtel & Spa à Namur : un menu qui change chaque mois, du lunch carte blanche à 50 €, dans une ancienne ferme en carré au-dessus de la Meuse.">
  <section class="hero wrap" data-section="hero">
    <p class="kicker" data-reveal="fade" data-intro>Restaurant du NE5T Hôtel &amp; Spa, Namur</p>
    <h1 class="display hero__t">Intuition</h1>
    <div class="g hero__row">
      <div class="hero__txt" data-reveal="up" data-intro data-delay="0.6">
        <p class="hero__lead">{site.invitation}</p>
        <p class="souple">Une gastronomie décomplexée, un menu qui change chaque mois, au rythme des saisons et des arrivages.</p>
        <div class="hero__actions">
          <a class="btn btn--plein" href={site.telephoneHref}><span class="btn__txt">Réserver au <span class="nb">{site.telephoneLisible}</span></span></a>
          <a class="btn" href={u('/carte/')}><span class="btn__txt">Voir le menu du mois</span></a>
        </div>
      </div>
      <figure class="hero__img" data-reveal="clip" data-intro data-delay="0.35">
        <div class="cadre" data-lueur><Photo cle="facadeNuit" haute sizes="(max-width: 900px) 100vw, 66vw" /></div>
      </figure>
    </div>
  </section>

  <section class="wrap enonce" aria-labelledby="t-enonce">
    <div class="g">
      <h2 id="t-enonce" class="display enonce__t">Une table confidentielle, au cœur d’un hôtel de charme. <em>Ici, on suit son intuition.</em></h2>
      <div data-reveal="up" class="seconde enonce__s">
        <p>Nico cuisine au fil des arrivages, d’une façon franche, sincère et intuitive. Manu s’occupe du vin et du rhum, et vous laisse aussi choisir votre flacon en cave.</p>
        <p>Le menu s’écrit en impressions : on commence par une phrase, on découvre le détail à table.</p>
      </div>
    </div>
  </section>

  <section class="section papier" aria-labelledby="t-index">
    <div class="wrap">
      <div class="g index__tete">
        <h2 id="t-index" class="display">Le menu du mois</h2>
        <p>Il est renouvelé chaque mois. Les plats se choisissent à table, les formules se paient par personne.</p>
      </div>
      <ol class="index">
        {impressions.map((i) => (
          <li>
            <h3 class="index__titre">{i.titre}</h3>
            <div class="index__plats">
              {i.plats.map((p) => <span class="plat">{p.nom}</span>)}
            </div>
          </li>
        ))}
      </ol>
      <div class="formules" data-reveal="up">
        {formules.map((f) => (
          <div class="formule">
            <p class="formule__nom">{f.nom}</p>
            <p class="formule__prix">{eur(f.prix)}</p>
            <p class="formule__vins">{f.vinsLabel ?? 'Sélection de vins à table'} : {eur(f.vins)}</p>
            <p class="formule__note">{f.note}</p>
          </div>
        ))}
      </div>
      <p class="suite-cta"><a class="btn" href={u('/carte/')}><span class="btn__txt">Lire la carte en détail</span></a></p>
    </div>
  </section>

  <section class="wrap mur" aria-label="Dans l’assiette et autour de la table">
    <div class="mur__grille">
      <figure data-reveal="clip" class="mur__a"><div class="cadre"><Photo cle="servicePlat" sizes="(max-width: 900px) 60vw, 40vw" /></div></figure>
      <figure data-reveal="clip" class="mur__b"><div class="cadre"><Photo cle="vin" sizes="(max-width: 900px) 40vw, 30vw" /></div></figure>
      <figure data-reveal="clip" class="mur__c"><div class="cadre"><Photo cle="dessert" sizes="(max-width: 900px) 40vw, 20vw" /></div></figure>
      <figure data-reveal="clip" class="mur__d"><div class="cadre"><Photo cle="poisson" sizes="(max-width: 900px) 60vw, 56vw" /></div><figcaption class="legende">{site.credit}</figcaption></figure>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="t-maison">
    <div class="g paire">
      <figure data-reveal="clip" class="paire__img"><div class="cadre"><Photo cle="facadeJour" sizes="(max-width: 900px) 100vw, 58vw" /></div></figure>
      <div class="paire__txt">
        <h2 id="t-maison" class="display">Une ferme en carré, pierre par pierre</h2>
        <div data-reveal="up" class="seconde">
          <p>Près de dix ans de rénovations, au-dessus de la Meuse, à deux pas de la citadelle. Certaines pierres ont été numérotées pour être reposées à l’identique.</p>
          <p><a class="lien" href={u('/histoire/')}>Découvrir la maison</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap faits" aria-labelledby="t-faits">
    <h2 id="t-faits" class="sr-only">Repères pratiques</h2>
    <div class="faits__liste">
      {faits.map((f) => (
        <div class="fait">
          <p class="fait__k">{f.k}</p>
          <p class="fait__v">{f.v}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
