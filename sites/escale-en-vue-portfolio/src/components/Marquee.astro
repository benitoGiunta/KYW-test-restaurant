---
// Marquee d'état : sans JS, les jours de service ; avec JS, « Ouvert » ou « Fermé » calculé depuis site.horaires (aucune date en dur).
import { site, guinguette, adresseLigne } from '../data/site';
const base = [guinguette.ouverture, site.saison.terminee ? `${site.saison.texte} : terminée` : site.saison.texte, adresseLigne(), `Réservation par ${site.reservation.outil}`];
const horaires = JSON.stringify(site.horaires.map((h) => ({ j: h.jour, c: h.creneaux })));
---
<aside class="marquee" data-marquee data-horaires={horaires} data-saison-terminee={site.saison.terminee ? site.saison.texte : undefined} aria-label="État du restaurant">
  <div class="marquee__piste">
    {[0, 1].map((k) => (
      <p class="marquee__groupe" aria-hidden={k === 1 ? 'true' : undefined}>
        <span class="marquee__etat" data-marquee-etat>{site.saison.terminee ? 'Saison terminée' : 'Horaires du jour'}</span>
        {base.map((t) => <span>{t}</span>)}
      </p>
    ))}
  </div>
</aside>
