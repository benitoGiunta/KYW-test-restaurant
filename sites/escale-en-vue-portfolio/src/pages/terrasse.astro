---
// La terrasse : toutes les tables sont dehors (dossier.md). Capacité, parking et événements inconnus : rien d'inventé.
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import Ornements from '../components/Ornements.astro';
import { site, guinguette as g, photoDe } from '../data/site';
import { asset } from '../lib/url';
const photos = ['table-panorama', 'bieres-trappistes', 'pres-transats'].map((n) => ({ ...photoDe(`/photos/${n}.webp`), n, cote: g.tirages.find((t) => t.src.includes(n))!.cote }));
---
<Base title="La terrasse" description={`La terrasse d'${site.nom} à Dave : toutes les tables sont dehors, face à la vallée, du jeudi soir au dimanche après-midi.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>Terrasse</h1>
      <p class="lead">Toutes les tables sont dehors, face à la vallée. On y vient du jeudi soir au dimanche après-midi, le temps d'une saison.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--canard is-flottant" style="--x:84%;--y:0%;--r:-8deg;--taille:130px" aria-hidden="true"><Objet id="parasol" classe="obj__svg" /></span>
    </div>
  </section>

  <section class="section section--corail">
    <div class="wrap manifeste__inner">
      <Ornements />
      <h2 style="font-size: var(--t-xl)">Dehors, <em class="ital">face à la vallée</em></h2>
      <p class="lead">{site.saison.texte}. La saison 2026 est terminée. Dates de la prochaine saison : à venir.</p>
      <ul role="list" style="display:flex;flex-wrap:wrap;gap:0.6em;justify-content:center;margin-top:calc(var(--u)*3)">
        {g.terrasse.points.map((t) => <li class="vege" style="font-size:var(--t-s);padding:0.4em 1em">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section__titre">À <em>savoir</em></h2>
      <div class="maison__grille">
        <div class="prose">
          <ul role="list">
            {g.terrasse.pratique.map((p) => <li>{p.texte}<span class="illu">{p.source}</span></li>)}
          </ul>
        </div>
        <div class="grille-photos">
          {photos.map((p, i) => (
            <figure class="tirage" style={`--r:${[-4, 3, -2][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
              <img src={asset(`/photos/s/${p.n}.webp`)} alt={p.alt} width={p.cote} height={p.cote} loading="lazy" decoding="async" />
              <figcaption>{p.alt.split(',')[0]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
