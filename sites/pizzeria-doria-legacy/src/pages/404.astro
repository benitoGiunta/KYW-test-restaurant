---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Pizzeria Doria" description="Cette page n’existe pas.">
  <section class="entete"><div class="container">
    <h1>Cette page n’existe pas.</h1>
    <p class="lead">Retournez à l’accueil ou ouvrez le menu.</p>
    <p><a class="btn btn--primary" href={base}>Accueil</a> <a class="btn" href={`${base}menu/`}>Menu 2026</a></p>
  </div></section>
</Base>
