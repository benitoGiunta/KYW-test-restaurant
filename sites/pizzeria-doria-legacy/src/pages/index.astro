---
import Base from '../layouts/Base.astro';
import Fin from '../components/Fin.astro';
import { resto, suggestions, midis, avis, groupesMenu, prix } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const n = (id: string) => groupesMenu.find((g) => g.id === id)!.cats.reduce((a, c) => a + c.plats.length, 0);
---
<Base page="accueil" title="Pizzeria Doria, pizzas et pâtes à Malonne, Namur" description="Pizzas, pâtes fraîches et viandes italiennes dans une ancienne banque de Malonne, à Namur. Sur place ou à emporter.">
  <section class="hero" aria-labelledby="hero-titre">
    <figure class="hero__photo" data-slot="hero" data-alt="Un pizzaiolo coupe une pizza garnie sur un plan de travail noir" data-placeholder="true">
      <img src={`${base}photos/pizza-coupe-1600.webp`} srcset={`${base}photos/pizza-coupe-800.webp 800w, ${base}photos/pizza-coupe-1600.webp 1600w`} sizes="100vw" width="1600" height="2400" alt="Un pizzaiolo coupe une pizza garnie sur un plan de travail" fetchpriority="high" decoding="async" />
    </figure>
    <div class="container hero__bas">
      <div class="hero__plaque">
        <h1 id="hero-titre">Pizzeria de famille, dans une ancienne banque.</h1>
        <p class="lead">Pizzas, pâtes fraîches et viandes italiennes, sur place ou à emporter.</p>
        <p class="hero__actions">
          <a class="btn btn--primary" href={resto.telHref}>Réserver une table</a>
          <a class="btn" href={resto.pizzy} rel="noopener">Commander à emporter</a>
        </p>
      </div>
    </div>
  </section>

  <section class="sect sugg" aria-labelledby="sugg-titre">
    <div class="container sugg__grille">
      <article class="card sugg__carte">
        <h2 id="sugg-titre">{suggestions.titre}</h2>
        <ul class="rows rows--card">
          {suggestions.lignes.map((l) => (
            <li class="row"><h3 class="row__nom">{l.nom}</h3><p class="row__desc">{l.desc}</p><span class="row__prix num">{prix(l.prix)}</span></li>
          ))}
        </ul>
      </article>
      <div class="tile emporter">
        <h2>Nos plats sont aussi à emporter</h2>
        <p class="lead">Pour toute commande à partir de 50 €, une bouteille de San Benedetto thé vert de 1,5 L ou une bouteille de vin rouge.</p>
        <p class="emporter__actions">
          <a class="btn btn--primary" href={resto.pizzy} rel="noopener">Commander en ligne</a>
          <a class="btn" href={resto.telHref}>Commander par téléphone</a>
          <a class="btn" href={resto.pdfEmporter} rel="noopener">Menu à emporter, PDF</a>
        </p>
      </div>
    </div>
  </section>

  <section class="sect midis" aria-labelledby="midis-titre">
    <div class="container">
      <div class="midis__tete">
        <h2 id="midis-titre">{midis.titre}</h2>
        <p class="lead">{midis.quand}</p>
      </div>
      <div class="midis__cols">
        <div>
          <h3>Cornets de pâtes</h3>
          <ul class="rows">{midis.cornets.map(([nom, p]) => <li class="row row--court"><h4 class="row__nom">{nom}</h4><span class="row__prix num">{prix(p)}</span></li>)}</ul>
        </div>
        <div>
          <h3>Paninis</h3>
          <ul class="rows">{midis.paninis.map(([nom, p]) => <li class="row row--court"><h4 class="row__nom">{nom}</h4><span class="row__prix num">{prix(p)}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sect bande carte-apercu" aria-labelledby="carte-titre">
    <div class="container carte-apercu__grille">
      <p class="figure carte-apercu__fig" aria-hidden="true">7,50&nbsp;€</p>
      <div class="carte-apercu__texte">
        <h2 id="carte-titre">Du marinara à 7,50 € à la Maradona à 18 €.</h2>
        <p class="lead">45 pizzas et pains, 15 pâtes, 6 viandes. Fior di latte sans lactose sur demande.</p>
        <ul class="carte-apercu__liens">
          <li><a class="tile tile--lien" href={`${base}menu/#pizza`}><span>Pizzas et pains</span><small>{n('pizza')} à la carte</small></a></li>
          <li><a class="tile tile--lien" href={`${base}menu/#pasta`}><span>Pasta</span><small>{n('pasta')} plats</small></a></li>
          <li><a class="tile tile--lien" href={`${base}menu/#viandes`}><span>Viandes et salades</span><small>{n('viandes')} plats</small></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sect histoire" aria-labelledby="hist-titre">
    <div class="container histoire__grille">
      <div class="histoire__texte">
        <h2 id="hist-titre">Une histoire de famille</h2>
        <p class="lead">La Pizzeria Doria est ouverte depuis octobre 2017 et est gérée par Rocco et Luigi, passionnés par la « cuisine italienne ».</p>
        {/* Hallmark · reworded "à changé" to "a changé" · coquille de l’original */}
        <p>Depuis mai 2023, le restaurant a changé d’adresse mais reste toujours dans la même idée… Vous régalez vos papilles avec une cuisine italienne et ses produits maison, parfois même bio.</p>
        <p><a class="btn" href={`${base}menu/`}>Voir le menu</a></p>
      </div>
      <figure class="histoire__photo ph ph--pate" data-slot="histoire" data-alt="Les mains d’une personne pétrissant une pâte à pizza sur un plan fariné" data-placeholder="true">
        <img src={`${base}photos/pate-1600.webp`} srcset={`${base}photos/pate-800.webp 800w, ${base}photos/pate-1600.webp 1600w`} sizes="(min-width: 60rem) 50vw, 100vw" width="1600" height="1066" alt="Les mains d’une personne pétrissant une pâte à pizza" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="sect avis" aria-labelledby="avis-titre">
    <div class="container">
      <h2 id="avis-titre">Les avis de nos clients</h2>
      <ul class="avis__liste">
        {avis.map((a) => (
          <li class="tile avis__item">
            <blockquote><h3>{a.titre}</h3><p>{a.texte}</p></blockquote>
            <p class="avis__qui">{a.qui}, publié sur Tripadvisor le {a.date}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sect coffres" aria-labelledby="coffres-titre">
    <div class="container coffres__grille">
      <figure class="coffres__photo ph ph--coffres" data-slot="coffres" data-alt="La salle des coffres : casiers métalliques d’une ancienne banque, tables en bois et chaises noires">
        <img src={`${base}photos/coffres-640.webp`} width="640" height="800" alt="La salle des coffres : casiers métalliques, tables en bois et chaises noires" loading="lazy" decoding="async" />
      </figure>
      <div class="coffres__texte">
        <h2 id="coffres-titre">À table dans la salle des coffres.</h2>
        {/* Hallmark · reworded "dans la région de Namur au sein Malonne" to "à Malonne, près de Namur" · lisibilité */}
        <p class="lead">Nous vous accueillons dans une salle spacieuse, à Malonne, près de Namur, dans une ancienne banque restaurée.</p>
        <p><a class="btn btn--primary" href="#reserver">Réserver votre table</a></p>
      </div>
    </div>
  </section>

  <Fin />
</Base>
