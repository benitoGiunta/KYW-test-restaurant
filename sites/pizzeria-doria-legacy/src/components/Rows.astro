---
import { prix, liste } from '../data/site';
interface Plat { nom: string; description: string | null; prix: number; placeholder?: boolean }
interface Props { plats: Plat[] }
const { plats } = Astro.props;
---
<ul class="rows">
  {plats.map((p) => (
    <li class="row">
      <h4 class="row__nom">{p.nom}</h4>
      {p.description && <p class="row__desc">{liste(p.description)}</p>}
      <span class="row__prix num">{prix(p.prix)}</span>
    </li>
  ))}
</ul>
