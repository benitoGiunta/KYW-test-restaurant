---
import KywFooter from '@kyw/footer';
import { resto, horaires } from '../data/site';
import '../styles/page.css';
interface Props { title: string; description: string; page: 'accueil' | 'menu' | 'vins' | 'contact' | '404'; jsonld?: Record<string, unknown>; }
const { title, description, page, jsonld } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = new URL(`${base}photos/coffres-640.webp`, Astro.site ?? 'https://kyw-test-restaurant.vercel.app').href;
const ogUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://kyw-test-restaurant.vercel.app').href;
const liens = [
  { id: 'accueil', href: base, label: 'Accueil' },
  { id: 'menu', href: `${base}menu/`, label: 'Menu 2026' },
  { id: 'vins', href: `${base}vins/`, label: 'Les vins' },
  { id: 'contact', href: `${base}contact/`, label: 'Contact' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content="Pizzeria Doria" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="La salle des coffres de la Pizzeria Doria : casiers métalliques, tables en bois et chaises noires" />
    <meta name="theme-color" content="#1a5b33" />
    <link rel="icon" href={`${base}photos/logo-doria.png`} type="image/png" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gabarito:wght@800&family=Manrope:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="slab">
      <div class="container slab__in">
        <a class="slab__marque" href={base} aria-label="Doria pizzeria, accueil">Doria <span>pizzeria</span></a>
        <button class="slab__burger" type="button" popovertarget="menu-principal" aria-label="Ouvrir le menu">Menu</button>
        <nav class="slab__nav" id="menu-principal" popover="auto" aria-label="Navigation principale">
          <ul>
            {liens.map((l) => <li><a href={l.href} aria-current={l.id === page ? 'page' : undefined}>{l.label}</a></li>)}
          </ul>
        </nav>
        <a class="btn btn--primary slab__cta" href={resto.telHref}>Réserver</a>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <section class="pied" aria-label="Coordonnées de la pizzeria">
      <div class="container pied__grille">
        <div class="pied__marque">
          <img src={`${base}photos/logo-doria.png`} width="120" height="120" alt="Doria Pizzeria" loading="lazy" />
        </div>
        <nav aria-label="Pied de page"><h2 class="pied__t">Le site</h2><ul>{liens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
        <div><h2 class="pied__t">Nous joindre</h2><ul><li><a href={resto.telHref}>{resto.tel}</a></li><li><a href={`mailto:${resto.email}`}>{resto.email}</a></li><li>{resto.adresse}, {resto.ville}</li></ul></div>
        <div><h2 class="pied__t">Nous suivre</h2><ul><li><a href={resto.facebook} rel="noopener">Facebook</a></li><li><a href={resto.tripadvisor} rel="noopener">Tripadvisor</a></li></ul></div>
        <div><h2 class="pied__t">Paiement</h2><ul><li>Payconiq</li><li>Espèces</li><li>TVA {resto.tva}</li></ul></div>
      </div>
      <p class="container pied__credits" data-credits>Photographies : Unsplash (Benu Marinescu, Hoja Studio, Nadya Spetnitskaya, Pinar Kucuk). Autres photos : Pizzeria Doria.</p>
    </section>
    <KywFooter base={import.meta.env.BASE_URL} />
    <script is:inline>
      (function () {
        var doc = document;
        /* Menu : le bouton annonce l'état réel du popover, Échap et clic dehors sont natifs */
        var nav = doc.getElementById('menu-principal'), burger = doc.querySelector('.slab__burger');
        if (nav && burger && nav.addEventListener) {
          nav.addEventListener('toggle', function (e) {
            var open = e.newState === 'open';
            burger.setAttribute('aria-expanded', open ? 'true' : 'false');
            burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
          });
        }
        /* Index de la carte : la pastille de la section ciblée est marquée (aria-current) */
        var pills = doc.querySelectorAll('.onglets a');
        function marque() { var h = location.hash; pills.forEach(function (a) { if (h && a.getAttribute('href') === h) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); }); }
        if (pills.length) { window.addEventListener('hashchange', marque); marque(); }
        /* Jour courant dans les casiers (fuseau de Namur), sans dire « ouvert » : l'heure n'est pas testée */
        var jours = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
        var nom = '';
        try { nom = new Intl.DateTimeFormat('fr-BE', { weekday: 'long', timeZone: 'Europe/Brussels' }).format(new Date()); } catch (e) { nom = jours[new Date().getDay()]; }
        nom = nom.charAt(0).toUpperCase() + nom.slice(1).toLowerCase();
        doc.querySelectorAll('.casier').forEach(function (c) {
          var dt = c.querySelector('dt');
          if (dt && dt.textContent.trim() === nom) { c.classList.add('casier--jour'); c.setAttribute('data-today', 'true'); }
        });
        /* Un seul reveal : les casiers et les avis, visibles sans script, sans mouvement réduit */
        var cibles = doc.querySelectorAll('[data-reveal]');
        var reduit = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!cibles.length) return;
        if (reduit || !('IntersectionObserver' in window)) { cibles.forEach(function (n) { n.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -4% 0px', threshold: 0 });
        cibles.forEach(function (n) { io.observe(n); });
        setTimeout(function () { cibles.forEach(function (n) { n.classList.add('is-in'); }); }, 4000);
      })();
    </script>
  </body>
</html>
