---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page du Café Fleuri n’existe pas : retour à la carte, à l’accueil ou à la réservation.">
  <section class="sec perdu" aria-labelledby="titre-404">
    <div class="wrap">
      <div class="plaque">
        <small>Rue des Fossés Fleuris, 5000 Namur</small>
        <h1 class="display" id="titre-404">Complet : cette page n’existe pas.</h1>
      </div>
      <p class="lead" style="font-size: var(--t-m); max-width: 30ch; margin-bottom: var(--serre)">Elle a débordé, et on ne l’a pas retrouvée. Le brunch, lui, est toujours au 38.</p>
      <div class="ctas">
        <a class="btn" href={u('/')}><span>Retour à l’accueil</span></a>
        <a class="btn btn--ghost" href={u('/carte/')}><span>La carte</span></a>
      </div>
    </div>
  </section>
</Base>
