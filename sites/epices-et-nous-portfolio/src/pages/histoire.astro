---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const cuisineM = photoDe('/photos/histoire-cuisine-nb-700.webp');
---
<Base title="Notre histoire" description={`Depuis 1999, Denis et Sophie Delvigne reçoivent leurs convives à Erpent : l'histoire d'Épices & Nous, de l'école hôtelière aux épices.`} preloadImage={{ href: cuisineM.src, media: '(max-width: 767px)' }}>
  <HeroPage titre="Notre histoire" chiffre={site.chiffres.ouverture} sur="Denis et Sophie Delvigne">
    <p>{site.histoire[0]}</p>
  </HeroPage>

  <section class="section" aria-label="Les deux fondateurs">
    <div class="wrap portraits">
      {site.equipe.map((m, i) => { const p = photoDe(m.photo); return (
        <article class="portrait">
          <figure class="portrait__photo" {...(i === 0 ? {} : { 'data-reveal': 'clip' })}>
            {i === 0 ? (
              <picture>
                <source media="(max-width: 767px)" srcset={asset(cuisineM.src)} />
                <img src={asset(p.src)} alt={m.photoAlt} width={p.largeur} height={p.hauteur} fetchpriority="high" decoding="async" />
              </picture>
            ) : (
              <img src={asset(p.src)} alt={m.photoAlt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
            )}
          </figure>
          <h2 class="portrait__nom">{m.nom}</h2>
          <p class="petite-cap">{m.role}</p>
          {m.bio.map((b) => <p class="portrait__bio">{b}</p>)}
        </article>
      ); })}
    </div>
  </section>

  <section class="section section--recit" aria-labelledby="recit-titre">
    <div class="wrap recit">
      <h2 class="petite-cap" id="recit-titre">Depuis 1999, à Erpent</h2>
      <div class="recit__texte stack">
        {site.histoire.slice(1).map((p) => <p data-reveal="fade">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="valeurs-titre">
    <div class="wrap equipe">
      <h2 class="petite-cap" id="valeurs-titre">Ce qui compte</h2>
      <ul class="valeurs" aria-label="Ce qui compte">
        {site.valeurs.map((v) => <li>{v}</li>)}
      </ul>
      <p class="actions"><a class="btn btn--primary" href={u('/reservation/')}>Réserver une table</a></p>
    </div>
  </section>
</Base>
