---
import Base from '../layouts/Base.astro';
import Chapitre from '../components/Chapitre.astro';
import { site, photoDe, horairesResume, adresseLigne, telHref, fourchette } from '../data/site';
import { u, asset } from '../lib/url';
const hero = photoDe('/photos/hero-table.webp');
const heroM = photoDe('/photos/hero-table-960.webp');
const c = site.chiffres;
const motsNom = site.nom.split(' ');
const motsCitation = site.citation.texte.split(' ');
const galerie = ['/photos/gal-saumon-nb.webp', '/photos/gal-girolles-nb.webp', '/photos/gal-passe-nb.webp', '/photos/gal-cocotte-nb.webp', '/photos/gal-poele-nb.webp'].map(photoDe);
const hauteurs = ['haute', 'basse', 'moyenne', 'haute', 'basse'];
const espaces = site.espaces.liste;
const menu = site.menus[0];
const resume = horairesResume();
const fe = fourchette('Entrées'), fp = fourchette('Plats'), fd = fourchette('Desserts');
---
<Base preloadImage={{ href: heroM.src, media: '(max-width: 767px)' }}>
  <section class="hero" data-hero aria-label="Accueil">
    <picture class="hero__photo">
      <source media="(max-width: 767px)" srcset={asset(heroM.src)} />
      <img src={asset(hero.src)} alt={hero.alt} width={hero.largeur} height={hero.hauteur} fetchpriority="high" decoding="async" data-critical />
    </picture>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="wrap hero__contenu">
      <p class="petite-cap hero__sur">{adresseLigne()}</p>
      <h1 class="hero__nom">{motsNom.map((m, i) => <><span class="hero__mot"><span class="hero__mot-in" data-hero-mot>{m}</span></span>{i < motsNom.length - 1 ? ' ' : ''}</>)}</h1>
      <p class="hero__accroche">{site.baseline}</p>
      <div class="actions">
        <a class="btn btn--primary" href={u('/reservation/')} data-magnetic="0.2">Réserver une table</a>
        <a class="lien lien--fleche" href="#services">Découvrir la maison</a>
      </div>
    </div>
  </section>

  <section class="guides" aria-label="Distinctions">
    <div class="wrap guides__inner">
      <p class="petite-cap guides__sur" data-reveal="fade">Dans les guides</p>
      <ul class="guides__liste">
        {site.distinctions.map((d) => (
          <li><a class="guides__item" href={d.url} rel="noopener"><span class="guides__nom">{d.nom}</span><span class="guides__detail">{d.detail}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Chapitre id="services" chiffre={c.services} photo={photoDe('/photos/chap-biche-1200.webp')} lien={{ href: u('/menu/'), label: 'Lire le menu' }}>
    <p>Un menu en {menu.services} services à {menu.prix}, {menu.description.charAt(0).toLowerCase() + menu.description.slice(1).replace(/\.$/, '')}.</p>
    <p>Au fil de la saison : tartare de saumon ou lentilles vertes du Puy, daurade royale ou noisettes de biche, tartelette au chocolat ou pomme caramélisée.</p>
  </Chapitre>

  <Chapitre id="prix" chiffre={c.prix} photo={photoDe('/photos/chap-sauce-1200.webp')} inverse filet lien={{ href: u('/carte/'), label: 'La carte et ses prix' }}>
    <p>{menu.prix} pour le menu {menu.services} services. À la carte, les entrées vont de {fe.min} à {fe.max} €, les plats de {fp.min} à {fp.max} € et les desserts de {fd.min} à {fd.max} €.</p>
    <p>Une cuisine française traditionnelle et créative, aux produits frais et locaux, relevée d'épices.</p>
  </Chapitre>

  <section class="citation" data-allume aria-labelledby="citation-source">
    <div class="wrap citation__wrap">
      <p class="petite-cap" id="citation-source">{site.citation.source}</p>
      <blockquote class="citation__texte" cite={site.citation.url}>
        <p>{motsCitation.map((m, i) => <><span class="mot">{m}</span>{i < motsCitation.length - 1 ? ' ' : ''}</>)}</p>
      </blockquote>
      <p class="citation__lien"><a class="lien" href={site.citation.url} rel="noopener">Lire la fiche Gault&amp;Millau</a></p>
    </div>
  </section>

  <Chapitre id="salles" chiffre={c.salles} photo={photoDe('/photos/chap-verriere-1200.webp')} lien={{ href: u('/maison/'), label: 'La maison' }}>
    <p>La salle avant, moderne et lumineuse, et la verrière à l'arrière, douce et feutrée. La terrasse ouvre dès que la météo le permet.</p>
    <p>{site.equipe[0].nom} en cuisine, {site.equipe[1].nom} en salle : une maison tenue en famille.</p>
  </Chapitre>

  <section class="onglets" data-onglets aria-labelledby="onglets-titre">
    <div class="onglets__photos" aria-hidden="true">
      {espaces.map((o, i) => { const ph = photoDe(o.photo); return <img class:list={['onglets__photo', { 'is-active': i === 0 }]} data-onglet-photo src={asset(ph.src)} alt="" width={ph.largeur} height={ph.hauteur} loading="lazy" decoding="async" />; })}
    </div>
    <div class="wrap onglets__contenu">
      <h2 class="petite-cap" id="onglets-titre">Deux espaces et une terrasse</h2>
      <p class="onglets__intro">{site.espaces.intro}</p>
      <div class="onglets__liste" role="tablist" aria-label="Les espaces de la maison">
        {espaces.map((o, i) => (
          <button class="onglet" role="tab" id={`onglet-${i}`} aria-controls={`panneau-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">
            <span class="onglet__nom">{o.nom}</span><span class="onglet__barre" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      {espaces.map((o, i) => (
        <div class="onglets__panneau" role="tabpanel" id={`panneau-${i}`} aria-labelledby={`onglet-${i}`} hidden={i !== 0}>
          <p>{o.texte}</p>
        </div>
      ))}
      <p class="onglets__action"><a class="btn" href={u('/maison/')}>Découvrir la maison</a><button class="onglets__pause lien" type="button" data-onglets-pause>Mettre en pause</button></p>
    </div>
  </section>

  <section class="galerie" aria-label="La cuisine en noir et blanc">
    <div class="galerie__bande">
      {galerie.map((p, i) => (
        <figure class:list={['galerie__item', `galerie__item--${hauteurs[i]}`]} data-reveal="up" data-delay={String(i * 0.08)} data-cursor="Voir">
          <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>

  <section class="cloture" data-rideau aria-labelledby="cloture-titre">
    <div class="rideau" aria-hidden="true"></div>
    <div class="wrap cloture__bloc">
      <p class="chiffre chiffre--centre" aria-hidden="true"><span data-compteur={String(c.ouverture.valeur)}>{c.ouverture.valeur}</span></p>
      <h2 class="petite-cap" id="cloture-titre"><span class="sr-only">{c.ouverture.libelle[0].toUpperCase() + c.ouverture.libelle.slice(1)} {c.ouverture.valeur}</span><span aria-hidden="true">{c.ouverture.libelle}</span></h2>
      <p class="cloture__sous">{c.ouverture.sousLibelle}.</p>
      <address class="cloture__adresse">{adresseLigne()}</address>
      <dl class="cloture__horaires">
        {resume.map((r) => <div><dt>{r.libelle}</dt><dd>{r.valeur}</dd></div>)}
      </dl>
      <div class="actions actions--centre">
        <a class="btn btn--primary" href={u('/reservation/')}>Réserver une table</a>
        <a class="lien" href={telHref()}>{site.telephone}</a>
      </div>
    </div>
  </section>
</Base>
