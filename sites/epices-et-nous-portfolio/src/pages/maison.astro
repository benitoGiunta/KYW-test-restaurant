---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site, photoDe, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const espaces = site.espaces.liste;
---
<Base title="La maison" description="La salle avant moderne et lumineuse, la verrière feutrée et la terrasse d'Épices & Nous, Chaussée de Marche à Erpent (Namur).">
  <HeroPage titre="La maison" chiffre={site.chiffres.salles} sur="Deux espaces et une terrasse">
    <p>{site.espaces.intro}</p>
  </HeroPage>

  <section class="section" aria-label="Les espaces de la maison">
    <div class="wrap offres">
      {espaces.map((o, i) => { const p = photoDe(o.photo); return (
        <article class:list={['offre', { 'offre--inverse': i % 2 === 1 }]}>
          <figure class="offre__photo" data-reveal="clip">
            <img src={asset(p.src)} alt={p.alt} width={p.largeur} height={p.hauteur} loading="lazy" decoding="async" />
          </figure>
          <div class="offre__texte">
            <h2 class="offre__nom">{o.nom}</h2>
            <p>{o.texte}</p>
          </div>
        </article>
      ); })}
    </div>
  </section>

  <section class="section section--contact" aria-labelledby="contact-titre">
    <div class="wrap contact">
      <h2 class="petite-cap" id="contact-titre">Choisir sa table</h2>
      <p class="contact__texte">Pour réserver, passez par le site du restaurant ou appelez-nous.</p>
      <p class="actions"><a class="btn btn--primary" href={u('/reservation/')}>Réserver</a> <a class="btn" href={telHref()}>Appeler le {site.telephone}</a></p>
    </div>
  </section>
</Base>
