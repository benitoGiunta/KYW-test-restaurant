---
import { horaires } from '../data/site';
---
<dl class="sched">
  {horaires.filter((j) => j.ouvert).map((j) => (
    <div class:list={['sched__row', !j.ouvert && 'is-closed']} data-jour={j.jour}>
      <dt>{j.nom}</dt>
      <dd>
        <time>{j.midi}</time> et <time>{j.soir}</time>
      </dd>
    </div>
  ))}
</dl>
