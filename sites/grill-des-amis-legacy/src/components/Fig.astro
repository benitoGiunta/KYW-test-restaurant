---
interface Props { src: string; alt: string; w: number; h: number; hero?: boolean; sizes?: string; pos?: string; class?: string; credit?: string }
const { src, alt, w, h, hero = false, sizes = '(max-width: 60rem) 100vw, 50vw', pos, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<figure class={`fig ${cls}`} data-slot={src} data-alt={alt} style={`aspect-ratio:${w} / ${h}`}>
  <img src={`${base}photos/${src}.webp`} width={w} height={h} alt={alt} sizes={sizes} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : undefined} decoding="async" style={pos ? `object-position:${pos}` : undefined} />
</figure>
