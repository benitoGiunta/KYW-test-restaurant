---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import { resto } from '../data/site';
---
<Base title="À propos, Le Grill des amiS à Namur" description="Une histoire de produits, de passion et d’amitié : l’A.D.N. du Grill des amiS à Namur, entre grillades, sauces maison et accords mets et vins." page="a-propos" image="mur-buches">
  <section class="pagehead" aria-labelledby="h-t">
    <div class="container pagehead__in">
      <div class="pagehead__txt">
        <h1 id="h-t">Notre A.D.N.</h1>
        <p class="lead">Une histoire de produits, de passion et d’amitié.</p>
      </div>
      <Fig class="pagehead__fig pagehead__fig--tall" src="mur-buches" w={1200} h={1800} hero sizes="(max-width: 60rem) 100vw, 40vw" alt="Table au mur de bûches empilées, salle du restaurant" />
    </div>
  </section>

  <section class="sec" aria-labelledby="h-v">
    <div class="container grid12">
      <h2 id="h-v" class="part__t">Ce que nous croyons</h2>
      <ul class="rows part__b">
        <li class="row"><h3 class="row__t">Des produits frais, faits maison</h3><p class="row__d">Sauces préparées sur place, frites maison, croquettes maison.</p></li>
        <li class="row"><h3 class="row__t">Une carte qui bouge</h3><p class="row__d">Les suggestions se renouvellent au rythme des arrivages et des envies du chef.</p></li>
        <li class="row"><h3 class="row__t">Pas que la viande</h3><p class="row__d">Des poissons soigneusement sélectionnés, des volailles, des plats qui rassemblent tous les convives.</p></li>
        <li class="row"><h3 class="row__t">Des accords mets et vins</h3><p class="row__d">Passionné de vin, le chef soigne les bouteilles qu’il propose pour sublimer chaque assiette.</p></li>
        <li class="row"><h3 class="row__t">L’accueil</h3><p class="row__d">Une attention particulière à l’accueil, au sourire et à chaque détail.</p></li>
      </ul>
    </div>
  </section>

  <section class="sec sec--tight" aria-label="Terrasse">
    <div class="container">
      <Fig class="wide" src="terrasse" w={1600} h={1065} sizes="(max-width: 90rem) 100vw, 1440px" pos="50% 55%" alt="Terrasse avec chaises colorées devant le restaurant" />
      <p class="small cap">La terrasse, devant le restaurant. Intérieur climatisé.</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-r">
    <div class="container grid12 offer">
      <div class="offer__txt">
        <h2 id="h-r">Venez partager notre passion.</h2>
        <p class="offer__act"><a class="btn btn--primary" href={resto.reserver} rel="noopener">Réserver</a></p>
      </div>
    </div>
  </section>
</Base>
