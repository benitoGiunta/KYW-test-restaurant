---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import { resto } from '../data/site';
---
<Base title="Traiteur et barbecues, Le Grill des amiS à Namur" description="Menus sur mesure, service clé en main et barbecues premium livrés chez vous : le traiteur du Grill des amiS, au départ de Namur." page="traiteur" image="viande-tranchee">
  <section class="pagehead" aria-labelledby="h-t">
    <div class="container pagehead__in">
      <div class="pagehead__txt">
        <h1 id="h-t">Traiteur et prestations en extérieur</h1>
        <p class="lead">Le Grill des amis se déplace chez vous, pour tous vos événements.</p>
        <p class="pagehead__act"><a class="btn btn--primary" href={resto.telHref}>Appeler le {resto.tel}</a></p>
      </div>
      <Fig class="pagehead__fig" src="viande-tranchee" w={1800} h={1200} hero sizes="(max-width: 60rem) 100vw, 55vw" alt="Viande rouge tranchée sur un plat, purée orange" />
    </div>
  </section>

  <section class="sec" aria-labelledby="h-o">
    <div class="container grid12">
      <h2 id="h-o" class="part__t">Trois façons de recevoir</h2>
      <ul class="rows part__b">
        <li class="row"><h3 class="row__t">Menus sur mesure</h3><p class="row__d">De la formule trois services aux buffets barbecue premium, personnalisables selon vos envies et votre budget.</p></li>
        <li class="row"><h3 class="row__t">Service clé en main</h3><p class="row__d">Préparation, cuisson, service à table ou buffet, et même la vaisselle si nécessaire.</p></li>
        <li class="row"><h3 class="row__t">Barbecues premium</h3><p class="row__d">Livrés et préparés en direct chez vous, avec matériel et équipes dédiés.</p></li>
      </ul>
    </div>
  </section>

  <section class="sec well grained" aria-labelledby="h-c">
    <div class="container grid12 offer">
      <div class="offer__txt">
        <h2 id="h-c">De la conception du menu au service.</h2>
        <p class="lead">Notre équipe vous accompagne, pour que vous profitiez de votre événement sans souci.</p>
        <p class="offer__act"><a class="btn btn--primary" href={resto.telHref}>Appeler le {resto.tel}</a></p>
      </div>
    </div>
  </section>
</Base>
