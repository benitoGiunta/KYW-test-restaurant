---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable, Le Grill des amiS" description="Cette page n’existe pas. Retour à l’accueil ou à la carte du Grill des amiS." page="404">
  <section class="pagehead" aria-labelledby="h-t">
    <div class="container pagehead__in pagehead__in--solo">
      <div class="pagehead__txt">
        <h1 id="h-t">Page introuvable</h1>
        <p class="lead">Cette page n’existe pas ou plus.</p>
        <p class="pagehead__act">
          <a class="btn btn--primary" href={base}>Accueil</a>
          <a class="btn" href={`${base}carte/`}>La carte</a>
        </p>
      </div>
    </div>
  </section>
</Base>
