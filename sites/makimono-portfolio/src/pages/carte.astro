---
import Base from '../layouts/Base.astro';
import Affiche from '../components/Affiche.astro';
import Bento from '../components/Bento.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
const tons: ('rouge' | 'jaune' | 'vert')[][] = [['rouge', 'jaune', 'vert'], ['vert', 'rouge', 'jaune'], ['jaune', 'vert', 'rouge']];
const bentos = site.carte.filter((c) => c.format === 'bento');
const listes = site.carte.filter((c) => c.format === 'liste');
---
<Base title="La carte" description={`La carte de ${site.nom} à ${site.adresse.commune} : uramaki signatures, nigiri flambés, poké bowls, Fast Box et Creative Box, accompagnements, desserts et boissons.`} fin="rouge">
  <Affiche tone="jaune" plein label="titre">
    <div class="wrap">
      <h1 id="titre" class="display display--mega affiche__titre" data-split="chars" data-intro>La carte</h1>
      <p class="lead">Rolls, nigiri et poké bowls, à déguster sur place ou à emporter. Pour un roll qui n’existe pas encore, passez par <a class="link" href={u('/composer/')}>Create.Your.Roll</a>.</p>
    </div>
  </Affiche>

  <Affiche tone="creme" prev="jaune" label="plats-titre">
    <div class="wrap stack" style="--u: calc(var(--gutter) * 2)">
      <h2 id="plats-titre" class="sr-only">Rolls, nigiri et poké bowls</h2>
      {bentos.map((c, i) => (
        <div>
          <h3 class="display display--xl affiche__chapeau" data-split="words">{c.categorie}</h3>
          {c.note && <p class="lead" style="margin-bottom: var(--gutter)">{c.note}</p>}
          <Bento plats={c.plats} tones={tons[i % tons.length]} />
        </div>
      ))}
    </div>
  </Affiche>

  <Affiche tone="vert" prev="creme" label="formules-titre">
    <div class="wrap">
      <h2 id="formules-titre" class="display display--mega affiche__titre" data-split="chars">Les boxes</h2>
      <div class="formules" data-claque>
        {site.menus.map((m) => (
          <article class="formule">
            <div>
              <h3>{m.nom}</h3>
              <p style="margin-top: var(--u)">{m.description}</p>
            </div>
            <p class="formule__prix">{m.prix}</p>
          </article>
        ))}
      </div>
    </div>
  </Affiche>

  <Affiche tone="creme" prev="vert" label="complements-titre">
    <div class="wrap stack" style="--u: calc(var(--gutter) * 2)">
      <h2 id="complements-titre" class="display display--xl affiche__titre" data-split="words">Et avec ça ?</h2>
      <div class="listes">
        {listes.map((c) => (
          <section class="liste" aria-labelledby={`l-${c.categorie.length}-${c.categorie.charCodeAt(0)}`}>
            <h3 id={`l-${c.categorie.length}-${c.categorie.charCodeAt(0)}`}>{c.categorie}</h3>
            <ul role="list">
              {c.plats.map((p) => (
                <li>
                  <span class="liste__nom">{p.nom}{p.description && <small>{p.description}</small>}</span>
                  <span class="liste__prix">{p.prix}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </Affiche>

  <Affiche tone="rouge" prev="creme" label="cta-titre">
    <div class="wrap">
      <h2 id="cta-titre" class="display display--mega affiche__titre" data-split="chars">On commande ?</h2>
      <div class="actions">
        <a class="btn btn--primary" href={u('/commander/')}>Commander</a>
        <a class="btn" href={u('/venir/')}>Venir sur place</a>
      </div>
    </div>
  </Affiche>
</Base>
