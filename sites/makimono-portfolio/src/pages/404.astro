---
import Base from '../layouts/Base.astro';
import Affiche from '../components/Affiche.astro';
import { u } from '../lib/url';
---
<Base title="Affiche arrachée" description="Cette page n’existe pas (erreur 404)." fin="rouge">
  <Affiche tone="rouge" plein label="titre">
    <div class="wrap">
      <p class="display display--mega display--contour" aria-hidden="true" data-split="chars" data-intro>404</p>
      <h1 id="titre" class="display display--xl affiche__titre" data-split="words" data-intro data-delay="0.2">Affiche arrachée</h1>
      <p class="hero__baseline">Cette page n’est plus collée au mur. Le reste du restaurant est toujours là.</p>
      <div class="actions hero__actions" data-reveal="up" data-intro data-delay="0.5">
        <a class="btn btn--primary" href={u('/')}>Retour à l’accueil</a>
        <a class="btn" href={u('/carte/')}>La carte</a>
      </div>
    </div>
  </Affiche>
</Base>
