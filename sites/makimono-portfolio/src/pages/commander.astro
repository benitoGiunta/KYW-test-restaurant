---
import Base from '../layouts/Base.astro';
import Affiche from '../components/Affiche.astro';
import Bento from '../components/Bento.astro';
import { site, telHref } from '../data/site';
import { u } from '../lib/url';
const boxes = site.menus.map((m) => ({ nom: m.nom, description: m.description, prix: m.prix, placeholder: false }));
---
<Base title="Commander" description={`Commander chez ${site.nom} à ${site.adresse.commune} : en ligne pour le retrait ou la livraison, Fast Box, Creative Box, traiteur et événements dans un rayon de 30 km.`} fin="vert">
  <Affiche tone="jaune" plein label="titre">
    <div class="wrap">
      <h1 id="titre" class="display display--mega display--mot affiche__titre" data-split="chars" data-intro>Commander</h1>
      <p class="lead">Retrait ou livraison : les rolls et les bowls de la carte, chez vous.</p>
      <div class="actions hero__actions" data-reveal="up" data-intro data-delay="0.5">
        {site.commande.map((c, i) => <a class:list={['btn', i === 0 && 'btn--primary']} href={c.url} rel="noopener">{c.nom}</a>)}
      </div>
    </div>
  </Affiche>

  <Affiche tone="rouge" prev="jaune" label="etapes-titre">
    <div class="wrap">
      <h2 id="etapes-titre" class="display display--xl affiche__titre" data-split="words">En trois gestes</h2>
      <div class="etapes">
        <ol data-cercles class="etapes__trois">
          {site.etapes.map((e) => <li><span class="cercle" aria-hidden="true"></span><div><strong>{e.titre}</strong><p>{e.texte}</p></div></li>)}
        </ol>
      </div>
    </div>
  </Affiche>

  <Affiche tone="creme" prev="rouge" label="boites-titre">
    <div class="wrap">
      <h2 id="boites-titre" class="display display--mega affiche__titre" data-split="chars">Les boxes</h2>
      <Bento plats={boxes} tones={['rouge', 'jaune']} />
      <div class="section__pied">
        <p class="lead">Ou toute la carte, en ligne ou sur place.</p>
        <a class="btn btn--primary" href={u('/carte/')}>La carte</a>
      </div>
    </div>
  </Affiche>

  <Affiche tone="vert" prev="creme" label="traiteur-titre">
    <div class="wrap">
      <h2 id="traiteur-titre" class="display display--xl affiche__titre" data-split="words">{site.traiteur.titre}</h2>
      <p class="lead" style="margin-bottom: var(--gutter)">{site.traiteur.texte}</p>
      <div class="actions">
        <a class="btn btn--primary" href={`mailto:${site.email.valeur}`}>Écrire à Makimono</a>
        <a class="btn" href={telHref()}>{site.telephone}</a>
      </div>
    </div>
  </Affiche>
</Base>
