---
import { site } from '../data/site';
import { u } from '../lib/url';
const liens = [
  { href: u('/carte/'), label: 'La carte' },
  { href: u('/composer/'), label: 'Composer' },
  { href: u('/commander/'), label: 'Commander' },
  { href: u('/venir/'), label: 'Venir' },
];
const ici = Astro.url.pathname.replace(/\/+$/, '');
const courant = (href: string) => (href.replace(/\/+$/, '') === ici ? 'page' : undefined);
// Repli sans JavaScript de la pastille ; le driver « ouvert » (drivers.ts) calcule l'état réel.
const horairesJson = JSON.stringify(site.horaires.map((h) => h.creneaux));
---
<header class="header" data-header>
  <div class="header__inner">
    <a class="header__brand" href={u('/')} aria-current={courant(u('/'))}>{site.nom}</a>
    <p class="pastille" data-ouvert data-horaires={horairesJson}>Midi et soir, dim. le soir</p>
    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
    </nav>
    <button class="header__burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>Menu</button>
  </div>
</header>
<nav class="menu" id="menu" aria-label="Navigation mobile" data-menu>
  <a href={u('/')} aria-current={courant(u('/'))}>Accueil</a>
  {liens.map((l) => <a href={l.href} aria-current={courant(l.href)}>{l.label}</a>)}
  <p class="pastille pastille--menu" data-ouvert data-horaires={horairesJson}>Midi et soir, dim. le soir</p>
</nav>
