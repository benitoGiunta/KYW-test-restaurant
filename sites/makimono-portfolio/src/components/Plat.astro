---
// Le roll composé dessiné en 5 couches (aplats de la palette, filet ink, ombre dure). Chaque couche porte
// data-couche="01..05" : le driver « empile » (src/motion/drivers.ts) ne lit que cet attribut, de sorte qu'un client
// qui fournit 5 PNG détourés remplace les <g> par des <img data-couche> sans toucher au code.
interface Props { class?: string; id?: string; title: string }
const { class: cls = '', id, title } = Astro.props;
---
<svg class:list={['plat', cls]} id={id} viewBox="0 0 520 420" role="img" aria-label={title}>
  <title>{title}</title>
  <g data-couche="01">
    <ellipse cx="268" cy="286" rx="232" ry="92" fill="var(--ink)" />
    <ellipse cx="260" cy="278" rx="232" ry="92" fill="var(--rouge)" stroke="var(--ink)" stroke-width="4" />
    <ellipse cx="260" cy="278" rx="168" ry="64" fill="none" stroke="var(--creme)" stroke-width="4" />
  </g>
  <g data-couche="02">
    <circle cx="190" cy="262" r="38" fill="var(--ink)" stroke="var(--ink)" stroke-width="4" />
    <circle cx="190" cy="262" r="30" fill="var(--creme)" />
    <circle cx="262" cy="236" r="38" fill="var(--ink)" stroke="var(--ink)" stroke-width="4" />
    <circle cx="262" cy="236" r="30" fill="var(--creme)" />
    <circle cx="334" cy="262" r="38" fill="var(--ink)" stroke="var(--ink)" stroke-width="4" />
    <circle cx="334" cy="262" r="30" fill="var(--creme)" />
    <circle cx="262" cy="296" r="38" fill="var(--ink)" stroke="var(--ink)" stroke-width="4" />
    <circle cx="262" cy="296" r="30" fill="var(--creme)" />
  </g>
  <g data-couche="03">
    <circle cx="190" cy="262" r="17" fill="var(--jaune)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="262" cy="236" r="17" fill="var(--jaune)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="334" cy="262" r="17" fill="var(--jaune)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="262" cy="296" r="17" fill="var(--jaune)" stroke="var(--ink)" stroke-width="3" />
  </g>
  <g data-couche="04">
    <circle cx="183" cy="257" r="6" fill="var(--rouge)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="197" cy="267" r="5" fill="var(--creme)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="255" cy="231" r="6" fill="var(--rouge)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="269" cy="241" r="5" fill="var(--creme)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="327" cy="257" r="6" fill="var(--rouge)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="341" cy="267" r="5" fill="var(--creme)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="255" cy="291" r="6" fill="var(--rouge)" stroke="var(--ink)" stroke-width="3" />
    <circle cx="269" cy="301" r="5" fill="var(--creme)" stroke="var(--ink)" stroke-width="3" />
  </g>
  <g data-couche="05">
    <path d="M170 200 q20 -26 40 0 t40 0 t40 0 t40 0" fill="none" stroke="var(--jaune)" stroke-width="7" stroke-linecap="round" />
    <path d="M200 340 q16 -18 32 0 t32 0 t32 0 t32 0" fill="none" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
    <circle cx="176" cy="250" r="3.2" fill="var(--ink)" />
    <circle cx="204" cy="272" r="3.2" fill="var(--ink)" />
    <circle cx="250" cy="222" r="3.2" fill="var(--ink)" />
    <circle cx="278" cy="246" r="3.2" fill="var(--ink)" />
    <circle cx="322" cy="250" r="3.2" fill="var(--ink)" />
    <circle cx="350" cy="272" r="3.2" fill="var(--ink)" />
    <circle cx="244" cy="302" r="3.2" fill="var(--ink)" />
    <circle cx="280" cy="310" r="3.2" fill="var(--ink)" />
  </g>
</svg>
