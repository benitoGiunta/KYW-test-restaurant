---
import KywFooter from '@kyw/footer';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import { resto, base, horaires } from '../data/site';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: resto.siteActuel,
  telephone: '+32483038847', email: resto.email, servesCuisine: ['Sushi', 'Uramaki', 'Poké bowl'],
  address: { '@type': 'PostalAddress', streetAddress: `${resto.adresse.rue} ${resto.adresse.numero}`, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
  sameAs: [resto.facebook, resto.instagram],
  openingHoursSpecification: horaires.flatMap((j) => [j.midi, j.soir].filter(Boolean).map((s) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: j.jour === 'Lundi' ? 'Monday' : j.jour === 'Mardi' ? 'Tuesday' : j.jour === 'Mercredi' ? 'Wednesday' : j.jour === 'Jeudi' ? 'Thursday' : j.jour === 'Vendredi' ? 'Friday' : j.jour === 'Samedi' ? 'Saturday' : 'Sunday', opens: s!.de, closes: s!.a }))),
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={resto.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}photos/13-nigiri-saumon-flambe.webp`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ultra&family=Chivo:wght@400;500;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={ld} />
    <style is:global>@import "../styles/page.css";</style>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu">
      <slot />
    </main>
    <Pied />
    <KywFooter base={base} />
    <script is:inline>
      (function () {
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var root = document.documentElement;
        var tl = document.querySelector('[data-onglets]');
        if (tl) {
          var tabs = Array.prototype.slice.call(tl.querySelectorAll('[role=tab]'));
          var sel = function (t, focus, anim) {
            tabs.forEach(function (x) {
              var on = x === t, p = document.getElementById(x.getAttribute('aria-controls'));
              x.setAttribute('aria-selected', on ? 'true' : 'false'); x.tabIndex = on ? 0 : -1;
              p.hidden = !on;
              if (on && anim && !rm) { p.classList.remove('entre'); void p.offsetWidth; p.classList.add('entre'); p.addEventListener('animationend', function () { p.classList.remove('entre'); }, { once: true }); }
            });
            if (focus) t.focus();
          };
          tabs.forEach(function (t, i) {
            t.addEventListener('click', function () { sel(t, false, true); });
            t.addEventListener('keydown', function (e) {
              var n = e.key === 'ArrowRight' ? (i + 1) % tabs.length : e.key === 'ArrowLeft' ? (i + tabs.length - 1) % tabs.length : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
              if (n > -1) { e.preventDefault(); sel(tabs[n], true, true); }
            });
          });
          sel(tabs[0], false, false);
        }
        /* Menu mobile : un clic sur un lien referme le popover (un <a> n'a pas de popovertarget) */
        var pop = document.getElementById('menu-mobile');
        if (pop && pop.hidePopover) pop.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a')) pop.hidePopover(); });
        /* Jour courant dans les horaires (Europe/Brussels) */
        try {
          var jour = new Intl.DateTimeFormat('fr-BE', { weekday: 'long', timeZone: 'Europe/Brussels' }).format(new Date()).toLowerCase();
          var ligne = document.querySelector('.sched__jour[data-jour="' + jour + '"]');
          if (ligne) {
            ligne.setAttribute('aria-current', 'date');
            var dd = ligne.querySelector('dd'), tag = document.createElement('span');
            tag.className = 'auj'; tag.textContent = 'Aujourd’hui'; dd.appendChild(tag);
          }
        } catch (e) {}
        /* Lien de nav actif : la dernière section dépassée sous la nav */
        var liens = Array.prototype.slice.call(document.querySelectorAll('.nav a[href*="#"]'));
        var cibles = Array.prototype.slice.call(document.querySelectorAll('main section[id], #evenement'));
        if (liens.length && cibles.length && document.querySelector('.hero')) {
          var maj = function () {
            var cur = null;
            cibles.forEach(function (c) { if (c.getBoundingClientRect().top <= 120) cur = c; });
            if (cur && cur.id === 'livraison' && document.getElementById('evenement').getBoundingClientRect().top <= 120) cur = document.getElementById('evenement');
            liens.forEach(function (a) {
              if (cur && a.hash === '#' + cur.id) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
            });
          };
          var tick = false;
          window.addEventListener('scroll', function () { if (!tick) { tick = true; requestAnimationFrame(function () { tick = false; maj(); }); } }, { passive: true });
          maj();
        }
        /* Un seul reveal : blocs de structure, une fois, sans effet si mouvement réduit ou sans observateur */
        var rev = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        if (rev.length && 'IntersectionObserver' in window && !rm) {
          try {
            var io = new IntersectionObserver(function (es) {
              es.forEach(function (e) {
                if (e.isIntersecting || e.boundingClientRect.top < 0) { e.target.classList.add('is-in'); io.unobserve(e.target); }
              });
            }, { rootMargin: '0px 0px -8% 0px' });
            rev.forEach(function (el) { io.observe(el); });
            root.classList.add('reveal-on');
          } catch (e) { root.classList.remove('reveal-on'); }
        }
      })();
    </script>
  </body>
</html>
