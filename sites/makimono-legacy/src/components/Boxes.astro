---
import { boxes } from '../data/site';
---
<section class="section boxes" id="boxes" aria-labelledby="titre-boxes">
  <div class="container">
    <div class="tete">
      <h2 id="titre-boxes">Les boxes</h2>
      <p class="lead">Seize pièces, à partager ou pas.</p>
    </div>
    <ul class="lignes lignes--gros">
      {boxes.map((b) => (
        <li class="boite">
          <h3>{b.nom}</h3>
          <p>{b.texte}</p>
          <span class="boite__prix num">{b.prix}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
