---
import { resto, photos } from '../data/site';
const f = photos.hero;
---
<section class="hero" aria-labelledby="titre-hero">
  <img class="hero__img" src={f.src} srcset={`${f.src800} 800w, ${f.src} 1600w`} sizes="100vw" width={f.w} height={f.h} alt={f.alt} fetchpriority="high" decoding="async" />
  <div class="container hero__in">
    <div class="hero__plaque">
      {/* Hallmark · reworded "Creative uramaki made with love" to "Des uramaki créatifs, faits avec amour" · la copie du site est en anglais, l'original reste en signature du pied */}
      <h1 id="titre-hero">Des uramaki créatifs, faits avec amour</h1>
      <p class="lead">Rolls, nigiri et poké bowls, sur place ou à emporter, à Namur.</p>
      <div class="actions">
        <a class="btn" href={resto.commande}>Commander en ligne</a>
        <a class="lien" href="#carte">Voir la carte</a>
      </div>
    </div>
  </div>
</section>
