---
import { resto } from '../data/site';
---
<section class="pied" aria-label="Coordonnées de Makimono">
  <div class="container pied__in">
    <p class="pied__mot">{resto.baseline}.</p>
    <div class="pied__cols">
      <p>{resto.adresse.rue} {resto.adresse.numero}, {resto.adresse.cp} {resto.adresse.ville}</p>
      <p><a href={resto.tel}>{resto.telAffiche}</a></p>
      <p><a href={resto.facebook} rel="noopener">Facebook</a> <a href={resto.instagram} rel="noopener">Instagram</a></p>
      <p class="pied__credits" data-credits>Photos : Makimono.</p>
    </div>
  </div>
</section>
