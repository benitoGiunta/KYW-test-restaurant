---
import { galerie } from '../data/site';
---
<section class="section galerie" id="galerie" aria-labelledby="titre-galerie">
  <div class="container">
    <div class="tete">
      <h2 id="titre-galerie">Photos</h2>
    </div>
    <div class="bento">
      {galerie.map((g) => (
        <figure class={`tuile ${g.cls}`}>
          <img src={g.src} srcset={`${g.src800} 800w, ${g.src} 1600w`} sizes="(min-width: 60rem) 50vw, 100vw" width={g.w} height={g.h} alt={g.alt} loading="lazy" decoding="async" />
          <figcaption>{g.legende}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
