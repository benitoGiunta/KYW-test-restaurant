---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Dumont Bouge" description="Cette page n’existe pas : retrouvez l’accueil, la carte ou la réservation de Dumont Bouge.">
  <section class="section" aria-labelledby="h1">
    <div class="container">
      <h1 id="h1">Cette page n’existe pas</h1>
      <p class="lead">L’adresse a changé. La carte et la réservation sont toujours là.</p>
      <div class="actions"><a class="btn btn--primary" href={`${base}reservations/`}>Réserver une table</a><a class="link" href={base}>Retour à l’accueil</a></div>
    </div>
  </section>
</Base>
