---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Cloture from '../components/Cloture.astro';
import Carte from '../components/Carte.astro';
import { resto, photos, t } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="boulangerie" title="Boulangerie, Dumont Bouge" description="Les treize pains de la boulangerie Dumont Bouge à Bouge, du petit blanc aux pains aux graines, avec leurs prix.">
  <section class="banner" aria-labelledby="h1">
    <div class="container banner__in">
      <div class="banner__txt">
        <h1 id="h1">Boulangerie</h1>
        <p class="lead">Des pains pétris et cuits chaque matin.</p>
        <div class="actions">
          <a class="btn btn--primary" href={`${base}reservations/`}>Réserver une table</a>
          <a class="link" href={resto.telHref}>Appeler le {resto.tel}</a>
        </div>
      </div>
      <Photo p={photos.pains} eager sizes="(min-width: 60rem) 50vw, 100vw" pos="50% 50%" class="banner__img" />
    </div>
  </section>
  <section class="section">
    <div class="container carte-wrap">
      <Carte i={0} id="pains" />
    </div>
  </section>
  <Cloture />
</Base>
