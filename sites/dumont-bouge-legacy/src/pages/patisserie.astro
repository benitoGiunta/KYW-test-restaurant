---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Cloture from '../components/Cloture.astro';
import Carte from '../components/Carte.astro';
import { resto, photos, t } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="patisserie" title="Pâtisserie, Dumont Bouge" description="Les gâteaux faits main de Dumont Bouge à Bouge : Saint Honoré, truffe chocolat, Javanais, Misérable. À commander par téléphone.">
  <section class="banner" aria-labelledby="h1">
    <div class="container banner__in">
      <div class="banner__txt">
        <h1 id="h1">Pâtisserie</h1>
        <p class="lead">Des gâteaux préparés à la main.</p>
        <div class="actions">
          <a class="btn btn--primary" href={`${base}reservations/`}>Réserver une table</a>
          <a class="link" href={resto.telHref}>Appeler le {resto.tel}</a>
        </div>
      </div>
      <Photo p={photos.vitrine} eager sizes="(min-width: 60rem) 50vw, 100vw" pos="50% 60%" class="banner__img" />
    </div>
  </section>
  <section class="section">
    <div class="container carte-wrap">
      <Carte i={1} id="gateaux" note={t("Commandez vos gâteaux dès maintenant au 081 22 96 02. Les prix ne sont pas publiés.")} />
      <p class="fill" data-fill>Prix des gâteaux : à confirmer par la maison.</p>
    </div>
  </section>
  <Cloture />
</Base>
