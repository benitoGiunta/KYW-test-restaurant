---
import Base from '../layouts/Base.astro';
import Horaires from '../components/Horaires.astro';
import { resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="reservations" bar={false} title="Réserver une table, Dumont Bouge" description="Réservez une table au tea-room de Dumont Bouge à Bouge : nombre de personnes, date et heure, ou par téléphone au 081 22 96 02.">
  <section class="counter" aria-labelledby="h1">
    <div class="container counter__in">
      <div class="counter__txt">
        <h1 id="h1">Réserver une table</h1>
        <p class="lead">Dites-nous combien vous êtes, le jour et l’heure.</p>
        <a class="counter__tel" href={resto.telHref}>{resto.tel}</a>
        <p class="counter__alt">Ou réservez sur <a href={resto.reservationOrigine} rel="noopener">le formulaire du site d’origine</a>.</p>
      </div>
      <form class="form" data-endpoint="" method="post" action="#" novalidate aria-describedby="form-note">
        <div class="field"><label for="personnes">Nombre de personnes</label>
          <select id="personnes" name="personnes" required aria-describedby="personnes-help"><option value="" selected disabled>Choisir</option>{Array.from({ length: 12 }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
          <p class="field__help" id="personnes-help" data-hint="" aria-live="polite"></p></div>
        <div class="field"><label for="date">Date</label>
          <input id="date" name="date" type="date" required aria-describedby="date-help" />
          <p class="field__help" id="date-help" data-hint="" aria-live="polite"></p></div>
        <div class="field"><label for="heure">Heure</label>
          <input id="heure" name="heure" type="time" min="07:00" max="18:00" required aria-describedby="heure-help" />
          <p class="field__help" id="heure-help" data-hint="De 7&nbsp;h&nbsp;00 à 18&nbsp;h&nbsp;00." aria-live="polite">De 7&nbsp;h&nbsp;00 à 18&nbsp;h&nbsp;00.</p></div>
        <div class="field"><label for="nom">Nom</label>
          <input id="nom" name="nom" type="text" autocomplete="name" placeholder="Prénom et nom" required aria-describedby="nom-help" />
          <p class="field__help" id="nom-help" data-hint="" aria-live="polite"></p></div>
        <div class="field"><label for="tel">Téléphone</label>
          <input id="tel" name="telephone" type="tel" inputmode="tel" autocomplete="tel" placeholder="0470 00 00 00" required aria-describedby="tel-help" />
          <p class="field__help" id="tel-help" data-hint="" aria-live="polite"></p></div>
        <button class="btn btn--primary" type="submit">Envoyer la demande</button>
        <p class="form__status" role="status" aria-live="polite"></p>
        <p class="form__note" id="form-note">Maquette : ce formulaire n’envoie rien. Pour réserver, appelez le {resto.tel}.</p>
      </form>
    </div>
  </section>
  <section class="section cloture" aria-labelledby="cloture-t">
    <div class="container cloture__in">
      <div class="cloture__head"><h2 id="cloture-t">Horaires et adresse</h2><p class="lead">Ouvert tous les jours à Bouge, de 7&nbsp;h&nbsp;00 à 18&nbsp;h&nbsp;00.</p></div>
      <Horaires />
    </div>
  </section>
</Base>
