---
import { nav, resto } from '../data/site';
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="nav">
  <div class="nav__in">
    <a class="nav__logo" href={base} aria-label="Dumont Bouge, accueil">
      <img src={`${base}photos/logo.png`} width="900" height="367" alt="Dumont Bouge" />
    </a>
    <nav class="nav__links" aria-label="Principal">
      {nav.map((n) => <a href={`${base}${n.href}`} aria-current={page === n.id ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="nav__act">
      <a class="nav__tel" href={resto.telHref}>{resto.tel}</a>
      <a class="btn btn--primary" href={`${base}reservations/`} aria-current={page === 'reservations' ? 'page' : undefined}>Réserver une table</a>
    </div>
  </div>
</header>
