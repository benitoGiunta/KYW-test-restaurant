---
import { nav, resto } from '../data/site';
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const left = nav.slice(0, 2), right = nav.slice(2);
---
<header class="nav">
  <div class="nav__in">
    <a class="nav__tel" href={resto.telHref} aria-label={`Appeler le ${resto.tel}`}>{resto.tel}</a>
    <a class="nav__logo" href={base} aria-label="Dumont Bouge, accueil">
      <img src={`${base}photos/logo.png`} width="900" height="367" alt="Dumont Bouge" />
    </a>
    <nav class="nav__links" id="menu" popover aria-label="Principal">
      <ul class="nav__g nav__g--l">{left.map((n) => <li><a href={`${base}${n.href}`} aria-current={page === n.id ? 'page' : undefined}>{n.label}</a></li>)}</ul>
      <ul class="nav__g nav__g--r">{right.map((n) => <li><a href={`${base}${n.href}`} aria-current={page === n.id ? 'page' : undefined}>{n.label}</a></li>)}</ul>
      <div class="nav__extra">
        <a class="btn btn--primary" href={`${base}reservations/`}>Réserver une table</a>
        <a class="link" href={resto.telHref}>Appeler le {resto.tel}</a>
      </div>
    </nav>
    <div class="nav__act">
      <a class="btn btn--primary nav__book" href={`${base}reservations/`} aria-current={page === 'reservations' ? 'page' : undefined}>Réserver</a>
      <button class="nav__menu btn btn--ghost" type="button" popovertarget="menu" popovertargetaction="toggle" aria-label="Menu" aria-haspopup="true"><span class="nav__bars" aria-hidden="true"></span><span class="nav__menu-t">Menu</span></button>
    </div>
  </div>
</header>
