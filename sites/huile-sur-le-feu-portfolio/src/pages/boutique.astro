---
import Base from '../layouts/Base.astro';
import Houle from '../components/Houle.astro';
import { site, photoDe, phraseBoutique, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const allee = photoDe('boutique-etageres');
const flacons = photoDe('boutique-flacons-oco');
const olivier = photoDe('boutique-allee');
---
<Base title="La boutique" description={`La boutique d'huiles d'olive Oliviers & Co dans le restaurant ${site.nom} à Namur : flacons, coffrets et produits italiens.`} theme="sombre">
  <section class="hero hero--page" data-hero aria-labelledby="t-boutique">
    <div class="hero__media" data-hero-media>
      <img src={asset(allee.src)} alt={allee.alt} width={allee.largeur} height={allee.hauteur} fetchpriority="high" decoding="async" data-critical />
    </div>
    <div class="hero__bas">
      <div class="wrap">
        <span class="eyebrow mono" style="color: inherit">La boutique</span>
        <h1 id="t-boutique" style="font-size: var(--t-xl); max-width: 14ch">Les huiles, sur l'étagère</h1>
      </div>
    </div>
    <svg class="hero__sep" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path data-houle d="M0,40 L1440,40 L1440,80 L0,80 Z" /></svg>
  </section>

  <section class="sec sec--ciel" aria-label="La boutique">
    <div class="wrap grid12">
      <div class="col-texte">
        <p class="lead">{phraseBoutique}</p>
        <p class="muted" style="margin-top: calc(var(--u) * 2)">Le restaurant abrite une petite épicerie d'huiles et de produits italiens, avec les huiles d'Oliviers & Co. La boutique en ligne du site actuel est annoncée « bientôt en ligne » : les prix ne sont pas publiés ici.</p>
      </div>
      <div class="col-droite">
        <span class="eyebrow mono">Passer à la boutique</span>
        <ul class="badges">
          <li class="badge is-ok">Dans le restaurant, rue de Marchovelette 19</li>
          <li class="badge is-ok">Mardi au samedi, 12h à 14h30 et 18h à 21h15</li>
          <li class="badge badge--illustratif">Coffrets cadeaux (illustratif)</li>
        </ul>
        <p style="margin-top: calc(var(--u) * 3)">Une question : <a class="link" href={telHref()}>{site.telephone}</a>.</p>
      </div>
    </div>
  </section>

  <section class="sec sec--eau sec--fin" aria-label="Les flacons">
    <Houle fill="eau" />
    <div class="wrap paire">
      <figure class="media" data-reveal="clip" data-cursor="Voir">
        <img src={asset(flacons.src)} alt={flacons.alt} width={flacons.largeur} height={flacons.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
        <figcaption class="mono">Flacons et coffrets · photo du restaurant</figcaption>
      </figure>
      <figure class="media media--portrait" data-reveal="clip" data-cursor="Voir">
        <img src={asset(olivier.src)} alt={olivier.alt} width={olivier.largeur} height={olivier.hauteur} loading="lazy" decoding="async" />
      </figure>
    </div>
    <div class="wrap"><div class="actions"><a class="btn btn--plein" href={u('/reservation/')}>Réserver une table</a><a class="btn" href={u('/')}>Retour à l'accueil</a></div></div>
  </section>
</Base>
