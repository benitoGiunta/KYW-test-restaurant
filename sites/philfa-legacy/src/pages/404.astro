---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { base } from '../data/site';
---
<Base title="Page introuvable, PhilFa" description="Cette adresse n’existe pas sur la maquette PhilFa. Retour à la carte, aux horaires ou à la réservation.">
  <Nav slot="nav" />
  <section class="band band--404"><div class="container notfound">
    <h1>Cette page n’existe pas.</h1>
    <p class="lead">Retour à la carte, aux horaires ou à la réservation.</p>
    <p><a class="btn btn--primary" href={base}>Retour à l’accueil</a></p>
  </div></section>
</Base>
