---
import { resto, base } from '../data/site';
---
<header class="nav">
  <div class="nav__banner">
    <div class="container nav__banner-in">
      <p>Ouvert du mardi au samedi, midi et soir</p>
      <a href={`tel:${resto.tel}`} class="nav__tel">{resto.telAffiche}</a>
    </div>
  </div>
  <div class="nav__bar">
    <div class="container nav__bar-in">
      <a class="nav__brand" href={`${base}#top`} aria-label="PhilFa, haut de page">PhilFa</a>
      <nav aria-label="Principal" class="nav__links">
        <a href={`${base}#carte`}>Carte</a>
        <a href={`${base}#salle`}>La salle</a>
        <a href={`${base}#maison`}>La maison</a>
        <a href={`${base}#infos`}>Infos</a>
      </nav>
      <a class="btn btn--primary btn--sm" href={resto.reservation} rel="noopener">Réserver</a>
    </div>
  </div>
</header>
