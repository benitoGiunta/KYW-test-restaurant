---
import { resto, base } from '../data/site';
---
<section class="hero" aria-labelledby="titre">
  <div class="container hero__in">
    <div class="hero__texte">
      <h1 id="titre">La pizzeria <span class="nw">rock-n-roll</span> d’Alex et Estelle</h1>
      <p class="lead">Pizzas au levain, pâte reposée 48 heures, bières craft, au {resto.adresse.rue} à Namur.</p>
      <div class="actions">
        <a class="btn btn--pass1" href={resto.reservation} rel="noopener">Réserver en ligne</a>
        <a class="btn btn--line" href={`${base}#carte`}>Voir la carte</a>
      </div>
    </div>
    <figure class="hero__photo pass-1" data-slot="hero" data-alt="Table en bois, pizza aux herbes vertes, verres de bière et bouteille">
      <img src={`${base}photos/table-1600.webp`} srcset={`${base}photos/table-800.webp 800w, ${base}photos/table-1600.webp 1600w`} sizes="(min-width: 60rem) 50vw, 100vw" width="1687" height="1035" alt="Table en bois avec une pizza aux herbes vertes, des verres de bière et une bouteille" fetchpriority="high" decoding="async" />
      <figcaption>Pizza aux herbes vertes et bières craft, sur table en bois.</figcaption>
    </figure>
  </div>
</section>
