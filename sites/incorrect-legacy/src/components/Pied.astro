---
import Logo from './Logo.astro';
import { resto, base } from '../data/site';
---
<section class="pied" aria-label="Coordonnées">
  <div class="container pied__in">
    <a class="pied__logo" href={base} aria-label="INCORЯECT, haut de page"><Logo /></a>
    <p class="pied__mot">La pizzeria rock-n-roll d’Alex et Estelle.</p>
    <ul class="pied__liens">
      <li><a href={resto.instagram} rel="noopener">Instagram</a></li>
      <li><a href={resto.facebook} rel="noopener">Facebook</a></li>
      <li><a href={resto.telHref}>{resto.tel}</a></li>
      <li><a href={resto.carte} rel="noopener">La carte en PDF</a></li>
    </ul>
    <p class="pied__credits" data-credits="Photos : INCORЯECT, site incorrect.pizza">Photos : INCORЯECT.</p>
  </div>
</section>
