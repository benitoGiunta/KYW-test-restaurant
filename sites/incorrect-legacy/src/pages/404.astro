---
import Base from '../layouts/Base.astro';
import { base, resto } from '../data/site';
---
<Base title="Page introuvable, INCORЯECT" description="Cette page n’existe pas. Retour à l’accueil de la pizzeria INCORЯECT à Namur.">
  <section class="section erreur">
    <div class="container">
      <h1>Cette page n’existe pas</h1>
      <p class="lead">La carte et la réservation sont sur l’accueil.</p>
      <div class="actions">
        <a class="btn btn--pass1" href={base}>Retour à l’accueil</a>
        <a class="btn btn--line" href={resto.telHref}>Appeler le {resto.tel}</a>
      </div>
    </div>
  </section>
</Base>
