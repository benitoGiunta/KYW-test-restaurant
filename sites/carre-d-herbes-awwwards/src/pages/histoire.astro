---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, histoire, equipe } from '../data/site';
import { u } from '../lib/url';
---
<Base page="histoire" title="Histoire" description="Le chef Damien Herbay, Anne-Sophie Gevaert-Herbay en salle et une maison de bord de Meuse : l’histoire de Carré d’herbes, à Wépion.">
  <section class="sec sec--ardoise hist-tete" aria-labelledby="titre">
    <div class="wrap hist-tete__grid">
      <h1 id="titre" data-split="lines" data-intro class="display hist-tete__titre">Une maison, un chef, un potager</h1>
      <Photo k="facade" class="hist-tete__photo" ratio="4 / 3" eager sizes="(min-width: 900px) 30vw, 80vw" />
    </div>
  </section>

  <section class="sec sec--pierre recit" aria-labelledby="chef">
    <div class="wrap recit__grid">
      <h2 id="chef" data-split="lines" class="titre">Au fourneau</h2>
      <div class="recit__texte">
        <p class="chapeau">{histoire.chef}</p>
        <p>{histoire.cuisine}</p>
      </div>
    </div>
  </section>

  <section class="sec sec--ardoise recit recit--nom" aria-labelledby="nom">
    <div class="wrap recit__grid">
      <h2 id="nom" data-split="lines" class="titre">Le nom</h2>
      <div class="recit__texte">
        <p class="chapeau">{histoire.nom}</p>
        <p>{histoire.lieu}</p>
        <div class="recit__duo">
          <Photo reveal="clip" k="parc" ratio="1 / 1" sizes="(min-width: 900px) 30vw, 80vw" />
          <Photo reveal="clip" k="poivre" ratio="1 / 1" pos="50% 40%" sizes="(min-width: 900px) 30vw, 80vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--pierre equipe" aria-labelledby="equipe">
    <div class="wrap recit__grid">
      <h2 id="equipe" data-split="lines" class="titre">À la maison</h2>
      <ul class="equipe__liste">
        {equipe.map((e) => <li><span class="equipe__nom display">{e.nom}</span><span class="equipe__role">{e.role}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec sec--ardoise cta-fin" aria-labelledby="table">
    <div class="wrap">
      <h2 id="table" data-split="lines" class="display cta-fin__titre">Une table ?</h2>
      <p class="hero__actions"><a class="btn" href={`tel:${site.telephone}`}><span>Appeler le {site.telephoneAffiche}</span></a><a class="lien" href={u('/reservation/')}>Horaires et accès</a></p>
    </div>
  </section>
</Base>
