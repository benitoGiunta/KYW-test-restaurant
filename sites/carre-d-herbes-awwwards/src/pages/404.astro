---
import Base from '../layouts/Base.astro';
import Rondes from '../components/Rondes.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Assiette introuvable" description="Cette page n'existe pas : l'assiette est vide. Retour à la carte ou à l'accueil de Carré d'herbes.">
  <section class="sec sec--ardoise e404" aria-labelledby="titre">
    <div class="wrap e404__grid">
      <div class="e404__plaque" aria-hidden="true"><span class="e404__vide"></span></div>
      <div>
        <h1 id="titre" data-split="lines" data-intro class="display e404__titre">Assiette vide</h1>
        <p class="e404__texte">Cette page n'est pas au menu. Revenez à la carte, ou à la porte d'entrée.</p>
        <p class="hero__actions"><a class="btn" href={u('/carte/')}><span>La carte</span></a><a class="lien" href={u('/')}>Accueil</a></p>
        <Rondes n={1} class="e404__n" />
      </div>
    </div>
  </section>
</Base>
