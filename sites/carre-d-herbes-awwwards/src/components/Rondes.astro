---
// Le nombre d'assiettes, dessiné : n ronds alignés. Décoratif (le texte porte l'information).
interface Props { n: number; class?: string }
const { n, class: cls = '' } = Astro.props;
---
<span class:list={['rondes', cls]} aria-hidden="true" data-n={n}>{Array.from({ length: n }, () => <i></i>)}</span>
