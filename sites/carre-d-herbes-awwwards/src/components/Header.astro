---
import { site } from '../data/site';
import { u } from '../lib/url';
interface Props { page?: string }
const { page = '' } = Astro.props;
const liens = [
  { href: u('/carte/'), label: 'La carte', id: 'carte' },
  { href: u('/histoire/'), label: 'Histoire', id: 'histoire' },
  { href: u('/reservation/'), label: 'Réserver', id: 'reservation' },
];
---
<header class="top">
  <a class="top__mark" href={u('/')} aria-label={`${site.nom}, accueil`}>
    <svg class="top__sigle" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="16" r="8" fill="currentColor"/></svg>
    <span>{site.nom}</span>
  </a>
  <button class="top__menu" type="button" aria-expanded="false" aria-controls="nav-principale"><span>Menu</span><i aria-hidden="true"></i></button>
  <nav class="top__nav" id="nav-principale" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => <li><a class="lien-nav" href={l.href} aria-current={page === l.id ? 'page' : undefined}>{l.label}</a></li>)}
      <li class="top__nav-tel"><a class="btn" href={`tel:${site.telephone}`}><span>Appeler le {site.telephoneAffiche}</span></a></li>
    </ul>
  </nav>
  <a class="btn btn--s top__call" href={`tel:${site.telephone}`}><span>{site.telephoneAffiche}</span></a>
</header>
<script is:inline>
  (function () {
    var h = document.querySelector('.top');
    if (!h) return;
    var m = function () { h.classList.toggle('top--fond', (window.scrollY || document.documentElement.scrollTop) > 8); };
    addEventListener('scroll', m, { passive: true }); m();
  })();
</script>
