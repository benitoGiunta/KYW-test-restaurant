---
import KywFooter from '@kyw/footer';
import { site, horaires } from '../data/site';
import { u } from '../lib/url';
const a = site.adresse;
---
<footer class="pied sec sec--ardoise" aria-label="Carré d'herbes en bref">
  <div class="wrap">
    <p class="pied__dire">À table, c'est ici.</p>
    <a class="pied__tel display" href={`tel:${site.telephone}`} aria-label={`Appeler le ${site.telephoneAffiche}`}>{site.telephoneAffiche}</a>
    <div class="pied__grid">
      <address>
        {a.rue} {a.numero}<br />{a.cp} {a.commune}
      </address>
      <p>Jeudi, vendredi, samedi : 12 h à 16 h, 19 h à minuit.<br />Dimanche : 12 h à 16 h.</p>
      <ul class="pied__liens">
        <li><a class="lien" href={u('/carte/')}>La carte</a></li>
        <li><a class="lien" href={u('/histoire/')}>Histoire</a></li>
        <li><a class="lien" href={u('/reservation/')}>Réserver</a></li>
        <li><a class="lien" href={site.plan} rel="noopener">Plan</a></li>
        {site.reseaux.map((r) => <li><a class="lien" href={r.url} rel="noopener">{r.nom}</a></li>)}
      </ul>
    </div>
    <p class="pied__credit">{site.credit}</p>
  </div>
</footer>
<KywFooter base={import.meta.env.BASE_URL} />
