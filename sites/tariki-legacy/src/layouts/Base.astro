---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import { resto, horaires } from '../data/site';
interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}photos/braises-900.webp`, Astro.site).href;
const jours = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: resto.nom,
  url: resto.site,
  image: ogImage,
  servesCuisine: 'Levantine',
  telephone: resto.tel,
  email: resto.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Rue de l’Ouvrage 2', postalCode: '5000', addressLocality: 'Namur', addressCountry: 'BE' },
  sameAs: [resto.instagram],
  openingHoursSpecification: horaires.flatMap((j) => j.creneaux.map((c) => { const [o, f] = c.split(' à '); return { '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${jours[j.jour]}`, opens: o, closes: f }; })),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14110e" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sofia+Sans+Extra+Condensed:wght@200;400&family=Barlow:wght@300;400;500&family=Amiri:wght@400&display=swap" rel="stylesheet" />
    {page !== '404' && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={resto.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Braises et flammes sur du bois" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      @import "../styles/page.css";
    </style>
  </head>
  <body data-page={page}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelector('img')?.remove(); s.prepend(im); } };
document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <script is:inline>
      (function () {
        var j = new Date().getDay();
        document.querySelectorAll('[data-jour]').forEach(function (el) { if (Number(el.dataset.jour) === j) { el.classList.add('is-now'); el.setAttribute('aria-current', 'date'); } });
        document.querySelectorAll('[data-tabs]').forEach(function (root) {
          var tabs = [].slice.call(root.querySelectorAll('[role="tab"]'));
          function show(t) {
            tabs.forEach(function (x) { var on = x === t; x.setAttribute('aria-selected', on ? 'true' : 'false'); x.tabIndex = on ? 0 : -1; var p = document.getElementById(x.getAttribute('aria-controls')); if (p) p.hidden = !on; });
          }
          tabs.forEach(function (t, i) {
            t.addEventListener('click', function () { show(t); });
            t.addEventListener('keydown', function (e) { var k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (!k) return; e.preventDefault(); var n = tabs[(i + k + tabs.length) % tabs.length]; n.focus(); show(n); });
          });
          show(tabs[0]);
        });
      })();
    </script>
    <KywFooter base={import.meta.env.BASE_URL} />
  </body>
</html>
