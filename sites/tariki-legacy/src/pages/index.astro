---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import Carte from '../components/Carte.astro';
import Horaires from '../components/Horaires.astro';
import { route } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="accueil" title="Tariki, cuisine levantine au feu de bois à Namur" description="Tariki est un restaurant de grillades au charbon et de mezzés à partager, à Namur : une carte courte, le feu comme seul fourneau.">
  <section class="hero" aria-labelledby="h-hero">
    <Fig class="hero__fig" name="hero" src="photos/braises-1920.webp" srcset="photos/braises-900.webp 900w, photos/braises-1920.webp 1920w" sizes="100vw" width={1920} height={1080} dataAlt="Braises et flammes sur du bois, visuel d’ambiance ; la vraie photo montrera le feu de la cuisine de Tariki" colour eager credits="Site d’origine tarikirestaurant.be" />
    <div class="container hero__in">
      <div class="hero__plate" aria-hidden="false">
        <img src={`${base}photos/logo-tariki.webp`} width="403" height="373" alt="Tariki, cuisine levantine au feu de bois, طريقي" fetchpriority="high" />
      </div>
      <div class="hero__text">
        <h1 id="h-hero">De notre route… jusqu’à votre table.</h1>
        <p class="lead">Cuisine levantine au feu de bois, à Namur.</p>
        <div class="actions">
          <a class="btn btn--primary" href="#reservation">Réserver une table</a>
          <a class="btn" href="#carte">Voir la carte</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="carte" aria-labelledby="h-carte">
    <div class="container">
      <div class="head">
        <h2 id="h-carte">La carte</h2>
        <p class="lead">Une carte courte, cuite au feu de bois.</p>
      </div>
      <Carte compact />
    </div>
  </section>

  <section class="sec sec--well" id="histoire" aria-labelledby="h-histoire">
    <div class="container">
      <div class="head head--ar">
        <h2 id="h-histoire">Notre histoire</h2>
        <p class="ar-line"><span lang="ar" dir="rtl" class="ar">طريقي</span>, mon chemin</p>
      </div>
      <ol class="route">
        {route.map((s) => (
          <li class="stop"><span class="stop__n num" aria-hidden="true">{s.n}</span><h3 class="stop__lieu">{s.lieu}</h3><p class="stop__ligne">{s.ligne}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec recit" aria-labelledby="h-recit">
    <div class="container recit__in">
      <div class="recit__text">
        <h2 id="h-recit">Au fil de cette route, nous n’avons pas seulement emporté des souvenirs. Nous avons emporté des saveurs, du feu, des traditions et l’amour du partage.</h2>
        <p>La Belgique nous a accueillis, offrant la sécurité, la dignité et la possibilité de reconstruire une vie.</p>
        <p>Bayti est né de cette gratitude. Puis Bayti le comptoir est venu compléter cette histoire.</p>
      </div>
      <Fig class="recit__fig" name="feu" src="photos/feu-1024.webp" srcset="photos/feu-600.webp 600w, photos/feu-1024.webp 1024w" sizes="(min-width: 60rem) 36vw, 100vw" width={1024} height={1024} dataAlt="Un feu de bois sur fond noir, visuel d’ambiance ; la vraie photo montrera le foyer de la cuisine" caption="Visuel d’ambiance du site d’origine, à remplacer par une photo du feu de Tariki." placeholder credits="Site d’origine tarikirestaurant.be" />
    </div>
  </section>

  <Fig class="salle" name="salle" src="photos/arcades-1600.webp" srcset="photos/arcades-800.webp 800w, photos/arcades-1600.webp 1600w" sizes="100vw" width={1600} height={1269} dataAlt="Couloir d’arcades ocre ; la vraie photo montrera la salle de Tariki" caption="Image d’ambiance illustrative, probablement générée : ce n’est pas la salle de Tariki." placeholder credits="Site d’origine tarikirestaurant.be" pos="50% 60%" />

  <section class="sec sec--well chapitre" aria-labelledby="h-chapitre">
    <div class="container chapitre__in">
      <h2 id="h-chapitre">Et aujourd’hui, Tariki ouvre un nouveau chapitre.</h2>
      <div class="chapitre__body">
        <p class="lead">Une cuisine vivante autour du feu, inspirée des routes que nous avons traversées : grillades au charbon, flammes ouvertes, cuisson lente, fumée, épices et âme du Levant.</p>
        <p>Bayti et Bayti le Comptoir continueront de vous accueillir, comme ils l’ont toujours fait. Tariki viendra simplement prolonger ce voyage.</p>
      </div>
      <p class="chapitre__fin">Plus qu’un restaurant, Tariki est un chemin raconté à travers le feu et l’hospitalité.</p>
    </div>
  </section>

  <Horaires />
</Base>
