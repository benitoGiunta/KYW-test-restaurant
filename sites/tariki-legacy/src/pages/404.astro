---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, Tariki" description="Cette page n’existe pas : retour à l’accueil de Tariki, cuisine levantine au feu de bois à Namur.">
  <section class="sec sec--page" aria-labelledby="h-404">
    <div class="container">
      <div class="head">
        <h1 id="h-404">Cette route ne mène nulle part.</h1>
        <p class="lead">La page demandée n’existe pas.</p>
      </div>
      <div class="actions">
        <a class="btn btn--primary" href={base}>Retour à l’accueil</a>
        <a class="btn" href={`${base}la-carte/`}>La carte</a>
      </div>
    </div>
  </section>
</Base>
