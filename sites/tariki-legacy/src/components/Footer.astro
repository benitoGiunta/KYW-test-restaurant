---
import { resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="close" aria-label="Coordonnées">
  <div class="container close__in">
    <p class="close__sign">{resto.baseline}</p>
    <address class="close__addr">
      <span>{resto.nom}</span>
      <span>{resto.rue}</span>
      <span>{resto.ville}</span>
    </address>
    <ul class="close__links">
      <li><a href={resto.telHref}>{resto.tel}</a></li>
      <li><a href={`mailto:${resto.email}`}>{resto.email}</a></li>
      <li><a href={resto.instagram} rel="noopener">Instagram, {resto.instagramNom}</a></li>
      <li><a href={`${base}la-carte/`}>La carte</a></li>
    </ul>
    <p class="close__credits" data-credits="Photos : site d’origine tarikirestaurant.be">Photos : visuels d’ambiance du site d’origine, tarikirestaurant.be (banque d’images possible, à remplacer par des photos du restaurant).</p>
  </div>
</section>
