---
import { horaires, resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fermes = horaires.filter((j) => !j.creneaux.length).map((j) => j.jour);
---
<section class="sec sec--end" id="horaires" aria-labelledby="h-horaires">
  <div class="container end">
    <div class="end__hours">
      <h2 id="h-horaires">Horaires</h2>
      <dl class="schedule">
        {horaires.map((j) => (
          <div class={`schedule__row ${j.creneaux.length ? '' : 'is-closed'}`} data-jour={j.jour}>
            <dt>{j.nom}</dt>
            <dd class="num">{j.creneaux.length ? j.creneaux.map((c) => <span>{c}</span>) : <span>Fermé</span>}</dd>
          </div>
        ))}
      </dl>
      <p class="end__addr">{resto.rue}, {resto.ville}</p>
    </div>
    <div class="end__book" id="reservation">
      <h2>Réservez votre table</h2>
      <p class="lead">Du lundi au samedi, midi et soir ; fermé le dimanche.</p>
      <form class="form" action={`${base}#reservation`} method="get" data-endpoint="" data-mailto={resto.email} data-closed={fermes.join(',')} data-slots={JSON.stringify(Object.fromEntries(horaires.map((j) => [j.jour, j.creneaux])))} novalidate>
        <div class="field">
          <label for="f-date">Date</label>
          <input id="f-date" type="date" name="date" autocomplete="off" required aria-describedby="f-date-help" />
          <p class="field__help" id="f-date-help">Du lundi au samedi, fermé le dimanche.</p>
        </div>
        <div class="field">
          <label for="f-heure">Heure</label>
          <input id="f-heure" type="text" name="heure" inputmode="numeric" autocomplete="off" placeholder="19:30" pattern="([01]?[0-9]|2[0-3]):[0-5][0-9]" required aria-describedby="f-heure-help" />
          <p class="field__help" id="f-heure-help">Au format 19:30.</p>
        </div>
        <div class="field">
          <label for="f-adultes">Adultes</label>
          <select id="f-adultes" name="adultes" required aria-describedby="f-adultes-help">
            {Array.from({ length: 12 }, (_, i) => i + 1).map((n) => <option value={n} selected={n === 2}>{n}</option>)}
          </select>
          <p class="field__help" id="f-adultes-help">De 1 à 12.</p>
        </div>
        <div class="field">
          <label for="f-enfants">Enfants</label>
          <select id="f-enfants" name="enfants" aria-describedby="f-enfants-help">
            {Array.from({ length: 13 }, (_, i) => i).map((n) => <option value={n}>{n}</option>)}
          </select>
          <p class="field__help" id="f-enfants-help">Facultatif.</p>
        </div>
        <div class="field field--wide">
          <label for="f-nom">Nom</label>
          <input id="f-nom" type="text" name="nom" autocomplete="name" placeholder="Prénom et nom" required aria-describedby="f-nom-help" />
          <p class="field__help" id="f-nom-help">Le nom de la réservation.</p>
        </div>
        <div class="field field--wide">
          <label for="f-tel">Téléphone</label>
          <input id="f-tel" type="tel" name="telephone" inputmode="tel" autocomplete="tel" placeholder="+32 492 00 00 00" pattern="[+]?[0-9 ]{8,16}" required aria-describedby="f-tel-help" />
          <p class="field__help" id="f-tel-help">Pour vous rappeler si besoin.</p>
        </div>
        <div class="form__act">
          <button class="btn btn--primary" type="submit">Préparer ma demande</button>
          <a class="btn" href={resto.telHref}>Appeler le {resto.tel}</a>
        </div>
        <p class="form__status" data-status role="status" aria-live="polite"></p>
        <p class="small">Ce formulaire prépare un e-mail adressé au restaurant, à envoyer depuis votre messagerie ; vous pouvez aussi appeler ou écrire à <a href={`mailto:${resto.email}`}>{resto.email}</a>.</p>
      </form>
      <p class="small"><a href={`${base}la-carte/`}>Accéder au menu</a></p>
    </div>
  </div>
</section>
