---
import { horaires, resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="sec sec--end" id="horaires" aria-labelledby="h-horaires">
  <div class="container end">
    <div class="end__hours">
      <h2 id="h-horaires">Horaires</h2>
      <dl class="schedule">
        {horaires.map((j) => (
          <div class={`schedule__row ${j.creneaux.length ? '' : 'is-closed'}`} data-jour={j.jour}>
            <dt>{j.nom}</dt>
            <dd class="num">{j.creneaux.length ? j.creneaux.map((c) => <span>{c}</span>) : <span>Fermé</span>}</dd>
          </div>
        ))}
      </dl>
      <p class="end__addr">{resto.rue}, {resto.ville}</p>
    </div>
    <div class="end__book" id="reservation">
      <h2>Réservez votre table</h2>
      <p class="lead">Réservez dès maintenant pour profiter pleinement de votre expérience au Tariki Restaurant.</p>
      <form class="form" action={`${base}#reservation`} method="get" data-endpoint="">
        <label class="field"><span>Date</span><input type="date" name="date" required /></label>
        <label class="field"><span>Heure</span><input type="time" name="heure" required /></label>
        <label class="field"><span>Adultes</span><input type="number" name="adultes" min="1" max="12" value="2" required /></label>
        <label class="field"><span>Enfants</span><input type="number" name="enfants" min="0" max="12" value="0" /></label>
        <label class="field field--wide"><span>Nom</span><input type="text" name="nom" autocomplete="name" required /></label>
        <label class="field field--wide"><span>Téléphone</span><input type="tel" name="telephone" autocomplete="tel" required /></label>
        <div class="form__act">
          <button class="btn btn--primary" type="submit">Demander une table</button>
          <a class="btn" href={resto.telHref}>Appeler le {resto.tel}</a>
        </div>
        <p class="small" data-status role="status">Le formulaire n’est pas encore relié à un système de réservation : pour réserver aujourd’hui, appelez ou écrivez à <a href={`mailto:${resto.email}`}>{resto.email}</a>.</p>
      </form>
      <p class="small"><a href={`${base}la-carte/`}>Accéder au menu</a></p>
    </div>
  </div>
</section>
