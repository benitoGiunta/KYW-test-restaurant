---
interface Props { name: string; src: string; srcset?: string; sizes?: string; width: number; height: number; alt?: string; dataAlt: string; caption?: string; eager?: boolean; pos?: string; colour?: boolean; placeholder?: boolean; credits?: string; reveal?: boolean; class?: string }
const { name, src, srcset, sizes, width, height, alt = '', dataAlt, caption, eager = false, pos = 'center', colour = false, placeholder = false, credits, reveal = false, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (s: string) => `${base}${s}`;
const ss = srcset ? srcset.split(',').map((x) => { const [p, w] = x.trim().split(' '); return `${u(p)} ${w}`; }).join(', ') : undefined;
---
<figure class={`fig ${colour ? 'fig--colour' : ''} ${cls}`} data-placeholder={placeholder ? 'true' : undefined} data-credits={credits} data-reveal={reveal ? '' : undefined}>
  <div class="fig__slot" data-slot={name} data-alt={dataAlt}>
    <img src={u(src)} srcset={ss} sizes={sizes} width={width} height={height} alt={alt} style={`object-position:${pos}`} loading={eager ? undefined : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? undefined : 'async'} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
