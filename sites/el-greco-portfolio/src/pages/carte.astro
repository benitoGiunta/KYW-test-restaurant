---
import Base from '../layouts/Base.astro';
import Objet from '../components/Objet.astro';
import { site, guinguette, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const g = guinguette;
const picto = (cat: string) => g.pictos.find((p) => cat.startsWith(p.categorie))?.picto ?? 'fourchette';
const photos = ['/photos/clocher.webp', '/photos/parasols.webp', '/photos/coupole.webp', '/photos/terrasses.webp'].map(photoDe);
const aBoire = site.carte.filter((c) => g.boissons.includes(c.categorie));
const aTable = site.carte.filter((c) => !g.boissons.includes(c.categorie));
const petite = (src: string) => asset(src.replace('/photos/', '/photos/s/'));
---
<Base title="La carte" description={`La carte de ${site.nom} à ${site.adresse.commune} : entrées, mezze, spécialités et grillades grecques, cocktails, vins grecs, menus enfant.`}>
  <section class="hero hero--page wrap" data-hero>
    <div class="hero__inner">
      <h1>La carte</h1>
      <p class="lead">Grillades, spécialités, poissons et menus enfant sont servis avec frites, pâtes grecques ou pomme au four, salade et trois sauces froides.</p>
    </div>
    <div class="hero__zone">
      <span class="obj obj--mobile obj--corail is-flottant" style="--x:84%;--y:4%;--r:14deg;--taille:110px" aria-hidden="true"><Objet id="amphore" classe="obj__svg" /></span>
    </div>
  </section>

  {[{ t: 'À table', c: aTable }, { t: 'À boire', c: aBoire }].map((b) => (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="carte">
          <h2 class="section__titre" style="margin-top:0">{b.t}</h2>
          <div class="carte__grille">
            {b.c.map((c) => (
              <div>
                <h3 class="cat__titre"><Objet id={picto(c.categorie)} />{c.categorie}</h3>
                <ul role="list">
                  {c.plats.map((p) => (
                    <li class="plat">
                      <span class="plat__nom">{p.nom}{p.description && <span class="plat__desc">{p.description}</span>}</span>
                      <span class="plat__points" aria-hidden="true"></span>
                      <span class="plat__prix">{p.prix}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="section section--canard">
    <div class="wrap">
      <h2 class="section__titre">Aux <em>quatre coins</em> de la Grèce</h2>
      <div class="grille-photos">
        {photos.map((p, i) => (
          <figure class="tirage" style={`--r:${[-4, 3, -2, 5][i]}deg`} data-reveal="up" data-delay={String(i * 0.08)}>
            <img src={petite(p.src)} alt={p.alt} width="640" height="640" loading="lazy" decoding="async" />
            <figcaption>{p.alt.split(' (')[0]}<span class="illu">photo de stock</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="actions"><a class="btn btn--lin" href={u('/reservation/')}>Réserver une table</a></div>
    </div>
  </section>
</Base>
