---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’est pas servie : La Maison des Desserts est ouverte du mardi au samedi, de 8 h à 18 h." teteSur="soir">
  <section class="tranche perdue" data-ton="soir">
    <div class="wrap grille">
      <p class="heure"><span class="num">18 h</span><small>Hors horaires</small></p>
      <div class="corps">
        <h1 class="entete__titre display" data-split="lines" data-intro style="font-size: var(--t-mega)">Cette page est fermée.</h1>
        <p class="texte" style="margin-top: var(--serre)">Elle n’existe pas, ou plus. Le comptoir, lui, ouvre du mardi au samedi à 8 h.</p>
        <div class="actions" style="margin-top: var(--normal)">
          <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
          <a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
