---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import '../styles/page.css';
import { resto } from '../data/site';
interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(`${base}photos/salle-tulipes.webp`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: 'https://www.lessentiel.be', image: og,
  telephone: '+3281568616', email: resto.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Rue Roger Clément 32', postalCode: '5020', addressLocality: 'Temploux', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: 50.4751615, longitude: 4.7385286 },
  sameAs: [resto.facebook, resto.instagram], servesCuisine: 'Française créative et de saison',
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '12:00', closes: '14:00' }, { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '19:00', closes: '21:30' }],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3ecdc" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@600&family=Grenze:wght@400&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    {page !== '404' && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={resto.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={page}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu"><slot /></main>
    <Footer />
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
    document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <KywFooter base={base} />
  </body>
</html>
