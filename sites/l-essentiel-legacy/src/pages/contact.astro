---
import Base from '../layouts/Base.astro';
import Horaires from '../components/Horaires.astro';
import Field from '../components/Field.astro';
import { resto } from '../data/site';
---
<Base page="contact" title="Contact, L’Essentiel à Temploux" description="Adresse, téléphone, e-mail et horaires de L’Essentiel, rue Roger Clément 32 à Temploux.">
  <section class="pagehead" aria-labelledby="h-1">
    <div class="container">
      <div class="split__text pagehead__text">
        <h1 id="h-1">Contact</h1>
        <address class="addr">
          <a href={resto.itineraire} rel="noopener">{resto.rue}<br />{resto.ville}</a>
          <a href={resto.telHref}>{resto.tel}</a>
          <a href={resto.emailHref}>{resto.email}</a>
        </address>
        <p><a class="btn btn--ghost" href={resto.itineraire} rel="noopener">Itinéraire</a></p>
      </div>
    </div>
  </section>
  <section class="sec sec--tight">
    <div class="container split split--form">
      <div class="split__text">
        <h2 class="h-section">Horaires</h2>
        <Horaires compact />
      </div>
      <form class="form" method="post" action="" data-endpoint="" data-fallback-tel={resto.tel} novalidate aria-label="Écrire à L’Essentiel">
        <div class="form__grid">
          <Field id="c-prenom" label="Prénom" name="prenom" autocomplete="given-name" placeholder="Prénom" />
          <Field id="c-nom" label="Nom" name="nom" autocomplete="family-name" placeholder="Nom" required msg="Indiquez votre nom." />
          <Field id="c-email" label="Adresse e-mail" name="email" type="email" autocomplete="email" inputmode="email" placeholder="nom@exemple.be" required msg="Indiquez votre adresse e-mail." />
          <Field id="c-tel" label="Téléphone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="0470 12 34 56" />
          <Field id="c-msg" label="Message" name="message" kind="textarea" rows={6} wide required placeholder="Votre message" msg="Écrivez votre message." />
        </div>
        <button class="btn" type="submit">Envoyer le message</button>
        <p class="form__status" role="status" aria-live="polite" data-status data-placeholder="true">Formulaire de maquette : l’envoi n’est pas branché. Pour joindre le restaurant, écrivez à l’adresse e-mail du restaurant ou appelez.</p>
      </form>
    </div>
  </section>
</Base>
