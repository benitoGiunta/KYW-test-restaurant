---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base page="404" title="Page introuvable, L’Essentiel" description="Cette page n’existe pas.">
  <section class="pagehead" aria-labelledby="h-1">
    <div class="container">
      <h1 id="h-1">Cette page est introuvable</h1>
      <p class="lead">Retour à <a href={base}>l’accueil</a> ou à la <a href={`${base}carte-menus/`}>carte</a>.</p>
    </div>
  </section>
</Base>
