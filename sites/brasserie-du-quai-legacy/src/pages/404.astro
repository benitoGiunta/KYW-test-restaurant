---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable · La Brasserie du Quai" description="Cette page n’existe pas ou plus." page="404">
  <section class="page-tete container" aria-labelledby="introuvable">
    <h1 id="introuvable">Cette page n’existe pas</h1>
    <p class="lead">L’adresse a peut-être changé avec le nouveau site.</p>
    <a class="btn btn--primary" href={base}>Revenir à l’accueil</a>
  </section>
</Base>
