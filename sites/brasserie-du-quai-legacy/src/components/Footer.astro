---
// Pied de page « statement » (draw 333a6d) : l'adresse en Young Serif (REVUE-1 F2-3 : la devise répétait le hero), puis les coordonnées
// du site d'origine. Les horaires n'y sont pas : ils sont dits une fois par page qui les porte (gate 69).
import { resto, nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="pied">
  <div class="container pied__in">
    <address class="pied__phrase">
      {resto.adresse.rue},<br />{resto.adresse.cp}&nbsp;{resto.adresse.commune}
    </address>
    <div class="pied__cols">
      <p class="pied__bloc">
        <a href={resto.telHref}>{resto.tel}</a><br />
        <a href={`mailto:${resto.email}`}>{resto.email}</a><br />
        <a href={resto.maps} rel="noopener">Itinéraire</a>
      </p>
      <ul class="pied__bloc pied__liens">
        <li><a href={resto.facebook} rel="noopener">Facebook</a></li>
        <li><a href={resto.instagram} rel="noopener">Instagram</a></li>
        <li><a href={`${base}${nav[1].href}`}>Offrir un bon cadeau</a></li>
      </ul>
    </div>
    <p class="pied__legal">TVA {resto.bce} · Photographies : La Brasserie du Quai</p>
  </div>
</footer>
