---
// Nav « banner-over-bar » : le bandeau garde ce que la barre d'origine portait (adresse à gauche, téléphone à droite),
// la barre dessous porte le logo, les cinq routes d'origine et l'action du job (anatomy.md § book).
import { nav, resto } from '../data/site';
interface Props { page: string }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = (p: string) => (p === page ? 'page' : undefined);
---
<header class="nav">
  <div class="nav__banner">
    <div class="container nav__banner-in">
      <a href={resto.maps} rel="noopener">{resto.adresse.rue}, {resto.adresse.cp} {resto.adresse.commune}</a>
      <a href={resto.telHref}>{resto.tel}</a>
    </div>
  </div>
  <nav class="nav__bar container" aria-label="Navigation principale">
    <a class="nav__logo" href={base} aria-label="La Brasserie du Quai, accueil">
      <img src={`${base}photos/logo.svg`} width="40" height="40" alt="" />
      <span>La Brasserie du Quai</span>
    </a>
    <ul class="nav__links">
      {nav.map((l) => <li><a href={`${base}${l.href}`} aria-current={current(l.page)}>{l.label}</a></li>)}
    </ul>
    <a class="btn btn--primary btn--nav" href={`${base}reservation/`} aria-current={current('reservation')}>Réserver</a>
    <button class="nav__menu" type="button" popovertarget="menu-mobile" aria-label="Ouvrir le menu">Menu</button>
  </nav>
  <div id="menu-mobile" class="menu-mobile" popover>
    <ul>
      <li><a href={base} aria-current={current('accueil')}>Accueil</a></li>
      {nav.map((l) => <li><a href={`${base}${l.href}`} aria-current={current(l.page)}>{l.label}</a></li>)}
      <li><a href={resto.telHref}>Appeler le {resto.tel}</a></li>
    </ul>
    <button class="btn btn--secondary" type="button" popovertarget="menu-mobile" popovertargetaction="hide">Fermer</button>
  </div>
</header>
