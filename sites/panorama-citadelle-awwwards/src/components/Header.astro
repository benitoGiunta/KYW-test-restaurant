---
import { u } from '../lib/url';
import { restaurant } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const courant = (p: string) => (path === u(p).replace(/\/+$/, '') + '/' ? 'page' : undefined);
const liens = [
  { href: '/carte/', label: 'La carte' },
  { href: '/histoire/', label: 'L’histoire' },
];
---
<header class="tete">
  <a class="tete__marque" href={base} aria-current={path === base ? 'page' : undefined} aria-label={`${restaurant.nom}, accueil`}>
    <svg class="tete__soleil" viewBox="0 0 28 28" width="28" height="28" aria-hidden="true"><path d="M3 18a11 11 0 0 1 22 0z" fill="currentColor"/><rect x="0" y="20.5" width="28" height="2" fill="currentColor"/></svg>
    <span class="tete__nom">Le Panorama</span>
  </a>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => (
        <li><a class="nl" href={u(l.href)} aria-current={courant(l.href)}><span class="nl__txt">{l.label}</span></a></li>
      ))}
      <li><a class="cta cta--petit" href={u('/reservation/')} aria-current={courant('/reservation/')}><span class="cta__txt">Réserver</span></a></li>
    </ul>
  </nav>
</header>
