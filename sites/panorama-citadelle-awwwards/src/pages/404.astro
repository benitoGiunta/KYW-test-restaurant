---
import Base from '../layouts/Base.astro';
import Regle from '../components/Regle.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas : retournez à l’accueil du Panorama ou à la carte.">
  <section class="perdu wrap">
    <Regle classe="regle--grande regle--perdue" marque={23} sansHeures />
    <h1 class="display perdu__titre">Vous avez dépassé le rebord</h1>
    <p class="perdu__texte">Cette page n’existe pas ou a changé d’adresse. Le sommet de la Citadelle, lui, est resté à sa place.</p>
    <p class="hero__actions">
      <a class="cta" href={u('/')}><span class="cta__txt">Revenir à l’accueil</span></a>
      <a class="cta cta--fantome" href={u('/carte/')}><span class="cta__txt">Lire la carte</span></a>
    </p>
  </section>
</Base>
