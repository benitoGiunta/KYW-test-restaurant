---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Formules" description={`Les formules de Bienvenue chez vous à Namur : ${site.menus[0].prix} le midi, ${site.menus[1].prix} en 4 escales, ${site.menus[2].prix} le soir, Voyage Signature ${site.menus[3].prix}.`}>
  <HeroPage titre="Formules" sur="Quatre voyages, une cuisine">
    <p>De trois à cinq escales, ou le Voyage Signature. Tout se réserve, et les accords se choisissent en supplément.</p>
  </HeroPage>

  <section class="section" aria-label="Les formules du Repas">
    <div class="wrap">
      <ol class="formules">
        {site.menus.map((m, i) => (
          <li class="formule" data-reveal="up" data-delay={String(i * 0.08)}>
            <p class="formule__prix" aria-hidden="true">{m.prix.replace(/\s*€/, '')}<span class="formule__euro">€</span></p>
            <div class="formule__texte">
              <h2 class="formule__nom">{m.nom}<span class="sr-only">, {m.prix}</span></h2>
              <p class="petite-cap">{m.detail}</p>
              <p>{m.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="formules__pied" data-reveal="fade">
        <p><strong>Mercredis à prix réduit.</strong> {site.mercredi}</p>
        <p><strong>Chèque cadeau.</strong> {site.bonCadeau.texte}</p>
        <div class="actions">
          <a class="btn" href={u('/menu/')}>Le menu en détail</a>
          <a class="btn btn--primary" href={u('/reservation/')}>Réserver</a>
        </div>
      </div>
    </div>
  </section>
</Base>
