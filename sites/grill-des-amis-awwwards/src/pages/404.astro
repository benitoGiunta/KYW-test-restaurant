---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Pièce introuvable" description="Cette page n’existe pas au Grill des amiS. Retournez à l’accueil, à la carte ou réservez une table.">
  <section class="perdu">
    <div class="wrap">
      <h1 class="display">Pièce introuvable</h1>
      <div class="perdu__lame" aria-hidden="true"></div>
      <p>Cette page n’est dans aucune de nos deux chambres de maturation. Revenez à table.</p>
      <div class="rdv-actions">
        <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
        <a class="cta" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
      </div>
    </div>
  </section>
</Base>
