---
import KywFooter from '@kyw/footer';
import { u } from '../lib/url';
import { site, services, fermes } from '../data/site';
const horairesDeja = /reservation\/?$/.test(Astro.url.pathname);
---
<section class="pied" aria-label="Contact et horaires">
  <div class="wrap pied__corps">
    <h2 class="pied__mot display" data-split="lines">À table, entre&nbsp;amis.</h2>
    <div class="pied__cta"><a class="cta cta--braise" href={u('/reservation/')}><span class="cta__txt">Réserver une table</span></a><a class="cta cta--ligne" href={site.telephoneHref}><span class="cta__txt">Appeler le {site.telephoneLisible}</span></a></div>
    <div class="pied__col">
      <h3 class="pied__titre">Venir</h3>
      <address>{site.adresse.rue} {site.adresse.numero}<br />{site.adresse.cp} {site.adresse.commune}</address>
      <p><a class="lien" href={site.planUrl} rel="noopener">Ouvrir le plan</a></p>
    </div>
    <div class="pied__col">
      <h3 class="pied__titre">Horaires</h3>
      {horairesDeja
        ? <p class="pied__note">Le détail des services est sur cette page.</p>
        : <>
            <ul class="pied__horaires">
              {services.map((s) => <li><span>{s.jours}</span><span>{s.midi}<br />{s.soir}</span></li>)}
            </ul>
            <p class="pied__note">{fermes}</p>
          </>}
    </div>
    <p class="pied__colophon">{site.credit}. Polices : Anton et Newsreader (Google Fonts). Construit avec Astro, GSAP et Lenis.</p>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
