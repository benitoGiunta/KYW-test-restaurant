---
// Pied de page minimal : nom, adresse, liens ; puis le pied de page KYW obligatoire (une seule mention « Maquette KYW »).
import KywFooter from '@kyw/footer';
import { site, adresseLigne, telHref } from '../data/site';
import { u, asset } from '../lib/url';
---
<footer class="footer">
  <div class="wrap footer__in">
    <div class="stack">
      <img class="footer__logo" src={asset('/photos/logo-inverse.png')} alt="Le Félicien brasserie" width="160" height="80" loading="lazy" decoding="async" />
      <address>{adresseLigne()}</address>
      <p><a class="link" href={telHref()}>{site.telephone}</a></p>
      <p><a class="link" href={`mailto:${site.email.valeur}`}>{site.email.valeur}</a></p>
    </div>
    <nav aria-label="Pied de page">
      <a class="link" href={u('/carte/')}>La carte</a>
      <a class="link" href={u('/formules/')}>Formules</a>
      <a class="link" href={u('/salle/')}>La salle</a>
      <a class="link" href={u('/histoire/')}>La maison</a>
      <a class="link" href={u('/reservation/')}>Réserver</a>
      {site.reseaux.map((r) => <a class="link" href={r.url} rel="noopener">{r.nom}</a>)}
    </nav>
  </div>
</footer>
<KywFooter base={import.meta.env.BASE_URL} />
