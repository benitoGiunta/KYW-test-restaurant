---
import KywFooter from '@kyw/footer';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import { resto, base } from '../data/site';
interface Props { title: string; description: string; pied?: boolean }
const { title, description, pied = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: resto.siteActuel,
  telephone: '+3281343789', servesCuisine: ['Japonaise', 'Sushi'],
  address: { '@type': 'PostalAddress', streetAddress: `${resto.adresse.rue} ${resto.adresse.numero}`, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 fill=%27%23df0505%27/%3E%3C/svg%3E" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}photos/23-nigiri-saumon-noir.jpg`, Astro.site).href} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sofia+Sans+Extra+Condensed:wght@200;400&family=Barlow:wght@300;400&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={ld} />
    <style is:global>@import "../styles/page.css";</style>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu"><slot /></main>
    {pied && <Pied />}
    <KywFooter base={base} />
    <script is:inline>
      document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });
      (() => {
        const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // menu mobile : <dialog> modal, focus rendu au bouton par le navigateur
        const bouton = document.querySelector('.nav__menu'), menu = document.getElementById('menu-mobile');
        if (bouton && menu && menu.showModal) {
          bouton.hidden = false;
          const fermer = () => menu.close();
          bouton.addEventListener('click', () => { menu.showModal(); bouton.setAttribute('aria-expanded', 'true'); });
          menu.addEventListener('close', () => bouton.setAttribute('aria-expanded', 'false'));
          menu.querySelector('.menu__fermer').addEventListener('click', fermer);
          menu.addEventListener('click', (e) => { if (e.target === menu || e.target.closest('a[href^="#"], a[href^="/"]')) fermer(); });
          matchMedia('(min-width: 60rem)').addEventListener('change', (m) => { if (m.matches && menu.open) fermer(); });
        }
        // jour et service en cours (heure de Namur), horaires du site : 12 h 00 à 14 h 00 et 18 h 00 à 22 h 00, 7 jours sur 7
        const etat = document.querySelector('[data-etat]');
        if (etat) {
          const [h, m] = new Intl.DateTimeFormat('fr-BE', { timeZone: 'Europe/Brussels', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).format(new Date()).split(':').map(Number);
          const t = h * 60 + m, S = [['Midi', 720, 840], ['Soir', 1080, 1320]];
          const cur = S.find(([, a, b]) => t >= a && t < b), nxt = S.find(([, a]) => t < a) || S[0];
          const f = (x) => Math.floor(x / 60) + '\u00a0h\u00a000';
          etat.textContent = cur ? `Ouvert maintenant, jusqu’à ${f(cur[2])}` : `Fermé, rouvre ${t >= 1320 ? 'demain ' : ''}à ${f(nxt[1])}`;
          etat.dataset.ouvert = cur ? 'oui' : 'non'; etat.hidden = false;
          document.querySelectorAll('.hor__l').forEach((l) => { if (cur && l.dataset.service === cur[0]) l.setAttribute('aria-current', 'time'); });
        }
        // un seul reveal : la photographie sort du fond une fois (thème Darkroom, mouvement still)
        const figs = [...document.querySelectorAll('[data-reveal]')];
        if (!figs.length) return;
        if (reduit || !('IntersectionObserver' in window)) { figs.forEach((f) => f.classList.add('is-in')); return; }
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
        figs.forEach((f) => io.observe(f));
        // filet : si l’observateur ne répond pas, tout est montré après 3 s
        setTimeout(() => figs.forEach((f) => f.classList.add('is-in')), 3000);
      })();
    </script>
  </body>
</html>
