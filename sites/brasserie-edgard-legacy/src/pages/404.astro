---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { u } from '../lib/url';
---
<Base title="Page introuvable, Mr Edgard" description="Cette page n’existe pas : retour à l’accueil de la Brasserie Edgard.">
  <Nav />
  <main id="contenu" class="nf container head">
    <h1>Cette page n’existe pas</h1>
    <p class="lead">La carte, elle, est bien là.</p>
    <div class="actions"><a class="btn btn--solid" href={u('la-carte/')}>Voir la carte</a><a class="link" href={u()}>Retour à l’accueil</a></div>
  </main>
  <Footer />
</Base>
