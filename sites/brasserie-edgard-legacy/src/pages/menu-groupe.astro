---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { groupe, prix } from '../data/site';
---
<Base title="Menu groupe, Mr Edgard, Saint-Servais" description="Menus pour les tables de plus de dix personnes (seize au maximum) : 34, 39 ou 49 € selon la formule, et formulaire de réservation pour les groupes.">
  <Nav current="menu-groupe/" />
  <main id="contenu">
    <header class="pagehead">
      <div class="container grid12 pagehead__grid">
        <div class="head">
          <h1>Menu groupe</h1>
          <p class="lead">{groupe.taille}. {groupe.limite}</p>
        </div>
      </div>
    </header>
    <section class="sec band lunch" aria-labelledby="g1">
      <div class="container grid12">
        <div class="head"><h2 id="g1">Trois formules</h2><p class="lead">Un menu unique pour la table, composé de ces choix.</p></div>
        <ul class="figures" style="--n:3">
          {groupe.formules.map((f) => <li data-reveal><span class="figure num">{prix(f.prix)}</span><span class="what">{f.nom}</span></li>)}
        </ul>
      </div>
    </section>
    <section class="sec" aria-label="Composition du menu">
      <div class="container cols3">
        <div><h2>Entrées</h2><ul class="plain">{groupe.entrees.map((e) => <li>{e}</li>)}</ul></div>
        <div><h2>Plats</h2><ul class="plain">{groupe.plats.map((e) => <li>{e}</li>)}</ul></div>
        <div><h2>Desserts</h2><ul class="plain">{groupe.desserts.map((e) => <li>{e}</li>)}</ul></div>
      </div>
    </section>
    <section class="sec band" aria-labelledby="c1">
      <div class="container grid12">
        <div class="head sec-head"><h2 id="c1">Conditions</h2></div>
        <ul class="cond">{groupe.conditions.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>
    <section class="sec" id="formulaire" aria-labelledby="f1">
      <div class="container grid12">
        <div class="head sec-head"><h2 id="f1">Formulaire de réservation</h2><p class="lead">Votre réservation ne sera effective qu’après acceptation du restaurant.</p></div>
        <form class="form" name="Réservation pour les groupes" method="post" data-endpoint="" novalidate>
          <div class="field"><label for="form-field-nom">Nom</label><input type="text" name="form_fields[nom]" id="form-field-nom" aria-describedby="form-field-nom-help" autocomplete="family-name" required /><p class="field__help" id="form-field-nom-help" aria-live="polite"></p></div>
          <div class="field"><label for="form-field-prenom">Prénom</label><input type="text" name="form_fields[prenom]" id="form-field-prenom" aria-describedby="form-field-prenom-help" autocomplete="given-name" required /><p class="field__help" id="form-field-prenom-help" aria-live="polite"></p></div>
          <div class="field"><label for="form-field-email">E-mail</label><input type="email" name="form_fields[email]" id="form-field-email" aria-describedby="form-field-email-help" autocomplete="email" inputmode="email" placeholder="nom@exemple.be" required /><p class="field__help" id="form-field-email-help" aria-live="polite"></p></div>
          <div class="field"><label for="form-field-tel">Téléphone</label><input type="tel" name="form_fields[tel]" id="form-field-tel" aria-describedby="form-field-tel-help" autocomplete="tel" inputmode="tel" placeholder="0470 00 00 00" required /><p class="field__help" id="form-field-tel-help" aria-live="polite"></p></div>
          <div class="field"><label for="form-field-participant">Participants</label>
            <select name="form_fields[participant]" id="form-field-participant" aria-describedby="form-field-participant-help" required>{groupe.participants.map((n) => <option value={n}>{n}</option>)}</select><p class="field__help" id="form-field-participant-help" aria-live="polite"></p></div>
          <div class="field"><label for="form-field-field_cd8b0b2">Choix du menu</label>
            <select name="form_fields[field_cd8b0b2]" id="form-field-field_cd8b0b2" aria-describedby="form-field-field_cd8b0b2-help" required>{groupe.menus.map((n) => <option value={n}>{n}</option>)}</select><p class="field__help" id="form-field-field_cd8b0b2-help" aria-live="polite"></p></div>
          <div class="field"><label for="form-field-field_69a766d">Date de votre venue</label><input type="date" name="form_fields[field_69a766d]" id="form-field-field_69a766d" aria-describedby="form-field-field_69a766d-help" required /><p class="field__help" id="form-field-field_69a766d-help" aria-live="polite"></p></div>
          <div class="field"><label for="form-field-field_3c4bab9">Heure d’arrivée</label>
            <select name="form_fields[field_3c4bab9]" id="form-field-field_3c4bab9" aria-describedby="form-field-field_3c4bab9-help" required>{groupe.heures.map((n) => <option value={n}>{n}</option>)}</select><p class="field__help" id="form-field-field_3c4bab9-help" aria-live="polite"></p></div>
          <div class="field field--wide"><label for="form-field-message">Message</label><textarea name="form_fields[message]" id="form-field-message" aria-describedby="form-field-message-help" rows="4"></textarea><p class="field__help" id="form-field-message-help" aria-live="polite"></p></div>
          <div class="field field--wide"><label class="check"><input type="checkbox" id="chk-field_55981f1" aria-describedby="chk-field_55981f1-help" name="form_fields[field_55981f1]" required /><span>Votre réservation ne sera effective qu’après acceptation du restaurant.</span></label><p class="field__help" id="chk-field_55981f1-help" aria-live="polite"></p></div>
          <div class="field field--wide"><label class="check"><input type="checkbox" id="chk-field_4a3ba11" aria-describedby="chk-field_4a3ba11-help" name="form_fields[field_4a3ba11]" required /><span>En soumettant ce formulaire, j’accepte que les informations saisies soient exploitées dans le cadre d’une relation commerciale.</span></label><p class="field__help" id="chk-field_4a3ba11-help" aria-live="polite"></p></div>
          <div class="field--wide"><button class="btn btn--solid" type="submit">Envoyer la demande</button></div>
          <p class="form__note" role="status" aria-live="polite">Maquette : l’envoi du formulaire n’est pas actif.</p>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Base>
