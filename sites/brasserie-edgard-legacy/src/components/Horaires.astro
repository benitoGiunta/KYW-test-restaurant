---
import { jours, horairesNote } from '../data/site';
---
<div class="schedule" id="horaires">
  <h2 class="schedule__title">Horaires</h2>
  <dl class="schedule__list">
    {jours.map((j) => (
      <div class="schedule__row" data-day={j.jour.toLowerCase()}>
        <dt>{j.jour}</dt>
        <dd><span class="schedule__hours">{j.heures}</span><span class="schedule__kitchen">{j.cuisine}</span></dd>
      </div>
    ))}
  </dl>
  <p class="schedule__note">{horairesNote}</p>
</div>
