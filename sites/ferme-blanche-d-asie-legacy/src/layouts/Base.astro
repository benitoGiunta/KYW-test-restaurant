---
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import KywFooter from '@kyw/footer';
import { resto, semaine, base } from '../data/site';
interface Props { title: string; description: string; page?: string }
const { title, description, page = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ff = (fam: string, file: string, w: string | number, style = 'normal') => `@font-face{font-family:'${fam}';font-style:${style};font-weight:${w};font-display:swap;src:url(${base}fonts/${file}) format('woff2')}`;
const fontFaces = [ff('Young Serif', 'young-serif.woff2', 400), ff('Instrument Sans', 'instrument-sans.woff2', '400 600'), ff('Instrument Sans', 'instrument-sans-italic.woff2', 400, 'italic')].join('');
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: new URL(base, Astro.site).href,
  telephone: '+32 81 44 64 89', servesCuisine: ['Asiatique', 'Chinoise'],
  address: { '@type': 'PostalAddress', streetAddress: resto.adresse.rue, postalCode: resto.adresse.cp, addressLocality: 'Malonne', addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
  sameAs: [resto.facebook],
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={resto.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}photos/salle-ronde-1400.webp`, Astro.site).href} />
    <meta property="og:image:alt" content="Salle à table ronde de La Ferme Blanche d’Asie à Malonne" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preload" href={`${base}fonts/young-serif.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/instrument-sans.woff2`} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
    <style is:global>@import "../styles/page.css";</style>
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body data-page={page}>
    <Nav page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Pied />
    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
    document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
    <KywFooter base={base} />
    <script is:inline>
      (function () {
        var j = document.querySelectorAll('.jour[data-i]'), d = new Date().getDay();
        j.forEach(function (el) { if (+el.getAttribute('data-i') === d) { el.setAttribute('data-today', ''); var dt = el.querySelector('dt'); var c = document.createElement('span'); c.className = 'chip'; c.textContent = 'Aujourd’hui'; dt.appendChild(c); } });
        var tl = document.querySelector('.tabs__list'); if (!tl) return;
        var tabs = tl.querySelectorAll('[role=tab]'), panels = document.querySelectorAll('.panel');
        function sel(t) { tabs.forEach(function (x) { var on = x === t; x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1; document.getElementById(x.getAttribute('aria-controls')).hidden = !on; }); }
        tabs.forEach(function (t, i) { t.addEventListener('click', function () { sel(t); });
          t.addEventListener('keydown', function (e) { var k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (!k) return; var n = tabs[(i + k + tabs.length) % tabs.length]; n.focus(); sel(n); e.preventDefault(); }); });
        sel(tabs[0]);
      })();
    </script>
  </body>
</html>
