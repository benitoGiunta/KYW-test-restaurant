---
import { resto, credits, u } from '../data/site';
---
<section class="pied container" aria-label="Coordonnées et liens" style={`--logo:url(${u('logo.png')})`}>
  <p class="pied__mast"><span class="nav__logo" aria-hidden="true"></span>{resto.nom}</p>
  <div class="pied__grid">
    <nav aria-label="Pied de page"><ul>
      <li><a href={u()}>Accueil</a></li><li><a href={u('menu')}>Menu</a></li><li><a href={u('reserve')}>Réservation</a></li><li><a href={u('photos')}>Photos</a></li><li><a href={u('contact')}>Contact</a></li>
    </ul></nav>
    <address>Allée de la Maison Blanche 20<br />5020 Malonne (Namur)<br /><a href={resto.maps}>Itinéraire</a></address>
    <p>Ouvert tous les jours, midi et soir.<br />Samedi jusqu’à minuit.</p>
    <ul>
      <li><a href={resto.tel}>{resto.telAffiche}</a></li>
      <li><a href={`mailto:${resto.mail}`}>{resto.mail}</a></li>
      <li><a href={resto.facebook} rel="noopener">Facebook</a></li>
    </ul>
  </div>
  <p class="pied__credits" data-credits>{credits}</p>
</section>
