---
// La carte complète : les deux services déployés l'un sous l'autre, avec ancres.
import Base from '../layouts/Base.astro';
import Lignes from '../components/Lignes.astro';
import { site, carteDe } from '../data/site';
---
<Base title="La carte" description={`La carte de Partage à ${site.adresse.commune} : starters, entrées, plats et desserts à partager, lunch du midi à 38 €, vins au verre et bar, avec tous les prix.`}>
  <section class="entete wrap">
    <h1 class="cap">La carte</h1>
    <p class="lead muted">Le soir, une carte à partager : plusieurs assiettes au milieu de la table. Le midi, un lunch en trois services pour la table entière. Carte du 28 septembre 2026, lunch du 21 octobre 2026 ; les photos au survol sont des photos de la maison, pas toujours du plat exact.</p>
  </section>
  <div class="col-carte">
    <div>
      <nav aria-label="Services" class="actions" style="margin-top: 0">
        <a class="btn" href="#soir">Le soir</a>
        <a class="btn" href="#midi">Le midi</a>
        <a class="btn" href="#bar">Le bar</a>
      </nav>
      <h2 class="cap cat__titre" id="soir" style="margin-top: calc(var(--u) * 5)">Soir <span class="muted" style="font-size: var(--t-s); font-family: var(--f-body); letter-spacing: 0.1em">du mardi au samedi</span></h2>
      {carteDe('soir').map((c) => <Lignes cat={c} />)}
      <h2 class="cap cat__titre" id="midi" style="margin-top: calc(var(--u) * 8)">Midi <span class="muted" style="font-size: var(--t-s); font-family: var(--f-body); letter-spacing: 0.1em">du mercredi au samedi</span></h2>
      {carteDe('midi').filter((c) => c.service === 'midi').map((c) => <Lignes cat={c} />)}
      <h2 class="cap cat__titre" id="bar" style="margin-top: calc(var(--u) * 8)">Le bar <span class="muted" style="font-size: var(--t-s); font-family: var(--f-body); letter-spacing: 0.1em">apéritifs, cocktails, bières, digestifs</span></h2>
      {site.carte.filter((c) => c.service === 'bar').map((c) => <Lignes cat={c} />)}
    </div>
  </div>
  <div class="apercu" data-apercu aria-hidden="true"><img alt="" width="560" height="700" /></div>
  <div style="height: calc(var(--u) * 6)"></div>
</Base>
