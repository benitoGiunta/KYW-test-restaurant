---
// Lunch et groupes : lunch, carte à partager et privatisation en chiffres géants (tous réels), bon cadeau, groupes.
import Base from '../layouts/Base.astro';
import { site, telHref } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Lunch et groupes" description={`Partage à Namur : lunch du midi à 38 €, carte à partager dès 11 €, privatisation pour 20 à 30 personnes et bon cadeau en ligne.`}>
  <section class="entete wrap">
    <h1 class="cap">Lunch et groupes</h1>
    <p class="lead muted">Le lunch du midi, la carte à partager le soir, la salle entière pour votre groupe, et un bon cadeau à offrir.</p>
  </section>
  <section class="wrap" aria-label="Les formules">
    <div class="formules">
      {site.menus.map((m, i) => (
        <article class="formule" data-reveal={i > 0 ? "fade" : undefined} data-delay={i > 0 ? String(i * 0.1) : undefined}>
          <p class="formule__prix num" data-prix-ecrit>{m.prix}</p>
          <h2 class="formule__nom">{m.nom}</h2>
          <p class="formule__quand">{m.quand}</p>
          <p class="formule__desc">{m.description}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section clair" id="cadeau" aria-labelledby="cadeau-titre" style="margin-top: calc(var(--u) * 6)">
    <div class="wrap acces">
      <div>
        <p class="petite-cap">Bon cadeau</p>
        <h2 class="cap cat__titre" id="cadeau-titre">Offrir une table</h2>
        <p style="margin-top: var(--u)">{site.cadeau.note}</p>
        <div class="actions"><a class="btn btn--plein" href={site.cadeau.url} rel="noopener">Demander un bon cadeau</a></div>
      </div>
      <div>
        <p class="petite-cap">Groupes et privatisation</p>
        <h2 class="cap cat__titre">De 20 à 30 personnes</h2>
        <p style="margin-top: var(--u)">{site.privatisation.texte}</p>
        <p style="margin-top: var(--u)">{site.reservation.note}</p>
        <div class="actions"><a class="btn" href={telHref()}>Appeler le {site.telephone}</a><a class="btn" href={u('/reservation/')}>Réserver</a></div>
      </div>
    </div>
  </section>
</Base>
