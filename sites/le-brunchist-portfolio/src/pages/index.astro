---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Horaires from '../components/Horaires.astro';
import Ligne from '../components/Ligne.astro';
import { site, moments, boissons, photoDe, adresseLigne } from '../data/site';
import { u, asset, srcsetDe } from '../lib/url';

const icones = ['tasse', 'assiette', 'couverts', 'verre', 'lune'];
const m = Object.fromEntries(moments.map((x) => [x.id, x]));
const cafe = m['m-9h30'], brunch = m['m-11h'], sale = m['m-12h30'], terrasse = m['m-14h30'], rideau = m['m-15h30'];
const photoCafe = photoDe(cafe.photo!), photoSale = photoDe(sale.photo!), photoTerrasse = photoDe(terrasse.photo!);
const medaillons = [
  { photo: photoDe('/photos/granola-fraises.webp'), titre: 'Granola', texte: 'Photo libre, assiette illustrative', placeholder: true },
  { photo: photoDe('/photos/framboises-tasse.webp'), titre: 'Fruits frais', texte: 'Photo libre, assiette illustrative', placeholder: true },
  { photo: photoDe('/photos/tasse-rouge.webp'), titre: 'Café au lait', texte: 'Photo libre, tasse illustrative', placeholder: true },
];
const photoAstre = photoDe('/photos/latte-art.webp');
const osm = `https://www.openstreetmap.org/search?query=${encodeURIComponent(adresseLigne())}`;
---
<Base theme="aube">
  <div data-accueil>
    <!-- HERO : cadran réglé à l'heure réelle. Le nom et l'accroche sont peints au premier rendu (LCP). -->
    <section class="hero" id="accueil" data-ciel="auto" aria-labelledby="titre">
      <figure class="hero__astre" data-astre>
        <span class="hero__orbite" data-astre-orbite aria-hidden="true"><span class="hero__soleil"></span></span>
        <span class="hero__photo"><img src={asset(photoAstre.src.replace('.webp', '-800.webp'))} alt={photoAstre.alt} width="800" height="534" fetchpriority="high" decoding="async" data-astre-img /></span>
      </figure>
      <div class="wrap">
        <div class="hero__haut">
          <p class="horloge" aria-label="Heure locale">
            <svg class="horloge__ring" viewBox="0 0 36 36" aria-hidden="true"><circle class="fond" cx="18" cy="18" r="15.9" /><circle class="cran" cx="18" cy="18" r="15.9" pathLength="100" data-horloge-ring /></svg>
            <span class="horloge__hm num" data-horloge-hm>--:--</span>
            <span class="horloge__s num" data-horloge-s aria-hidden="true"></span>
          </p>
        </div>
        <h1 class="hero__nom t-mega" id="titre">Le<br />Brunchist</h1>
        <p class="hero__baseline lead">Café-brunch à Namur : cafés de spécialité, cuisine locale et maison, du mercredi au dimanche, de 9h30 à 15h30.</p>
        <ul class="chips" data-reveal="up" data-intro data-delay="0.35" aria-label="Les moments de la matinée">
          {moments.map((x, i) => (
            <li><a class="chip" href={`#${x.id}`} data-chip={x.id}><Icone nom={icones[i]} /><span class="chip__h">{x.heureTexte}</span><span class="chip__t">{x.titre}</span></a></li>
          ))}
        </ul>
        <p class="maintenant" data-maintenant hidden>
          <a class="maintenant__lien" href="#accueil" data-maintenant-lien><span class="maintenant__point" aria-hidden="true"></span><span data-maintenant-texte>Aller au moment présent</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></a>
        </p>
      </div>
    </section>

    <!-- 7h CAFÉ : split texte | photo. -->
    <section class="moment moment--split" id={cafe.id} data-ciel={cafe.theme} aria-labelledby="t-9h30">
      <div class="wrap cols">
        <div class="c1-6">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{cafe.heureTexte}</p>
            <h2 class="moment__titre" id="t-9h30" data-split="words">{cafe.titre}{cafe.placeholder ? <span class="tag">illustratif</span> : null}</h2>
          </div>
          <p class="moment__accroche" data-reveal="fade">{cafe.accroche}</p>
          <ul class="lignes" data-reveal="up">
            {cafe.lignes.map((l) => <Ligne l={l} />)}
          </ul>
        </div>
        <figure class="c8-12 photo photo--4x5" data-reveal="clip">
          <img src={asset(photoCafe.src)} srcset={srcsetDe(photoCafe.src)} sizes="(max-width: 767px) 100vw, 50vw" alt={photoCafe.alt} width={photoCafe.largeur} height={photoCafe.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
        </figure>
      </div>
    </section>

    <!-- 9h BRUNCH : médaillons ronds à titre courbé. -->
    <section class="moment" id={brunch.id} data-ciel={brunch.theme} aria-labelledby="t-11h">
      <div class="wrap">
        <div class="moment__tete">
          <p class="moment__heure num" data-split="chars">{brunch.heureTexte}</p>
          <h2 class="moment__titre" id="t-11h" data-split="words">{brunch.titre}{brunch.placeholder ? <span class="tag">illustratif</span> : null}</h2>
        </div>
        <div class="cols">
          <p class="c1-6 moment__accroche">{brunch.accroche}</p>
          <ul class="c1-10 medaillons" data-medaillons tabindex="0" aria-label="Assiettes du brunch (photos libres illustratives)">
            {medaillons.map((md, i) => (
              <li>
                <div class="medaillon">
                  <div class="medaillon__photo"><img src={asset(md.photo.src)} srcset={srcsetDe(md.photo.src)} sizes="(max-width: 767px) 100vw, 50vw" alt={md.photo.alt} width={md.photo.largeur} height={md.photo.hauteur} loading="lazy" decoding="async" /></div>
                  <svg class="medaillon__anneau" viewBox="0 0 200 200" aria-hidden="true">
                    <defs><path id={`arc-${i}`} d="M100,100 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0" /></defs>
                    <text><textPath href={`#arc-${i}`} startOffset="0">{md.titre} · illustratif · {md.titre} · illustratif ·</textPath></text>
                  </svg>
                </div>
                <p class="medaillon__legende"><b>{md.titre}</b>{md.texte}{md.placeholder ? <span class="tag">illustratif</span> : null}</p>
              </li>
            ))}
          </ul>
          <div class="c1-6">
            <ul class="lignes" data-reveal="up">
              {brunch.lignes.map((l) => <Ligne l={l} />)}
            </ul>
            <p class="actions"><a class="fleche" href={u('/brunch/')}>Le brunch en détail <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 12h30 SALÉ : lignes + index des boissons. -->
    <section class="moment" id={sale.id} data-ciel={sale.theme} aria-labelledby="t-12h30">
      <div class="wrap cols">
        <div class="c1-5">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{sale.heureTexte}</p>
            <h2 class="moment__titre" id="t-12h30" data-split="words">{sale.titre}</h2>
          </div>
          <p class="moment__accroche" data-reveal="fade">{sale.accroche}</p>
          <ul class="lignes" data-reveal="up">
            {sale.lignes.map((l) => <Ligne l={l} />)}
          </ul>
          <div class="actions"><a class="btn" href={u('/carte/')}>Toute la carte</a></div>
        </div>
        <div class="c7-12">
          <figure class="photo photo--4x3" data-reveal="clip" style="margin-bottom: calc(var(--u) * 3)">
            <img src={asset(photoSale.src)} srcset={srcsetDe(photoSale.src)} sizes="(max-width: 767px) 100vw, 50vw" alt={photoSale.alt} width={photoSale.largeur} height={photoSale.hauteur} loading="lazy" decoding="async" data-parallax="0.08" />
          </figure>
          <p class="chapeau">À boire<span class="tag">prix illustratifs</span></p>
          <ol class="jours">
            {boissons.map((b) => (
              <li class="jour" data-reveal="up">
                <span class="jour__nom">{b.categorie}</span>
                <span class="jour__plat">{b.nom}</span>
                <span class="jour__prix">{b.prix}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 14h30 TERRASSE : bande de cartes, ciel corail. -->
    <section class="moment" id={terrasse.id} data-ciel={terrasse.theme} aria-labelledby="t-14h30">
      <div class="wrap">
        <div class="moment__tete">
          <p class="moment__heure num" data-split="chars">{terrasse.heureTexte}</p>
          <h2 class="moment__titre" id="t-14h30" data-split="words">{terrasse.titre}</h2>
        </div>
        <div class="cols" style="margin-bottom: calc(var(--u) * 3)">
          <p class="c1-6 moment__accroche" style="margin-bottom: 0">{terrasse.accroche}</p>
          <p class="c8-12" data-reveal="fade"><span class="happy"><Icone nom="verre" />Terrasse en extérieur, Place d’Armes</span></p>
        </div>
        <ul class="bande lignes" data-reveal="up" tabindex="0" aria-label="Cartes du goûter, défilables">
          <li class="carte-apero carte-apero--photo"><img src={asset(photoTerrasse.src)} srcset={srcsetDe(photoTerrasse.src)} sizes="(max-width: 767px) 100vw, 50vw" alt={photoTerrasse.alt} width={photoTerrasse.largeur} height={photoTerrasse.hauteur} loading="lazy" decoding="async" /></li>
          {terrasse.lignes.map((l) => (
            <li class="carte-apero">
              <p class="carte-apero__nom">{l.nom}{l.placeholder ? <span class="tag">exemple</span> : l.prixIllustratif ? <span class="tag">prix illustratif</span> : null}</p>
              <p>{l.detail && <span class="t-s muted">{l.detail}<br /></span>}<span class="carte-apero__prix">{l.prix}</span></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 15h30 RIDEAU : statement, horaires à flèches, avis, itinéraire. -->
    <section class="moment" id={rideau.id} data-ciel={rideau.theme} aria-labelledby="t-15h30">
      <div class="wrap cols">
        <div class="c1-6">
          <div class="moment__tete">
            <p class="moment__heure num" data-split="chars">{rideau.heureTexte}</p>
            <h2 class="moment__titre" id="t-15h30" data-split="words">{rideau.titre}</h2>
          </div>
          <p class="statement" data-split="lines">{rideau.accroche}</p>
          <blockquote class="avis" style="margin-top: calc(var(--u) * 4); max-width: 28rem" data-reveal="up">
            <p>{site.avis[0].texte}</p>
            <cite>{site.avis[0].auteur}, {site.avis[0].source}</cite>
          </blockquote>
        </div>
        <div class="c8-12" data-reveal="up">
          <p class="chapeau">Horaires de la semaine</p>
          <Horaires />
          <p class="note" style="margin-top: var(--u)">{adresseLigne()}<span class="tag">à confirmer</span></p>
          <div class="actions">
            <a class="btn btn--soleil" href={u('/reservation/')}>Venir, réserver</a>
            <a class="btn" href={osm} rel="noopener">Itinéraire</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
