---
import Base from '../layouts/Base.astro';
import Ligne from '../components/Ligne.astro';
import { site, moments, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const brunch = moments.find((m) => m.id === 'm-11h')!;
const plats = [
  { photo: photoDe('/photos/granola-fraises.webp'), titre: 'Granola maison', texte: 'Cité par la presse locale ; photo libre' },
  { photo: photoDe('/photos/framboises-tasse.webp'), titre: 'Fruits frais', texte: 'Photo libre, assiette illustrative' },
  { photo: photoDe('/photos/tasse-rouge.webp'), titre: 'Café au lait', texte: 'Photo libre, tasse illustrative' },
  { photo: photoDe('/photos/miel-pot.webp'), titre: 'Miel', texte: 'Photo libre, illustrative' },
];
const salle = photoDe('/photos/salle-table-bois.webp');
const theiere = photoDe('/photos/theiere.webp');
---
<Base title="Le brunch" theme="midi" description={`Le brunch de ${site.nom} à ${site.adresse.commune} : eggs benedict, granola maison, pancakes, jus frais pressés, du mercredi au dimanche.`}>
  <section class="section" data-ciel="midi">
    <div class="wrap cols">
      <div class="c1-6">
        <p class="chapeau" data-reveal="fade" data-intro>Du mercredi au dimanche</p>
        <h1 class="t-xl" data-split="lines" data-intro>Le brunch</h1>
        <p class="lead" style="margin-top: calc(var(--u) * 2)">{brunch.accroche}</p>
        <p class="note">Les plats cités viennent de la presse et d'avis publics ; la carte complète et les prix restent à confirmer avec la maison.</p>
        <div class="actions" data-reveal="up" data-intro data-delay="0.3">
          <a class="btn btn--solid" href={u('/reservation/')} data-magnetic="0.2">Venir, réserver</a>
          <a class="btn" href={u('/carte/')}>La carte</a>
        </div>
      </div>
      <figure class="c8-12 photo photo--4x5">
        <img src={asset(salle.src)} alt={salle.alt} width={salle.largeur} height={salle.hauteur} data-critical fetchpriority="high" data-parallax="0.08" />
      </figure>
    </div>
  </section>

  <section class="section" data-ciel="ocre">
    <div class="wrap">
      <div class="section__head">
        <p class="chapeau">Les assiettes<span class="tag">photos illustratives</span></p>
        <h2 class="t-xl" data-split="words">Rondes, vues du dessus</h2>
      </div>
      <ul class="medaillons" data-medaillons tabindex="0" aria-label="Assiettes du brunch (photos libres illustratives)" style="grid-template-columns: repeat(4, minmax(0, 1fr))">
        {plats.map((md, i) => (
          <li>
            <div class="medaillon">
              <div class="medaillon__photo"><img src={asset(md.photo.src)} alt={md.photo.alt} width={md.photo.largeur} height={md.photo.hauteur} loading="lazy" decoding="async" /></div>
              <svg class="medaillon__anneau" viewBox="0 0 200 200" aria-hidden="true">
                <defs><path id={`barc-${i}`} d="M100,100 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0" /></defs>
                <text><textPath href={`#barc-${i}`}>{md.titre} · illustratif · {md.titre} · illustratif ·</textPath></text>
              </svg>
            </div>
            <p class="medaillon__legende"><b>{md.titre}</b>{md.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" data-ciel="aube">
    <div class="wrap cols">
      <div class="c1-6">
        <p class="chapeau">À la carte<span class="tag">prix illustratifs</span></p>
        <h2 class="t-l" data-split="words">Ce qui se mange au brunch</h2>
        <ul class="lignes" style="margin-top: calc(var(--u) * 2)" data-reveal="up">
          {site.carte[0].plats.map((p) => <Ligne l={p} />)}
        </ul>
      </div>
      <figure class="c8-12 photo photo--4x3" data-reveal="scale">
        <img src={asset(theiere.src)} alt={theiere.alt} width={theiere.largeur} height={theiere.hauteur} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</Base>
