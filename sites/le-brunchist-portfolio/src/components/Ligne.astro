---
// Une ligne de carte : nom, prix, détail ; « exemple » si la ligne est inventée, « prix illustratif » si seul le prix l'est.
import type { Ligne } from '../data/site';
interface Props { l: Pick<Ligne, 'nom' | 'detail' | 'prix' | 'placeholder' | 'prixIllustratif'> }
const { l } = Astro.props;
---
<li class="ligne"><span class="ligne__nom">{l.nom}{l.placeholder ? <span class="tag">exemple</span> : l.prixIllustratif ? <span class="tag">prix illustratif</span> : null}</span>{l.prix && <span class="ligne__prix">{l.prix}</span>}{l.detail && <span class="ligne__detail">{l.detail}</span>}</li>
