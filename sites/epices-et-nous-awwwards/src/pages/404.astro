---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Table introuvable" description="Page introuvable chez Épices & Nous : la maison vous réinstalle à l’accueil, à la carte ou à la réservation, à Erpent près de Namur.">
  <section class="quatre wrap">
    <h1 class="quatre__titre display">Table <em>introuvable</em></h1>
    <div class="deux">
      <div class="deux__g">
        <p class="voix">En cuisine</p>
        <p class="quatre__voix">Rien ne mijote à cette adresse.</p>
      </div>
      <div class="deux__d">
        <p class="voix">En salle</p>
        <p class="quatre__voix">Revenez par l’accueil : je vous installe.</p>
        <p class="poster__actions">
          <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
          <a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">Voir la carte</span></a>
        </p>
      </div>
    </div>
  </section>
</Base>
