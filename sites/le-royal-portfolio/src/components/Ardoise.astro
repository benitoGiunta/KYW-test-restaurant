---
// L'ardoise : onglets table / bar (sticky), panneaux de catégories. Sans JS : les deux parties affichées l'un sous l'autre.
import { carteDe } from '../data/site';
import Lignes from './Lignes.astro';
const services = [
  { id: 'table', label: 'Table', sous: 'midi et soir', cats: carteDe('table') },
  { id: 'bar', label: 'Bar', sous: 'vins, bières, cocktails', cats: carteDe('bar') },
];
---
<div class="onglets" role="tablist" aria-label="Service" data-onglets>
  {services.map((s) => (
    <button class="onglets__tab" role="tab" id={`tab-${s.id}`} aria-controls={`panneau-${s.id}`} aria-selected="false" data-groupe={s.id} type="button">
      {s.label}<small>{s.sous}</small>
    </button>
  ))}
  <span class="onglets__trait" data-trait aria-hidden="true"></span>
</div>
{services.map((s) => (
  <div class="panneau" id={`panneau-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} hidden>
    <h2 class="panneau__titre-js cap cat__titre" style="margin-top: calc(var(--u) * 4)">{s.label} <span class="muted" style="font-size: var(--t-s); font-family: var(--f-body); letter-spacing: 0.1em">{s.sous}</span></h2>
    {s.cats.map((c) => <Lignes cat={c} />)}
  </div>
))}
<div class="apercu" data-apercu aria-hidden="true"><img alt="" width="560" height="700" /></div>
