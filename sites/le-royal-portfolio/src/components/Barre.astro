---
// Barre basse fixe (réserver, appeler, la carte). Placée après le pied de page dans le DOM : l'ordre de tabulation suit la lecture.
import { telHref } from '../data/site';
import { u } from '../lib/url';
---
<div class="barre" role="navigation" aria-label="Actions rapides">
  <a href={u('/reservation/')}>Réserver</a>
  <a href={telHref()}>Appeler</a>
  <a href={u('/carte/')}>La carte</a>
</div>
