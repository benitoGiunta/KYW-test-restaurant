---
// La maison : ce que le dossier prouve (la place, la terrasse, la cuisine), un indicateur d'avis sourcé. Histoire, équipe : inconnues, donc absentes.
import Base from '../layouts/Base.astro';
import { site, photoDe } from '../data/site';
import { asset, u } from '../lib/url';
const facade = photoDe('/photos/facade-800.webp');
const terrasse = photoDe('/photos/terrasse-960.webp');
---
<Base title="La maison" preloadImage={{ href: facade.src }} description={`La Brasserie Le Royal, Place du Théâtre à ${site.adresse.commune} : un cadre élégant et chaleureux, une cuisine de brasserie généreuse et une terrasse face au Théâtre.`}>
  <section class="entete wrap">
    <h1 class="cap">La maison</h1>
    <p class="lead muted">{site.baseline}</p>
  </section>
  <section class="wrap maison">
    <figure class="maison__media">
      <img src={asset(facade.src)} alt={facade.alt} width={facade.largeur} height={facade.hauteur} fetchpriority="high" decoding="async" />
    </figure>
    <div class="prose">
      {site.histoire.map((p) => <p>{p}</p>)}
    </div>
  </section>
  <section class="section" aria-labelledby="avis-titre">
    <div class="wrap">
      <p class="petite-cap">Ce qu'on en dit</p>
      <h2 class="cap cat__titre" id="avis-titre">Les notes des clients</h2>
      <ul class="equipe" style="margin-top: calc(var(--u) * 2)">
        {site.notes.map((n) => (
          <li><span class="nom">{n.source} : {n.note} sur 5</span><span class="muted">{n.nombre} avis, {n.precision}</span></li>
        ))}
      </ul>
      <div class="actions"><a class="btn" href={u('/carte/')}>La carte</a><a class="btn btn--plein" href={u('/reservation/')}>Réserver</a></div>
    </div>
  </section>
</Base>
