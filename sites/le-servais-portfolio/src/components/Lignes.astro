---
// Lignes de carte : nom, prix, détail. Un drapeau « exemple » n'apparaît que sur une ligne non prouvée.
import type { Ligne } from '../data/site';
const { lignes, reveal = true, class: classe = '', style } = Astro.props as { lignes: Ligne[]; reveal?: boolean; class?: string; style?: string };
---
<ul class:list={['lignes', classe]} data-reveal={reveal ? 'up' : undefined} style={style}>
  {lignes.map((x) => (
    <li class="ligne"><span class="ligne__nom">{x.nom}{x.placeholder ? <span class="tag">exemple</span> : null}</span>{x.prix && <span class="ligne__prix">{x.prix}</span>}{x.detail && <span class="ligne__detail">{x.detail}</span>}</li>
  ))}
</ul>
