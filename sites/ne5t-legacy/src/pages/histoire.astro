---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Foot from '../components/Foot.astro';
import Photo from '../components/Photo.astro';
import { site, equipe } from '../data/site';
---
<Base title="Notre histoire, la Maison Gersdorff à Namur" description="Une ancienne ferme en carré au-dessus de la Meuse, à deux pas de la citadelle de Namur, transformée en hôtel et spa après près de dix ans de rénovations.">
  <Nav current="histoire" />
  <main id="contenu">
    <section class="hero hero--corridor" aria-labelledby="titre">
      <div class="container hero__content">
        <h1 id="titre">Une ferme en carré sur la Meuse</h1>
        <p class="lead">Près de dix ans de rénovations, pierre par pierre.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="ferme">
      <div class="container duo">
        <Photo name="04-couple-cour" class="duo__photo" sizes="(min-width: 60rem) 50vw, 100vw" ratio="3 / 2" pos="50% 40%" />
        <div class="duo__text">
          <h2 id="ferme">À deux pas de la citadelle</h2>
          <p>Certaines pierres ont été numérotées pour être reposées à l’identique. Benoît Gersdorff, le propriétaire, parle d’un lieu qui mêle le service des palaces et l’accueil d’une maison de famille.</p>
        </div>
      </div>
    </section>

    <section class="section section--band" aria-labelledby="equipe">
      <div class="container split">
        <div class="split__head"><h2 id="equipe">Les personnes</h2></div>
        <ul class="rows">
          {equipe.map((e) => (
            <li class="row"><div class="row__name"><h3>{e.nom}</h3><p class="row__note">{e.role}</p></div></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bleed" aria-label="Les ailes de la Maison Gersdorff">
      <Photo name="03-ailes-batiment" class="bleed__photo" sizes="100vw" ratio="21 / 9" pos="50% 55%" />
    </section>

    <section class="section" aria-labelledby="venir">
      <div class="container split">
        <div class="split__head">
          <h2 id="venir">Venir à la Maison Gersdorff</h2>
          <address class="addr">
            <p>{site.adresse.rue}<br />{site.adresse.cp} {site.adresse.commune}</p>
          </address>
        </div>
        <p class="lead">Quatre suites, deux duplex, un spa et le restaurant Intuition sous le même toit.</p>
      </div>
    </section>
  </main>
  <Foot />
</Base>
