---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Foot from '../components/Foot.astro';
import Photo from '../components/Photo.astro';
import { site, suites } from '../data/site';
---
<Base title="Suites et duplex de NE5T, Namur" description="Quatre suites et deux duplex à la Maison Gersdorff, à Namur : Suite Cosy, Suite Ne5t, Suite Terrasse, Suite Blanche, Duplex Madeleine, Duplex Vauban.">
  <Nav current="suites" />
  <main id="contenu">
    <section class="hero hero--stage" aria-labelledby="titre">
      <div class="container hero__grid">
        <div class="hero__content">
          <h1 id="titre">Quatre suites, deux duplex</h1>
          <p class="lead">Chacune a son style, dans la pierre de la ferme.</p>
          <p class="hero__actions">
            <a class="btn btn--primary" href={site.roomraccoon} rel="noopener">Réserver une chambre</a>
          </p>
        </div>
        <Photo name="17-duplex-salon-cheminee" class="hero__photo" eager sizes="(min-width: 60rem) 58vw, 100vw" ratio="4 / 3" />
      </div>
    </section>

    <section class="section" aria-labelledby="suites">
      <div class="container duo">
        <div class="duo__text">
          <h2 id="suites">Les suites</h2>
          <ul class="rows">
            {suites.suites.map((s) => <li data-reveal class="row"><h3>{s}</h3></li>)}
          </ul>
        </div>
        <div class="duo__photo">
          <Photo name="23-suite-terrasse-bain" reveal sizes="(min-width: 60rem) 40vw, 100vw" caption="Suite Terrasse" />
          <Photo name="18-chambre-lit" reveal sizes="(min-width: 60rem) 40vw, 100vw" ratio="4 / 3" />
        </div>
      </div>
    </section>

    <section class="section section--band" aria-labelledby="duplex">
      <div class="container split">
        <div class="split__head"><h2 id="duplex">Les duplex</h2></div>
        <ul class="rows">
          {suites.duplex.map((s) => <li data-reveal class="row"><h3>{s}</h3></li>)}
        </ul>
      </div>
      <div class="container suites-gallery">
        <Photo name="24-duplex-vauban" reveal sizes="(min-width: 60rem) 30vw, 100vw" caption="Duplex Vauban" />
        <Photo name="19-duplex-salle-a-manger" reveal sizes="(min-width: 60rem) 30vw, 100vw" caption="Salle à manger d’un duplex" />
        <Photo name="22-cuisine-ilot" reveal sizes="(min-width: 60rem) 30vw, 100vw" caption="Cuisine avec îlot" />
      </div>
    </section>

    <section class="section" aria-labelledby="tarifs">
      <div class="container">
        <div class="well figure-well" data-reveal>
          <h2 id="tarifs">Les chambres</h2>
          <p class="figure-well__num num" aria-label="de 260 à 400 euros">260 à 400 €</p>
          <div class="figure-well__rest">
            <p class="figure-well__label">La nuit, à titre indicatif.</p>
            <ul class="rows rows--tight">
              <li data-reveal class="row"><p>Petit-déjeuner : 26 € pour les résidents, 30 € pour les autres</p></li>
              <li data-reveal class="row"><p>Repas en suite : à réserver 24 h avant, supplément de 15 %</p></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section close" aria-labelledby="reserver">
      <div class="container close__grid">
        <div class="close__text">
          <h2 id="reserver">Réserver une chambre</h2>
          <p class="lead">Les chambres se réservent en ligne, le restaurant par téléphone.</p>
          <p class="hero__actions">
            <a class="btn btn--primary" href={site.roomraccoon} rel="noopener">Réserver en ligne</a>
            <a class="btn btn--ghost" href={site.telHref}>Appeler le {site.telAffiche}</a>
          </p>
        </div>
        <Photo name="20-duplex-salon-clair" reveal class="close__photo" sizes="(min-width: 60rem) 45vw, 100vw" ratio="4 / 3" />
      </div>
    </section>
  </main>
  <Foot />
</Base>
