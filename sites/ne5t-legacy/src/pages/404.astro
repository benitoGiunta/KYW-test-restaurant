---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Foot from '../components/Foot.astro';
import { u } from '../lib/typo';
---
<Base title="Page introuvable, NE5T Hôtel & Spa" description="Cette page n’existe pas.">
  <Nav />
  <main id="contenu">
    <section class="hero hero--corridor" aria-labelledby="titre">
      <div class="container hero__content">
        <h1 id="titre">Cette page n’existe pas</h1>
        <p class="lead">Retournez à l’accueil de la Maison Gersdorff.</p>
        <p class="hero__actions"><a class="btn btn--primary" href={u('')}>Accueil</a></p>
      </div>
    </section>
  </main>
  <Foot />
</Base>
