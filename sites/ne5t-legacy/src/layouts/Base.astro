---
import '../styles/page.css';
import { nbsp } from '../lib/typo';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kyw-test-restaurant.vercel.app').href;
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/photos/01-facade-nuit-piscine.webp`, Astro.site ?? 'https://kyw-test-restaurant.vercel.app').href;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: 'Intuition, NE5T Hôtel & Spa',
  address: { '@type': 'PostalAddress', streetAddress: 'Avenue Vauban 46', postalCode: '5000', addressLocality: 'Namur', addressCountry: 'BE' },
  telephone: '+32 81 58 88 88', email: 'info@ne5t.com', servesCuisine: 'Cuisine de saison',
  url: canonical,
});
const icone = "data:image/svg+xml," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='12' fill='#1a1511'/><text x='32' y='42' font-family='Georgia,serif' font-size='26' text-anchor='middle' fill='#e8806a'>N5</text></svg>");
const body = nbsp(await Astro.slots.render('default'));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={icone} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <script type="application/ld+json" set:html={ld} />
    <meta name="theme-color" content="#1a1511" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Fragment set:html={body} />
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        try {
          var calme = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (calme || !('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-in'); }); }
          else {
            var io = new IntersectionObserver(function (list) {
              list.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
            }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
            els.forEach(function (e) { io.observe(e); });
          }
          var jour = new Intl.DateTimeFormat('fr-BE', { weekday: 'long', timeZone: 'Europe/Brussels' }).format(new Date()).toLowerCase();
          document.querySelectorAll('.schedule__row').forEach(function (r) {
            var dt = r.querySelector('dt');
            if (dt && dt.textContent.trim().toLowerCase() === jour) { r.classList.add('is-today'); r.setAttribute('aria-current', 'date'); }
          });
        } catch (e) { els.forEach(function (x) { x.classList.add('is-in'); }); }
        var m = document.getElementById('menu-principal'), t = document.querySelector('.nav__toggle');
        if (m && t) {
          m.addEventListener('toggle', function (ev) { t.setAttribute('aria-expanded', ev.newState === 'open' ? 'true' : 'false'); });
          window.addEventListener('resize', function () { if (m.matches(':popover-open') && window.innerWidth > 960) m.hidePopover(); });
        }
      })();
    </script>
  </body>
</html>
