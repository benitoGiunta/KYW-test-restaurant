---
import KywFooter from '@kyw/footer';
import { site, nav } from '../data/site';
import { u } from '../lib/typo';
---
<footer class="foot">
  <div class="container foot__grid">
    <p class="foot__statement">Une seule invitation : suivre notre intuition.</p>
    <nav class="foot__nav" aria-label="Plan du site">
      <ul>
        {nav.map((n) => <li><a href={u(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>
    <address class="foot__addr">
      <p>{site.nom}<br />{site.adresse.rue}, {site.adresse.cp} {site.adresse.commune}</p>
      <p><a href={site.telHref}>{site.telAffiche}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>
        <a href={site.facebook} rel="noopener">Facebook</a>, <a href={site.instagram} rel="noopener">Instagram</a>, <a href={site.tripadvisor} rel="noopener">TripAdvisor</a>
      </p>
    </address>
    <p class="foot__credits" data-credits>Photographies issues du site ne5t.com.</p>
  </div>
</footer>
<KywFooter base={import.meta.env.BASE_URL} />
