---
import Nav from '../components/Nav.astro';
import { resto } from '../data/site';
import Footer from '../components/Footer.astro';
import KywFooter from '@kyw/footer';
import '../styles/page.css';
interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, servesCuisine: 'Cuisine française', telephone: '+3281344819',
  address: { '@type': 'PostalAddress', streetAddress: resto.adresse.rue, postalCode: resto.adresse.cp, addressLocality: 'Wépion', addressCountry: 'BE' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Saturday'], opens: '12:00', closes: '16:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Saturday'], opens: '19:00', closes: '23:59' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:00', closes: '16:00' }
  ],
  sameAs: [resto.facebook]
};
---
<!doctype html>
<html lang="fr">
  <head>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:type" content="restaurant" />
    <meta property="og:image" content={new URL(base + 'og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=Archivo:wght@400;500&family=Archivo+Narrow:wght@600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav page={page} />
    <main id="contenu"><slot /></main>
    <Footer />
    <KywFooter base={import.meta.env.BASE_URL} />
    <script is:inline>
      (function () {
        var t = document.querySelector('.nav__toggle'), m = document.getElementById('menu-nav');
        if (t && m) m.addEventListener('toggle', function (e) { t.setAttribute('aria-expanded', e.newState === 'open' ? 'true' : 'false'); });
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = [].filter.call(document.querySelectorAll('main .section > .container'), function (el) { return el.getBoundingClientRect().top > innerHeight * 0.9; });
        els.forEach(function (el) { el.setAttribute('data-reveal', ''); });
        var queued = false;
        function check() { queued = false; els = els.filter(function (el) { if (el.getBoundingClientRect().top < innerHeight * 0.92) { el.classList.add('is-in'); return false; } return true; }); if (!els.length) { removeEventListener('scroll', tick); removeEventListener('resize', tick); } }
        function tick() { if (!queued) { queued = true; requestAnimationFrame(check); } }
        addEventListener('scroll', tick, { passive: true }); addEventListener('resize', tick);
      })();
    </script>
  </body>
</html>
