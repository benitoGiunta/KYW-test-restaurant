---
import Base from '../layouts/Base.astro';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable, Carré d’herbes" description="Cette page n’existe pas." page="404">
  <section class="pagehead"><div class="container stack"><h1>Cette page n’existe pas</h1><p class="lead">Elle a peut-être changé d’adresse.</p><a class="btn" href={B}>Retour à l’accueil</a></div></section>
</Base>
