---
const { p, caption, hero = false, sizes = '(min-width: 1000px) 45vw, 100vw' } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<figure class="fig">
  <img src={B + p.src} width={p.w} height={p.h} alt={p.alt} sizes={sizes} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : undefined} decoding="async" />
  {caption && <figcaption class="small">{caption}</figcaption>}
</figure>
