---
import { nav, resto } from '../data/site';
const { page } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const items = [...nav, { href: 'bon-cadeau/', label: 'Bon cadeau', page: 'cadeau' }];
---
<header class="nav">
  <div class="container">
    <a class="nav__brand" href={B} aria-label="Carré d’herbes, accueil">Carré d’herbes</a>
    <nav aria-label="Navigation principale">
      <ul class="nav__links">
        {items.map((i) => <li><a href={B + i.href} aria-current={page === i.page ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav__end">
      <a class="nav__tel" href={resto.telHref}>{resto.tel}</a>
      <a class="btn btn--line" href={B + 'reservations/'}>Réserver</a>
      <button class="nav__toggle" type="button" popovertarget="menu-nav" aria-expanded="false" aria-controls="menu-nav">Menu</button>
      <div class="nav__panel" id="menu-nav" popover aria-label="Navigation">
        <ul>{items.map((i) => <li><a href={B + i.href} aria-current={page === i.page ? 'page' : undefined}>{i.label}</a></li>)}<li><a href={resto.telHref}>{resto.tel}</a></li></ul>
      </div>
    </div>
  </div>
</header>
