---
import { nav, resto } from '../data/site';
const { page } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const items = [...nav, { href: 'bon-cadeau/', label: 'Bon cadeau', page: 'cadeau' }];
---
<header class="nav">
  <div class="container">
    <a class="nav__brand" href={B}>Carré d’herbes</a>
    <nav aria-label="Navigation principale">
      <ul class="nav__links">
        {items.map((i) => <li><a href={B + i.href} aria-current={page === i.page ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav__end">
      <a class="nav__tel" href={resto.telHref}>{resto.tel}</a>
      <a class="btn" href={B + 'reservations/'}>Comment réserver</a>
      <details class="nav__menu">
        <summary>Menu</summary>
        <ul>{items.map((i) => <li><a href={B + i.href}>{i.label}</a></li>)}<li><a href={resto.telHref}>{resto.tel}</a></li></ul>
      </details>
    </div>
  </div>
</header>
