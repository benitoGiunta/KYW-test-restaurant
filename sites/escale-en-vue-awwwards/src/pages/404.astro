---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Page introuvable" description="Cette page n’existe pas ou plus. Retour à Escale en Vue !, terrasse et restaurant à Dave.">
  <section class="wrap perdu">
    <h1 class="perdu__titre display">Pas d’escale à cette adresse.</h1>
    <div class="horizon perdu__ligne" aria-hidden="true"></div>
    <p class="petit">Rien en vue sur cette page.</p>
    <p class="quatre__lien"><a class="cta" href={u('/')}><span class="cta__txt">Retour à la terrasse</span></a><a class="cta cta--contour" href={u('/carte/')}><span class="cta__txt">La carte</span></a></p>
  </section>
</Base>
