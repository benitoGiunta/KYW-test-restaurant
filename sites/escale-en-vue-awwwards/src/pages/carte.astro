---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { carte, site } from '../data/site';
const fmt = (p: number | null) => (p == null ? null : `${p.toFixed(2).replace('.', ',')} €`);
---
<Base page="carte" title="La carte" description="L’offre d’Escale en Vue ! à Dave : apéro planchette, plat maison sur réservation avec variante végé, bières trappistes et régionales, softs.">
  <section class="wrap page-tete">
    <h1 class="page-tete__titre display">La carte</h1>
    <p class="page-tete__chapeau">Petites assiettes fraîches et locales, bières de la région, une alternative végé à chaque plat.</p>
  </section>
  <p class="wrap carte__note petit">Aucune carte ni aucun prix ne sont publiés par la maison : cette page reprend l’offre mentionnée, sans tarif.</p>
  {carte.map((c) => (
    <section class="carte__cat" id={c.id} aria-labelledby={`cat-${c.id}`}>
      <div class="wrap grille">
        <h2 class="index__titre display" id={`cat-${c.id}`}>{c.titre}</h2>
        <ul class="index__liste">
          {c.plats.map((p) => (
            <li class={`index__ligne${p.photo ? ' index__ligne--photo' : ''}`}>
              <div>
                <p class="index__nom">{p.nom}</p>
                <p class="index__desc">{p.description}</p>
                {fmt(p.prix) && <p class="index__prix" style="font-variant-numeric:tabular-nums">{fmt(p.prix)}</p>}
              </div>
              {p.photo && <div class="index__vignette"><Photo cle={p.photo === 'bol' ? 'bol' : p.photo === 'planchette' ? 'planchette' : 'trappistes'} sizes="176px" widths={[176, 352]} decorative /></div>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
