  verre: `<path d="M30 10 H70 L66 40 Q62 58 50 58 Q38 58 34 40 Z"/><path d="M50 58 V84"/><path d="M34 88 H66"/><path d="M36 28 H64"/>
    <path d="M40 20 Q50 24 60 20" stroke-dasharray="2 4"/>`,
  basilic: `<path d="M50 90 V52"/><path d="M50 52 C20 48 14 20 50 8 C86 20 80 48 50 52 Z"/><path d="M50 52 V16"/><path d="M50 40 L36 28"/><path d="M50 40 L64 28"/><path d="M50 30 L42 22"/><path d="M50 30 L58 22"/>
