---
// Boutons de coin : Appeler (bas gauche) et Commander (rouge, bas droite), fixes sur toutes les pages ;
// barre basse en mobile ; se retirent quand le pied de page est visible.
import { site, telHref } from '../data/site';
import { u } from '../lib/url';

---
<div class="coins" data-coins>
  <a class="coin coin--gauche" href={telHref()}><span class="coin__fleche" aria-hidden="true">←</span><span>Appeler</span></a>
  <a class="coin coin--droite" href={u('/commander/')}><span>Commander</span><span class="coin__fleche" aria-hidden="true">→</span></a>
</div>
