---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="La carte" description={`La carte de ${site.nom} à ${site.adresse.commune} : nigiri, maki, temaki, menus et box, plats chauds, salades, bières et boissons, avec les prix.`}>
  <section class="hero hero--page col-l">
    <h1 class="hero__titre tube" data-tube>La carte</h1>
    <p class="lead" data-reveal="fade">{site.accroche.carte} Prix en euros, à emporter ou en livraison.</p>
  </section>

  <section class="section section--serre col-l" aria-labelledby="formules">
    <h2 id="formules" class="meta" style="margin-bottom: calc(var(--u) * 3)">Menus et box</h2>
    <ul class="menus" style="list-style: none; padding: 0">
      {site.menus.map((m, i) => (
        <li class="menu" data-reveal="up" data-delay={String(i * 0.08)}>
          <p class="titre" style="font-size: var(--t-m)">{m.nom}</p>
          <p class="menu__prix">{m.prix}</p>
          {m.description && <p>{m.description}</p>}
        </li>
      ))}
    </ul>
  </section>

  {site.carte.map((cat) => {
    const [titre, ...reste] = cat.categorie.split(/,\s*/);
    const detail = reste.join(', ').replace(/[()]/g, '');
    return (
    <section class="section section--serre col-l">
      <div class="section__tete">
        <h2 class="tube tube--l" data-tube data-reveal="fade">{titre}</h2>
        {detail && <p class="meta">{detail}</p>}
      </div>
      <ol class="index" data-reveal="fade">
        {cat.plats.map((p, i) => (
          <li class="index__item">
            <span class="index__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="index__nom">{p.nom}</span>
            <span class="index__prix">{p.prix ?? ''}</span>
            {p.description && <span class="index__desc">{p.description}</span>}
          </li>
        ))}
      </ol>
    </section>
    );
  })}

  <section class="section col-l">
    <div class="actions" style="margin-top: 0">
      <a class="btn btn--ambre" href={u('/commander/')}>Commander <span class="fleche" aria-hidden="true">→</span></a>
      <a class="btn" href={u('/boissons/')}>Les boissons</a>
    </div>
  </section>
</Base>
