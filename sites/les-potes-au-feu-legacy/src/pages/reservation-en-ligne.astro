---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Horaires from '../components/Horaires.astro';
import { resto } from '../data/site';
---
<Base
  page="reservation-en-ligne"
  title="Réservation en ligne, Les Potes au Feu à Namur"
  description="Réservez votre table aux Potes au Feu, à Namur, en ligne avec Zenchef ou par téléphone pour la dernière minute."
>
  <section class="banner banner--split" aria-labelledby="page-titre">
    <div class="container">
      <div class="banner__head">
        <h1 id="page-titre">Réservation en ligne</h1>
        <p class="lead">Choisissez votre soir, votre heure et vos couverts : la table vous attend.</p>
      </div>
    </div>
  </section>

  <section class="book section section--top0" aria-label="Module de réservation">
    <div class="container book__grid">
      <div>
        <div class="book__frame">
          <iframe src={resto.zenchef} title="Réserver une table aux Potes au Feu avec Zenchef" loading="lazy"></iframe>
        </div>
        <p class="caption">Le module ne s’affiche pas ? <a href={resto.zenchef}>Ouvrir la réservation Zenchef</a>.</p>
      </div>
      <aside class="book__aside" aria-labelledby="tel-titre">
        <h2 id="tel-titre">Dernière minute ou plus de six personnes</h2>
        <p>Pour toute réservation de dernière minute ou de plus de 6 personnes, merci de nous appeler.</p>
        <p class="book__phone"><a href={resto.telHref}>{resto.telAffiche}</a></p>
        <Horaires compact />
        <Photo nom="23-salle-banquette-michelin" largeurs={[640, 1280]} w={1280} h={1280} slot="salle-jour"
          alt="La salle de jour : banquette, coussins moutarde, lambris vert-gris, tables en chêne" sizes="(min-width: 60rem) 36vw, 100vw" />
      </aside>
    </div>
  </section>
</Base>
