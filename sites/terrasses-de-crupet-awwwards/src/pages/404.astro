---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Page introuvable" description="Cette page n’existe pas ou plus. Retrouvez la carte, le lieu et la réservation des Terrasses de Crupet.">
  <section class="perdu">
    <div class="wrap perdu__in">
      <div class="hublot perdu__rond" aria-hidden="true" data-iris="intro"><span class="display">404</span></div>
      <div class="perdu__txt">
        <h1 class="display display--xl" data-split="lines" data-intro>Cette table n’existe pas</h1>
        <p class="lede">La page demandée est introuvable. Le miroir reflète seulement la salle : repartons de l’accueil.</p>
        <p class="perdu__cta"><a class="btn btn--solid ui" href={base}>Retour à l’accueil</a> <a class="btn ui" href={`${base}carte/`}>La carte</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .perdu { padding-block: clamp(3rem, 8vw, 7rem); }
  .perdu__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--gutter); align-items: center; }
  .perdu__rond { display: grid; place-items: center; background: var(--c-panel); }
  .perdu__rond span { font-size: var(--t-mega); color: var(--c-accent); letter-spacing: -0.04em; }
  .perdu__txt { display: grid; gap: 1.5rem; justify-items: start; }
  .perdu__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 720px) { .perdu__in { grid-template-columns: 1fr; } .perdu__rond { width: 70%; } }
</style>
