---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photos, credit } from '../data/photos';
import { restaurant as r, signatures, platsParNom, euro, menuFetes } from '../data/site';
const base = import.meta.env.BASE_URL;
const trois = [
  { p: photos.terrasse, t: 'La terrasse', d: 'Longues tables sous auvent, pour déjeuner dehors.', up: 0 },
  { p: photos.miroirs, t: 'La salle', d: 'Murs verts, fauteuils cuivrés, trois miroirs ronds.', up: 1 },
  { p: photos.bar, t: 'Le bar', d: 'Cocktails maison, bières belges, vins au verre.', up: 2 },
];
---
<Base description={r.description}>
  <section class="hero" aria-labelledby="h1">
    <div class="wrap grid hero__grid">
      <div class="hero__text">
        <h1 id="h1" class="display display--mega" data-split="lines" data-intro>Les Terrasses<br />de Crupet</h1>
        <p class="lede hero__lede" data-reveal="up" data-intro>{r.baseline} Brasserie familiale, ouverte tous les jours.</p>
        <p class="hero__cta" data-reveal="up" data-intro>
          <a class="btn btn--solid ui" href={r.reservationUrl} rel="noopener">Réserver une table</a>
          <a class="btn ui" href={r.phoneHref}>Appeler le {r.phone}</a>
        </p>
      </div>
      <div class="hero__hublot hublot" data-reveal="scale" data-intro>
        <Image src={photos.miroirs.src} alt={photos.miroirs.alt} widths={[480, 720, 960]} sizes="(min-width: 900px) 40vw, 90vw" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="rule trois" aria-labelledby="h-trois">
    <div class="wrap">
      <h2 id="h-trois" class="display display--xl trois__title" data-split="lines">Trois miroirs, trois façons de s’asseoir</h2>
      <ul class="trois__row">
        {trois.map((x) => (
          <li class={`trois__item up-${x.up}`}>
            <div class="hublot" data-reveal="scale">
              <Image src={x.p.src} alt={x.p.alt} widths={[400, 640]} sizes="(min-width: 900px) 30vw, 80vw" loading="lazy" decoding="async" />
            </div>
            <h3 class="display display--l">{x.t}</h3>
            <p class="muted">{x.d}</p>
          </li>
        ))}
      </ul>
      <p class="credit">{credit}</p>
    </div>
  </section>

  <section class="rule horaires" aria-labelledby="h-horaires">
    <div class="wrap grid">
      <h2 id="h-horaires" class="horaires__title display display--xl" data-split="lines">Deux services, sept jours sur sept</h2>
      <ul class="horaires__list">
        {r.services.map((s) => (
          <li><span class="display display--l">{s.nom}</span><span class="price display display--l">{s.de} à {s.a}</span></li>
        ))}
      </ul>
      <p class="horaires__note muted">{r.note} On peut réserver dans le restaurant ou dans le chalet d’hiver.</p>
    </div>
  </section>

  <section class="rule extrait" aria-labelledby="h-carte">
    <div class="wrap grid">
      <div class="extrait__head">
        <h2 id="h-carte" class="display display--xl" data-split="lines">À la carte</h2>
        <p class="lede">Cuisine de brasserie, plats à partager, carte enfants, une cinquantaine de vins.</p>
        <p><a class="btn ui" href={`${base}carte/`}>Voir toute la carte</a></p>
      </div>
      <ol class="extrait__list">
        {signatures.map((nom) => {
          const p = platsParNom(nom);
          return (
            <li>
              <div><h3 class="display display--l extrait__nom">{p.nom}</h3>{p.description && <p class="muted">{p.description}</p>}</div>
              <span class="price display display--l">{euro(p.prix)}</span>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="rule fetes" aria-labelledby="h-fetes">
    <div class="wrap grid">
      <div class="fetes__img hublot" data-reveal="scale">
        <Image src={photos.chalet.src} alt={photos.chalet.alt} widths={[400, 640]} sizes="(min-width: 900px) 28vw, 70vw" loading="lazy" decoding="async" />
      </div>
      <div class="fetes__txt">
        <h2 id="h-fetes" class="display display--l" data-split="lines">Menus de fêtes à emporter</h2>
        <p class="prose">De {menuFetes.prix}, à retirer {menuFetes.retrait}. Des bons cadeaux sont aussi proposés au restaurant.</p>
        <p><a class="btn ui" href={`${base}reservation/`}>Comment réserver</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3rem, 7vw, 6rem); }
  .hero__grid { align-items: center; row-gap: 2rem; }
  .hero__text { grid-column: 1 / span 7; grid-row: 1; }
  .hero__hublot { grid-column: 8 / span 5; grid-row: 1; width: 100%; }
  .hero__lede { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .hero__cta { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 900px) {
    .hero__text { grid-column: 1 / -1; grid-row: 1; }
    .hero__hublot { grid-column: 2 / span 3; grid-row: 2; }
  }
  .trois__title { max-width: 16ch; }
  .trois__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); margin-top: clamp(2rem, 5vw, 4rem); align-items: start; }
  .trois__item { display: grid; gap: 0.75rem; align-content: start; }
  .trois__item .display { margin-top: 0.75rem; }
  .up-1 { margin-top: clamp(2rem, 6vw, 6rem); }
  .up-2 { margin-top: clamp(1rem, 3vw, 3rem); }
  .trois .credit { margin-top: 3rem; }
  @media (max-width: 720px) {
    .trois__row { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); gap: 1rem; padding-bottom: 1rem; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .trois__item { flex: 0 0 78%; scroll-snap-align: start; margin-top: 0 !important; }
  }
  .horaires__title { grid-column: 1 / span 6; }
  .horaires__list { grid-column: 8 / span 5; align-self: end; }
  .horaires__list li { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--c-line); align-items: baseline; }
  .horaires__list li:first-child { border-top: 1px solid var(--c-line); }
  .horaires__note { grid-column: 8 / span 5; margin-top: 1.25rem; max-width: 46ch; }
  @media (max-width: 900px) { .horaires__title, .horaires__list, .horaires__note { grid-column: 1 / -1; } .horaires__list { margin-top: 2rem; } }
  .extrait__head { grid-column: 1 / span 4; display: grid; gap: 1.5rem; align-content: start; }
  .extrait__list { grid-column: 6 / span 7; }
  .extrait__list li { display: flex; justify-content: space-between; gap: 1.5rem; padding-block: 1.1rem; border-bottom: 1px solid var(--c-line); align-items: baseline; }
  .extrait__list li:first-child { border-top: 1px solid var(--c-line); }
  .extrait__nom { font-size: var(--t-m); line-height: 1.15; letter-spacing: -0.01em; }
  .extrait__list .price { font-size: var(--t-m); }
  @media (max-width: 900px) { .extrait__head, .extrait__list { grid-column: 1 / -1; } .extrait__list { margin-top: 2.5rem; } }
  .fetes__img { grid-column: 2 / span 4; }
  .fetes__txt { grid-column: 7 / span 5; display: grid; gap: 1.5rem; align-content: center; justify-items: start; }
  @media (max-width: 900px) { .fetes__img { grid-column: 1 / span 3; } .fetes__txt { grid-column: 1 / -1; margin-top: 2rem; } }
</style>
