---
import Base from '../layouts/Base.astro';
import { site, photoDe } from '../data/site';
import { u, asset } from '../lib/url';
const ancres: [RegExp, string][] = [
  [/^La cuisine \(servie de 12h/, 'salon'],
  [/^Pâtisseries et assiettes/, 'patisserie'],
  [/^Boulangerie/, 'boulangerie'],
  [/^Fêtes/, 'chocolaterie'],
];
const photos: Record<string, string> = {
  'La cuisine (servie de 12h00 à 15h00)': '/photos/salle-rayures.webp',
  'Pâtisseries et assiettes': '/photos/entremets-dore.webp',
  'Boulangerie (carte des fêtes 2026-2027)': '/photos/pain-croute.webp',
  "Fêtes de fin d'année 2026-2027 (commandes)": '/photos/entremets-chocolat.webp',
};
const ancre = (c: string) => ancres.find(([re]) => re.test(c))?.[1];
const labels = ['Suggestions', 'Cuisine de midi', "Cuisine de l'après-midi", 'Petit déjeuner', 'Desserts et boissons', 'Pâtisseries', 'Crêpes', 'Glaces', 'Gaufres et milk-shakes', 'Boissons chaudes', 'Boissons froides', 'Boulangerie', 'Fêtes'];
const idDe = (c: string, i: number) => ancre(c) ?? `rubrique-${i + 1}`;
const liens = site.carte.map((c, i) => [idDe(c.categorie, i), labels[i] ?? c.categorie.replace(/\s*\(.*?\)/g, '')]);
---
<Base title="La carte" description={`La carte de ${site.nom} à ${site.adresse.commune} : suggestions du moment, cuisine de midi, crêpes, glaces, gaufres, boissons, boulangerie et fêtes.`}>
  <section class="page-hero" style="background: var(--c-rose)" data-activite="La carte" data-couleur="rose">
    <div class="wrap page-hero__inner">
      <h1><span class="etiquette etiquette--ink">La <em>carte</em></span></h1>
      <p class="lead">Du petit déjeuner aux coupes glacées, du pain aux pralines : toute la carte de la maison, de la cuisine de midi aux fêtes.</p>
    </div>
  </section>

  <nav class="sommaire" aria-label="Rubriques de la carte" data-sommaire>
    {liens.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
  </nav>

  <div class="wrap">
    {site.carte.map((cat, i) => {
      const ph = photos[cat.categorie] ? photoDe(photos[cat.categorie]) : null;
      return (
        <section class="carte-cat" id={idDe(cat.categorie, i)}>
          <div class="damier" class:list={[i % 2 ? 'damier--inv' : '']}>
            <div>
              <h2 class="titre titre--l"><span class="etiquette">{cat.categorie}</span></h2>
              <ul class="lignes">
                {cat.plats.map((p) => (
                  <li>
                    <span>{p.nom}{p.placeholder && <span class="illu">exemple</span>}{p.description && <span class="muted"> ({p.description})</span>}</span>
                    {p.prix && <span class:list={[p.prix.length > 16 ? 'prix--long' : '']}>{p.prix}</span>}
                  </li>
                ))}
              </ul>
            </div>
            {ph && <div class="damier__photo"><img src={asset(ph.src)} alt={ph.alt} width={ph.largeur} height={ph.hauteur} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>}
          </div>
        </section>
      );
    })}
  </div>

  <section class="aplat aplat--postit" aria-labelledby="t-formules">
    <div class="wrap">
      <h2 class="titre titre--l" id="t-formules"><span class="etiquette" data-split="lines">Les <em>formules</em></span></h2>
      <div class="formules" data-reveal="up">
        {site.menus.map((m) => (
          <article class="formule">
            <h3>{m.nom}</h3>
            <p class="prix">{m.prix}</p>
            <p class="muted">{m.description}</p>
          </article>
        ))}
      </div>
      <div class="actions">
        <a class="btn btn--ink" href={site.boutique.url} rel="noopener">Commander en ligne</a>
        <a class="btn" href={u('/contact/')}>Horaires et contact</a>
      </div>
    </div>
  </section>
</Base>
