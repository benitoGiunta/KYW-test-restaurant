---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { u } from '../lib/url';
---
<Base title="Page introuvable" description={`Cette page n'existe pas ou plus sur le site de ${site.nom}. Retrouvez la carte, les fêtes et les horaires depuis l'accueil.`}>
  <section class="page-hero" style="background: var(--c-postit)">
    <div class="wrap page-hero__inner">
      <h1><span class="etiquette etiquette--ink">Décollé</span></h1>
      <p class="lead">Ce flyer n'est plus sur le mur. L'adresse a peut-être changé de nom, ou contient une coquille. Le reste est bien collé : la carte, les fêtes et les horaires.</p>
    </div>
  </section>
  <section class="aplat aplat--ecru" style="border-top: 0">
    <div class="wrap actions" style="margin-top: 0">
      <a class="btn btn--ink" href={u('/')}>Retour à l'accueil</a>
      <a class="btn" href={u('/carte/')}>La carte</a>
      <a class="btn" href={u('/contact/')}>Horaires et contact</a>
    </div>
  </section>
</Base>
