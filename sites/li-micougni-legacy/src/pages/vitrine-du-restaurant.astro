---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="La vitrine de Li Micougni : les plats et la salle en photos" description="Les nouveautés de Li Micougni à Namur : plats, salle et coulisses du lancement, en photos." page="vitrine-du-restaurant">
  <section class="stage stage--short" aria-labelledby="h-vitrine">
    <div class="container rows-layout">
      <div class="rows-layout__head">
        <h1 id="h-vitrine">Vitrine du restaurant</h1>
      </div>
      <div>
        <p class="lead">Les nouvelles de Li Micougni : ce qu’on y mange de nouveau, et l’aventure qui prend forme.</p>
        <p class="actions"><a class="btn btn--primary" href={`${base}contact/#reserver`}><span>Réserver une table</span></a></p>
      </div>
    </div>
  </section>

  <section class="sec sec--s" aria-labelledby="h-nouv">
    <div class="container">
      <h2 id="h-nouv" class="sec__title">Nos dernières nouveautés</h2>
      <div class="bento">
        <Fig id="saumon" class="bento__lead" sizes="(min-width: 60rem) 64vw, 100vw" pos="50% 50%" />
        <Fig id="rouget" class="bento__t" sizes="(min-width: 60rem) 30vw, 100vw" />
        <Fig id="poisson" class="bento__t" sizes="(min-width: 60rem) 30vw, 100vw" />
        <Fig id="veloute" class="bento__t" sizes="(min-width: 60rem) 30vw, 100vw" />
        <Fig id="viande" class="bento__lead2" sizes="(min-width: 60rem) 64vw, 100vw" />
        <Fig id="roast-beef" class="bento__t" sizes="(min-width: 60rem) 30vw, 100vw" />
      </div>
    </div>
  </section>
</Base>
