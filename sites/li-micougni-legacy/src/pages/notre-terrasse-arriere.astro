---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import Horaires from '../components/Horaires.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="La terrasse arrière de Li Micougni, une cour privée à Namur" description="Une terrasse de 30 couverts dans une cour privée, ouverte toute l’année, au cœur de Namur." page="notre-terrasse-arriere">
  <section class="stage" aria-labelledby="h-terrasse">
    <div class="container split split--5-7 split--stage">
      <div class="split__text">
        <h1 id="h-terrasse">Notre terrasse arrière</h1>
        <p class="lead">Ouverte toute l’année, pour déguster vos plats favoris en plein air.</p>
        <p class="actions"><a class="btn btn--primary" href={`${base}contact/#reserver`}><span>Réserver une table</span></a></p>
      </div>
      <Fig id="terrasse" ratio="4 / 5" sizes="(min-width: 60rem) 56vw, 100vw" pos="50% 70%" priority />
    </div>
  </section>

  <section class="sec sec--m" aria-label="La terrasse en trois faits">
    <div class="container rows-layout">
      <div class="rows-layout__head"><h2>Dans la cour</h2></div>
      <dl class="facts">
        <div class="fact"><dt>Couverts</dt><dd class="fact__big num">30</dd></div>
        <div class="fact"><dt>Lieu</dt><dd class="fact__big">Une cour privée</dd></div>
        <div class="fact"><dt>Saison</dt><dd class="fact__big">Toute l’année</dd></div>
      </dl>
    </div>
  </section>

  <section class="sec sec--l" aria-labelledby="h-braise">
    <div class="container split split--6-6">
      <div>
        <Fig id="grill" ratio="4 / 5" sizes="(min-width: 60rem) 40vw, 100vw" pos="50% 55%" />
        <p class="caption">Le grill au charbon de bois, dans la cour.</p>
      </div>
      <div class="split__text">
        <h2 id="h-braise">Les grillades dehors</h2>
        <p class="lead">Entrecôte, onglet, magret, spareribs ou épées : tout se cuit au charbon de bois.</p>
        <p><a class="link" href={`${base}menu/#les-grillades`}>Voir les grillades</a></p>
      </div>
    </div>
  </section>

  <Horaires />
</Base>
