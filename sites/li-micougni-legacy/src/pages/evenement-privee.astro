---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
import { resto } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Évènement privé à Namur, privatiser Li Micougni" description="Anniversaire, réunion ou évènement professionnel : Li Micougni se privatise, avec un menu adapté à votre budget." page="evenement-privee">
  <section class="stage" aria-labelledby="h-event">
    <div class="container split split--5-7 split--stage">
      <div class="split__text">
        <h1 id="h-event">Un évènement&nbsp;?</h1>
        <p class="lead">Anniversaire, évènement professionnel ou autre occasion : un cadre chaleureux, des menus adaptés.</p>
        <p class="actions"><a class="btn btn--primary" href={`${base}contact/`}><span>Nous contacter</span></a></p>
      </div>
      <Fig id="salle" ratio="4 / 3" sizes="(min-width: 60rem) 56vw, 100vw" pos="50% 60%" priority />
    </div>
  </section>

  <section class="sec sec--l" aria-label="Ce que nous proposons">
    <div class="container">
      <ul class="rows rows--wide">
        <li class="row row--3"><h2 class="row__title">À votre disposition</h2><p>Anniversaire, mariage, réunion professionnelle ou toute autre occasion : l’équipe vous accompagne.</p></li>
        <li class="row row--3"><h2 class="row__title">Un lieu privatisé</h2><p>Le restaurant devient un lieu réservé à vous et à vos invités, avec amuse-bouches, entrées et plats.</p></li>
        <li class="row row--3"><h2 class="row__title">Un menu adapté</h2><p>Un menu personnalisé, qui respecte votre budget et vos goûts.</p></li>
      </ul>
    </div>
  </section>

  <section class="sec sec--m" aria-labelledby="h-parler">
    <div class="container split split--6-6">
      <Fig id="salle-tables" ratio="4 / 5" sizes="(min-width: 60rem) 40vw, 100vw" pos="50% 60%" />
      <div class="split__text">
        <h2 id="h-parler">Parlons de votre date</h2>
        <p><a class="num" href={resto.tel.href}>{resto.tel.affiche}</a><br /><a href={`mailto:${resto.email}`}>{resto.email}</a></p>
        <p class="actions"><a class="btn btn--primary" href={`${base}contact/`}><span>Écrire au restaurant</span></a></p>
      </div>
    </div>
  </section>
</Base>
