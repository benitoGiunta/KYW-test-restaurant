---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Page introuvable, Li Micougni" page="404">
  <section class="stage" aria-labelledby="h-404">
    <div class="container rows-layout">
      <div class="rows-layout__head"><h1 id="h-404">Page introuvable</h1></div>
      <div>
        <p class="lead">Cette page n’existe pas ou n’existe plus.</p>
        <p class="actions"><a class="btn btn--primary" href={base}><span>Retour à l’accueil</span></a> <a class="btn" href={`${base}menu/`}><span>La carte</span></a></p>
      </div>
    </div>
  </section>
</Base>
