---
import Base from '../layouts/Base.astro';
import Fig from '../components/Fig.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="L’histoire de Li Micougni, deux passionnés de l’horeca à Namur" description="Li Micougni est né de l’amitié de deux passionnés de l’horeca, avec la culture wallonne et le plaisir de se retrouver." page="a-propos-de-nous">
  <section class="stage" aria-labelledby="h-histoire">
    <div class="container split split--7-5 split--stage">
      <div class="split__text">
        <h1 id="h-histoire">Notre histoire, votre expérience</h1>
        <p class="lead">Li Micougni est né de l’amitié de deux passionnés du monde de l’horeca.</p>
      </div>
      <Fig id="polaroids" ratio="3 / 4" sizes="(min-width: 60rem) 36vw, 100vw" pos="50% 40%" priority />
    </div>
  </section>

  <section class="sec sec--l" aria-label="Le concept et l’histoire">
    <div class="container">
      <ul class="rows rows--wide">
        <li class="row row--3"><h2 class="row__title">À propos de nous</h2><p>Nous voulions un lieu chaleureux et accueillant, où la bonne cuisine et le plaisir de partager sont à l’honneur.</p></li>
        <li class="row row--3"><h2 class="row__title">Notre concept</h2><p>Partager de bons moments autour de plats savoureux : des planches à partager, des produits frais et locaux, une carte qui évolue avec les saisons.</p></li>
        <li class="row row--3"><h2 class="row__title">Une histoire wallonne</h2><p>Une passion pour la culture wallonne et pour les retrouvailles autour d’une bonne table, avec des plats faits maison.</p></li>
      </ul>
    </div>
  </section>

  <section class="sec sec--band fibre" aria-labelledby="h-demi">
    <div class="container">
      <h2 class="statement" id="h-demi">Vous êtes tous les bienvenus, même les demi-fous.</h2>
      <p class="statement__link"><a class="link" href={`${base}contact/#reserver`}>Réserver une table</a></p>
    </div>
  </section>

  <section class="sec sec--m" aria-labelledby="h-valeurs">
    <div class="container split split--5-7">
      <h2 id="h-valeurs">Ce que nous gardons</h2>
      <ul class="rows">
        <li class="row row--2"><h3>Produits locaux et de saison</h3></li>
        <li class="row row--2"><h3>Fait maison</h3></li>
        <li class="row row--2"><h3>Une carte qui évolue</h3></li>
        <li class="row row--2"><h3>Convivialité et partage</h3></li>
      </ul>
    </div>
  </section>
</Base>
