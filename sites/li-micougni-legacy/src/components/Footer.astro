---
import { resto, nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="foot" aria-label="Coordonnées du restaurant">
  <div class="container foot__grid">
    <div class="foot__letter">
      <p class="foot__sign">Vous êtes tous les bienvenus, même les demi-fous.</p>
      <p class="foot__from">Li Micougni, {resto.adresse.rue}, {resto.adresse.ville}.</p>
    </div>
    <div class="foot__col">
      <p><a class="num" href={resto.tel.href}>{resto.tel.affiche}</a><br /><a href={`mailto:${resto.email}`}>{resto.email}</a></p>
      <p><a href={resto.instagram} rel="noopener">Instagram</a><br /><a href={resto.facebook} rel="noopener">Facebook</a></p>
    </div>
    <ul class="foot__col foot__nav">
      {nav.map((n) => <li><a href={`${base}${n.href}`}>{n.label}</a></li>)}
    </ul>
    <p class="foot__credits" data-credits>Photographies : Li Micougni. Site d’origine : <a href={resto.site} rel="noopener">limicougni.com</a>.</p>
  </div>
</section>
