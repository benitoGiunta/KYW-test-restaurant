---
import { resto, jours } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="sec sec--horaires" id="horaires" aria-labelledby="h-horaires">
  <div class="container horaires">
    <div class="horaires__head">
      <h2 id="h-horaires">Horaires et adresse</h2>
      <p class="lead">Ouvert à partir de mardi soir 17&nbsp;h jusqu’à dimanche 17&nbsp;h.</p>
      <p class="actions"><a class="btn btn--primary" href={`${base}contact/#reserver`}><span>Réserver une table</span></a> <a class="btn" href={resto.tel.href}><span>{resto.tel.affiche}</span></a></p>
    </div>
    <dl class="sched">
      {jours.map((j) => (
        <div class:list={['sched__row', j.ferme && 'is-closed']} data-jour={j.jour}>
          <dt>{j.jour}</dt>
          <dd>{j.fill ? <span class="fill" data-fill="horaires">{j.fill}</span> : j.val}</dd>
        </div>
      ))}
    </dl>
    <address class="lieu">
      <p class="lieu__rue">{resto.adresse.rue}<br />{resto.adresse.ville}</p>
      <p><a href={resto.itineraire} rel="noopener">Itinéraire</a></p>
    </address>
  </div>
</section>
