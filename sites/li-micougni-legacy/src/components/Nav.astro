---
import { resto, nav } from '../data/site';
interface Props { page: string }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="nav">
  <nav class="nav__pill" aria-label="Navigation principale">
    <a class="nav__brand" href={base} aria-label="Li Micougni, accueil">
      <img src={`${base}photos/logo-96.png`} srcset={`${base}photos/logo-96.png 1x, ${base}photos/logo-360.webp 3x`} width="48" height="48" alt="" />
      <span class="nav__name">Li Micougni</span>
    </a>
    <ul class="nav__links">
      {nav.map((n) => <li><a href={`${base}${n.href}`} aria-current={page === n.href.replace('/', '') ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
    <a class="btn nav__cta" href={`${base}contact/#reserver`}><span>Réserver</span></a>
    <button class="nav__burger" type="button" popovertarget="nav-menu" aria-expanded="false" aria-controls="nav-menu"><span class="nav__b-closed">Menu</span><span class="nav__b-open">Fermer</span></button>
    <div class="menu" id="nav-menu" popover>
      <ul>
        {nav.map((n) => <li><a href={`${base}${n.href}`} aria-current={page === n.href.replace('/', '') ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <a class="btn btn--primary menu__cta" href={`${base}contact/#reserver`}><span>Réserver une table</span></a>
    </div>
  </nav>
</header>
