---
import Base from '../layouts/Base.astro';
import Plan from '../components/Plan.astro';
import { u } from '../lib/url';
---
<Base page="404" title="Table introuvable" description="Cette page n’existe pas : Le 54 compte trente-quatre couverts, et aucun à cette adresse. Retour à l’accueil, à la carte ou à la réservation.">
  <section class="perdu wrap g12" aria-labelledby="h1">
    <h1 class="display perdu__titre" id="h1">Cette table n’existe pas.</h1>
    <div class="perdu__plan"><Plan lit={0} /><p class="plan-note" data-reveal="fade" data-intro data-delay="1.2">Trente-quatre couverts, et aucun à cette adresse.</p></div>
    <div class="perdu__bas">
      <p>La page que vous cherchez n’est pas à notre carte. Revenez à l’accueil ou choisissez une table.</p>
      <div class="actions">
        <a class="cta" href={u('/')}><span class="cta__txt">Retour à l’accueil</span></a>
        <a class="cta cta--ghost" href={u('/carte/')}><span class="cta__txt">La carte</span></a>
        <a class="cta cta--ghost" href={u('/reservation/')}><span class="cta__txt">Réserver</span></a>
      </div>
    </div>
  </section>
</Base>
