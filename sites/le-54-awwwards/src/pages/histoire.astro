---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { histoire, equipe, site } from '../data/site';
---
<Base page="histoire" title="Histoire" description="L’histoire du restaurant Le 54 à Dave : la famille Collignon reprend la maison en 2010 et le chef Jonathan Collignon en fait une table gastronomique.">
  <section class="entete wrap g12" aria-labelledby="h1">
    <h1 class="display entete__titre" id="h1">Histoire</h1>
    <p class="entete__lead">{histoire.chapeau}</p>
  </section>

  <section class="histoire wrap g12" aria-label="La maison et son chef">
    <div class="histoire__texte">
      {histoire.paragraphes.map((p) => <p>{p}</p>)}
    </div>
    <dl class="equipe">
      {equipe.map((e) => <div><dt>{e.nom}</dt><dd>{e.role}</dd></div>)}
    </dl>
  </section>

  <section class="paire paire--inverse wrap g12" aria-labelledby="geste-titre">
    <figure class="paire__media">
      <Photo cle="geste" sizes="(min-width: 48rem) 58vw, 100vw" widths={[480, 800, 1200, 1600]} />
      <figcaption>Le dressage, en cuisine. {site.credit}.</figcaption>
    </figure>
    <div class="paire__texte">
      <h2 class="display d-l" id="geste-titre">Le geste avant le décor.</h2>
      <p>Ici, l’assiette se dresse à la main, plat après plat, pour trente-quatre couverts au plus.</p>
      <p><a class="lien" href={u('/carte/')}>Voir la carte</a></p>
    </div>
  </section>
</Base>
