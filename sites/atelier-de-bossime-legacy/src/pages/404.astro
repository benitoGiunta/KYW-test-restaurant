---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base
  page="404"
  title="Page introuvable, L’Atelier de Bossimé"
  description="Cette page n’existe pas sur le site de Bossimé : retrouvez l’accueil, la carte ou la réservation."
>
  <section class="section" aria-labelledby="page-titre">
    <div class="container grid">
      <div class="head head--8">
        <h1 id="page-titre">Cette page n’existe pas</h1>
        <p class="lead">L’adresse a changé. La carte et la réservation sont toujours là.</p>
        <div class="actions" style="margin-top: var(--space-xl)">
          <a class="btn btn--primary" href={`${base}reserver-une-table/`}>Réserver une table</a>
          <a class="link" href={base}>Retour à l’accueil</a>
        </div>
      </div>
    </div>
  </section>
</Base>
