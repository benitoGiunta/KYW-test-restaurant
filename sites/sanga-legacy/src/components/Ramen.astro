---
import Rubrique from './Rubrique.astro';
import { ramen, bouillons } from '../data/site';
---
<section class="section ramen" id="carte" aria-labelledby="t-ramen">
  <div class="container ramen__grid">
    <div class="ramen__tete">
      <h2 id="t-ramen">Cinq ramen, trois bouillons</h2>
      <p class="lead">Chaque ramen se choisit en bouillon :</p>
      <ul class="bouillons" aria-label="Bouillons au choix">
        {bouillons.map((b) => <li>{b}</li>)}
      </ul>
    </div>
    <Rubrique r={ramen} titre={false} />
  </div>
</section>
