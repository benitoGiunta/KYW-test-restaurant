---
import Rubrique from './Rubrique.astro';
import { entrees, divers, boissons } from '../data/site';
---
<section class="band band--ink complements" aria-labelledby="t-compl">
  <div class="container">
    <h2 id="t-compl">Pour commencer, pour accompagner, pour boire</h2>
    <div class="complements__grid">
      <Rubrique r={entrees} />
      <Rubrique r={divers} />
      <Rubrique r={boissons} />
    </div>
  </div>
</section>
