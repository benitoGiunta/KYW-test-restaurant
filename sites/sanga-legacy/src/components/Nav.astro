---
import { resto, base } from '../data/site';
// Hallmark · dropped "recherche, compte, panier" · la boutique reste chez Order & Eat (lien Commander conservé) ; une carte de 33 lignes n'a pas besoin de recherche
---
<header class="nav">
  <div class="container nav__bar">
    <a class="nav__brand" href={base} aria-label="Sanga, accueil">
      <span class="nav__name">Sanga</span><span class="nav__kanji" lang="ja">{resto.kanji}</span>
    </a>
    <nav class="nav__links" aria-label="Sections">
      <a href="#carte">Carte</a>
      <a href="#livraison">Livraison</a>
      <a href="#horaires">Horaires</a>
    </nav>
    <a class="btn nav__cta" href={resto.commander}>Commander</a>
  </div>
</header>
