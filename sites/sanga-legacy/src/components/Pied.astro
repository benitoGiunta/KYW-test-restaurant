---
import { resto } from '../data/site';
---
<footer class="pied" aria-label="Coordonnées">
  <div class="container pied__grid">
    <div class="pied__mast">
      <p class="pied__nom" aria-hidden="true">Sanga</p>
      <p class="pied__accueil">{resto.accueil}</p>
    </div>
    <nav class="pied__liens" aria-label="Liens utiles">
      <a href={resto.commander}>Commander en ligne</a>
      <a href={resto.telHref}>{resto.telAffiche}</a>
      <a href={resto.maps}>{resto.adresse.rue}, {resto.adresse.cp} {resto.adresse.ville}</a>
      <a href={resto.cgv}>Conditions générales</a>
      <a href={resto.vie_privee}>Politique de confidentialité</a>
    </nav>
    <p class="pied__legal small">{resto.denomination}, entreprise {resto.bce}. Photographies : le restaurant (sanganamur.be, Order &amp; Eat).</p>
  </div>
</footer>
