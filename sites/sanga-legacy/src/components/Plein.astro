---
import { base } from '../data/site';
---
<section class="plein" aria-label="Photographie">
  <div class="container">
    <figure class="photo">
      <div class="photo__frame photo__frame--wide" data-slot="bols" data-alt="Deux bols de ramen vus de dessus, baguettes en bois, serviette de lin">
        <img src={`${base}photos/hero-ramen.webp`} alt="Deux bols de ramen vus de dessus, posés sur une serviette claire avec des baguettes en bois" width="1600" height="1067" loading="lazy" decoding="async" />
      </div>
      <figcaption class="small">Deux bols de ramen vus de dessus</figcaption>
    </figure>
  </div>
</section>
