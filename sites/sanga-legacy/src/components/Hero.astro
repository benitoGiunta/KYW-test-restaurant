---
import { resto, base } from '../data/site';
---
<section class="hero" aria-labelledby="titre">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="titre">{resto.baseline}</h1>
      <p class="lead">{resto.accroche}</p>
      <div class="counter well">
        <a class="counter__tel" href={resto.telHref}><span class="small">Appeler</span><span class="counter__num num">{resto.telAffiche}</span></a>
        <a class="btn" href={resto.commander}>Commander en ligne</a>
      </div>
    </div>
    <figure class="photo hero__photo">
      <div class="photo__frame" data-slot="hero" data-alt="Ramen au chashu et gyoza sur une table en bois, avec une louche en bois">
        <img src={`${base}photos/ramen.jpg`} alt="Un bol de ramen au chashu, œuf mollet et oignons verts, posé près de gyoza et d’un bol d’udon sur une table en bois" width="720" height="960" fetchpriority="high" decoding="async" />
      </div>
      <figcaption class="small">Ramen au chashu et gyoza</figcaption>
    </figure>
  </div>
</section>
