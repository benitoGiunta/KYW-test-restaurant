---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ramen from '../components/Ramen.astro';
import Plein from '../components/Plein.astro';
import Nouilles from '../components/Nouilles.astro';
import Complements from '../components/Complements.astro';
import Livraison from '../components/Livraison.astro';
import Horaires from '../components/Horaires.astro';
import Pied from '../components/Pied.astro';
---
<Base title="Sanga, ramen japonais à Namur, Rue Saint-Loup" description="Le premier restaurant de ramen à Namur : ramen, udon, soba et donburi, midi et soir du mardi au dimanche, sur place, à emporter ou livrés.">
  <Hero />
  <Ramen />
  <Plein />
  <Nouilles />
  <Complements />
  <Livraison />
  <Horaires />
  <Pied slot="pied" />
</Base>
