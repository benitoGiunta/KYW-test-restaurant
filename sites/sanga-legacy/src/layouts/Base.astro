---
import KywFooter from '@kyw/footer';
import Nav from '../components/Nav.astro';
import { resto, base } from '../data/site';
interface Props { title: string; description: string; pied?: boolean }
const { title, description, pied = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant', name: resto.nom, url: resto.siteActuel,
  telephone: '+3281241038', servesCuisine: ['Ramen', 'Cuisine japonaise'],
  address: { '@type': 'PostalAddress', streetAddress: resto.adresse.rue, postalCode: resto.adresse.cp, addressLocality: resto.adresse.ville, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: resto.geo.lat, longitude: resto.geo.lon },
});
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 fill=%27%23b8322a%27/%3E%3C/svg%3E" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}photos/ramen.jpg`, Astro.site).href} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=Archivo:wght@400;500&family=Archivo+Narrow:wght@600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={ld} />
    <style is:global>@import "../styles/page.css";</style>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu"><slot /></main>
    {pied && <slot name="pied" />}
    <KywFooter base={base} />
  </body>
</html>
