---
import Base from '../layouts/Base.astro';
import { SITE, u } from '../data/site';
---
<Base title="Page introuvable, La Dolce Vita Wépion" description="Cette page n’existe pas." ld={false}>
  <section class="phead" aria-labelledby="h1">
    <div class="container">
      <h1 id="h1">Cette page n’existe pas.</h1>
      <p class="lead">Revenez à l’accueil, ou appelez-nous pour réserver.</p>
      <div class="actions">
        <a class="btn btn--primary" href={u()}>Retour à l’accueil</a>
        <a class="link" href={SITE.tel.href}>Réserver au {SITE.tel.aff}</a>
      </div>
    </div>
  </section>
</Base>
