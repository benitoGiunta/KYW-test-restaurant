---
import { u } from '../lib/url';
import { restaurant } from '../data/site';
interface Props { courant?: string }
const { courant = '' } = Astro.props;
const liens = [
  { href: '/carte/', label: 'La carte', id: 'carte' },
  { href: '/histoire/', label: 'Histoire', id: 'histoire' },
  { href: '/reservation/', label: 'Réserver', id: 'reservation' },
];
---
<header class="tete">
  <a class="tete__marque" href={u('/')} aria-label="La Dolce Vita, accueil"><span class="tete__neon" aria-hidden="true">la dolce vita</span><span class="tete__lieu">Wépion</span></a>
  <nav class="tete__nav" aria-label="Navigation principale">
    <ul>
      {liens.map((l) => <li><a class="nav-lien" href={u(l.href)} aria-current={courant === l.id ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
  </nav>
  <a class="cta cta--petit tete__appel" href={`tel:${restaurant.telephone}`}><span class="cta__txt">Appeler <span class="nw">{restaurant.telephoneLisible}</span></span></a>
  <button class="tete__menu" type="button" popovertarget="menu-mobile" aria-label="Menu">Menu</button>
  <div id="menu-mobile" class="menu-mobile" popover>
    <button class="menu-mobile__fermer" type="button" popovertarget="menu-mobile" popovertargetaction="hide">Fermer</button>
    <ul>
      <li><a class="menu-mobile__lien" href={u('/')} aria-current={courant === 'accueil' ? 'page' : undefined}>Accueil</a></li>
      {liens.map((l) => <li><a class="menu-mobile__lien" href={u(l.href)} aria-current={courant === l.id ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
    <a class="cta" href={`tel:${restaurant.telephone}`}><span class="cta__txt">Appeler le <span class="nw">{restaurant.telephoneLisible}</span></span></a>
  </div>
</header>
