---
import { ClientRouter } from 'astro:transitions';
import { restaurant, horaires } from '../data/site';
import { asset } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props { title?: string; description?: string; page?: string }
const { title, description = restaurant.description, page = 'accueil' } = Astro.props;
const fullTitle = title ? `${title} | ${restaurant.nom}` : `${restaurant.nom} | Ristorante pizzeria à Wépion, Namur`;
const siteUrl = Astro.site ?? new URL('https://kyw-test-restaurant.vercel.app');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(asset('/og.png'), siteUrl).href;
const groupes = new Map<string, string[]>();
for (const h of horaires) for (const [a, b] of h.services) groupes.set(`${a}-${b}`, [...(groupes.get(`${a}-${b}`) ?? []), h.en]);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurant.nom,
  description: restaurant.description,
  url: new URL(asset('/'), siteUrl).href,
  telephone: restaurant.telephone,
  email: restaurant.email,
  servesCuisine: restaurant.typeCuisine,
  image: ogImage,
  address: { '@type': 'PostalAddress', streetAddress: `${restaurant.adresse.rue} ${restaurant.adresse.numero}`, postalCode: restaurant.adresse.cp, addressLocality: restaurant.adresse.commune, addressRegion: 'Namur', addressCountry: restaurant.adresse.pays },
  openingHoursSpecification: [...groupes].map(([cle, jours]) => {
    const [opens, closes] = cle.split('-');
    return { '@type': 'OpeningHoursSpecification', dayOfWeek: jours, opens, closes };
  }),
  acceptsReservations: true,
  hasMenu: new URL(asset('/carte/'), siteUrl).href,
  sameAs: restaurant.reseaux.map((r) => r.url),
};
---
<!doctype html>
<html lang="fr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1a2017" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={restaurant.nom} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" as="font" type="font/woff2" href={asset('/fonts/sacramento-400-normal.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={asset('/fonts/archivo-400_800-normal.woff2')} crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"></div></div>
    <Header courant={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
