---
// Pied de page « finale » : le nom géant monte en parallaxe sur brun, puis le pied de page KYW obligatoire.
import KywFooter from '@kyw/footer';
import { site, adresseLigne, horaireTexte, telHref } from '../data/site';
import { u } from '../lib/url';
interface Props { compact?: boolean; resume?: boolean }
const { compact = false, resume = false } = Astro.props;
---
<section class="footer" data-temp="80" aria-label="Le restaurant">
  <div class="wrap">
    <p class="footer__name" aria-hidden="true" data-parallax="0.12">{site.nom}</p>
    <p class="sr-only">{site.nom}</p>
    <div class="footer__cols">
      <div class="stack">
        <p class="t-xs muted">Adresse</p>
        <address>{adresseLigne()}</address>
        <p><a class="link" href={telHref()}>{site.telephone}</a></p>
      </div>
      {!compact && <div>
        <p class="t-xs muted" style="margin-bottom: var(--u)">Horaires</p>
        {resume ? <p>Ouvert jeudi à samedi et lundi</p> : <dl class="horaires">
          {site.horaires.map((h) => <><dt>{h.jour}</dt><dd>{horaireTexte(h)}</dd></>)}
        </dl>}
      </div>}
      <div class="stack">
        <p class="t-xs muted">Sur place et à emporter</p>
        {site.reseaux.map((r) => <p><a class="link" href={r.url} rel="noopener">{r.nom}</a></p>)}
        <p><a class="link" href={u('/reservation/')}>Réserver une table</a></p>
        <p><a class="link" href={u('/traiteur/')}>Traiteur et groupes</a></p>
      </div>
    </div>
    <div class="footer__colophon">
      {site.colophon.map((c) => <p>{c}</p>)}
    </div>
  </div>
</section>
<KywFooter base={import.meta.env.BASE_URL} />
