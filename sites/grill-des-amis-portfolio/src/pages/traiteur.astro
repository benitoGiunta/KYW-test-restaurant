---
import Base from '../layouts/Base.astro';
import { site, photoDe, telHref } from '../data/site';
import { u, asset } from '../lib/url';
const salle = photoDe('/photos/salle-comptoir.webp');
---
<Base title="Traiteur et groupes" description={`Traiteur à Namur avec ${site.nom} : menus sur mesure, barbecues premium livrés chez vous, repas de groupe.`} start={20}>
  <section class="hero hero--page" data-temp="20">
    <div class="wrap">
      <p class="chapeau" data-reveal="fade" data-intro>Traiteur et groupes</p>
      <h1 class="hero__title" data-split="lines" data-intro data-delay="0.1">Le feu chez vous</h1>
      <p class="hero__lead" style="margin-top: calc(var(--u) * 3)">{site.traiteur.intro}</p>
    </div>
  </section>

  <section class="section" data-temp="20">
    <div class="wrap">
      <div class="formules">
        {site.traiteur.formules.map((f, i) => (
          <article class="formule" data-reveal="up" data-delay={String(i * 0.1)}>
            <h2>{f.nom}</h2>
            <p>{f.texte}</p>
            {f.placeholder && <p class="tag" style="margin-top: var(--u)">Formule illustrative</p>}
          </article>
        ))}
      </div>
      <figure class="fig" data-reveal="clip" style="aspect-ratio: 16 / 9; margin-top: calc(var(--u) * 8)">
        <img src={asset(salle.src)} alt={salle.alt} width={salle.largeur} height={salle.hauteur} loading="lazy" decoding="async" />
      </figure>
      <div class="actions">
        <a class="btn btn--solid" href={telHref()}>Appeler le restaurant, {site.telephone}</a>
        <a class="btn btn--quiet" href={u('/')}>Retour à la braise</a>
      </div>
    </div>
  </section>
</Base>
