---
// Le sceau : seul cercle et seul rouge du site. Lien vers la réservation ; rotation de 8° au survol (CSS),
// se pose (scale 1.3 → 1) à l'entrée (setup.ts, [data-sceau]). Initiales dérivées du nom du restaurant.
import { site } from '../data/site';
import { u } from '../lib/url';
interface Props { taille?: 'm' | 'l' }
const { taille = 'm' } = Astro.props;
---
<a class={`sceau sceau--${taille}`} href={u('/reservation/')} data-sceau>
  <span class="sceau__disque">
    <span class="sceau__initiales">{site.sceau.initiales}</span>
  </span>
  <span class="sceau__legende">Réserver</span>
</a>
