---
// Une assiette : un disque. Avec photo (prise de haut, recadrée au ras de l'assiette) ou vide (dessinée, navet du logo).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Navet from './Navet.astro';
interface Props { image?: ImageMetadata; alt?: string; widths?: number[]; sizes?: string; priorite?: boolean; class?: string; creme?: boolean }
const { image, alt = '', widths = [320, 480, 640, 900], sizes = '(max-width: 767px) 60vw, 34vw', priorite = false, class: cls = '', creme = false } = Astro.props;
---
{image ? (
  <div class:list={['assiette', cls]}>
    <Image src={image} alt={alt} widths={widths} sizes={sizes} loading={priorite ? 'eager' : 'lazy'} fetchpriority={priorite ? 'high' : 'auto'} decoding="async" />
  </div>
) : (
  <div class:list={['assiette', 'assiette--vide', { 'assiette--creme': creme }, cls]}><Navet /></div>
)}
