---
import { resto, u } from '../data/site';
---
<footer class="pied" id="pied">
  <div class="container">
    <p class="pied-mast">{resto.nom}</p>
    <div class="g12 pied-cols">
      <div>
        <h2>Adresse</h2>
        <address>{resto.adresse.rue} {resto.adresse.numero}<br />{resto.adresse.cp} {resto.adresse.ville}</address>
        <a class="link" href={resto.itineraire} rel="noopener">Voir l’itinéraire</a>
      </div>
      <div>
        <h2>Réservation</h2>
        <a class="tel" href={resto.tel.href}>{resto.tel.affiche}</a>
        <a class="link" href={u('reveillon/')}>Le réveillon du 31 décembre</a>
      </div>
      <div>
        <h2>Le site</h2>
        <a class="link" href={resto.confidentialite} rel="noopener">Confidentialité</a>
        <a class="link" href={resto.credit.href} rel="noopener">{resto.credit.texte}</a>
      </div>
    </div>
    <p class="pied-legal"><span>{resto.legal.raison}</span><span>{resto.legal.tva}</span></p>
  </div>
</footer>
