---
import Base from '../layouts/Base.astro';
import Accents from '../components/Accents.astro';
import Photo from '../components/Photo.astro';
import { u } from '../lib/url';
import { site } from '../data/site';
import type { CleePhoto } from '../lib/photos';

const chapitres: { quand: string; titre: string; texte: string; photo: CleePhoto; legende: string }[] = [
  {
    quand: '2011',
    titre: 'Huit tables dans un coin de la ferme',
    texte: "Ludovic Vanackere a 20 ans quand il ouvre Bossimé dans l'exploitation familiale, à Loyers. Le restaurant compte huit tables. Le menu est une surprise : on mange ce que le jardin donne.",
    photo: 'ferme',
    legende: 'La ferme de Bossimé, côté cour.',
  },
  {
    quand: 'Le fenil',
    titre: 'Une salle sous la charpente',
    texte: "La salle s'installe dans l'ancien fenil, rénové en matériaux durables. La cuisine reste ouverte sur la salle, et de grandes baies vitrées donnent sur les jardins.",
    photo: 'vitrineJardin',
    legende: 'La salle derrière la baie, le jardin dans le reflet.',
  },
  {
    quand: 'Aujourd’hui',
    titre: 'Une étoile verte et un livret',
    texte: "Le Guide MICHELIN distingue la maison d'une étoile verte pour sa démarche durable, et le Gault&Millau a nommé le chef jeune chef de l'année. Le menu surprise reste, et un livret permet désormais de composer ses plats.",
    photo: 'equipeTrois',
    legende: 'En cuisine, tabliers Bossimé.',
  },
];
---
<Base title="Histoire" description="L'histoire de L'Atelier de Bossimé : ouvert en 2011 par Ludovic Vanackere à 20 ans, dans la ferme familiale de Loyers, aujourd'hui étoile verte du Guide MICHELIN.">
  <section class="ph ph--histoire" aria-labelledby="histoire-titre">
    <div class="wrap ph__grille ph__grille--paire">
      <div class="ph__texte">
        <h1 id="histoire-titre" class="ph__titre">Ouvert à 20 ans, au coin de la ferme.</h1>
        <p class="ph__chapo">Bossimé est d'abord une ferme familiale. Ludovic Vanackere y a posé une table, puis une salle, puis une brigade. Le restaurant n'a jamais quitté la ferme.</p>
      </div>
      <figure class="ph__photo">
        <div class="cadre"><Photo cle="cuisineOuverte" prioritaire widths={[640, 960, 1400]} sizes="(max-width: 767px) 100vw, 56vw" /></div>
        <figcaption class="legende">La cuisine ouverte, au passe.</figcaption>
      </figure>
    </div>
  </section>

  <ol class="recit wrap">
    {chapitres.map((c, i) => (
      <li class={`recit__chapitre recit__chapitre--${i % 2 ? 'droite' : 'gauche'}`}>
        <figure class="recit__photo">
          <div class="cadre" data-biais><Photo cle={c.photo} widths={[480, 800, 1200]} sizes="(max-width: 767px) 100vw, 50vw" /></div>
          <figcaption class="legende">{c.legende}</figcaption>
        </figure>
        <div class="recit__texte">
          <p class="recit__quand num"><Accents n={i + 1} classe="recit__traits" />{c.quand}</p>
          <h2 class="recit__titre" data-split="lines">{c.titre}</h2>
          <p data-reveal="up">{c.texte}</p>
        </div>
      </li>
    ))}
  </ol>

  <section class="maxime" aria-labelledby="maxime-titre">
    <div class="wrap">
      <h2 id="maxime-titre" class="maxime__phrase" data-split="lines">« L'exigence de la cuisine, la simplicité de la nature. »</h2>
      <p class="maxime__source">La seconde devise de la maison.</p>
    </div>
  </section>

  <section class="equipe" aria-labelledby="equipe-titre">
    <div class="wrap equipe__grille">
      <figure class="equipe__photo">
        <div class="cadre" data-biais><Photo cle="duoCuisine" widths={[480, 800, 1200]} sizes="(max-width: 767px) 100vw, 50vw" /></div>
        <figcaption class="legende">Deux cuisiniers de la brigade, devant la cuisine.</figcaption>
      </figure>
      <div class="equipe__texte">
        <h2 id="equipe-titre" class="equipe__titre" data-split="lines">Qui cuisine</h2>
        <dl class="equipe__liste">
          <dt>Ludovic Vanackere</dt>
          <dd>Chef et fondateur.</dd>
          <dt>La brigade</dt>
          <dd>Une quarantaine de personnes travaillent à l'année dans le projet Bossimé, du potager à la brasserie de La Confluence, à Namur.</dd>
        </dl>
        <p><a class="lien" href={u('/carte/')}>Voir ce que la cuisine sert</a></p>
      </div>
    </div>
  </section>
</Base>
