---
import Base from '../layouts/Base.astro';
import { site, cahier, adresseLigne, horaireTexte, telHref, photoDe } from '../data/site';
import { u } from '../lib/url';
import Plan from '../components/Plan.astro';
import Polaroid from '../components/Polaroid.astro';
---
<Base title="Commander" description={`Commander ou réserver des pains chez Monepi à ${site.adresse.commune} : par téléphone au ${site.telephone}. Horaires, adresse et plan.`}>
  <section class="page-cahier" aria-labelledby="h1">
    <div class="wrap">
      <div class="titre titre--grand">
        <p class="titre__sur">{cahier.titre}, commandes</p>
        <h1 id="h1" data-split="words" data-intro>Commander</h1>
        <p class="lead" style="margin-top: var(--u)">Pour réserver ses produits, on appelle la boulangerie au {site.telephone}. La boutique est rue Es Fays 43, à Loyers.</p>
      </div>
      <div class="actions" style="margin-top: 0">
        <a class="btn btn--plein" href={telHref()}>Appeler le {site.telephone}</a>
        <a class="btn" href={u('/pains/')}>Choisir dans la liste des pains</a>
      </div>
    </div>
    <p class="folio"></p>
  </section>

  <section class="page-cahier" aria-labelledby="h-venir">
    <div class="wrap">
      <div class="titre">
        <h2 id="h-venir" data-split="words">Venir</h2>
      </div>
      <div class="pratique">
        <div class="stack">
          <dl class="horaires horaires--grand">
            {site.horaires.map((h) => <><dt>{h.jour}</dt><dd>{horaireTexte(h)}</dd></>)}
          </dl>
          <p class="muted" style="font-size: var(--t-s)">Seul le vendredi est publié par la boulangerie. Pour les autres jours, appelez avant de passer.</p>
          <p><strong>Adresse</strong><br />{adresseLigne()}</p>
          <Plan />
        </div>
        <Polaroid photo={photoDe('/photos/four-bouche.webp')} rot={2} legende="la bouche du four" />
      </div>
    </div>
    <p class="folio"></p>
  </section>
</Base>
